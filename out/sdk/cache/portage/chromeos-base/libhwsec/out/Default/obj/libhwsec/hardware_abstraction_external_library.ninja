defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DBUILD_LIBHWSEC -DUSE_TPM_DYNAMIC=false -DUSE_TPM1=false\|\|false -DUSE_TPM2=false\|\|false -DUSE_FUZZER=false
