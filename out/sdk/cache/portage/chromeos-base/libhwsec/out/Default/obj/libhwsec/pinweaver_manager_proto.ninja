defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/libhwsec -Igen/include -I../../../../../../../mnt/host/source/src/platform2 -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIE
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libpinweaver_manager_proto

build obj/gen/include/libhwsec/libpinweaver_manager_proto.pinweaver_leaf_label_data.pb.o: cxx gen/include/libhwsec/pinweaver_leaf_label_data.pb.cc || obj/libhwsec/pinweaver_manager_proto_gen.stamp
  source_file_part = pinweaver_leaf_label_data.pb.cc
  source_name_part = pinweaver_leaf_label_data.pb

build ./libpinweaver_manager_proto.a: alink obj/gen/include/libhwsec/libpinweaver_manager_proto.pinweaver_leaf_label_data.pb.o || obj/libhwsec/pinweaver_manager_proto_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
