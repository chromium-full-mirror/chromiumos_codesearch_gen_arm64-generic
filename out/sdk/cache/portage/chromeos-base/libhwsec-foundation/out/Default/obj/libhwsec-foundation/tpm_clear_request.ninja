defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DENABLE_PROFILING=false -DCHROMEOS_ENVIRONMENT=1 -DUSE_TPM1=false -DUSE_TPM2=false -DUSE_TPM2_SIMULATOR=false -DUSE_TPM_DYNAMIC=false
include_dirs = -Igen/include -I../../../../../../../mnt/host/source/src/platform2
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIE -Wconsumed -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/usr/include/libchrome -I/usr/include/glib-2.0 -I/usr/lib64/glib-2.0/include -I/usr/include/perfetto -I/usr/include/nss -I/usr/include/nspr -I/usr/include/dbus-1.0 -I/usr/lib64/dbus-1.0/include -I/usr/include/chromeos -DPROTOBUF_USE_DLLS -Wno-unused-local-typedefs -DBASE_VER=1241304 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -DPROTOBUF_USE_DLLS -pthread
cflags_cc = -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -Wno-error=deprecated-declarations
root_out_dir = .
target_output_name = tpm_clear_request

build obj/libhwsec-foundation/tool/tpm_clear_request.tpm_clear_request.o: cxx ../../../../../../../mnt/host/source/src/platform2/libhwsec-foundation/tool/tpm_clear_request.cc
  source_file_part = tpm_clear_request.cc
  source_name_part = tpm_clear_request

build ./tpm_clear_request: link obj/libhwsec-foundation/tool/tpm_clear_request.tpm_clear_request.o ./lib/libhwsec-foundation.so || obj/libhwsec-foundation/_tpm_clear_request-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,-O2 -Wl,--as-needed -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed -pie -pthread
  libs = -lbrillo -lbase -lpthread -lcrossystem -lssl -lcrypto -lre2
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
