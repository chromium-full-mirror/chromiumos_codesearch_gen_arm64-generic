ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../usr/bin/gn --root=../../../../../../tmp/portage/chromeos-base/power_manager-client-0.0.1-r2792/work/power_manager-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libpower_manager-client-headers: phony obj/power_manager/client/libpower_manager-client-headers.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build power_manager/client$:all: phony obj/power_manager/client/all.stamp
build power_manager/client$:libpower_manager-client-headers: phony obj/power_manager/client/libpower_manager-client-headers.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/power_manager/client/all.stamp $
    obj/power_manager/client/libpower_manager-client-headers.stamp

default all
