defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D__CHROMEOS__ -D_POSIX_C_SOURCE=199309L -DUSE_FEC=0 -DUSE_HWID_OVERRIDE=false -DUSE_HW_DETAILS=false -DUSE_LVM_STATEFUL_PARTITION=false
include_dirs = -Igen/include -I../../../../../../../mnt/host/source/src/platform2 -I../../../../../../../mnt/host/source/src/platform2/update_engine/client_library/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ffunction-sections -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/usr/include/libchrome -I/usr/include/glib-2.0 -I/usr/lib64/glib-2.0/include -I/usr/include/perfetto -I/usr/include/nss -I/usr/include/nspr -I/usr/include/dbus-1.0 -I/usr/lib64/dbus-1.0/include -I/usr/include/chromeos -DPROTOBUF_USE_DLLS -pthread -Wno-unused-local-typedefs -DBASE_VER=1257783 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/usr/include/xz-embedded -I/usr/include/ext2fs -I/usr/include/et
cflags_cc = -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-strict-aliasing -Wdelete-non-virtual-dtor
root_out_dir = .
target_output_name = delta_generator

build obj/update_engine/payload_generator/delta_generator.generate_delta_main.o: cxx ../../../../../../../mnt/host/source/src/platform2/update_engine/payload_generator/generate_delta_main.cc || obj/update_engine/update_engine-dbus-kiosk-app-client.stamp obj/update_engine/update_metadata-protos_gen.stamp
  source_file_part = generate_delta_main.cc
  source_name_part = generate_delta_main

build ./delta_generator: link obj/update_engine/payload_generator/delta_generator.generate_delta_main.o ./libpayload_consumer.a ./libpayload_generator.a ./libupdate_metadata-protos.a || obj/update_engine/_delta_generator-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,-O2 -Wl,--as-needed -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed -Wl,--gc-sections -L/usr/lib
  libs = -lbrillo -lbase -lpthread -lsystem_api-device_management-protos -lsystem_api-hps-protos -lsystem_api-power_manager-protos -lsystem_api-protos -lsystem_api-kerberos-protos -lsystem_api-login_manager-protos -lsystem_api-lorgnette-protos -lsystem_api-smbprovider-protos -lsystem_api-vm_concierge-protos -lsystem_api-vm_applications-protos -lsystem_api-vm_launch-protos -lsystem_api-vm_sk_forwarding-protos -lsystem_api-vm_cicerone-protos -lsystem_api-seneschal-protos -lsystem_api-oobe_config-protos -lsystem_api-runtime_probe-protos -lsystem_api-dlcservice-protos -lsystem_api-update_engine-protos -lsystem_api-vm_plugin_dispatcher-protos -lsystem_api-u2f-protos -lsystem_api-chunneld-protos -lsystem_api-system_proxy-protos -lsystem_api-vm_permission_service-protos -lsystem_api-anomaly_detector-protos -lsystem_api-minios-protos -lsystem_api-dlp-protos -lsystem_api-rmad-protos -lsystem_api-fusebox-protos -lsystem_api-privacy_screen-protos -lsystem_api-cdm_oemcrypto-protos -lsystem_api-ml-protos -lsystem_api-lvmd-protos -lsystem_api-shadercached-protos -lsystem_api-spaced-protos -lsystem_api-imageloader-protos -lsystem_api -lsystem_api-arc-protos -lsystem_api-private_computing-protos -lsystem_api-arcvm_data_migrator-protos -lsystem_api-featured-protos -lsystem_api-vm_wl-protos -lsystem_api-printscanmgr-protos -lsystem_api-vm_memory_management-protos -lprotobuf-lite -labsl_log_internal_check_op -labsl_log_internal_nullguard -labsl_log_severity -labsl_strings -labsl_string_view -labsl_base -lrt -labsl_raw_logging_internal -labsl_spinlock_wait -labsl_throw_delegate -labsl_strings_internal -labsl_int128 -labsl_log_internal_message -labsl_examine_stack -labsl_stacktrace -labsl_debugging_internal -labsl_symbolize -labsl_demangle_internal -labsl_malloc_internal -labsl_log_internal_format -labsl_log_internal_globals -labsl_time -labsl_civil_time -labsl_time_zone -labsl_str_format_internal -labsl_log_internal_proto -labsl_log_internal_log_sink_set -labsl_log_globals -labsl_hash 