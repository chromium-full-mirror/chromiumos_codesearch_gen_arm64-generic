defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../mnt/host/source/src/platform2 -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIE -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libsystem_api-vm_concierge-protos

build obj/system_api/system_api-vm_concierge-protos.inputdeps.stamp: stamp obj/system_api/system_api-arc-protos_gen.stamp obj/system_api/system_api-vm_concierge-protos_gen.stamp
build obj/gen/include/vm_concierge/libsystem_api-vm_concierge-protos.concierge_service.pb.o: cxx gen/include/vm_concierge/concierge_service.pb.cc || obj/system_api/system_api-vm_concierge-protos.inputdeps.stamp
  source_file_part = concierge_service.pb.cc
  source_name_part = concierge_service.pb

build ./libsystem_api-vm_concierge-protos.a: alink obj/gen/include/vm_concierge/libsystem_api-vm_concierge-protos.concierge_service.pb.o || obj/system_api/system_api-vm_concierge-protos_gen.stamp ./libsystem_api-arc-protos.a
  arflags = rcs
  output_extension = .a
  output_dir = 
