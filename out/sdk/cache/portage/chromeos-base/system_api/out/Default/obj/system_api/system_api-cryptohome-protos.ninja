build obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.auth_factor.pb.o: cxx gen/include/cryptohome/proto_bindings/auth_factor.pb.cc || obj/system_api/system_api-cryptohome-protos_gen.stamp
