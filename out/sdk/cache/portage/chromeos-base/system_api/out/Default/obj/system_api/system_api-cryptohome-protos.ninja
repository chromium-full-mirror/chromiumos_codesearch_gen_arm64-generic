  source_file_part = fido.pb.cc
  source_name_part = fido.pb
build obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.key.pb.o: cxx gen/include/cryptohome/proto_bindings/key.pb.cc || obj/system_api/system_api-cryptohome-protos_gen.stamp
