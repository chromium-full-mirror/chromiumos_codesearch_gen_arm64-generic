build obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.rpc.pb.o: cxx gen/include/cryptohome/proto_bindings/rpc.pb.cc || obj/system_api/system_api-cryptohome-protos_gen.stamp
  source_file_part = rpc.pb.cc
  source_name_part = rpc.pb

build ./libsystem_api-cryptohome-protos.a: alink obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.UserDataAuth.pb.o obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.auth_factor.pb.o obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.fido.pb.o obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.key.pb.o obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.recoverable_key_store.pb.o obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.rpc.pb.o || obj/system_api/system_api-cryptohome-protos_gen.stamp
  arflags = rcs
