build obj/gen/include/cryptohome/proto_bindings/libsystem_api-cryptohome-protos.recoverable_key_store.pb.o: cxx gen/include/cryptohome/proto_bindings/recoverable_key_store.pb.cc || obj/system_api/system_api-cryptohome-protos_gen.stamp
  source_file_part = recoverable_key_store.pb.cc
