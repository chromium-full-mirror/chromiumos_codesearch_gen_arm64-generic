ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../usr/bin/gn --root=../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2389/work/libbrillo-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libbrillo: phony obj/libbrillo/libbrillo.stamp
build _libbrillo-compression-install_config: phony obj/libbrillo/_libbrillo-compression-install_config.stamp
build _libbrillo-core-install_config: phony obj/libbrillo/_libbrillo-core-install_config.stamp
build _libbrillo-cryptohome-install_config: phony obj/libbrillo/_libbrillo-cryptohome-install_config.stamp
build _libbrillo-dbus-install_config: phony obj/libbrillo/_libbrillo-dbus-install_config.stamp
build _libbrillo-grpc-install_config: phony obj/libbrillo/_libbrillo-grpc-install_config.stamp
build _libbrillo-http-install_config: phony obj/libbrillo/_libbrillo-http-install_config.stamp
build _libbrillo-minijail-install_config: phony obj/libbrillo/_libbrillo-minijail-install_config.stamp
build _libbrillo-namespaces-install_config: phony obj/libbrillo/_libbrillo-namespaces-install_config.stamp
build _libbrillo-protobuf-install_config: phony obj/libbrillo/_libbrillo-protobuf-install_config.stamp
build _libbrillo-storage-install_config: phony obj/libbrillo/_libbrillo-storage-install_config.stamp
build _libbrillo-streams-install_config: phony obj/libbrillo/_libbrillo-streams-install_config.stamp
