defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DBUS=true -DUSE_RTTI_FOR_TYPE_TAGS=1 -DUSE_ENTERPRISE_ROLLBACK_REVEN=false
include_dirs = -Igen/include -I../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2404/work/libbrillo-0.0.1 -I../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2404/work/libbrillo-0.0.1/libbrillo
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIC -I/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1255387 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/usr/include/glib-2.0 -I/usr/lib64/glib-2.0/include -I/usr/include/perfetto -I/usr/include/nss -I/usr/include/nspr -I/usr/include/dbus-1.0 -I/usr/lib64/dbus-1.0/include -DPROTOBUF_USE_DLLS
cflags_cc = -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libbrillo-compression

build obj/libbrillo/brillo/compression/libbrillo-compression.zlib_compressor.o: cxx ../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2404/work/libbrillo-0.0.1/libbrillo/brillo/compression/zlib_compressor.cc
  source_file_part = zlib_compressor.cc
  source_name_part = zlib_compressor

build ./lib/libbrillo-compression.so: solink obj/libbrillo/brillo/compression/libbrillo-compression.zlib_compressor.o || obj/libbrillo/_libbrillo-compression-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,-O2 -Wl,--as-needed -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed
  libs = -lbase -lpthread -lz
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
