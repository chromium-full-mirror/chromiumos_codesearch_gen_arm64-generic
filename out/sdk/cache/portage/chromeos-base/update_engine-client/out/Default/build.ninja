ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../usr/bin/gn --root=../../../../../../tmp/portage/chromeos-base/update_engine-client-0.0.1-r2372/work/update_engine-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libupdate_engine-client-headers: phony obj/update_engine/client-headers/libupdate_engine-client-headers.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build update_engine/client-headers$:all: phony obj/update_engine/client-headers/all.stamp
build update_engine/client-headers$:libupdate_engine-client-headers: phony obj/update_engine/client-headers/libupdate_engine-client-headers.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/update_engine/client-headers/all.stamp $
    obj/update_engine/client-headers/libupdate_engine-client-headers.stamp

default all
