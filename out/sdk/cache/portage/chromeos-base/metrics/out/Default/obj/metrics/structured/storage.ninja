defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/metrics/structured/proto -Igen/include -I../../../../../../tmp/portage/chromeos-base/metrics-0.0.1-r3727/work/metrics-0.0.1/platform2 -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIC
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libstorage

build obj/gen/include/metrics/structured/proto/libstorage.storage.pb.o: cxx gen/include/metrics/structured/proto/storage.pb.cc || obj/metrics/structured/storage_gen.stamp
  source_file_part = storage.pb.cc
  source_name_part = storage.pb
build obj/gen/include/metrics/structured/proto/libstorage.structured_data.pb.o: cxx gen/include/metrics/structured/proto/structured_data.pb.cc || obj/metrics/structured/storage_gen.stamp
  source_file_part = structured_data.pb.cc
  source_name_part = structured_data.pb

build ./libstorage.a: alink obj/gen/include/metrics/structured/proto/libstorage.storage.pb.o obj/gen/include/metrics/structured/proto/libstorage.structured_data.pb.o || obj/metrics/structured/storage_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
