ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../usr/bin/gn --root=../../../../../../tmp/portage/chromeos-base/metrics-0.0.2-r3777/work/metrics-0.0.2/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _update_reset_counter-install_config: phony obj/metrics/structured/_update_reset_counter-install_config.stamp
build gen_structured_events: phony obj/metrics/structured/gen_structured_events.stamp
build install_minijail_conf: phony obj/metrics/install_minijail_conf.stamp
build libmetrics: phony ./lib/libmetrics.so
build libmetrics_daemon: phony ./libmetrics_daemon.a
build libstructuredmetrics: phony ./lib/libstructuredmetrics.so
build libstructuredmetrics_install_headers: phony obj/metrics/structured/libstructuredmetrics_install_headers.stamp
build libstructuredmetrics_pkg_config: phony obj/metrics/structured/libstructuredmetrics_pkg_config.stamp
build libupload_service: phony ./libupload_service.a
build metrics_proto: phony ./libmetrics_proto.a
build metrics_proto_gen: phony obj/metrics/metrics_proto_gen.stamp
build metrics_test_support: phony obj/metrics/metrics_test_support.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build storage: phony ./libstorage.a
build storage_gen: phony obj/metrics/structured/storage_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build metrics$:all: phony obj/metrics/all.stamp
build metrics$:install_minijail_conf: phony obj/metrics/install_minijail_conf.stamp
build metrics$:libmetrics: phony ./lib/libmetrics.so
build metrics$:libmetrics_daemon: phony ./libmetrics_daemon.a
build metrics$:libupload_service: phony ./libupload_service.a
build metrics$:metrics_client: phony ./metrics_client
build metrics$:metrics_daemon: phony ./metrics_daemon
build metrics$:metrics_proto: phony ./libmetrics_proto.a
build metrics$:metrics_proto_gen: phony obj/metrics/metrics_proto_gen.stamp
build metrics$:metrics_test_support: phony obj/metrics/metrics_test_support.stamp
build metrics/structured$:_update_reset_counter-install_config: phony obj/metrics/structured/_update_reset_counter-install_config.stamp
build metrics/structured$:gen_structured_events: phony obj/metrics/structured/gen_structured_events.stamp
build metrics/structured$:libstructuredmetrics: phony ./lib/libstructuredmetrics.so
build metrics/structured$:libstructuredmetrics_install_headers: phony obj/metrics/structured/libstructuredmetrics_install_headers.stamp
build metrics/structured$:libstructuredmetrics_pkg_config: phony obj/metrics/structured/libstructuredmetrics_pkg_config.stamp
build metrics/structured$:storage: phony ./libstorage.a
build metrics/structured$:storage_gen: phony obj/metrics/structured/storage_gen.stamp
build metrics/structured$:update_reset_counter: phony ./update_reset_counter

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/metrics/all.stamp $
    obj/metrics/install_minijail_conf.stamp $
    ./lib/libmetrics.so $
    ./libmetrics_daemon.a $
    ./libupload_service.a $
    ./metrics_client $
    ./metrics_daemon $
    ./libmetrics_proto.a $
    obj/metrics/metrics_proto_gen.stamp $
    obj/metrics/metrics_test_support.stamp $
    obj/metrics/structured/_update_reset_counter-install_config.stamp $
    obj/metrics/structured/gen_structured_events.stamp $
    ./lib/libstructuredmetrics.so $
    obj/metrics/structured/libstructuredmetrics_install_headers.stamp $
    obj/metrics/structured/libstructuredmetrics_pkg_config.stamp $
    ./libstorage.a $
    obj/metrics/structured/storage_gen.stamp $
    ./update_reset_counter

default all
