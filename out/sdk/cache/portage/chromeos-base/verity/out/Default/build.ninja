ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../usr/bin/gn --root=../../../../../../tmp/portage/chromeos-base/verity-0.0.1-r507/work/verity-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libdm-bht-install_config: phony obj/verity/_libdm-bht-install_config.stamp
build _verity-install_config: phony obj/verity/_verity-install_config.stamp
build install_fls_header: phony obj/verity/install_fls_header.stamp
build install_headers: phony obj/verity/install_headers.stamp
build install_pkg_config: phony obj/verity/install_pkg_config.stamp
build install_subtool: phony obj/verity/install_subtool.stamp
build libdm-bht: phony ./lib/libdm-bht.so
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build verity$:_libdm-bht-install_config: phony obj/verity/_libdm-bht-install_config.stamp
build verity$:_verity-install_config: phony obj/verity/_verity-install_config.stamp
build verity$:all: phony obj/verity/all.stamp
build verity$:install_fls_header: phony obj/verity/install_fls_header.stamp
build verity$:install_headers: phony obj/verity/install_headers.stamp
build verity$:install_pkg_config: phony obj/verity/install_pkg_config.stamp
build verity$:install_subtool: phony obj/verity/install_subtool.stamp
build verity$:libdm-bht: phony ./lib/libdm-bht.so
build verity$:verity: phony ./verity

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/verity/_libdm-bht-install_config.stamp $
    obj/verity/_verity-install_config.stamp $
    obj/verity/all.stamp $
    obj/verity/install_fls_header.stamp $
    obj/verity/install_headers.stamp $
    obj/verity/install_pkg_config.stamp $
    obj/verity/install_subtool.stamp $
    ./lib/libdm-bht.so $
    ./verity

default all
