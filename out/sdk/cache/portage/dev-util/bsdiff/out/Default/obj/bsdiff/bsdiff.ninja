defines = -DNDEBUG -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../tmp/portage/dev-util/bsdiff-4.3.1-r41/work/bsdiff-4.3.1/platform2 -I../../../../../../tmp/portage/dev-util/bsdiff-4.3.1-r41/work/bsdiff-4.3.1/platform2/bsdiff/include -I../../../../../../tmp/portage/dev-util/bsdiff-4.3.1-r41/work/bsdiff-4.3.1/platform2/aosp/external
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -fPIE -Wextra -Wno-unused-parameter
cflags_cc = -std=gnu++20 -DNDEBUG -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -O2 -pipe -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -Wnon-virtual-dtor
root_out_dir = .
target_output_name = bsdiff

build obj/bsdiff/bsdiff.bsdiff_arguments.o: cxx ../../../../../../tmp/portage/dev-util/bsdiff-4.3.1-r41/work/bsdiff-4.3.1/platform2/bsdiff/bsdiff_arguments.cc
  source_file_part = bsdiff_arguments.cc
  source_name_part = bsdiff_arguments
build obj/bsdiff/bsdiff.bsdiff_main.o: cxx ../../../../../../tmp/portage/dev-util/bsdiff-4.3.1-r41/work/bsdiff-4.3.1/platform2/bsdiff/bsdiff_main.cc
  source_file_part = bsdiff_main.cc
  source_name_part = bsdiff_main

build ./bsdiff: link obj/bsdiff/bsdiff.bsdiff_arguments.o obj/bsdiff/bsdiff.bsdiff_main.o ./libbsdiff.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,-O2 -Wl,--as-needed -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed -pie -L/usr/lib
  libs = -lbz2 -lbrotlienc -ldivsufsort -ldivsufsort64
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
