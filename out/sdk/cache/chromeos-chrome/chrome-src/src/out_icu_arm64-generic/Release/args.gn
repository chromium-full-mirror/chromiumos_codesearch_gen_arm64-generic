is_chromeos_device = true
icu_disable_thin_archive = true
is_official_build = true
is_debug = false
use_ozone = true
use_evdev_gestures = false
linux_use_bundled_binutils = false
use_debug_fission = false
enable_remoting = false
enable_nacl = false
icu_use_data_file = true
use_xkbcommon = true
use_system_harfbuzz = false
use_system_freetype = false
use_system_libsync = false
use_cups = true
use_bundled_fontconfig = false
use_custom_libcxx = false
is_asan = false
is_msan = false
is_ubsan = false
use_thin_lto = false
is_cfi = false
use_cfi_cast = false
use_cras = false
treat_warnings_as_errors = false
use_goma = false
target_sysroot = "/build/arm64-generic"
system_libdir = "lib64"
pkg_config = "/build/arm64-generic/build/bin/pkg-config"
target_os = "chromeos"
host_pkg_config = "x86_64-pc-linux-gnu-pkg-config"
target_cpu = "arm64"
arm_arch = "armv8-a"
chrome_orderfile_path = ""
cros_target_ar = "llvm-ar"
cros_target_cc = "aarch64-cros-linux-gnu-clang"
cros_target_cxx = "aarch64-cros-linux-gnu-clang++"
host_toolchain = "//build/toolchain/cros:host"
custom_toolchain = "//build/toolchain/cros:target"
cros_target_ld = "aarch64-cros-linux-gnu-clang++"
cros_target_nm = "llvm-nm"
cros_target_readelf = "llvm-readelf"
cros_target_extra_cflags = "-pipe -march=armv8-a -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -fdebug-types-section -faddrsig -Wno-unknown-warning-option "
cros_target_extra_cppflags = ""
cros_target_extra_cxxflags = "-pipe -march=armv8-a -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -ffunction-sections -fdata-sections -fdebug-types-section -D__google_stl_debug_vector=1 -faddrsig -Wno-unknown-warning-option -stdlib=libc++ "
cros_target_extra_ldflags = "-Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -stdlib=libc++ -Wl,--no-fatal-warnings "
cros_host_cc = "x86_64-pc-linux-gnu-clang -B/usr/bin"
cros_host_cxx = "x86_64-pc-linux-gnu-clang++ -B/usr/bin"
cros_host_ar = "llvm-ar"
cros_host_ld = "x86_64-pc-linux-gnu-clang++"
cros_host_nm = "llvm-nm"
cros_host_readelf = "llvm-readelf"
cros_host_extra_cflags = " -Wno-unknown-warning-option"
cros_host_extra_cxxflags = " -Wno-unknown-warning-option"
cros_host_extra_cppflags = ""
cros_host_extra_ldflags = ""
