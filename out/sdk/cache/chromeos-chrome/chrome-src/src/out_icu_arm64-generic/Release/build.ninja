ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../home/chrome-bot/chrome_root/src/buildtools/linux64/gn --root=../../../../../../../home/chrome-bot/chrome_root/src -q --root-target=//third_party/icu --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

pool build_toolchain_action_pool
  depth = 32

pool build_toolchain_link_pool
  depth = 15

subninja toolchain.ninja

build blink_buildflags: phony obj/build/blink_buildflags.stamp
build branding_buildflags: phony obj/build/branding_buildflags.stamp
build buildflag_header_h: phony obj/build/buildflag_header_h.stamp
build buildflags: phony obj/build/config/coverage/buildflags.stamp
build chromecast_buildflags: phony obj/build/chromecast_buildflags.stamp
build chromeos_buildflags: phony obj/build/chromeos_buildflags.stamp
build chromium_git_revision: phony obj/build/util/chromium_git_revision.stamp
build common_deps: phony obj/build/config/common_deps.stamp
build compiler_buildflags: phony obj/build/config/compiler/compiler_buildflags.stamp
build convert_chart_json: phony obj/third_party/catapult/tracing/convert_chart_json.stamp
build copy_icudata: phony obj/third_party/icu/copy_icudata.stamp
build deps: phony obj/build/config/sanitizers/deps.stamp
build executable_deps: phony obj/build/config/executable_deps.stamp
build fuchsia_pytype: phony obj/testing/fuchsia_pytype.stamp
build generate_about_tracing: phony obj/third_party/catapult/tracing/generate_about_tracing.stamp
build gold_common_pytype: phony obj/build/gold_common_pytype.stamp
build icu: phony obj/third_party/icu/icu.stamp
build icudata: phony obj/third_party/icu/icudata.stamp
build icudata_hash: phony obj/third_party/icu/icudata_hash.stamp
