build icuuc_private_hidden_visibility: phony obj/third_party/icu/libicuuc_hidden_visibility.a
build icuuc_public: phony obj/third_party/icu/icuuc_public.stamp
build linux: phony obj/build/config/linux/linux.stamp
build llvm-symbolizer_data: phony obj/build/config/clang/llvm-symbolizer_data.stamp
build loadable_module_deps: phony obj/build/config/loadable_module_deps.stamp
build options_sources: phony obj/build/config/sanitizers/liboptions_sources.a
