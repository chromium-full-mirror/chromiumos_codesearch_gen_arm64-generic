defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_GNU_SOURCE -D_LIBCPP_ENABLE_ASSERTIONS=1 -DCR_CLANG_REVISION=\"llvmorg-18-init-17730-gf670112a-1\" -DNDEBUG -DNVALGRIND
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Iirt_arm/gen
label_name = check_version_internal
root_out_dir = irt_arm
target_out_dir = irt_arm/obj/base
target_output_name = check_version_internal


build irt_arm/obj/base/check_version_internal.stamp: irt_arm_stamp || irt_arm/obj/base/check_version_internal_action.stamp
