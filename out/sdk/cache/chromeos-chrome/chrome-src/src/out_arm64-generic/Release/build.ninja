ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../home/chrome-bot/chrome_root/src/buildtools/linux64/gn --root=../../../../../../../home/chrome-bot/chrome_root/src -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

pool build_toolchain_action_pool
  depth = 64

pool build_toolchain_link_pool
  depth = 6

subninja toolchain.ninja
subninja clang_newlib_arm/toolchain.ninja
subninja glibc_arm/toolchain.ninja
subninja host/toolchain.ninja
subninja host_for_rust_host_build_tools/toolchain.ninja
subninja irt_arm/toolchain.ninja
subninja nacl_bootstrap/toolchain.ninja
subninja nacl_helper_arm32/toolchain.ninja
subninja newlib_pnacl/toolchain.ninja
subninja test_irt_arm/toolchain.ninja
subninja v8_snapshot/toolchain.ninja

build all_rust: phony obj/all_rust.stamp
build blink_python_tests: phony obj/blink_python_tests.stamp
build blink_tests: phony obj/blink_tests.stamp
build blink_web_tests: phony obj/blink_web_tests.stamp
