  source_name_part = crc32_simd
build host/obj/third_party/zlib/zlib_crc32_simd/crc_folding.o: host_cc ../../../../../../../home/chrome-bot/chrome_root/src/third_party/zlib/crc_folding.c
  source_file_part = crc_folding.c
  source_name_part = crc_folding

build host/obj/third_party/zlib/zlib_crc32_simd.stamp: host_stamp host/obj/third_party/zlib/zlib_crc32_simd/crc32_simd.o host/obj/third_party/zlib/zlib_crc32_simd/crc_folding.o || host/obj/third_party/zlib/zlib_common_headers.stamp
