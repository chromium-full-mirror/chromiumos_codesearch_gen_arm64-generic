defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_GNU_SOURCE -D_LIBCPP_ENABLE_ASSERTIONS=1 -DCR_CLANG_REVISION=\"llvmorg-18-init-17730-gf670112a-1\" -DNDEBUG -DNVALGRIND
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Iirt_arm/gen
cflags = -gline-tables-only -Wall -Wextra -Wimplicit-fallthrough -Wextra-semi -Wunreachable-code-aggressive -Wthread-safety -Wno-missing-field-initializers -Wno-unused-parameter -Wno-psabi -Wloop-analysis -Wno-unneeded-internal-declaration -Wenum-compare-conditional -Wno-ignored-pragma-optimize -Wno-deprecated-builtins -Wno-bitfield-constant-conversion -Wno-deprecated-this-capture -Wno-invalid-offsetof -Wno-vla-extension -Wno-thread-safety-reference-return -Wshadow -Werror -fno-ident -fno-strict-aliasing -fcolor-diagnostics -fmerge-all-constants -U__STRICT_ANSI__ -integrated-as -fasynchronous-unwind-tables -fomit-frame-pointer -Xclang -fdebug-compilation-dir -Xclang . -no-canonical-prefixes -fomit-frame-pointer -g2 -gsplit-dwarf -Xclang -fuse-ctor-homing -fvisibility=hidden -Os -ffunction-sections -fdata-sections
cflags_cc = -std=c++20 -Wno-trigraphs -fno-exceptions -fno-rtti -fvisibility-inlines-hidden
label_name = base_static
root_out_dir = irt_arm
target_out_dir = irt_arm/obj/base
target_output_name = libbase_static

build irt_arm/obj/base/base_static.inputdeps.stamp: irt_arm_stamp irt_arm/obj/base/fuzzing_buildflags.stamp irt_arm/obj/build/chromeos_buildflags.stamp host/tls_edit
build irt_arm/obj/base/base_static/base_switches.o: irt_arm_cxx ../../../../../../../home/chrome-bot/chrome_root/src/base/base_switches.cc || irt_arm/obj/base/base_static.inputdeps.stamp
  source_file_part = base_switches.cc
  source_name_part = base_switches

build irt_arm/obj/base/libbase_static.a: irt_arm_alink irt_arm/obj/base/base_static/base_switches.o || irt_arm/obj/base/fuzzing_buildflags.stamp irt_arm/obj/build/chromeos_buildflags.stamp
  arflags =
  output_extension = .a
  output_dir = irt_arm/obj/base
