defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_NONE -DNDEBUG -DNVALGRIND
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Iglibc_arm/gen
label_name = c
root_out_dir = glibc_arm
target_out_dir = glibc_arm/obj/ppapi/c
target_output_name = c


build glibc_arm/obj/ppapi/c/c.stamp: glibc_arm_stamp
