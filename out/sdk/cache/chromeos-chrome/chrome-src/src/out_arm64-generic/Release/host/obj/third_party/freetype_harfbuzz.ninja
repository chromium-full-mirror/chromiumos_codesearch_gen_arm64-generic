defines = -DUSE_UDEV -DUSE_AURA=1 -DUSE_GLIB=1 -DUSE_OZONE=1 -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -DNO_UNWIND_TABLES -D_GNU_SOURCE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE -DCR_CLANG_REVISION=\"llvmorg-18-init-17730-gf670112a-2\" -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DCR_LIBCXX_REVISION=9d119c1f4a097b7d27210874f4eba3fc91a83a4e -DNDEBUG -DNVALGRIND -DDYNAMIC_ANNOTATIONS_ENABLED=0 -DFT_CONFIG_MODULES_H=\"freetype-custom/freetype/config/ftmodule.h\" -DFT_CONFIG_OPTIONS_H=\"freetype-custom/freetype/config/ftoption.h\" -DPDFIUM_REQUIRED_MODULES -DCHROMIUM_RESTRICT_VISIBILITY
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Ihost/gen -I../../../../../../../home/chrome-bot/chrome_root/src/buildtools/third_party/libc++ -I../../../../../../../home/chrome-bot/chrome_root/src/third_party/freetype/include -I../../../../../../../home/chrome-bot/chrome_root/src/third_party/freetype/include/freetype-custom -I../../../../../../../home/chrome-bot/chrome_root/src/third_party/freetype/src/include -I../../../../../../../home/chrome-bot/chrome_root/src/third_party/harfbuzz-ng/src/src
label_name = freetype_harfbuzz
target_out_dir = host/obj/third_party
target_output_name = freetype_harfbuzz


build host/obj/third_party/freetype_harfbuzz.stamp: host_stamp || host/obj/third_party/freetype/freetype_source.stamp host/obj/third_party/harfbuzz-ng/harfbuzz_source.stamp host/obj/third_party/libpng/libpng_sources.stamp host/obj/third_party/zlib/libchrome_zlib.a host/obj/third_party/zlib/zlib_adler32_simd.stamp host/obj/third_party/zlib/zlib_common_headers.stamp host/obj/third_party/zlib/zlib_inflate_chunk_simd.stamp host/obj/third_party/zlib/zlib_slide_hash_simd.stamp host/obj/third_party/zlib/zlib_crc32_simd.stamp host/obj/third_party/icu/libicuuc.a host/obj/third_party/icu/icuuc_public.stamp
