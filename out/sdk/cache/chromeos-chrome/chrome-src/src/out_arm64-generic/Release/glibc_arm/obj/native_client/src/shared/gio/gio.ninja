defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_NONE -DNDEBUG -DNVALGRIND -D_POSIX_C_SOURCE=199506 -D_XOPEN_SOURCE=600 -D_GNU_SOURCE=1 -D__STDC_LIMIT_MACROS=1 -DDYNAMIC_ANNOTATIONS_ENABLED=1 -DDYNAMIC_ANNOTATIONS_PREFIX=NACL_
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Iglibc_arm/gen
cflags = -Wall -Wno-psabi -Wno-unused-local-typedefs -Wno-maybe-uninitialized -Wno-deprecated-declarations -Wno-comments -Wno-packed-not-aligned -Wno-missing-field-initializers -Wno-unused-parameter -Werror -fno-ident -fno-strict-aliasing -O2 -fdata-sections -ffunction-sections -fno-math-errno -fomit-frame-pointer -gsplit-dwarf -fvisibility=hidden
cflags_c =
label_name = gio
root_out_dir = glibc_arm
target_out_dir = glibc_arm/obj/native_client/src/shared/gio
target_output_name = libgio

build glibc_arm/obj/native_client/src/shared/gio/gio/gio.o: glibc_arm_cc ../../../../../../../home/chrome-bot/chrome_root/src/native_client/src/shared/gio/gio.c
  source_file_part = gio.c
  source_name_part = gio
build glibc_arm/obj/native_client/src/shared/gio/gio/gprintf.o: glibc_arm_cc ../../../../../../../home/chrome-bot/chrome_root/src/native_client/src/shared/gio/gprintf.c
  source_file_part = gprintf.c
  source_name_part = gprintf

build glibc_arm/obj/native_client/src/shared/gio/libgio.a: glibc_arm_alink glibc_arm/obj/native_client/src/shared/gio/gio/gio.o glibc_arm/obj/native_client/src/shared/gio/gio/gprintf.o || glibc_arm/obj/build/config/nacl/nacl_base.stamp
  arflags =
  output_extension = .a
  output_dir = glibc_arm/obj/native_client/src/shared/gio
