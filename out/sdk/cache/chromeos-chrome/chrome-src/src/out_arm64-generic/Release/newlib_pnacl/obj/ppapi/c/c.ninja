defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_GNU_SOURCE -D_LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_NONE -DCR_CLANG_REVISION=\"llvmorg-18-init-14420-gea3a3b25-3\" -DNDEBUG -DNVALGRIND
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Inewlib_pnacl/gen
label_name = c
root_out_dir = newlib_pnacl
