defines = -DOFFICIAL_BUILD -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D_FORTIFY_SOURCE=3 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_GNU_SOURCE -DCR_CLANG_REVISION=\"llvmorg-18-init-8676-g11d07d9e-2\" -DNDEBUG -DNVALGRIND
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Inewlib_pnacl/gen
label_name = c
root_out_dir = newlib_pnacl
target_out_dir = newlib_pnacl/obj/ppapi/c
target_output_name = c


build newlib_pnacl/obj/ppapi/c/c.stamp: newlib_pnacl_stamp
