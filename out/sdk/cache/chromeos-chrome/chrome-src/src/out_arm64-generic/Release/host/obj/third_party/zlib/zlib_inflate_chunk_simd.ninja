target_out_dir = host/obj/third_party/zlib
target_output_name = zlib_inflate_chunk_simd

build host/obj/third_party/zlib/zlib_inflate_chunk_simd/inffast_chunk.o: host_cc ../../../../../../../home/chrome-bot/chrome_root/src/third_party/zlib/contrib/optimizations/inffast_chunk.c
  source_file_part = inffast_chunk.c
  source_name_part = inffast_chunk
build host/obj/third_party/zlib/zlib_inflate_chunk_simd/inflate.o: host_cc ../../../../../../../home/chrome-bot/chrome_root/src/third_party/zlib/contrib/optimizations/inflate.c
