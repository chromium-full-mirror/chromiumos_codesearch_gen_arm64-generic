defines = -DOFFICIAL_BUILD -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_GNU_SOURCE -D_LIBCPP_ENABLE_ASSERTIONS=1 -DCR_CLANG_REVISION=\"llvmorg-18-init-14420-gea3a3b25-3\" -DNDEBUG -DNVALGRIND -DABSL_ALLOCATOR_NOTHROW=1
include_dirs = -I../../../../../../../home/chrome-bot/chrome_root/src -Iirt_arm/gen -I../../../../../../../home/chrome-bot/chrome_root/src/third_party/abseil-cpp
label_name = span
root_out_dir = irt_arm
target_out_dir = irt_arm/obj/third_party/abseil-cpp/absl/types
target_output_name = span


build irt_arm/obj/third_party/abseil-cpp/absl/types/span.stamp: irt_arm_stamp || irt_arm/obj/third_party/abseil-cpp/absl/algorithm/algorithm.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/core_headers.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/nullability.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/throw_delegate.stamp irt_arm/obj/third_party/abseil-cpp/absl/meta/type_traits.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/config.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/raw_logging_internal.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/atomic_hook.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/errno_saver.stamp irt_arm/obj/third_party/abseil-cpp/absl/base/log_severity.stamp
