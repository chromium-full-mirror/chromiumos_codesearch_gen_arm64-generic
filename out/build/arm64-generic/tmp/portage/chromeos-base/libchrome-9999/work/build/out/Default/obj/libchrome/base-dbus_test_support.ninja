defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DOS_CHROMEOS -DUSE_NSS_CERTS -DUSE_SYSTEM_LIBEVENT -DNO_TCMALLOC -DMOJO_BACKWARDS_COMPAT -DMOJO_CORE_LEGACY_PROTOCOL -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS
include_dirs = -Igen/include -I../../../libchrome-9999/platform2 -I/build/arm64-generic/usr/include -I../../../libchrome-9999/platform2/libchrome -Igen/libchrome -I../../../libchrome-9999/platform2/libchrome/third_party/perfetto/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -Wno-deprecated-register -Wno-narrowing -Wno-unreachable-code-return -Wno-unused-local-typedefs -Xclang-only=-Wno-char-subscripts
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -O2 -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libbase-dbus_test_support

build obj/libchrome/base-dbus_test_support.inputdeps.stamp: stamp obj/libchrome/allocator_buildflags.stamp obj/libchrome/allocator_debugging_buildflags.stamp obj/libchrome/allocator_logging_buildflags.stamp obj/libchrome/blink_buildflags.stamp obj/libchrome/branding_buildflags.stamp obj/libchrome/cfi_buildflags.stamp obj/libchrome/chromecast_buildflags.stamp obj/libchrome/chromeos_buildflags.stamp obj/libchrome/clang_profiling_buildflags.stamp obj/libchrome/compiler_buildflags.stamp obj/libchrome/debugging_buildflags.stamp obj/libchrome/feature_list_buildflags.stamp obj/libchrome/ios_cronet_buildflags.stamp obj/libchrome/ipc_buildflags.stamp obj/libchrome/message_pump_buildflags.stamp obj/libchrome/mojo_buildflags.stamp obj/libchrome/mojo_cpp_bindings_buildflags.stamp obj/libchrome/partition_allocator_buildflags.stamp obj/libchrome/partition_allocator_chromecast_buildflags.stamp obj/libchrome/partition_allocator_chromeos_buildflags.stamp obj/libchrome/partition_allocator_raw_ptr_buildflags.stamp obj/libchrome/profiler_buildflags.stamp obj/libchrome/rust_buildflags.stamp obj/libchrome/synchronization_buildflags.stamp obj/libchrome/tracing_buildflags.stamp
