ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../libchrome-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libchrome: phony obj/libchrome/libchrome.stamp
build all_buildflags: phony obj/libchrome/all_buildflags.stamp
build allocator_buildflags: phony obj/libchrome/allocator_buildflags.stamp
build allocator_debugging_buildflags: phony obj/libchrome/allocator_debugging_buildflags.stamp
build allocator_logging_buildflags: phony obj/libchrome/allocator_logging_buildflags.stamp
build base: phony obj/libchrome/base.stamp
build base-base_test_support: phony ./libbase-base_test_support.a
build base-core: phony ./lib/libbase-core.so
build base-crypto: phony ./lib/libbase-crypto.so
build base-dbus: phony ./lib/libbase-dbus.so
build base-dbus_test_support: phony ./libbase-dbus_test_support.a
build base-policy: phony ./lib/libbase-policy.so
build base-test: phony obj/libchrome/base-test.stamp
build blink_buildflags: phony obj/libchrome/blink_buildflags.stamp
build branding_buildflags: phony obj/libchrome/branding_buildflags.stamp
build buildflag_header_h: phony obj/libchrome/buildflag_header_h.stamp
build cfi_buildflags: phony obj/libchrome/cfi_buildflags.stamp
build chromecast_buildflags: phony obj/libchrome/chromecast_buildflags.stamp
build chromeos_buildflags: phony obj/libchrome/chromeos_buildflags.stamp
build clang_profiling_buildflags: phony obj/libchrome/clang_profiling_buildflags.stamp
build compiler_buildflags: phony obj/libchrome/compiler_buildflags.stamp
build debugging_buildflags: phony obj/libchrome/debugging_buildflags.stamp
build feature_list_buildflags: phony obj/libchrome/feature_list_buildflags.stamp
build install_basever: phony obj/libchrome/install_basever.stamp
build install_buildflag_header: phony obj/libchrome/install_buildflag_header.stamp
build install_header: phony obj/libchrome/install_header.stamp
build install_mojom_generated: phony obj/libchrome/install_mojom_generated.stamp
build install_protozero_generated: phony obj/libchrome/install_protozero_generated.stamp
build ios_cronet_buildflags: phony obj/libchrome/ios_cronet_buildflags.stamp
build ipc_buildflags: phony obj/libchrome/ipc_buildflags.stamp
build libchrome-test: phony obj/libchrome/libchrome-test.stamp
build libmojo: phony obj/libchrome/libmojo.stamp
build message_pump_buildflags: phony obj/libchrome/message_pump_buildflags.stamp
build mojo: phony ./lib/libmojo.so
build mojo_buildflags: phony obj/libchrome/mojo_buildflags.stamp
build mojo_cpp_bindings_buildflags: phony obj/libchrome/mojo_cpp_bindings_buildflags.stamp
build mojom_bindings_gen: phony obj/libchrome/mojom_bindings_gen.stamp
build mojom_bindings_gen_mojo_templates: phony obj/libchrome/mojom_bindings_gen_mojo_templates.stamp
build mojom_bindings_gen_mojo_templates_dir: phony obj/libchrome/mojom_bindings_gen_mojo_templates_dir.stamp
build mojom_bindings_gen_parse: phony obj/libchrome/mojom_bindings_gen_parse.stamp
build mojom_type_mappings: phony obj/libchrome/mojom_type_mappings.stamp
