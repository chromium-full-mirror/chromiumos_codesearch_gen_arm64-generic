defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DOS_CHROMEOS -DUSE_NSS_CERTS -DUSE_SYSTEM_LIBEVENT -DNO_TCMALLOC -DMOJO_BACKWARDS_COMPAT -DMOJO_CORE_LEGACY_PROTOCOL -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS -DCOMPONENT_BUILD -DPOLICY_COMPONENT_IMPLEMENTATION
include_dirs = -Igen/include -I../../../libchrome-9999/platform2 -I/build/arm64-generic/usr/include -I../../../libchrome-9999/platform2/libchrome -Igen/libchrome -I../../../libchrome-9999/platform2/libchrome/third_party/perfetto/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -Wno-deprecated-register -Wno-narrowing -Wno-unreachable-code-return -Wno-unused-local-typedefs -Xclang-only=-Wno-char-subscripts
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -O2 -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libbase-policy

build obj/libchrome/base-policy.inputdeps.stamp: stamp obj/libchrome/allocator_buildflags.stamp obj/libchrome/allocator_debugging_buildflags.stamp obj/libchrome/allocator_logging_buildflags.stamp obj/libchrome/blink_buildflags.stamp obj/libchrome/branding_buildflags.stamp obj/libchrome/cfi_buildflags.stamp obj/libchrome/chromecast_buildflags.stamp obj/libchrome/chromeos_buildflags.stamp obj/libchrome/clang_profiling_buildflags.stamp obj/libchrome/compiler_buildflags.stamp obj/libchrome/debugging_buildflags.stamp obj/libchrome/feature_list_buildflags.stamp obj/libchrome/ios_cronet_buildflags.stamp obj/libchrome/ipc_buildflags.stamp obj/libchrome/message_pump_buildflags.stamp obj/libchrome/mojo_buildflags.stamp obj/libchrome/mojo_cpp_bindings_buildflags.stamp obj/libchrome/partition_allocator_buildflags.stamp obj/libchrome/partition_allocator_chromecast_buildflags.stamp obj/libchrome/partition_allocator_chromeos_buildflags.stamp obj/libchrome/partition_allocator_raw_ptr_buildflags.stamp obj/libchrome/profiler_buildflags.stamp obj/libchrome/rust_buildflags.stamp obj/libchrome/synchronization_buildflags.stamp obj/libchrome/tracing_buildflags.stamp obj/libchrome/tracing_protozero.stamp
build obj/libchrome/components/policy/core/common/libbase-policy.json_schema_constants.o: cxx ../../../libchrome-9999/platform2/libchrome/components/policy/core/common/json_schema_constants.cc || obj/libchrome/base-policy.inputdeps.stamp
  source_file_part = json_schema_constants.cc
  source_name_part = json_schema_constants
build obj/libchrome/components/policy/core/common/libbase-policy.registry_dict.o: cxx ../../../libchrome-9999/platform2/libchrome/components/policy/core/common/registry_dict.cc || obj/libchrome/base-policy.inputdeps.stamp
  source_file_part = registry_dict.cc
  source_name_part = registry_dict
build obj/libchrome/components/policy/core/common/libbase-policy.schema.o: cxx ../../../libchrome-9999/platform2/libchrome/components/policy/core/common/schema.cc || obj/libchrome/base-policy.inputdeps.stamp
  source_file_part = schema.cc
  source_name_part = schema

build ./lib/libbase-policy.so: solink obj/libchrome/components/policy/core/common/libbase-policy.json_schema_constants.o obj/libchrome/components/policy/core/common/libbase-policy.registry_dict.o obj/libchrome/components/policy/core/common/libbase-policy.schema.o ./lib/libbase-core.so || obj/libchrome/all_buildflags.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -Wl,--undefined-glob=\*perfetto\*SystemProducer\* -Wl,-z,defs
  libs = -lre2
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
