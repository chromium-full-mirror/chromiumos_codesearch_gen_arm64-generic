ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../vpd-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _vpd-install_config: phony obj/vpd/_vpd-install_config.stamp
build install_init: phony obj/vpd/install_init.stamp
build install_sbin_scripts: phony obj/vpd/install_sbin_scripts.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build vpd$:_vpd-install_config: phony obj/vpd/_vpd-install_config.stamp
build vpd$:all: phony obj/vpd/all.stamp
build vpd$:install_init: phony obj/vpd/install_init.stamp
build vpd$:install_sbin_scripts: phony obj/vpd/install_sbin_scripts.stamp
build vpd$:vpd: phony ./vpd
build vpd$:vpd_c_test: phony ./vpd_c_test

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/vpd/_vpd-install_config.stamp $
    obj/vpd/all.stamp $
    obj/vpd/install_init.stamp $
    obj/vpd/install_sbin_scripts.stamp $
    ./vpd $
    ./vpd_c_test

default all
