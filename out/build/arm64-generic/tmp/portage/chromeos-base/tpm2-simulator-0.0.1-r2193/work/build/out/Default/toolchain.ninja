rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/tpm2-simulator/all.stamp
build obj/tpm2-simulator/_libtpm2_simulator_executor-install_config.stamp: stamp
build obj/tpm2-simulator/_tpm2-simulator-init-install_config.stamp: stamp
build obj/tpm2-simulator/_tpm2-simulator-install_config.stamp: stamp
build obj/tpm2-simulator/_tpm2-simulator-stop-install_config.stamp: stamp
build obj/tpm2-simulator/all.stamp: stamp obj/tpm2-simulator/install_init_scripts.stamp obj/tpm2-simulator/install_seccomp_policy.stamp obj/tpm2-simulator/install_tmpfiles_config.stamp ./tpm2-simulator ./tpm2-simulator-init ./tpm2-simulator-stop
build obj/tpm2-simulator/install_init_scripts.stamp: stamp
build obj/tpm2-simulator/install_seccomp_policy.stamp: stamp
build obj/tpm2-simulator/install_tmpfiles_config.stamp: stamp
subninja obj/tpm2-simulator/libtpm2_simulator_executor.ninja
subninja obj/tpm2-simulator/tpm2-simulator.ninja
subninja obj/tpm2-simulator/tpm2-simulator-init.ninja
subninja obj/tpm2-simulator/tpm2-simulator-stop.ninja
subninja obj/tpm2-simulator/tpm_executor_version_library.ninja
