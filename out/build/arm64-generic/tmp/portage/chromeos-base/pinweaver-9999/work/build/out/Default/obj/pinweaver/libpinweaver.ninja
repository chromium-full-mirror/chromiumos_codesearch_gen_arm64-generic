defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../pinweaver-9999/platform2 -I/build/arm64-generic/usr/include -I../../../pinweaver-9999/platform2/pinweaver -I../../../pinweaver-9999/platform2/pinweaver/eal/tpm_storage
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_c = -std=gnu17 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libpinweaver

build obj/pinweaver/libpinweaver.pinweaver.o: cc ../../../pinweaver-9999/platform2/pinweaver/pinweaver.c
  source_file_part = pinweaver.c
  source_name_part = pinweaver

build ./libpinweaver.a: alink obj/pinweaver/libpinweaver.pinweaver.o
  arflags = rcs
  output_extension = .a
  output_dir = 
