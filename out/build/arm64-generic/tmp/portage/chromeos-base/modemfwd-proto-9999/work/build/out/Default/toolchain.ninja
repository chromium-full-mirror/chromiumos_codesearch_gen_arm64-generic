  command = /usr/bin/env ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py protoc --proto_path /mnt/host/source/src/platform2/modemfwd/proto --proto_path /build/arm64-generic/usr/share/proto --go_out $:/build/arm64-generic/tmp/portage/chromeos-base/modemfwd-proto-9999/work/build/out/Default/gen/go/src/ /mnt/host/source/src/platform2/modemfwd/proto/firmware_manifest_v2.proto /mnt/host/source/src/platform2/modemfwd/proto/helper_manifest.proto /mnt/host/source/src/platform2/modemfwd/proto/journal_entry.proto
  description = ACTION //modemfwd/proto:modemfw-goprotos(//common-mk/toolchain:toolchain)
  restat = 1

build gen/go/src/firmware_manifest_v2.pb.go gen/go/src/helper_manifest.pb.go gen/go/src/journal_entry.pb.go: __modemfwd_proto_modemfw-goprotos___common-mk_toolchain_toolchain__rule | ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/firmware_manifest_v2.proto ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/helper_manifest.proto ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/journal_entry.proto

build obj/modemfwd/proto/modemfw-goprotos.stamp: stamp gen/go/src/firmware_manifest_v2.pb.go gen/go/src/helper_manifest.pb.go gen/go/src/journal_entry.pb.go
subninja obj/modemfwd/proto/modemfw-protos.ninja
rule __modemfwd_proto_modemfw-protos_gen___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py protoc firmware_manifest_v2.proto helper_manifest.proto journal_entry.proto --proto_path /mnt/host/source/src/platform2/modemfwd/proto --proto_path /build/arm64-generic/usr/share/proto --cpp_out=/build/arm64-generic/tmp/portage/chromeos-base/modemfwd-proto-9999/work/build/out/Default/gen/include/modemfwd/proto_bindings
  description = ACTION //modemfwd/proto:modemfw-protos_gen(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/modemfwd/proto_bindings/firmware_manifest_v2.pb.cc gen/include/modemfwd/proto_bindings/firmware_manifest_v2.pb.h gen/include/modemfwd/proto_bindings/helper_manifest.pb.cc gen/include/modemfwd/proto_bindings/helper_manifest.pb.h gen/include/modemfwd/proto_bindings/journal_entry.pb.cc gen/include/modemfwd/proto_bindings/journal_entry.pb.h: __modemfwd_proto_modemfw-protos_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/firmware_manifest_v2.proto ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/helper_manifest.proto ../../../../../../../../../../mnt/host/source/src/platform2/modemfwd/proto/journal_entry.proto

