ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build modemfw-goprotos: phony obj/modemfwd/proto/modemfw-goprotos.stamp
build modemfw-protos: phony ./libmodemfw-protos.a
build modemfw-protos_gen: phony obj/modemfwd/proto/modemfw-protos_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build modemfwd/proto$:all: phony obj/modemfwd/proto/all.stamp
build modemfwd/proto$:modemfw-goprotos: phony obj/modemfwd/proto/modemfw-goprotos.stamp
build modemfwd/proto$:modemfw-protos: phony ./libmodemfw-protos.a
build modemfwd/proto$:modemfw-protos_gen: phony obj/modemfwd/proto/modemfw-protos_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/modemfwd/proto/all.stamp $
    obj/modemfwd/proto/modemfw-goprotos.stamp $
    ./libmodemfw-protos.a $
    obj/modemfwd/proto/modemfw-protos_gen.stamp

default all
