defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/modemfwd/proto_bindings -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libmodemfw-protos

build obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.firmware_manifest_v2.pb.o: cxx gen/include/modemfwd/proto_bindings/firmware_manifest_v2.pb.cc || obj/modemfwd/proto/modemfw-protos_gen.stamp
  source_file_part = firmware_manifest_v2.pb.cc
  source_name_part = firmware_manifest_v2.pb
build obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.helper_manifest.pb.o: cxx gen/include/modemfwd/proto_bindings/helper_manifest.pb.cc || obj/modemfwd/proto/modemfw-protos_gen.stamp
  source_file_part = helper_manifest.pb.cc
  source_name_part = helper_manifest.pb
build obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.journal_entry.pb.o: cxx gen/include/modemfwd/proto_bindings/journal_entry.pb.cc || obj/modemfwd/proto/modemfw-protos_gen.stamp
  source_file_part = journal_entry.pb.cc
  source_name_part = journal_entry.pb

build ./libmodemfw-protos.a: alink obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.firmware_manifest_v2.pb.o obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.helper_manifest.pb.o obj/gen/include/modemfwd/proto_bindings/libmodemfw-protos.journal_entry.pb.o || obj/modemfwd/proto/modemfw-protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
