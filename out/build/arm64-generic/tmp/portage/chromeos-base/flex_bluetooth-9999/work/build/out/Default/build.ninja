ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../flex_bluetooth-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _process_flex_bluetooth_overrides-install_config: phony obj/flex_bluetooth/_process_flex_bluetooth_overrides-install_config.stamp
build install_upstart_config: phony obj/flex_bluetooth/install_upstart_config.stamp
build libflex_bluetooth_overrides: phony ./libflex_bluetooth_overrides.a
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build flex_bluetooth$:_process_flex_bluetooth_overrides-install_config: phony obj/flex_bluetooth/_process_flex_bluetooth_overrides-install_config.stamp
build flex_bluetooth$:all: phony obj/flex_bluetooth/all.stamp
build flex_bluetooth$:flex_bluetooth_overrides_test: phony ./flex_bluetooth_overrides_test
build flex_bluetooth$:install_upstart_config: phony obj/flex_bluetooth/install_upstart_config.stamp
build flex_bluetooth$:libflex_bluetooth_overrides: phony ./libflex_bluetooth_overrides.a
build flex_bluetooth$:process_flex_bluetooth_overrides: phony ./process_flex_bluetooth_overrides

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/flex_bluetooth/_process_flex_bluetooth_overrides-install_config.stamp $
    obj/flex_bluetooth/all.stamp $
    ./flex_bluetooth_overrides_test $
    obj/flex_bluetooth/install_upstart_config.stamp $
    ./libflex_bluetooth_overrides.a $
    ./process_flex_bluetooth_overrides

default all
