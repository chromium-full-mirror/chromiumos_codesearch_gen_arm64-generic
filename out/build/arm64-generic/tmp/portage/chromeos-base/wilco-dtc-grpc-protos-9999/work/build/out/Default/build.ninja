ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build root: phony obj/common-mk/gn_root/root.stamp
build wilco_dtc_go_grpc_protos: phony obj/diagnostics/grpc/wilco_dtc_go_grpc_protos.stamp
build wilco_dtc_grpc_protos: phony ./libwilco_dtc_grpc_protos.a
build wilco_dtc_grpc_protos_gen: phony obj/diagnostics/grpc/wilco_dtc_grpc_protos_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build diagnostics/grpc$:all: phony obj/diagnostics/grpc/all.stamp
build diagnostics/grpc$:wilco_dtc_go_grpc_protos: phony obj/diagnostics/grpc/wilco_dtc_go_grpc_protos.stamp
build diagnostics/grpc$:wilco_dtc_grpc_protos: phony ./libwilco_dtc_grpc_protos.a
build diagnostics/grpc$:wilco_dtc_grpc_protos_gen: phony obj/diagnostics/grpc/wilco_dtc_grpc_protos_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/diagnostics/grpc/all.stamp $
    obj/diagnostics/grpc/wilco_dtc_go_grpc_protos.stamp $
    ./libwilco_dtc_grpc_protos.a $
    obj/diagnostics/grpc/wilco_dtc_grpc_protos_gen.stamp

default all
