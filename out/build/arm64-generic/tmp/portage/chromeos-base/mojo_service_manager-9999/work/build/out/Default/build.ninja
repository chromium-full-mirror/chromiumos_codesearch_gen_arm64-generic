ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _install_seccomp-check_seccomp: phony obj/mojo_service_manager/init/_install_seccomp-check_seccomp.stamp
build _libmojo_service_manager-install_config: phony obj/mojo_service_manager/lib/_libmojo_service_manager-install_config.stamp
build _libmojo_service_manager-mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom-install_config.stamp
build _libmojo_service_manager-mojom_gen-service_manager.mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-service_manager.mojom-install_config.stamp
build _libmojo_service_manager-mojom_gen-time.mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-time.mojom-install_config.stamp
build _mojo_service_manager_test_tool-install_config: phony obj/mojo_service_manager/testing/_mojo_service_manager_test_tool-install_config.stamp
build daemon: phony obj/mojo_service_manager/daemon/daemon.stamp
build headers: phony obj/mojo_service_manager/lib/headers.stamp
build init: phony obj/mojo_service_manager/init/init.stamp
build install_init_config: phony obj/mojo_service_manager/init/install_init_config.stamp
build install_minijail_conf: phony obj/mojo_service_manager/init/install_minijail_conf.stamp
build install_policy: phony obj/mojo_service_manager/testing/install_policy.stamp
build install_seccomp: phony obj/mojo_service_manager/init/install_seccomp.stamp
build install_tmpfiles_config: phony obj/mojo_service_manager/init/install_tmpfiles_config.stamp
build lib: phony obj/mojo_service_manager/lib/lib.stamp
build libmojo_service_manager: phony ./lib/libmojo_service_manager.so
build libmojo_service_manager-mojom: phony ./libmojo_service_manager-mojom.a
build libmojo_service_manager-mojom_gen: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen.stamp
build libmojo_service_manager-mojom_gen_mojo_templates: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates.stamp
build libmojo_service_manager-mojom_gen_mojo_templates_dir: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates_dir.stamp
build libmojo_service_manager-mojom_gen_parse: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_parse.stamp
build libmojo_service_manager_daemon: phony obj/mojo_service_manager/daemon/libmojo_service_manager_daemon.stamp
build libmojo_service_manager_source_set: phony obj/mojo_service_manager/lib/libmojo_service_manager_source_set.stamp
build mojo_test_runner: phony obj/mojo_service_manager/testing/mojo_test_runner.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build test_mojom: phony ./libtest_mojom.a
build test_mojom_gen: phony obj/mojo_service_manager/testing/test_mojom_gen.stamp
build test_mojom_gen_mojo_templates: phony obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates.stamp
build test_mojom_gen_mojo_templates_dir: phony obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates_dir.stamp
build test_mojom_gen_parse: phony obj/mojo_service_manager/testing/test_mojom_gen_parse.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build mojo_service_manager$:all: phony obj/mojo_service_manager/all.stamp
build mojo_service_manager/daemon$:_mojo_service_manager-install_config: phony obj/mojo_service_manager/daemon/_mojo_service_manager-install_config.stamp
build mojo_service_manager/daemon$:daemon: phony obj/mojo_service_manager/daemon/daemon.stamp
build mojo_service_manager/daemon: phony obj/mojo_service_manager/daemon/daemon.stamp
build mojo_service_manager/daemon$:daemon_test_helper: phony ./daemon_test_helper
build mojo_service_manager/daemon$:libmojo_service_manager_daemon: phony obj/mojo_service_manager/daemon/libmojo_service_manager_daemon.stamp
build mojo_service_manager/daemon$:mojo_service_manager: phony ./mojo_service_manager
build mojo_service_manager/daemon$:mojo_service_manager_test: phony ./mojo_service_manager_test
build mojo_service_manager/init$:_install_seccomp-check_seccomp: phony obj/mojo_service_manager/init/_install_seccomp-check_seccomp.stamp
build mojo_service_manager/init$:init: phony obj/mojo_service_manager/init/init.stamp
build mojo_service_manager/init: phony obj/mojo_service_manager/init/init.stamp
build mojo_service_manager/init$:install_init_config: phony obj/mojo_service_manager/init/install_init_config.stamp
build mojo_service_manager/init$:install_minijail_conf: phony obj/mojo_service_manager/init/install_minijail_conf.stamp
build mojo_service_manager/init$:install_seccomp: phony obj/mojo_service_manager/init/install_seccomp.stamp
build mojo_service_manager/init$:install_tmpfiles_config: phony obj/mojo_service_manager/init/install_tmpfiles_config.stamp
build mojo_service_manager/lib$:_libmojo_service_manager-install_config: phony obj/mojo_service_manager/lib/_libmojo_service_manager-install_config.stamp
build mojo_service_manager/lib$:_mojo_service_manager-install_config: phony obj/mojo_service_manager/lib/_mojo_service_manager-install_config.stamp
build mojo_service_manager/lib$:headers: phony obj/mojo_service_manager/lib/headers.stamp
build mojo_service_manager/lib$:lib: phony obj/mojo_service_manager/lib/lib.stamp
build mojo_service_manager/lib: phony obj/mojo_service_manager/lib/lib.stamp
build mojo_service_manager/lib$:libmojo_service_manager: phony ./lib/libmojo_service_manager.so
build mojo_service_manager/lib$:libmojo_service_manager_source_set: phony obj/mojo_service_manager/lib/libmojo_service_manager_source_set.stamp
build mojo_service_manager/lib$:mojo_service_manager: phony obj/mojo_service_manager/lib/mojo_service_manager.stamp
build mojo_service_manager/lib/mojom$:_libmojo_service_manager-mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom-install_config.stamp
build mojo_service_manager/lib/mojom$:_libmojo_service_manager-mojom_gen-service_manager.mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-service_manager.mojom-install_config.stamp
build mojo_service_manager/lib/mojom$:_libmojo_service_manager-mojom_gen-time.mojom-install_config: phony obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-time.mojom-install_config.stamp
build mojo_service_manager/lib/mojom$:libmojo_service_manager-mojom: phony ./libmojo_service_manager-mojom.a
build mojo_service_manager/lib/mojom$:libmojo_service_manager-mojom_gen: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen.stamp
build mojo_service_manager/lib/mojom$:libmojo_service_manager-mojom_gen_mojo_templates: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates.stamp
build mojo_service_manager/lib/mojom$:libmojo_service_manager-mojom_gen_mojo_templates_dir: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates_dir.stamp
build mojo_service_manager/lib/mojom$:libmojo_service_manager-mojom_gen_parse: phony obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_parse.stamp
build mojo_service_manager/testing$:_mojo_service_manager_test_tool-install_config: phony obj/mojo_service_manager/testing/_mojo_service_manager_test_tool-install_config.stamp
build mojo_service_manager/testing$:all: phony obj/mojo_service_manager/testing/all.stamp
build mojo_service_manager/testing$:install_policy: phony obj/mojo_service_manager/testing/install_policy.stamp
build mojo_service_manager/testing$:mojo_service_manager_test_tool: phony ./mojo_service_manager_test_tool
build mojo_service_manager/testing$:mojo_test_runner: phony obj/mojo_service_manager/testing/mojo_test_runner.stamp
build mojo_service_manager/testing$:test_mojom: phony ./libtest_mojom.a
build mojo_service_manager/testing$:test_mojom_gen: phony obj/mojo_service_manager/testing/test_mojom_gen.stamp
build mojo_service_manager/testing$:test_mojom_gen_mojo_templates: phony obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates.stamp
build mojo_service_manager/testing$:test_mojom_gen_mojo_templates_dir: phony obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates_dir.stamp
build mojo_service_manager/testing$:test_mojom_gen_parse: phony obj/mojo_service_manager/testing/test_mojom_gen_parse.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/mojo_service_manager/all.stamp $
    obj/mojo_service_manager/daemon/_mojo_service_manager-install_config.stamp $
    obj/mojo_service_manager/daemon/daemon.stamp $
    ./daemon_test_helper $
    obj/mojo_service_manager/daemon/libmojo_service_manager_daemon.stamp $
    ./mojo_service_manager $
    ./mojo_service_manager_test $
    obj/mojo_service_manager/init/_install_seccomp-check_seccomp.stamp $
    obj/mojo_service_manager/init/init.stamp $
    obj/mojo_service_manager/init/install_init_config.stamp $
    obj/mojo_service_manager/init/install_minijail_conf.stamp $
    obj/mojo_service_manager/init/install_seccomp.stamp $
    obj/mojo_service_manager/init/install_tmpfiles_config.stamp $
    obj/mojo_service_manager/lib/_libmojo_service_manager-install_config.stamp $
    obj/mojo_service_manager/lib/_mojo_service_manager-install_config.stamp $
    obj/mojo_service_manager/lib/headers.stamp $
    obj/mojo_service_manager/lib/lib.stamp $
    ./lib/libmojo_service_manager.so $
    obj/mojo_service_manager/lib/libmojo_service_manager_source_set.stamp $
    obj/mojo_service_manager/lib/mojo_service_manager.stamp $
    obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom-install_config.stamp $
    obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-service_manager.mojom-install_config.stamp $
    obj/mojo_service_manager/lib/mojom/_libmojo_service_manager-mojom_gen-time.mojom-install_config.stamp $
    ./libmojo_service_manager-mojom.a $
    obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen.stamp $
    obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates.stamp $
    obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_mojo_templates_dir.stamp $
    obj/mojo_service_manager/lib/mojom/libmojo_service_manager-mojom_gen_parse.stamp $
    obj/mojo_service_manager/testing/_mojo_service_manager_test_tool-install_config.stamp $
    obj/mojo_service_manager/testing/all.stamp $
    obj/mojo_service_manager/testing/install_policy.stamp $
    ./mojo_service_manager_test_tool $
    obj/mojo_service_manager/testing/mojo_test_runner.stamp $
    ./libtest_mojom.a $
    obj/mojo_service_manager/testing/test_mojom_gen.stamp $
    obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates.stamp $
    obj/mojo_service_manager/testing/test_mojom_gen_mojo_templates_dir.stamp $
    obj/mojo_service_manager/testing/test_mojom_gen_parse.stamp

default all
