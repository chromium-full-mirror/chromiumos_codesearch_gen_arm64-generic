defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = libmojo_service_manager


build ./lib/libmojo_service_manager.so: solink obj/mojo_service_manager/lib/libmojo_service_manager_source_set.connect.o ./libmojo_service_manager-mojom.a || obj/mojo_service_manager/lib/libmojo_service_manager_source_set.stamp obj/mojo_service_manager/lib/_libmojo_service_manager-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic
  libs = -lbrillo -lbase -lpthread -lmojo
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
