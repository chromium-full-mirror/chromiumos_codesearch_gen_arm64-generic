defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -I/build/arm64-generic/usr/include/libchrome -Wno-cast-qual -Wno-cast-align
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = mojo_test_runner

build obj/mojo_service_manager/testing/mojo_test_runner.mojo_test_runner.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/mojo_service_manager/testing/mojo_test_runner.cc
  source_file_part = mojo_test_runner.cc
  source_name_part = mojo_test_runner

build obj/mojo_service_manager/testing/mojo_test_runner.stamp: stamp obj/mojo_service_manager/testing/mojo_test_runner.mojo_test_runner.o
