ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../cbor-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libcbor_pc: phony obj/cbor/libcbor_pc.stamp
build libcbor_shared: phony ./lib/libcbor.so
build libcbor_source_set: phony obj/cbor/libcbor_source_set.stamp
build libcbor_static: phony ./libcbor.a
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build cbor$:all: phony obj/cbor/all.stamp
build cbor$:cbor_unittests: phony ./cbor_unittests
build cbor$:libcbor_pc: phony obj/cbor/libcbor_pc.stamp
build cbor$:libcbor_shared: phony ./lib/libcbor.so
build cbor$:libcbor_source_set: phony obj/cbor/libcbor_source_set.stamp
build cbor$:libcbor_static: phony ./libcbor.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a

build all: phony $
    obj/cbor/all.stamp $
    ./cbor_unittests $
    obj/cbor/libcbor_pc.stamp $
    ./lib/libcbor.so $
    obj/cbor/libcbor_source_set.stamp $
    ./libcbor.a $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a

default all
