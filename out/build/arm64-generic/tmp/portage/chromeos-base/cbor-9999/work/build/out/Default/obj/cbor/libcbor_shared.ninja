defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../cbor-9999/platform2 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = libcbor


build ./lib/libcbor.so: solink obj/cbor/libcbor_source_set.diagnostic_writer.o obj/cbor/libcbor_source_set.reader.o obj/cbor/libcbor_source_set.values.o obj/cbor/libcbor_source_set.writer.o || obj/cbor/libcbor_source_set.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic
  libs = -lbase -lpthread
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
