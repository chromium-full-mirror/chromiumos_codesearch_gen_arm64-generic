defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../cbor-9999/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = cbor_unittests

build obj/cbor/cbor_unittests.diagnostic_writer_unittest.o: cxx ../../../cbor-9999/platform2/cbor/diagnostic_writer_unittest.cc
  source_file_part = diagnostic_writer_unittest.cc
  source_name_part = diagnostic_writer_unittest
build obj/cbor/cbor_unittests.reader_unittest.o: cxx ../../../cbor-9999/platform2/cbor/reader_unittest.cc
  source_file_part = reader_unittest.cc
  source_name_part = reader_unittest
build obj/cbor/cbor_unittests.values_unittest.o: cxx ../../../cbor-9999/platform2/cbor/values_unittest.cc
  source_file_part = values_unittest.cc
  source_name_part = values_unittest
build obj/cbor/cbor_unittests.writer_unittest.o: cxx ../../../cbor-9999/platform2/cbor/writer_unittest.cc
  source_file_part = writer_unittest.cc
  source_name_part = writer_unittest

build ./cbor_unittests: link obj/cbor/cbor_unittests.diagnostic_writer_unittest.o obj/cbor/cbor_unittests.reader_unittest.o obj/cbor/cbor_unittests.values_unittest.o obj/cbor/cbor_unittests.writer_unittest.o obj/cbor/libcbor_source_set.diagnostic_writer.o obj/cbor/libcbor_source_set.reader.o obj/cbor/libcbor_source_set.values.o obj/cbor/libcbor_source_set.writer.o ./libcbor.a ./libtestrunner.a || obj/cbor/libcbor_source_set.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/
  libs = -lgmock -lgtest -lpthread -lbase-test -lbase -lbrillo
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
