defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/proto -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libfeature-protos

build obj/gen/include/proto/libfeature-protos.device_selection.pb.o: cxx gen/include/proto/device_selection.pb.cc || obj/libsegmentation/feature-protos_gen.stamp
  source_file_part = device_selection.pb.cc
  source_name_part = device_selection.pb
build obj/gen/include/proto/libfeature-protos.feature_management.pb.o: cxx gen/include/proto/feature_management.pb.cc || obj/libsegmentation/feature-protos_gen.stamp
  source_file_part = feature_management.pb.cc
  source_name_part = feature_management.pb
build obj/gen/include/proto/libfeature-protos.hwid_feature_requirement.pb.o: cxx gen/include/proto/hwid_feature_requirement.pb.cc || obj/libsegmentation/feature-protos_gen.stamp
  source_file_part = hwid_feature_requirement.pb.cc
  source_name_part = hwid_feature_requirement.pb

build ./libfeature-protos.a: alink obj/gen/include/proto/libfeature-protos.device_selection.pb.o obj/gen/include/proto/libfeature-protos.feature_management.pb.o obj/gen/include/proto/libfeature-protos.hwid_feature_requirement.pb.o || obj/libsegmentation/feature-protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
