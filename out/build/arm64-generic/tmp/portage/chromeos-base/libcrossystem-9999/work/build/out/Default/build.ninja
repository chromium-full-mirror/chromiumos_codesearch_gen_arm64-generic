ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libcrossystem: phony ./lib/libcrossystem.so
build _libcrossystem-install_config: phony obj/libcrossystem/_libcrossystem-install_config.stamp
build _libcrossystem-test-install_config: phony obj/libcrossystem/_libcrossystem-test-install_config.stamp
build _libcrossystem-test_pc-install_config: phony obj/libcrossystem/_libcrossystem-test_pc-install_config.stamp
build _libcrossystem_pc-install_config: phony obj/libcrossystem/_libcrossystem_pc-install_config.stamp
build _libcrossystem_static-install_config: phony obj/libcrossystem/_libcrossystem_static-install_config.stamp
build install_libcrossystem_headers: phony obj/libcrossystem/install_libcrossystem_headers.stamp
build libcrossystem-test: phony ./lib/libcrossystem-test.so
build libcrossystem-test_pc: phony obj/libcrossystem/libcrossystem-test_pc.stamp
build libcrossystem_pc: phony obj/libcrossystem/libcrossystem_pc.stamp
build libcrossystem_static: phony ./libcrossystem_static.a
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build libcrossystem$:_libcrossystem-install_config: phony obj/libcrossystem/_libcrossystem-install_config.stamp
build libcrossystem$:_libcrossystem-test-install_config: phony obj/libcrossystem/_libcrossystem-test-install_config.stamp
build libcrossystem$:_libcrossystem-test_pc-install_config: phony obj/libcrossystem/_libcrossystem-test_pc-install_config.stamp
build libcrossystem$:_libcrossystem_pc-install_config: phony obj/libcrossystem/_libcrossystem_pc-install_config.stamp
build libcrossystem$:_libcrossystem_static-install_config: phony obj/libcrossystem/_libcrossystem_static-install_config.stamp
build libcrossystem$:all: phony obj/libcrossystem/all.stamp
build libcrossystem$:install_libcrossystem_headers: phony obj/libcrossystem/install_libcrossystem_headers.stamp
build libcrossystem$:libcrossystem: phony ./lib/libcrossystem.so
build libcrossystem$:libcrossystem-test: phony ./lib/libcrossystem-test.so
build libcrossystem$:libcrossystem-test_pc: phony obj/libcrossystem/libcrossystem-test_pc.stamp
build libcrossystem$:libcrossystem_pc: phony obj/libcrossystem/libcrossystem_pc.stamp
build libcrossystem$:libcrossystem_static: phony ./libcrossystem_static.a
build libcrossystem$:libcrossystem_tests: phony ./libcrossystem_tests

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/libcrossystem/_libcrossystem-install_config.stamp $
    obj/libcrossystem/_libcrossystem-test-install_config.stamp $
    obj/libcrossystem/_libcrossystem-test_pc-install_config.stamp $
    obj/libcrossystem/_libcrossystem_pc-install_config.stamp $
    obj/libcrossystem/_libcrossystem_static-install_config.stamp $
    obj/libcrossystem/all.stamp $
    obj/libcrossystem/install_libcrossystem_headers.stamp $
    ./lib/libcrossystem.so $
    ./lib/libcrossystem-test.so $
    obj/libcrossystem/libcrossystem-test_pc.stamp $
    obj/libcrossystem/libcrossystem_pc.stamp $
    ./libcrossystem_static.a $
    ./libcrossystem_tests

default all
