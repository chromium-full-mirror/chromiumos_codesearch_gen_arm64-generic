defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_FEATURE_MANAGEMENT=false
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -DUSE_RTTI_FOR_TYPE_TAGS=1 -Wno-unused-local-typedefs -DBASE_VER=1211970 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -DUSE_RTTI_FOR_TYPE_TAGS=1 -Wno-unused-local-typedefs -DBASE_VER=1211970 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libsegmentation_tests

build obj/libsegmentation/libsegmentation_tests.inputdeps.stamp: stamp obj/libsegmentation/feature-protos_gen.stamp obj/libsegmentation/libsegmentation-test_pc.stamp
build obj/libsegmentation/libsegmentation_tests.feature_management_impl_test.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/libsegmentation/feature_management_impl_test.cc || obj/libsegmentation/libsegmentation_tests.inputdeps.stamp
  source_file_part = feature_management_impl_test.cc
  source_name_part = feature_management_impl_test
build obj/libsegmentation/libsegmentation_tests.feature_management_test.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/libsegmentation/feature_management_test.cc || obj/libsegmentation/libsegmentation_tests.inputdeps.stamp
  source_file_part = feature_management_test.cc
  source_name_part = feature_management_test

build ./libsegmentation_tests: link obj/libsegmentation/libsegmentation_tests.feature_management_impl_test.o obj/libsegmentation/libsegmentation_tests.feature_management_test.o obj/libsegmentation/libsegmentation_sources.feature_management.o obj/libsegmentation/libsegmentation_sources.feature_management_impl.o ./lib/libsegmentation-test.so ./libsegmentation_static.a ./libtestrunner.a ./libfeature-protos.a || obj/libsegmentation/libsegmentation_sources.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -lrootdev -lbrillo -lbase -lcrossystem -lprotobuf -lcrossystem-test -lbase-test
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
