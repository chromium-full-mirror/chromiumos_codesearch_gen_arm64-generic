defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = libsegmentation


build ./lib/libsegmentation.so: solink obj/libsegmentation/libsegmentation_sources.feature_management.o obj/libsegmentation/libsegmentation_sources.feature_management_impl.o ./libfeature-protos.a || obj/libsegmentation/libsegmentation_sources.stamp obj/libsegmentation/_libsegmentation-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lrootdev -lbrillo -lbase -lpthread -lcrossystem -lprotobuf
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
