build ./power_manager_util_test: link obj/power_manager/common/power_manager_util_test.activity_logger_test.o obj/power_manager/common/power_manager_util_test.battery_percentage_converter_test.o obj/power_manager/common/power_manager_util_test.prefs_test.o obj/power_manager/common/power_manager_util_test.util_test.o ./libutil.a ./libutil_test.a ./libtestrunner.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -pthread -L/build/arm64-generic/usr/lib64
