  source_name_part = battery_percentage_converter_test
build obj/power_manager/common/power_manager_util_test.prefs_test.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/power_manager/common/prefs_test.cc
  source_file_part = prefs_test.cc
