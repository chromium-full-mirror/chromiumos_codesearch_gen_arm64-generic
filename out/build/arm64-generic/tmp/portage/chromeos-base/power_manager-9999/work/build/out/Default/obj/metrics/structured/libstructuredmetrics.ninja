defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -DVCSID=\"9999-3ebbb89bcc9f6b02863d0181a9ee6f5bac38a8d9\" -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libstructuredmetrics

build obj/metrics/structured/libstructuredmetrics.inputdeps.stamp: stamp obj/metrics/structured/gen_structured_events.stamp obj/metrics/structured/storage_gen.stamp
build obj/metrics/structured/libstructuredmetrics.c_structured_metrics.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/c_structured_metrics.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = c_structured_metrics.cc
  source_name_part = c_structured_metrics
build obj/metrics/structured/libstructuredmetrics.event_base.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/event_base.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = event_base.cc
  source_name_part = event_base
build obj/metrics/structured/libstructuredmetrics.fake_recorder.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/fake_recorder.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = fake_recorder.cc
  source_name_part = fake_recorder
build obj/metrics/structured/libstructuredmetrics.key_data.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/key_data.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = key_data.cc
  source_name_part = key_data
build obj/metrics/structured/libstructuredmetrics.persistent_proto.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/persistent_proto.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = persistent_proto.cc
  source_name_part = persistent_proto
build obj/metrics/structured/libstructuredmetrics.recorder_impl.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/recorder_impl.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = recorder_impl.cc
  source_name_part = recorder_impl
build obj/metrics/structured/libstructuredmetrics.recorder_singleton.o: cxx ../../../../../../../../../../mnt/host/source/src/platform2/metrics/structured/recorder_singleton.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = recorder_singleton.cc
  source_name_part = recorder_singleton
build obj/gen/include/metrics/structured/libstructuredmetrics.structured_events.o: cxx gen/include/metrics/structured/structured_events.cc || obj/metrics/structured/libstructuredmetrics.inputdeps.stamp
  source_file_part = structured_events.cc
  source_name_part = structured_events

build ./lib/libstructuredmetrics.so: solink obj/metrics/structured/libstructuredmetrics.c_structured_metrics.o obj/metrics/structured/libstructuredmetrics.event_base.o obj/metrics/structured/libstructuredmetrics.fake_recorder.o obj/metrics/structured/libstructuredmetrics.key_data.o obj/metrics/structured/libstructuredmetrics.persistent_proto.o obj/metrics/structured/libstructuredmetrics.recorder_impl.o obj/metrics/structured/libstructuredmetrics.recorder_singleton.o obj/gen/include/metrics/structured/libstructuredmetrics.structured_events.o ./libstorage.a ./lib/libmetrics.so || obj/metrics/structured/gen_structured_events.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lbrillo -lbase -lpthread -lprotobuf-lite
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
