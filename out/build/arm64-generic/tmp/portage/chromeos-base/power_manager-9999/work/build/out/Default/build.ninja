ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build battery_saver_tool: phony ./battery_saver
build _backlight_tool-install_config: phony obj/power_manager/_backlight_tool-install_config.stamp
build _battery_saver_tool-install_config: phony obj/power_manager/_battery_saver_tool-install_config.stamp
build _check_powerd_config-install_config: phony obj/power_manager/_check_powerd_config-install_config.stamp
build _cpufreq_config-install_config: phony obj/power_manager/_cpufreq_config-install_config.stamp
build _dump_power_status-install_config: phony obj/power_manager/_dump_power_status-install_config.stamp
build _fake_adaptive_charging_ml_service-install_config: phony obj/power_manager/_fake_adaptive_charging_ml_service-install_config.stamp
build _inject_powerd_input_event-install_config: phony obj/power_manager/_inject_powerd_input_event-install_config.stamp
build _memory_suspend_test-install_config: phony obj/power_manager/_memory_suspend_test-install_config.stamp
