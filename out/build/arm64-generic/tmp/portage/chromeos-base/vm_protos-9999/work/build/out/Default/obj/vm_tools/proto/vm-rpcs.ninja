defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/vm_protos/proto_bindings -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libvm-rpcs

build obj/vm_tools/proto/vm-rpcs.inputdeps.stamp: stamp obj/vm_tools/proto/common-protos_gen.stamp obj/vm_tools/proto/vm-rpcs_gen.stamp
build obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_guest.grpc.pb.o: cxx gen/include/vm_protos/proto_bindings/vm_guest.grpc.pb.cc || obj/vm_tools/proto/vm-rpcs.inputdeps.stamp
  source_file_part = vm_guest.grpc.pb.cc
  source_name_part = vm_guest.grpc.pb
build obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_guest.pb.o: cxx gen/include/vm_protos/proto_bindings/vm_guest.pb.cc || obj/vm_tools/proto/vm-rpcs.inputdeps.stamp
  source_file_part = vm_guest.pb.cc
  source_name_part = vm_guest.pb
build obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_host.grpc.pb.o: cxx gen/include/vm_protos/proto_bindings/vm_host.grpc.pb.cc || obj/vm_tools/proto/vm-rpcs.inputdeps.stamp
  source_file_part = vm_host.grpc.pb.cc
  source_name_part = vm_host.grpc.pb
build obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_host.pb.o: cxx gen/include/vm_protos/proto_bindings/vm_host.pb.cc || obj/vm_tools/proto/vm-rpcs.inputdeps.stamp
  source_file_part = vm_host.pb.cc
  source_name_part = vm_host.pb

build ./libvm-rpcs.a: alink obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_guest.grpc.pb.o obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_guest.pb.o obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_host.grpc.pb.o obj/gen/include/vm_protos/proto_bindings/libvm-rpcs.vm_host.pb.o || obj/vm_tools/proto/vm-rpcs_gen.stamp ./libcommon-protos.a
  arflags = rcs
  output_extension = .a
  output_dir = 
