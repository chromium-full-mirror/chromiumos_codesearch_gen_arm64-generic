rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/libec/all.stamp
subninja obj/common-mk/testrunner/testrunner.ninja
build obj/libec/_libec-install_config.stamp: stamp
build obj/libec/_libec_pc-install_config.stamp: stamp
build obj/libec/_libec_static-install_config.stamp: stamp
build obj/libec/all.stamp: stamp obj/libec/install_fingerprint_headers.stamp obj/libec/install_libec_headers.stamp obj/libec/install_pwm_headers.stamp obj/libec/install_thermal_headers.stamp ./lib/libec.so obj/libec/libec_pc.stamp ./libec_static.a ./libec_tests
build obj/libec/install_fingerprint_headers.stamp: stamp
build obj/libec/install_libec_headers.stamp: stamp
build obj/libec/install_pwm_headers.stamp: stamp
build obj/libec/install_thermal_headers.stamp: stamp
subninja obj/libec/libec.ninja
subninja obj/libec/libec_common.ninja
rule __libec_libec_pc___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/generate-pc.py --output /build/arm64-generic/tmp/portage/chromeos-base/libec-9999/work/build/out/Default/obj/libec/libec.pc --name=libec --description=Chromium\$ OS\$ Embedded\$ Controller\$ Library --version=0.1 --requires=libchrome --requires=libusb-1.0 --requires-private=absl --requires-private=libbrillo --requires-private=libchrome --requires-private=libpower_manager-client --requires-private=libusb-1.0 --libs=-lec
  description = ACTION //libec:libec_pc(//common-mk/toolchain:toolchain)
  restat = 1

build obj/libec/libec.pc: __libec_libec_pc___common-mk_toolchain_toolchain__rule | ../../../../../../../../../../mnt/host/source/src/platform2/common-mk/generate-pc.py obj/libec/_libec_pc-install_config.stamp

build obj/libec/libec_pc.stamp: stamp obj/libec/libec.pc
subninja obj/libec/libec_static.ninja
subninja obj/libec/libec_tests.ninja
