defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = libec


build ./lib/libec.so: solink obj/libec/libec_common.add_entropy_command.o obj/libec/libec_common.charge_current_limit_set_command.o obj/libec/libec_common.device_event_command.o obj/libec/libec_common.display_soc_command.o obj/libec/libec_common.ec_command_factory.o obj/libec/libec_common.ec_panicinfo.o obj/libec/libec_common.ec_usb_device_monitor.o obj/libec/libec_common.ec_usb_endpoint.o obj/libec/fingerprint/libec_common.fp_context_command.o obj/libec/fingerprint/libec_common.fp_context_command_factory.o obj/libec/fingerprint/libec_common.fp_encryption_status_command.o obj/libec/fingerprint/libec_common.fp_frame_command.o obj/libec/fingerprint/libec_common.fp_get_nonce_command.o obj/libec/fingerprint/libec_common.fp_info_command.o obj/libec/fingerprint/libec_common.fp_mode.o obj/libec/fingerprint/libec_common.fp_mode_command.o obj/libec/fingerprint/libec_common.fp_pairing_key_keygen_command.o obj/libec/fingerprint/libec_common.fp_pairing_key_wrap_command.o obj/libec/fingerprint/libec_common.fp_preload_template_command.o obj/libec/fingerprint/libec_common.fp_read_match_secret_command.o obj/libec/fingerprint/libec_common.fp_read_match_secret_with_pubkey_command.o obj/libec/fingerprint/libec_common.fp_seed_command.o obj/libec/fingerprint/libec_common.fp_stats_command.o obj/libec/fingerprint/libec_common.fp_template_command.o obj/libec/libec_common.flash_info_command.o obj/libec/libec_common.flash_info_params.o obj/libec/libec_common.flash_protect_command.o obj/libec/libec_common.flash_protect_command_factory.o obj/libec/libec_common.flash_spi_info_command.o obj/libec/libec_common.get_chip_info_command.o obj/libec/libec_common.get_comms_status_command.o obj/libec/libec_common.get_features_command.o obj/libec/libec_common.get_mkbp_wake_mask_command.o obj/libec/libec_common.get_protocol_info_command.o obj/libec/libec_common.get_version_command.o obj/libec/libec_common.hello_command.o obj/libec/libec_common.i2c_passthru_command.o obj/libec/libec_common.i2c_read_command.o obj/libec/libec_common.led_control_command.o obj/libec/libec_common.mkbp_event.o obj/libec/libec_common.motion_sense_command_lid_angle.o obj/libec/libec_common.rand_num_command.o obj/libec/libec_common.reboot_ec_command.o obj/libec/libec_common.rollback_info_command.o obj/libec/libec_common.set_force_lid_open_command.o obj/libec/libec_common.set_mkbp_wake_mask_command.o obj/libec/libec_common.smart_discharge_command.o obj/libec/libec_common.versions_command.o || obj/libec/libec_common.stamp obj/libec/_libec-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -labsl_base -labsl_log_severity -labsl_malloc_internal -labsl_raw_logging_internal -labsl_scoped_set_env -labsl_spinlock_wait -labsl_strerror -labsl_throw_delegate -labsl_hashtablez_sampler -labsl_raw_hash_set -labsl_crc32c -labsl_crc_cord_state -labsl_crc_cpu_detect -labsl_crc_internal -labsl_debugging_internal -labsl_demangle_internal -labsl_examine_stack -labsl_failure_signal_handler -labsl_leak_check -labsl_stacktrace -labsl_symbolize -labsl_flags -labsl_flags_commandlineflag -labsl_flags_commandlineflag_internal -labsl_flags_config -labsl_flags_internal -labsl_flags_marshalling -labsl_flags_parse -labsl_flags_private_handle_accessor -labsl_flags_program_name -labsl_flags_reflection -labsl_flags_usage -labsl_flags_usage_internal -labsl_city -labsl_hash -labsl_low_level_hash -labsl_die_if_null -labsl_log_entry -labsl_log_flags -labsl_log_globals -labsl_log_initialize -labsl_log_internal_check_op -labsl_log_internal_conditions -labsl_log_internal_format -labsl_log_internal_globals -labsl_log_internal_log_sink_set -labsl_log_internal_message -labsl_log_internal_nullguard -labsl_log_internal_proto -labsl_log_sink -labsl_int128 -labsl_exponential_biased -labsl_periodic_sampler -labsl_random_distributions -labsl_random_internal_distribution_test_util -labsl_random_internal_platform -labsl_random_internal_pool_urbg -labsl_random_internal_randen -labsl_random_internal_randen_hwaes -labsl_random_internal_randen_hwaes_impl -labsl_random_internal_randen_slow -labsl_random_internal_seed_material -labsl_random_seed_gen_exception -labsl_random_seed_sequences -labsl_status -labsl_statusor -labsl_cord -labsl_cord_internal -labsl_cordz_functions -labsl_cordz_handle -labsl_cordz_info -labsl_cordz_sample_token -labsl_str_format_internal -labsl_strings -labsl_strings_internal -labsl_graphcycles_internal -labsl_synchronization -labsl_civil_time -labsl_time -labsl_time_zone -labsl_bad_any_cast_impl -labsl_bad_optional_access -labsl_bad_variant_access -lbrillo -lbase -lpthread -lusb-1.0
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
