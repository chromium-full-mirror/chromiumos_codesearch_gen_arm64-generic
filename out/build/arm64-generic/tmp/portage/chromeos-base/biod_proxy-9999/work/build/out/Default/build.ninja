ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libbiod_proxy-install_config: phony obj/biod/biod_proxy/_libbiod_proxy-install_config.stamp
build install_headers: phony obj/biod/biod_proxy/install_headers.stamp
build libbiod_proxy: phony ./lib/libbiod_proxy.so
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build biod/biod_proxy$:_libbiod_proxy-install_config: phony obj/biod/biod_proxy/_libbiod_proxy-install_config.stamp
build biod/biod_proxy$:all: phony obj/biod/biod_proxy/all.stamp
build biod/biod_proxy$:biod_proxy_test_runner: phony ./biod_proxy_test_runner
build biod/biod_proxy$:install_headers: phony obj/biod/biod_proxy/install_headers.stamp
build biod/biod_proxy$:libbiod_proxy: phony ./lib/libbiod_proxy.so
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a

build all: phony $
    obj/biod/biod_proxy/_libbiod_proxy-install_config.stamp $
    obj/biod/biod_proxy/all.stamp $
    ./biod_proxy_test_runner $
    obj/biod/biod_proxy/install_headers.stamp $
    ./lib/libbiod_proxy.so $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a

default all
