defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -I/build/arm64-generic/usr/include/tensorflow -Igen/include -I../../../ml-9999/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -Wno-cast-qual -Wno-cast-align -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -Wno-cast-qual -Wno-cast-align
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libml_for_benchmark

build obj/ml/libml_for_benchmark.inputdeps.stamp: stamp obj/ml/benchmark_proto_gen.stamp obj/ml/ml_mojo_bindings_gen.stamp obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
build obj/ml/libml_for_benchmark.benchmark.o: cxx ../../../ml-9999/platform2/ml/benchmark.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = benchmark.cc
  source_name_part = benchmark
build obj/ml/custom_ops/libml_for_benchmark.transpose_conv_bias.o: cxx ../../../ml-9999/platform2/ml/custom_ops/transpose_conv_bias.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = transpose_conv_bias.cc
  source_name_part = transpose_conv_bias
build obj/ml/libml_for_benchmark.graph_executor_delegate.o: cxx ../../../ml-9999/platform2/ml/graph_executor_delegate.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = graph_executor_delegate.cc
  source_name_part = graph_executor_delegate
build obj/ml/libml_for_benchmark.graph_executor_impl.o: cxx ../../../ml-9999/platform2/ml/graph_executor_impl.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = graph_executor_impl.cc
  source_name_part = graph_executor_impl
build obj/ml/libml_for_benchmark.metrics.o: cxx ../../../ml-9999/platform2/ml/metrics.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = metrics.cc
  source_name_part = metrics
build obj/ml/libml_for_benchmark.model_conversions.o: cxx ../../../ml-9999/platform2/ml/model_conversions.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = model_conversions.cc
  source_name_part = model_conversions
build obj/ml/libml_for_benchmark.model_delegate.o: cxx ../../../ml-9999/platform2/ml/model_delegate.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = model_delegate.cc
  source_name_part = model_delegate
build obj/ml/libml_for_benchmark.model_impl.o: cxx ../../../ml-9999/platform2/ml/model_impl.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = model_impl.cc
  source_name_part = model_impl
build obj/ml/libml_for_benchmark.model_metadata.o: cxx ../../../ml-9999/platform2/ml/model_metadata.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = model_metadata.cc
  source_name_part = model_metadata
build obj/ml/libml_for_benchmark.process.o: cxx ../../../ml-9999/platform2/ml/process.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = process.cc
  source_name_part = process
build obj/ml/libml_for_benchmark.request_metrics.o: cxx ../../../ml-9999/platform2/ml/request_metrics.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = request_metrics.cc
  source_name_part = request_metrics
build obj/ml/libml_for_benchmark.tensor_view.o: cxx ../../../ml-9999/platform2/ml/tensor_view.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = tensor_view.cc
  source_name_part = tensor_view
build obj/ml/libml_for_benchmark.time_metrics.o: cxx ../../../ml-9999/platform2/ml/time_metrics.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = time_metrics.cc
  source_name_part = time_metrics
build obj/ml/libml_for_benchmark.util.o: cxx ../../../ml-9999/platform2/ml/util.cc || obj/ml/libml_for_benchmark.inputdeps.stamp
  source_file_part = util.cc
  source_name_part = util

build ./lib/libml_for_benchmark.so: solink obj/ml/libml_for_benchmark.benchmark.o obj/ml/custom_ops/libml_for_benchmark.transpose_conv_bias.o obj/ml/libml_for_benchmark.graph_executor_delegate.o obj/ml/libml_for_benchmark.graph_executor_impl.o obj/ml/libml_for_benchmark.metrics.o obj/ml/libml_for_benchmark.model_conversions.o obj/ml/libml_for_benchmark.model_delegate.o obj/ml/libml_for_benchmark.model_impl.o obj/ml/libml_for_benchmark.model_metadata.o obj/ml/libml_for_benchmark.process.o obj/ml/libml_for_benchmark.request_metrics.o obj/ml/libml_for_benchmark.tensor_view.o obj/ml/libml_for_benchmark.time_metrics.o obj/ml/libml_for_benchmark.util.o ./libbenchmark_proto.a ./lib/libmlbenchmark_proto.so ./libmlbenchmark_driver_common.a ./libml_mojo_bindings.a || obj/ml/ml_mojo_bindings_lib.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -ltensorflowlite -lbrillo -lbase -lpthread -lmetrics -lmojo -lprotobuf
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
