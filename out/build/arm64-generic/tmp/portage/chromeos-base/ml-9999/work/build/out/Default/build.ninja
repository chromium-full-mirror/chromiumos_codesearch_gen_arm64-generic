build ml$:ml_mojo_bindings_lib: phony obj/ml/ml_mojo_bindings_lib.stamp
build ml$:ml_service: phony ./ml_service
build ml$:ml_service_test: phony ./ml_service_test
build ml$:ml_soda_proto: phony ./libml_soda_proto.a
build ml$:ml_soda_proto_gen: phony obj/ml/ml_soda_proto_gen.stamp
build ml$:ml_text_suggester_proto: phony ./libml_text_suggester_proto.a
build ml$:ml_text_suggester_proto_gen: phony obj/ml/ml_text_suggester_proto_gen.stamp
build ml/dbus_service$:core: phony ./libcore.a
build ml/dbus_service$:dbus-adaptors: phony obj/ml/dbus_service/dbus-adaptors.stamp
build ml_benchmark$:_libmlbenchmark_proto-install_config: phony obj/ml_benchmark/_libmlbenchmark_proto-install_config.stamp
build ml_benchmark$:_ml_benchmark-install_config: phony obj/ml_benchmark/_ml_benchmark-install_config.stamp
build ml_benchmark$:all: phony obj/ml_benchmark/all.stamp
build ml_benchmark$:libmlbenchmark: phony ./libmlbenchmark.a
build ml_benchmark$:libmlbenchmark_proto: phony ./lib/libmlbenchmark_proto.so
build ml_benchmark$:ml_benchmark: phony ./ml_benchmark
build ml_benchmark$:ml_benchmark_config_proto: phony ./libml_benchmark_config_proto.a
build ml_benchmark$:ml_benchmark_config_proto_gen: phony obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
build ml_benchmark$:ml_benchmark_test: phony ./ml_benchmark_test
