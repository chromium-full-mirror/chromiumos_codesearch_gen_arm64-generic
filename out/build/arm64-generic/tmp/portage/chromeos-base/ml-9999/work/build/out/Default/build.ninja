build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/ml/all.stamp $
    ./libbenchmark_proto.a $
    obj/ml/benchmark_proto_gen.stamp $
    obj/ml/example_preprocessor.stamp $
    ./lib/libml_for_benchmark.so $
    ./libml_assist_ranker_proto.a $
    obj/ml/ml_assist_ranker_proto_gen.stamp $
    ./libml_common.a $
    ./libml_grammar_proto.a $
    obj/ml/ml_grammar_proto_gen.stamp $
    ./libml_handwriting_proto.a $
    obj/ml/ml_handwriting_proto_gen.stamp $
    ./libml_ica_proto.a $
    obj/ml/ml_ica_proto_gen.stamp $
    ./libml_mojo_bindings.a $
    obj/ml/ml_mojo_bindings_gen.stamp $
    obj/ml/ml_mojo_bindings_gen_mojo_templates.stamp $
    obj/ml/ml_mojo_bindings_gen_mojo_templates_dir.stamp $
    obj/ml/ml_mojo_bindings_gen_parse.stamp $
    obj/ml/ml_mojo_bindings_lib.stamp $
    ./ml_service $
    ./ml_service_test $
    ./libml_soda_proto.a $
    obj/ml/ml_soda_proto_gen.stamp $
    ./libml_text_suggester_proto.a $
    obj/ml/ml_text_suggester_proto_gen.stamp $
    ./libcore.a $
    obj/ml/dbus_service/dbus-adaptors.stamp $
    obj/ml_benchmark/_libmlbenchmark_proto-install_config.stamp $
    obj/ml_benchmark/_ml_benchmark-install_config.stamp $
    obj/ml_benchmark/all.stamp $
    ./libmlbenchmark.a $
    ./lib/libmlbenchmark_proto.so $
    ./ml_benchmark $
    ./libml_benchmark_config_proto.a $
    obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp $
    ./ml_benchmark_test $
    ./driver_common_test $
    ./libmlbenchmark_driver_common.a $
    obj/ml_core/dlc/all.stamp $
    ./libdlc_client.a

default all
