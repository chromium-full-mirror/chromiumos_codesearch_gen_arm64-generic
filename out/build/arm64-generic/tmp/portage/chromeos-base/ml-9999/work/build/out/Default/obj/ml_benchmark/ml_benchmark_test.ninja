defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../ml-9999/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -pthread
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = ml_benchmark_test

build obj/ml_benchmark/ml_benchmark_test.json_serializer_test.o: cxx ../../../ml-9999/platform2/ml_benchmark/json_serializer_test.cc || obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
  source_file_part = json_serializer_test.cc
  source_name_part = json_serializer_test
build obj/ml_benchmark/ml_benchmark_test.memory_sampler_test.o: cxx ../../../ml-9999/platform2/ml_benchmark/memory_sampler_test.cc || obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
  source_file_part = memory_sampler_test.cc
  source_name_part = memory_sampler_test
build obj/ml_benchmark/ml_benchmark_test.shared_library_benchmark_test.o: cxx ../../../ml-9999/platform2/ml_benchmark/shared_library_benchmark_test.cc || obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
  source_file_part = shared_library_benchmark_test.cc
  source_name_part = shared_library_benchmark_test
build obj/ml_benchmark/ml_benchmark_test.sysmetrics_test.o: cxx ../../../ml-9999/platform2/ml_benchmark/sysmetrics_test.cc || obj/ml_benchmark/ml_benchmark_config_proto_gen.stamp
  source_file_part = sysmetrics_test.cc
  source_name_part = sysmetrics_test

build ./ml_benchmark_test: link obj/ml_benchmark/ml_benchmark_test.json_serializer_test.o obj/ml_benchmark/ml_benchmark_test.memory_sampler_test.o obj/ml_benchmark/ml_benchmark_test.shared_library_benchmark_test.o obj/ml_benchmark/ml_benchmark_test.sysmetrics_test.o ./libmlbenchmark.a ./libml_benchmark_config_proto.a ./libtestrunner.a ./lib/libmlbenchmark_proto.so
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -pthread -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -lbase-test -lbrillo -lbase -lre2 -lprotobuf
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
