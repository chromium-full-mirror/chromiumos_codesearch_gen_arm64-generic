defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../ml-9999/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -Wno-cast-qual -Wno-cast-align
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = example_preprocessor

build obj/ml/example_preprocessor/example_preprocessor.example_preprocessing.o: cxx ../../../ml-9999/platform2/ml/example_preprocessor/example_preprocessing.cc || obj/ml/ml_assist_ranker_proto_gen.stamp
  source_file_part = example_preprocessing.cc
  source_name_part = example_preprocessing
build obj/ml/example_preprocessor/example_preprocessor.ranker_example_util.o: cxx ../../../ml-9999/platform2/ml/example_preprocessor/ranker_example_util.cc || obj/ml/ml_assist_ranker_proto_gen.stamp
  source_file_part = ranker_example_util.cc
  source_name_part = ranker_example_util

build obj/ml/example_preprocessor.stamp: stamp obj/ml/example_preprocessor/example_preprocessor.example_preprocessing.o obj/ml/example_preprocessor/example_preprocessor.ranker_example_util.o || ./libml_assist_ranker_proto.a
