defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -I/build/arm64-generic/usr/include/tensorflow -Igen/include -I../../../ml-9999/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -Wno-cast-qual -Wno-cast-align
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libcore

build obj/ml/dbus_service/core.inputdeps.stamp: stamp obj/ml/ml_assist_ranker_proto_gen.stamp obj/ml/ml_mojo_bindings_gen.stamp obj/ml/dbus_service/dbus-adaptors.stamp
build obj/ml/dbus_service/libcore.adaptive_charging_service.o: cxx ../../../ml-9999/platform2/ml/dbus_service/adaptive_charging_service.cc || obj/ml/dbus_service/core.inputdeps.stamp
  source_file_part = adaptive_charging_service.cc
  source_name_part = adaptive_charging_service
build obj/ml/dbus_service/libcore.tf_model_graph_executor.o: cxx ../../../ml-9999/platform2/ml/dbus_service/tf_model_graph_executor.cc || obj/ml/dbus_service/core.inputdeps.stamp
  source_file_part = tf_model_graph_executor.cc
  source_name_part = tf_model_graph_executor
build obj/ml/dbus_service/libcore.tf_model_graph_executor_util.o: cxx ../../../ml-9999/platform2/ml/dbus_service/tf_model_graph_executor_util.cc || obj/ml/dbus_service/core.inputdeps.stamp
  source_file_part = tf_model_graph_executor_util.cc
  source_name_part = tf_model_graph_executor_util

build ./libcore.a: alink obj/ml/dbus_service/libcore.adaptive_charging_service.o obj/ml/dbus_service/libcore.tf_model_graph_executor.o obj/ml/dbus_service/libcore.tf_model_graph_executor_util.o || obj/ml/dbus_service/dbus-adaptors.stamp obj/ml/example_preprocessor.stamp ./libml_assist_ranker_proto.a obj/ml/ml_mojo_bindings_lib.stamp ./libml_mojo_bindings.a
  arflags = rcsT
  output_extension = .a
  output_dir = 
