ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../tast-local-helpers-cros-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build tast-tests/helpers/local$:all: phony obj/tast-tests/helpers/local/all.stamp
build tast-tests/helpers/local$:arc.Suspend.readclocks: phony ./arc.Suspend.readclocks
build tast-tests/helpers/local$:crash.Seccomp.brk: phony ./crash.Seccomp.brk
build tast-tests/helpers/local$:cryptohome.SequentialConsistency.filewriter: phony ./cryptohome.SequentialConsistency.filewriter
build tast-tests/helpers/local$:featured.FeatureLibraryLateBoot.check: phony ./featured.FeatureLibraryLateBoot.check
build tast-tests/helpers/local$:graphics.GBM.gbmtest: phony ./graphics.GBM.gbmtest
build tast-tests/helpers/local$:hardware.VerifyRemoteSleep.timersignal: phony ./hardware.VerifyRemoteSleep.timersignal
build tast-tests/helpers/local$:kernel.PerfCallgraph.graph: phony ./kernel.PerfCallgraph.graph
build tast-tests/helpers/local$:multivm.Lifecycle.allocate: phony ./multivm.Lifecycle.allocate
build tast-tests/helpers/local$:platform.UserCrash.crasher: phony ./platform.UserCrash.crasher
build tast-tests/helpers/local$:platform.UserCrash.crasher.sym: phony obj/tast-tests/helpers/local/platform.UserCrash.crasher.sym.stamp
build tast-tests/helpers/local$:security.AltSyscall.adjtimex: phony ./security.AltSyscall.adjtimex
build tast-tests/helpers/local$:security.AltSyscall.alt_syscall: phony ./security.AltSyscall.alt_syscall
build tast-tests/helpers/local$:security.AltSyscall.clock_adjtime: phony ./security.AltSyscall.clock_adjtime
build tast-tests/helpers/local$:security.AltSyscall.mmap: phony ./security.AltSyscall.mmap
build tast-tests/helpers/local$:security.AltSyscall.read: phony ./security.AltSyscall.read
build tast-tests/helpers/local$:security.MemoryFileExecTelemetry.memfd_fexecve: phony ./security.MemoryFileExecTelemetry.memfd_fexecve
build tast-tests/helpers/local$:security.MemoryFileExecTelemetry.test_bin: phony ./security.MemoryFileExecTelemetry.test_bin
build tast-tests/helpers/local$:security.Minijail.bpfdeny: phony ./security.Minijail.bpfdeny
build tast-tests/helpers/local$:security.Minijail.landlock_refer: phony ./security.Minijail.landlock_refer
build tast-tests/helpers/local$:security.Minijail.landlock_walk: phony ./security.Minijail.landlock_walk
build tast-tests/helpers/local$:security.Minijail.staticbashexec: phony ./security.Minijail.staticbashexec
build tast-tests/helpers/local$:security.MinijailSeccomp.fail: phony ./security.MinijailSeccomp.fail
build tast-tests/helpers/local$:security.MinijailSeccomp.ok: phony ./security.MinijailSeccomp.ok
build tast-tests/helpers/local$:security.MinijailSeccomp.open: phony ./security.MinijailSeccomp.open
build tast-tests/helpers/local$:security.PtraceProcess.sleeper: phony ./security.PtraceProcess.sleeper
build tast-tests/helpers/local$:security.PtraceThread.thread-prctl: phony ./security.PtraceThread.thread-prctl

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/tast-tests/helpers/local/all.stamp $
    ./arc.Suspend.readclocks $
    ./crash.Seccomp.brk $
    ./cryptohome.SequentialConsistency.filewriter $
    ./featured.FeatureLibraryLateBoot.check $
    ./graphics.GBM.gbmtest $
    ./hardware.VerifyRemoteSleep.timersignal $
    ./kernel.PerfCallgraph.graph $
    ./multivm.Lifecycle.allocate $
    ./platform.UserCrash.crasher $
    obj/tast-tests/helpers/local/platform.UserCrash.crasher.sym.stamp $
    ./security.AltSyscall.adjtimex $
    ./security.AltSyscall.alt_syscall $
    ./security.AltSyscall.clock_adjtime $
    ./security.AltSyscall.mmap $
    ./security.AltSyscall.read $
    ./security.MemoryFileExecTelemetry.memfd_fexecve $
    ./security.MemoryFileExecTelemetry.test_bin $
    ./security.Minijail.bpfdeny $
    ./security.Minijail.landlock_refer $
    ./security.Minijail.landlock_walk $
    ./security.Minijail.staticbashexec $
    ./security.MinijailSeccomp.fail $
    ./security.MinijailSeccomp.ok $
    ./security.MinijailSeccomp.open $
    ./security.PtraceProcess.sleeper $
    ./security.PtraceThread.thread-prctl

default all
