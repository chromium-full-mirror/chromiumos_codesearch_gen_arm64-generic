defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../tast-local-helpers-cros-9999/platform2 -I/build/arm64-generic/usr/include
cflags = -g -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_c = -std=gnu17 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = multivm.Lifecycle.allocate

build obj/tast-tests/helpers/local/multivm.Lifecycle.allocate.multivm.Lifecycle.allocate.o: cc ../../../tast-local-helpers-cros-9999/platform2/tast-tests/helpers/local/multivm.Lifecycle.allocate.c
  source_file_part = multivm.Lifecycle.allocate.c
  source_name_part = multivm.Lifecycle.allocate

build ./multivm.Lifecycle.allocate: link obj/tast-tests/helpers/local/multivm.Lifecycle.allocate.multivm.Lifecycle.allocate.o
  ldflags = -static -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie
  libs =
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
