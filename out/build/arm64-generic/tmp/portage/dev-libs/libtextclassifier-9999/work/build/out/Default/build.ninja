ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../libtextclassifier-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build flatbuffers: phony obj/libtextclassifier/flatbuffers.stamp
build flatbuffers_gen: phony obj/libtextclassifier/flatbuffers_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build textclassifier: phony ./libtextclassifier.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libtextclassifier$:all: phony obj/libtextclassifier/all.stamp
build libtextclassifier$:flatbuffers: phony obj/libtextclassifier/flatbuffers.stamp
build libtextclassifier$:flatbuffers_gen: phony obj/libtextclassifier/flatbuffers_gen.stamp
build libtextclassifier$:textclassifier: phony ./libtextclassifier.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libtextclassifier/all.stamp $
    obj/libtextclassifier/flatbuffers.stamp $
    obj/libtextclassifier/flatbuffers_gen.stamp $
    ./libtextclassifier.a

default all
