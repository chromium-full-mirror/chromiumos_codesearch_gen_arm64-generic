defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../libtextclassifier-9999/platform2 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = flatbuffers


build obj/libtextclassifier/flatbuffers.stamp: stamp || obj/libtextclassifier/flatbuffers_gen.stamp
