defines = -DSAFTM_COMPACT_LOGGING -DTC3_CALENDAR_ICU -DTC3_DISABLE_LUA -DTC3_UNILIB_ICU -DTC3_VOCAB_ANNOTATOR_IMPL -DZLIB_CONST -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/libtextclassifier -I/build/arm64-generic/usr/include/icu-chrome/common -I/build/arm64-generic/usr/include/icu-chrome/i18n -I/build/arm64-generic/usr/include/marisa-aosp -I/build/arm64-generic/usr/include/tensorflow -I../../../libtextclassifier-9999/platform2/libtextclassifier -Igen/include -I../../../libtextclassifier-9999/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libtextclassifier

