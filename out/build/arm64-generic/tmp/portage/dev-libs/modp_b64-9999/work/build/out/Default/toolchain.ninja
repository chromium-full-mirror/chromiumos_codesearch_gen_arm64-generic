rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/modp_b64/all.stamp
build obj/modp_b64/all.stamp: stamp ./libmodp_b64.a obj/modp_b64/modp_b64_pkgconfig.stamp
subninja obj/modp_b64/modp_b64.ninja
rule __modp_b64_modp_b64_pkgconfig___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../modp_b64-9999/platform2/common-mk/generate-pc.py --output /build/arm64-generic/tmp/portage/dev-libs/modp_b64-9999/work/build/out/Default/obj/modp_b64/libmodp_b64.pc --name=modp_b64 --description=modp_b64\$ decoder. --version=0 --libs=-L/usr/lib64 --libs=-lmodp_b64
  description = ACTION //modp_b64:modp_b64_pkgconfig(//common-mk/toolchain:toolchain)
  restat = 1

build obj/modp_b64/libmodp_b64.pc: __modp_b64_modp_b64_pkgconfig___common-mk_toolchain_toolchain__rule | ../../../modp_b64-9999/platform2/common-mk/generate-pc.py ./libmodp_b64.a

build obj/modp_b64/modp_b64_pkgconfig.stamp: stamp obj/modp_b64/libmodp_b64.pc
