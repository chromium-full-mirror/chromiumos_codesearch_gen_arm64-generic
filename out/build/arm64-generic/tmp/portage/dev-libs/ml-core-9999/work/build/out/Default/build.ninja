ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../../usr/bin/gn --root=../../../ml-core-9999/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libcros_ml_core-install_config: phony obj/ml_core/_libcros_ml_core-install_config.stamp
build install_headers: phony obj/ml_core/install_headers.stamp
build install_minijail_conf: phony obj/ml_core/install_minijail_conf.stamp
build install_tmpfiles: phony obj/ml_core/install_tmpfiles.stamp
build libcros_ml_core: phony ./lib/libcros_ml_core.so
build maybe_install_dev_lib: phony obj/ml_core/maybe_install_dev_lib.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build unittest_deps: phony obj/ml_core/unittest_deps.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build ml_core$:_libcros_ml_core-install_config: phony obj/ml_core/_libcros_ml_core-install_config.stamp
build ml_core$:all: phony obj/ml_core/all.stamp
build ml_core$:install_headers: phony obj/ml_core/install_headers.stamp
build ml_core$:install_minijail_conf: phony obj/ml_core/install_minijail_conf.stamp
build ml_core$:install_tmpfiles: phony obj/ml_core/install_tmpfiles.stamp
build ml_core$:libcros_ml_core: phony ./lib/libcros_ml_core.so
build ml_core$:maybe_install_dev_lib: phony obj/ml_core/maybe_install_dev_lib.stamp
build ml_core$:unittest_deps: phony obj/ml_core/unittest_deps.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/ml_core/_libcros_ml_core-install_config.stamp $
    obj/ml_core/all.stamp $
    obj/ml_core/install_headers.stamp $
    obj/ml_core/install_minijail_conf.stamp $
    obj/ml_core/install_tmpfiles.stamp $
    ./lib/libcros_ml_core.so $
    obj/ml_core/maybe_install_dev_lib.stamp $
    obj/ml_core/unittest_deps.stamp

default all
