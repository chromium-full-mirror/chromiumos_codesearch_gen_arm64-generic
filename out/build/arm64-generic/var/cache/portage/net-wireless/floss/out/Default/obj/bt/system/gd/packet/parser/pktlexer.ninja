defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r5374/work/floss-0.0.2/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r5374/work/floss-0.0.2/platform2/bt/system/gd/packet/parser -Igen/bt/system/gd/packet/parser
