defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DTARGET_FLOSS -DEXPORT_SYMBOL=__attribute__\(\(visibility\(\"default\"\)\)\) -DFALLTHROUGH_INTENDED=\[\[clang$:$:fallthrough\]\] -DEXCLUDE_NONSTANDARD_CODECS
include_dirs = -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system -Igen/include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system/linux_include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system/types -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system/include -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system/gd -Igen/bt/system/gd -Igen/bt/system/gd/dumpsys/bundler -Igen/bt/system/gd/rust/shim -I../../../../../../../tmp/portage/net-wireless/floss-0.0.2-r4565/work/floss-0.0.2/platform2/bt/system/gd/rust/shim -Igen
root_out_dir = .
target_output_name = net_test_device

build obj/bt/system/device/net_test_device.inputdeps.stamp: stamp obj/bt/system/gd/rust/shim/cxxlibheader.stamp obj/bt/system/gd/rust/shim/init_flags_bridge_code_gen.stamp obj/bt/system/gd/rust/shim/init_flags_bridge_header.stamp obj/external/proto_logging/stats/enums/bluetooth/libbt-platform-protos-lite_gen.stamp

build ./net_test_device: link obj/gen/bt/system/gd/rust/shim/src/init_flags_bridge_code.init_flags.rs.o ./libdevice.a ./libbtcore.a ./libosi.a ./libbluetooth_rust_interop.a ./libcommon.a ./libbt-platform-protos-lite.a || obj/bt/system/gd/rust/shim/init_flags_bridge_code.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -L/build/arm64-generic/usr/lib64
  libs = -lpthread -lrt -ldl -lgtest_main -lgtest -lbase -lstructuredmetrics -lssl -lcrypto
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
