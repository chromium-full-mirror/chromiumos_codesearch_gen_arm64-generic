ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/media-libs/cros-camera-libcamera_connector_test-0.0.1-r882/work/cros-camera-libcamera_connector_test-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cros_camera_connector_test-install_config: phony obj/camera/common/libcamera_connector_test/_cros_camera_connector_test-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build camera/common/libcamera_connector_test$:_cros_camera_connector_test-install_config: phony obj/camera/common/libcamera_connector_test/_cros_camera_connector_test-install_config.stamp
build camera/common/libcamera_connector_test$:all: phony obj/camera/common/libcamera_connector_test/all.stamp
build camera/common/libcamera_connector_test$:cros_camera_connector_test: phony ./cros_camera_connector_test
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/camera/common/libcamera_connector_test/_cros_camera_connector_test-install_config.stamp $
    obj/camera/common/libcamera_connector_test/all.stamp $
    ./cros_camera_connector_test $
    obj/common-mk/gn_root/root.stamp

default all
