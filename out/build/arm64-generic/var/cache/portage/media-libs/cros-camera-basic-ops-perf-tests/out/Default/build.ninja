ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/media-libs/cros-camera-basic-ops-perf-tests-0.0.1-r10/work/cros-camera-basic-ops-perf-tests-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _mojo_perf_test-install_config: phony obj/camera/common/basic_ops_perf_tests/_mojo_perf_test-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build test_mojom: phony ./libtest_mojom.a
build test_mojom_gen: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen.stamp
build test_mojom_gen_mojo_templates: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates.stamp
build test_mojom_gen_mojo_templates_dir: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates_dir.stamp
build test_mojom_gen_parse: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_parse.stamp
build camera/common/basic_ops_perf_tests$:_mojo_perf_test-install_config: phony obj/camera/common/basic_ops_perf_tests/_mojo_perf_test-install_config.stamp
build camera/common/basic_ops_perf_tests$:all: phony obj/camera/common/basic_ops_perf_tests/all.stamp
build camera/common/basic_ops_perf_tests$:mojo_perf_test: phony ./mojo_perf_test
build camera/common/basic_ops_perf_tests$:test_mojom: phony ./libtest_mojom.a
build camera/common/basic_ops_perf_tests$:test_mojom_gen: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen.stamp
build camera/common/basic_ops_perf_tests$:test_mojom_gen_mojo_templates: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates.stamp
build camera/common/basic_ops_perf_tests$:test_mojom_gen_mojo_templates_dir: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates_dir.stamp
build camera/common/basic_ops_perf_tests$:test_mojom_gen_parse: phony obj/camera/common/basic_ops_perf_tests/test_mojom_gen_parse.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/camera/common/basic_ops_perf_tests/_mojo_perf_test-install_config.stamp $
    obj/camera/common/basic_ops_perf_tests/all.stamp $
    ./mojo_perf_test $
    ./libtest_mojom.a $
    obj/camera/common/basic_ops_perf_tests/test_mojom_gen.stamp $
    obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates.stamp $
    obj/camera/common/basic_ops_perf_tests/test_mojom_gen_mojo_templates_dir.stamp $
    obj/camera/common/basic_ops_perf_tests/test_mojom_gen_parse.stamp $
    obj/common-mk/gn_root/root.stamp

default all
