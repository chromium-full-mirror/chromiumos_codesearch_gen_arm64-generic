ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/media-libs/cros-camera-usb-tests-0.0.1-r605/work/cros-camera-usb-tests-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _camera_characteristics_test-install_config: phony obj/camera/hal/usb/tests/_camera_characteristics_test-install_config.stamp
build _camera_dfu_test-install_config: phony obj/camera/hal/usb/tests/_camera_dfu_test-install_config.stamp
build _media_v4l2_test-install_config: phony obj/camera/hal/usb/tests/_media_v4l2_test-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build camera/hal/usb/tests$:_camera_characteristics_test-install_config: phony obj/camera/hal/usb/tests/_camera_characteristics_test-install_config.stamp
build camera/hal/usb/tests$:_camera_dfu_test-install_config: phony obj/camera/hal/usb/tests/_camera_dfu_test-install_config.stamp
build camera/hal/usb/tests$:_media_v4l2_test-install_config: phony obj/camera/hal/usb/tests/_media_v4l2_test-install_config.stamp
build camera/hal/usb/tests$:all: phony obj/camera/hal/usb/tests/all.stamp
build camera/hal/usb/tests$:camera_characteristics_test: phony ./camera_characteristics_test
build camera/hal/usb/tests$:camera_dfu_test: phony ./camera_dfu_test
build camera/hal/usb/tests$:media_v4l2_test: phony ./media_v4l2_test
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/camera/hal/usb/tests/_camera_characteristics_test-install_config.stamp $
    obj/camera/hal/usb/tests/_camera_dfu_test-install_config.stamp $
    obj/camera/hal/usb/tests/_media_v4l2_test-install_config.stamp $
    obj/camera/hal/usb/tests/all.stamp $
    ./camera_characteristics_test $
    ./camera_dfu_test $
    ./media_v4l2_test $
    obj/common-mk/gn_root/root.stamp

default all
