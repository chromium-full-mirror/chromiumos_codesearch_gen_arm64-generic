ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/media-libs/cros-camera-tracing-0.0.1-r62/work/cros-camera-tracing-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _install_tracing_protos-0-install_config: phony obj/camera/tracing/_install_tracing_protos-0-install_config.stamp
build install_tracing_bin: phony obj/camera/tracing/install_tracing_bin.stamp
build install_tracing_protos: phony obj/camera/tracing/install_tracing_protos.stamp
build install_tracing_sql: phony obj/camera/tracing/install_tracing_sql.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build camera/tracing$:_install_tracing_protos-0-install_config: phony obj/camera/tracing/_install_tracing_protos-0-install_config.stamp
build camera/tracing$:all: phony obj/camera/tracing/all.stamp
build camera/tracing$:install_tracing_bin: phony obj/camera/tracing/install_tracing_bin.stamp
build camera/tracing$:install_tracing_protos: phony obj/camera/tracing/install_tracing_protos.stamp
build camera/tracing$:install_tracing_sql: phony obj/camera/tracing/install_tracing_sql.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/camera/tracing/_install_tracing_protos-0-install_config.stamp $
    obj/camera/tracing/all.stamp $
    obj/camera/tracing/install_tracing_bin.stamp $
    obj/camera/tracing/install_tracing_protos.stamp $
    obj/camera/tracing/install_tracing_sql.stamp $
    obj/common-mk/gn_root/root.stamp

default all
