rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/camera/tracing/_install_tracing_protos-0-install_config.stamp: stamp
build obj/camera/tracing/all.stamp: stamp obj/camera/tracing/install_tracing_bin.stamp obj/camera/tracing/install_tracing_protos.stamp obj/camera/tracing/install_tracing_sql.stamp
build obj/camera/tracing/install_tracing_bin.stamp: stamp
rule __camera_tracing_install_tracing_protos___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py /mnt/host/source/src/platform2/camera/tracing/archive_proto.sh /mnt/host/source/src/platform2/camera/tracing/metrics protos /build/arm64-generic/var/cache/portage/media-libs/cros-camera-tracing/out/Default/gen/camera/tracing/protos.tar.gz
  description = ACTION //camera/tracing:install_tracing_protos(//common-mk/toolchain:toolchain)
  restat = 1

build gen/camera/tracing/protos.tar.gz: __camera_tracing_install_tracing_protos___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../mnt/host/source/src/platform2/camera/tracing/metrics/protos obj/camera/tracing/_install_tracing_protos-0-install_config.stamp

build obj/camera/tracing/install_tracing_protos.stamp: stamp gen/camera/tracing/protos.tar.gz
build obj/camera/tracing/install_tracing_sql.stamp: stamp
build obj/common-mk/gn_root/root.stamp: stamp obj/camera/tracing/all.stamp
