ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/spaced-0.0.1-r935/work/spaced-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libspaced-install_config: phony obj/spaced/_libspaced-install_config.stamp
build _libspaced-test_pc-install_config: phony obj/spaced/_libspaced-test_pc-install_config.stamp
build _libspaced_pc-install_config: phony obj/spaced/_libspaced_pc-install_config.stamp
build _spaced-install_config: phony obj/spaced/_spaced-install_config.stamp
build _spaced_cli-install_config: phony obj/spaced/_spaced_cli-install_config.stamp
build install_dbus_config: phony obj/spaced/install_dbus_config.stamp
build install_headers: phony obj/spaced/install_headers.stamp
build install_init: phony obj/spaced/install_init.stamp
build install_minijail_conf: phony obj/spaced/install_minijail_conf.stamp
build libspaced: phony ./lib/libspaced.so
build libspaced-test_pc: phony obj/spaced/libspaced-test_pc.stamp
build libspaced_pc: phony obj/spaced/libspaced_pc.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build spaced_adaptor: phony obj/spaced/spaced_adaptor.stamp
build spaced_proxy: phony obj/spaced/spaced_proxy.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build spaced$:_libspaced-install_config: phony obj/spaced/_libspaced-install_config.stamp
build spaced$:_libspaced-test_pc-install_config: phony obj/spaced/_libspaced-test_pc-install_config.stamp
build spaced$:_libspaced_pc-install_config: phony obj/spaced/_libspaced_pc-install_config.stamp
build spaced$:_spaced-install_config: phony obj/spaced/_spaced-install_config.stamp
build spaced$:_spaced_cli-install_config: phony obj/spaced/_spaced_cli-install_config.stamp
build spaced$:all: phony obj/spaced/all.stamp
build spaced$:install_dbus_config: phony obj/spaced/install_dbus_config.stamp
build spaced$:install_headers: phony obj/spaced/install_headers.stamp
build spaced$:install_init: phony obj/spaced/install_init.stamp
build spaced$:install_minijail_conf: phony obj/spaced/install_minijail_conf.stamp
build spaced$:libspaced: phony ./lib/libspaced.so
build spaced$:libspaced-test_pc: phony obj/spaced/libspaced-test_pc.stamp
build spaced$:libspaced_pc: phony obj/spaced/libspaced_pc.stamp
build spaced$:spaced: phony ./spaced
build spaced$:spaced_adaptor: phony obj/spaced/spaced_adaptor.stamp
build spaced$:spaced_cli: phony ./spaced_cli
build spaced$:spaced_proxy: phony obj/spaced/spaced_proxy.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/spaced/_libspaced-install_config.stamp $
    obj/spaced/_libspaced-test_pc-install_config.stamp $
    obj/spaced/_libspaced_pc-install_config.stamp $
    obj/spaced/_spaced-install_config.stamp $
    obj/spaced/_spaced_cli-install_config.stamp $
    obj/spaced/all.stamp $
    obj/spaced/install_dbus_config.stamp $
    obj/spaced/install_headers.stamp $
    obj/spaced/install_init.stamp $
    obj/spaced/install_minijail_conf.stamp $
    ./lib/libspaced.so $
    obj/spaced/libspaced-test_pc.stamp $
    obj/spaced/libspaced_pc.stamp $
    ./spaced $
    obj/spaced/spaced_adaptor.stamp $
    ./spaced_cli $
    obj/spaced/spaced_proxy.stamp

default all
