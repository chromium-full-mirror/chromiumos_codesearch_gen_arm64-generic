  source_file_part = png.cc
  source_name_part = png
build obj/screen-capture-utils/screenshot.screenshot.o: cxx ../../../../../../../tmp/portage/chromeos-base/screen-capture-utils-0.0.1-r426/work/screen-capture-utils-0.0.1/screen-capture-utils/screenshot.cc
  source_file_part = screenshot.cc
