ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/screen-capture-utils-0.0.1-r426/work/screen-capture-utils-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _kmsvnc-install_config: phony obj/screen-capture-utils/_kmsvnc-install_config.stamp
build _screenshot-install_config: phony obj/screen-capture-utils/_screenshot-install_config.stamp
build libscreen-capture: phony ./libscreen-capture.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build screen-capture-utils$:_kmsvnc-install_config: phony obj/screen-capture-utils/_kmsvnc-install_config.stamp
build screen-capture-utils$:_screenshot-install_config: phony obj/screen-capture-utils/_screenshot-install_config.stamp
build screen-capture-utils$:all: phony obj/screen-capture-utils/all.stamp
build screen-capture-utils$:kmsvnc: phony ./kmsvnc
build screen-capture-utils$:libscreen-capture: phony ./libscreen-capture.a
build screen-capture-utils$:screenshot: phony ./screenshot

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/screen-capture-utils/_kmsvnc-install_config.stamp $
    obj/screen-capture-utils/_screenshot-install_config.stamp $
    obj/screen-capture-utils/all.stamp $
    ./kmsvnc $
    ./libscreen-capture.a $
    ./screenshot

default all
