rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/private_computing/all.stamp
subninja obj/common-mk/testrunner/testrunner.ninja
build obj/private_computing/_private_computingd-install_config.stamp: stamp
build obj/private_computing/all.stamp: stamp obj/private_computing/dbus_adaptors_generator.stamp obj/private_computing/install_init.stamp obj/private_computing/install_minijail_conf.stamp obj/private_computing/install_service.stamp obj/private_computing/install_systemd.stamp ./private_computingd ./private_computing_test
rule __private_computing_dbus_adaptors_generator___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/private_computing/out/Default/gen/include/private_computing/${source_name_part}.h -service-config=/mnt/host/source/src/platform2/private_computing/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //private_computing:dbus_adaptors_generator(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/private_computing/org.chromium.PrivateComputing.h: __private_computing_dbus_adaptors_generator___common-mk_toolchain_toolchain__rule ../../../../../../../../../mnt/host/source/src/platform2/private_computing/dbus_bindings/org.chromium.PrivateComputing.xml | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.PrivateComputing

build obj/private_computing/dbus_adaptors_generator.stamp: stamp gen/include/private_computing/org.chromium.PrivateComputing.h
build obj/private_computing/install_init.stamp: stamp
build obj/private_computing/install_minijail_conf.stamp: stamp
build obj/private_computing/install_service.stamp: stamp
build obj/private_computing/install_systemd.stamp: stamp
subninja obj/private_computing/private_computing_lib.ninja
subninja obj/private_computing/private_computing_test.ninja
subninja obj/private_computing/private_computingd.ninja
