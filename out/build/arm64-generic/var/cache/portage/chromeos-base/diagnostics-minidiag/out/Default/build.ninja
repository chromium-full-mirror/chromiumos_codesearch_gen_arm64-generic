ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/diagnostics-minidiag-0.0.1-r247/work/diagnostics-minidiag-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cros-minidiag-tool-install_config: phony obj/diagnostics/cros_minidiag/_cros-minidiag-tool-install_config.stamp
build install_upstart_config: phony obj/diagnostics/cros_minidiag/install_upstart_config.stamp
build libcros-minidiag-tool: phony obj/diagnostics/cros_minidiag/libcros-minidiag-tool.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build diagnostics/cros_minidiag$:_cros-minidiag-tool-install_config: phony obj/diagnostics/cros_minidiag/_cros-minidiag-tool-install_config.stamp
build diagnostics/cros_minidiag$:all: phony obj/diagnostics/cros_minidiag/all.stamp
build diagnostics/cros_minidiag$:cros-minidiag-tool: phony ./cros-minidiag-tool
build diagnostics/cros_minidiag$:install_upstart_config: phony obj/diagnostics/cros_minidiag/install_upstart_config.stamp
build diagnostics/cros_minidiag$:libcros-minidiag-tool: phony obj/diagnostics/cros_minidiag/libcros-minidiag-tool.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/diagnostics/cros_minidiag/_cros-minidiag-tool-install_config.stamp $
    obj/diagnostics/cros_minidiag/all.stamp $
    ./cros-minidiag-tool $
    obj/diagnostics/cros_minidiag/install_upstart_config.stamp $
    obj/diagnostics/cros_minidiag/libcros-minidiag-tool.stamp

default all
