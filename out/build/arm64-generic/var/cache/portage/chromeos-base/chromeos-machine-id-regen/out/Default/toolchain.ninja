rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/machine-id-regen/all.stamp
build obj/machine-id-regen/_machine-id-regen-install_config.stamp: stamp
build obj/machine-id-regen/all.stamp: stamp ./lib-machine-id-regen.a ./machine-id-regen obj/machine-id-regen/tmpfile_confs.stamp obj/machine-id-regen/init_confs.stamp
build obj/machine-id-regen/init_confs.stamp: stamp
subninja obj/machine-id-regen/lib-machine-id-regen.ninja
subninja obj/machine-id-regen/machine-id-regen.ninja
build obj/machine-id-regen/tmpfile_confs.stamp: stamp
rule __machine-id-regen_upstart_proxies___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/chromeos-machine-id-regen-0.0.2-r107/work/chromeos-machine-id-regen-0.0.2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -service-config= -proxy=/build/arm64-generic/var/cache/portage/chromeos-base/chromeos-machine-id-regen/out/Default/gen/include/upstart/dbus-proxies.h ../../../../../../../usr/share/dbus-1/interfaces/com.ubuntu.Upstart.xml
  description = ACTION //machine-id-regen:upstart_proxies(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/upstart/dbus-proxies.h: __machine-id-regen_upstart_proxies___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/chromeos-machine-id-regen-0.0.2-r107/work/chromeos-machine-id-regen-0.0.2/common-mk/file_generator_wrapper.py ../../../../../../../usr/share/dbus-1/interfaces/com.ubuntu.Upstart.xml

build obj/machine-id-regen/upstart_proxies.stamp: stamp gen/include/upstart/dbus-proxies.h
