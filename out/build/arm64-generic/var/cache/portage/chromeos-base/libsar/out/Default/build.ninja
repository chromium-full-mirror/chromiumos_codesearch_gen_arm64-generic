ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libsar-0.0.1-r135/work/libsar-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libsar: phony ./lib/libsar.so
build _libsar-install_config: phony obj/libsar/_libsar-install_config.stamp
build _libsar_pkg_config-install_config: phony obj/libsar/_libsar_pkg_config-install_config.stamp
build _libsar_test_support-install_config: phony obj/libsar/_libsar_test_support-install_config.stamp
build _libsar_test_support_pkg_config-install_config: phony obj/libsar/_libsar_test_support_pkg_config-install_config.stamp
build install_headers: phony obj/libsar/install_headers.stamp
build libsar_pkg_config: phony obj/libsar/libsar_pkg_config.stamp
build libsar_test_support: phony ./lib/libsar_test_support.so
build libsar_test_support_pkg_config: phony obj/libsar/libsar_test_support_pkg_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libsar$:_libsar-install_config: phony obj/libsar/_libsar-install_config.stamp
build libsar$:_libsar_pkg_config-install_config: phony obj/libsar/_libsar_pkg_config-install_config.stamp
build libsar$:_libsar_test_support-install_config: phony obj/libsar/_libsar_test_support-install_config.stamp
build libsar$:_libsar_test_support_pkg_config-install_config: phony obj/libsar/_libsar_test_support_pkg_config-install_config.stamp
build libsar$:all: phony obj/libsar/all.stamp
build libsar$:install_headers: phony obj/libsar/install_headers.stamp
build libsar$:libsar: phony ./lib/libsar.so
build libsar$:libsar_pkg_config: phony obj/libsar/libsar_pkg_config.stamp
build libsar$:libsar_test_support: phony ./lib/libsar_test_support.so
build libsar$:libsar_test_support_pkg_config: phony obj/libsar/libsar_test_support_pkg_config.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libsar/_libsar-install_config.stamp $
    obj/libsar/_libsar_pkg_config-install_config.stamp $
    obj/libsar/_libsar_test_support-install_config.stamp $
    obj/libsar/_libsar_test_support_pkg_config-install_config.stamp $
    obj/libsar/all.stamp $
    obj/libsar/install_headers.stamp $
    ./lib/libsar.so $
    obj/libsar/libsar_pkg_config.stamp $
    ./lib/libsar_test_support.so $
    obj/libsar/libsar_test_support_pkg_config.stamp

default all
