rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/libsar/all.stamp
build obj/libsar/_libsar-install_config.stamp: stamp
build obj/libsar/_libsar_pkg_config-install_config.stamp: stamp
build obj/libsar/_libsar_test_support-install_config.stamp: stamp
build obj/libsar/_libsar_test_support_pkg_config-install_config.stamp: stamp
build obj/libsar/all.stamp: stamp obj/libsar/install_headers.stamp ./lib/libsar.so obj/libsar/libsar_pkg_config.stamp ./lib/libsar_test_support.so
build obj/libsar/install_headers.stamp: stamp
subninja obj/libsar/libsar.ninja
rule __libsar_libsar_pkg_config___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/libsar-0.0.1-r147/work/libsar-0.0.1/common-mk/generate-pc.py --output /build/arm64-generic/var/cache/portage/chromeos-base/libsar/out/Default/obj/libsar/libsar.pc --name=libsar --description=Library\$ to\$ support\$ SAR\$ sensor\$ like\$ Semtech\$ SX93xx\$ components\$ for\$ ChromiumOS --version=0.1 --libs=-lsar
  description = ACTION //libsar:libsar_pkg_config(//common-mk/toolchain:toolchain)
  restat = 1

build obj/libsar/libsar.pc: __libsar_libsar_pkg_config___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/libsar-0.0.1-r147/work/libsar-0.0.1/common-mk/generate-pc.py obj/libsar/_libsar_pkg_config-install_config.stamp

build obj/libsar/libsar_pkg_config.stamp: stamp obj/libsar/libsar.pc
subninja obj/libsar/libsar_test_support.ninja
rule __libsar_libsar_test_support_pkg_config___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/libsar-0.0.1-r147/work/libsar-0.0.1/common-mk/generate-pc.py --output /build/arm64-generic/var/cache/portage/chromeos-base/libsar/out/Default/obj/libsar/libsar_test_support.pc --name=libsar_test_support --description=Test\$ helper\$ library\$ to\$ support\$ SAR\$ sensor\$ for\$ ChromiumOS --version=0.1 --libs=-lsar_test_support
  description = ACTION //libsar:libsar_test_support_pkg_config(//common-mk/toolchain:toolchain)
  restat = 1

build obj/libsar/libsar_test_support.pc: __libsar_libsar_test_support_pkg_config___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/libsar-0.0.1-r147/work/libsar-0.0.1/common-mk/generate-pc.py obj/libsar/_libsar_test_support_pkg_config-install_config.stamp

