rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/system-proxy/all.stamp
build obj/system-proxy/_system_proxy-install_config.stamp: stamp
build obj/system-proxy/_system_proxy_worker-install_config.stamp: stamp
build obj/system-proxy/all.stamp: stamp obj/system-proxy/dbus_code_generator.stamp obj/system-proxy/install_dbus_config.stamp obj/system-proxy/install_init.stamp obj/system-proxy/install_minijail_conf.stamp obj/system-proxy/install_policy.stamp obj/system-proxy/install_services.stamp ./libsystemproxy.a ./system_proxy ./system_proxy_worker ./libworker-protos.a
rule __system-proxy_dbus_code_generator___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/system-proxy-0.0.1-r643/work/system-proxy-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/system-proxy/out/Default/gen/include/system_proxy/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/system-proxy-0.0.1-r643/work/system-proxy-0.0.1/system-proxy/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //system-proxy:dbus_code_generator(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/system_proxy/org.chromium.SystemProxy.h: __system-proxy_dbus_code_generator___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/system-proxy-0.0.1-r643/work/system-proxy-0.0.1/system-proxy/dbus_bindings/org.chromium.SystemProxy.xml | ../../../../../../../tmp/portage/chromeos-base/system-proxy-0.0.1-r643/work/system-proxy-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.SystemProxy

build obj/system-proxy/dbus_code_generator.stamp: stamp gen/include/system_proxy/org.chromium.SystemProxy.h
