defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libsystemproxyworker

build obj/system-proxy/libsystemproxyworker.curl_socket.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/system-proxy/curl_socket.cc || obj/system-proxy/worker-protos_gen.stamp
  source_file_part = curl_socket.cc
  source_name_part = curl_socket
build obj/system-proxy/libsystemproxyworker.http_util.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/system-proxy/http_util.cc || obj/system-proxy/worker-protos_gen.stamp
  source_file_part = http_util.cc
  source_name_part = http_util
build obj/system-proxy/libsystemproxyworker.protobuf_util.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/system-proxy/protobuf_util.cc || obj/system-proxy/worker-protos_gen.stamp
  source_file_part = protobuf_util.cc
  source_name_part = protobuf_util
build obj/system-proxy/libsystemproxyworker.proxy_connect_job.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/system-proxy/proxy_connect_job.cc || obj/system-proxy/worker-protos_gen.stamp
  source_file_part = proxy_connect_job.cc
  source_name_part = proxy_connect_job
build obj/system-proxy/libsystemproxyworker.server_proxy.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/system-proxy/server_proxy.cc || obj/system-proxy/worker-protos_gen.stamp
  source_file_part = server_proxy.cc
  source_name_part = server_proxy

build ./libsystemproxyworker.a: alink obj/system-proxy/libsystemproxyworker.curl_socket.o obj/system-proxy/libsystemproxyworker.http_util.o obj/system-proxy/libsystemproxyworker.protobuf_util.o obj/system-proxy/libsystemproxyworker.proxy_connect_job.o obj/system-proxy/libsystemproxyworker.server_proxy.o || ./libworker-protos.a
  arflags = rcsT
  output_extension = .a
  output_dir = 
