ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/vtpm-0.0.1-r646/work/vtpm-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _vtpm_client-install_config: phony obj/vtpm/_vtpm_client-install_config.stamp
build _vtpmd-install_config: phony obj/vtpm/_vtpmd-install_config.stamp
build database_proto: phony ./libdatabase_proto.a
build database_proto_gen: phony obj/vtpm/database_proto_gen.stamp
build install_init: phony obj/vtpm/install_init.stamp
build install_minijail_conf: phony obj/vtpm/install_minijail_conf.stamp
build install_policy: phony obj/vtpm/install_policy.stamp
build install_systemd: phony obj/vtpm/install_systemd.stamp
build install_tmpfiles_config: phony obj/vtpm/install_tmpfiles_config.stamp
build interface_proto: phony ./libinterface_proto.a
build interface_proto_gen: phony obj/vtpm/interface_proto_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build vtpm-adaptors: phony obj/vtpm/vtpm-adaptors.stamp
build vtpm_proxies: phony obj/vtpm/vtpm_proxies.stamp
build vtpm_server_library: phony obj/vtpm/vtpm_server_library.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build vtpm$:_vtpm_client-install_config: phony obj/vtpm/_vtpm_client-install_config.stamp
build vtpm$:_vtpmd-install_config: phony obj/vtpm/_vtpmd-install_config.stamp
build vtpm$:all: phony obj/vtpm/all.stamp
build vtpm$:database_proto: phony ./libdatabase_proto.a
build vtpm$:database_proto_gen: phony obj/vtpm/database_proto_gen.stamp
build vtpm$:install_init: phony obj/vtpm/install_init.stamp
build vtpm$:install_minijail_conf: phony obj/vtpm/install_minijail_conf.stamp
build vtpm$:install_policy: phony obj/vtpm/install_policy.stamp
build vtpm$:install_systemd: phony obj/vtpm/install_systemd.stamp
build vtpm$:install_tmpfiles_config: phony obj/vtpm/install_tmpfiles_config.stamp
build vtpm$:interface_proto: phony ./libinterface_proto.a
build vtpm$:interface_proto_gen: phony obj/vtpm/interface_proto_gen.stamp
build vtpm$:vtpm-adaptors: phony obj/vtpm/vtpm-adaptors.stamp
build vtpm$:vtpm_client: phony ./vtpm_client
build vtpm$:vtpm_proxies: phony obj/vtpm/vtpm_proxies.stamp
build vtpm$:vtpm_server_library: phony obj/vtpm/vtpm_server_library.stamp
build vtpm$:vtpmd: phony ./vtpmd

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/vtpm/_vtpm_client-install_config.stamp $
    obj/vtpm/_vtpmd-install_config.stamp $
    obj/vtpm/all.stamp $
    ./libdatabase_proto.a $
    obj/vtpm/database_proto_gen.stamp $
    obj/vtpm/install_init.stamp $
    obj/vtpm/install_minijail_conf.stamp $
    obj/vtpm/install_policy.stamp $
    obj/vtpm/install_systemd.stamp $
    obj/vtpm/install_tmpfiles_config.stamp $
    ./libinterface_proto.a $
    obj/vtpm/interface_proto_gen.stamp $
    obj/vtpm/vtpm-adaptors.stamp $
    ./vtpm_client $
    obj/vtpm/vtpm_proxies.stamp $
    obj/vtpm/vtpm_server_library.stamp $
    ./vtpmd

default all
