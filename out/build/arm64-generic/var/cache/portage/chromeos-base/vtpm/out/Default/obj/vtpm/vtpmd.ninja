defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/attestation-client -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = vtpmd

build obj/vtpm/vtpmd.main.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/vtpm/main.cc || obj/vtpm/database_proto_gen.stamp obj/vtpm/interface_proto_gen.stamp obj/vtpm/vtpm-adaptors.stamp
  source_file_part = main.cc
  source_name_part = main

build ./vtpmd: link obj/vtpm/vtpmd.main.o obj/vtpm/backends/vtpm_server_library.attested_virtual_endorsement.o obj/vtpm/backends/vtpm_server_library.cacheable_blob.o obj/vtpm/backends/vtpm_server_library.disk_cache_blob.o obj/vtpm/backends/vtpm_server_library.endorsement_password_changer.o obj/vtpm/backends/vtpm_server_library.real_static_analyzer.o obj/vtpm/backends/vtpm_server_library.real_tpm_handle_manager.o obj/vtpm/backends/vtpm_server_library.real_tpm_property_manager.o obj/vtpm/backends/vtpm_server_library.scoped_host_key_handle.o obj/vtpm/backends/vtpm_server_library.vek.o obj/vtpm/backends/vtpm_server_library.vek_cert.o obj/vtpm/backends/vtpm_server_library.vek_cert_manager.o obj/vtpm/backends/vtpm_server_library.vsrk.o obj/vtpm/commands/vtpm_server_library.direct_forward_command.o obj/vtpm/commands/vtpm_server_library.forward_command.o obj/vtpm/commands/vtpm_server_library.get_capability_command.o obj/vtpm/commands/vtpm_server_library.null_command.o obj/vtpm/commands/vtpm_server_library.nv_read_command.o obj/vtpm/commands/vtpm_server_library.nv_read_public_command.o obj/vtpm/commands/vtpm_server_library.self_test_command.o obj/vtpm/commands/vtpm_server_library.unsupported_command.o obj/vtpm/commands/vtpm_server_library.virtualizer.o obj/vtpm/vtpm_server_library.vtpm_service.o ./libdatabase_proto.a ./libinterface_proto.a || obj/vtpm/vtpm-adaptors.stamp obj/vtpm/vtpm_server_library.stamp obj/vtpm/_vtpmd-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -L/build/arm64-generic/usr/lib64
  libs = -lhwsec-profiling -lbrillo -lbase -lpthread -lprotobuf -lsystem_api-device_management-protos -lsystem_api-hps-protos -lsystem_api-power_manager-protos -lsystem_api-authpolicy-protos -lsystem_api-protos -lsystem_api-kerberos-protos -lsystem_api-login_manager-protos -lsystem_api-lorgnette-protos -lsystem_api-smbprovider-protos -lsystem_api-vm_concierge-protos -lsystem_api-vm_applications-protos -lsystem_api-vm_launch-protos -lsystem_api-vm_sk_forwarding-protos -lsystem_api-vm_cicerone-protos -lsystem_api-seneschal-protos -lsystem_api-oobe_config-protos -lsystem_api-runtime_probe-protos -lsystem_api-dlcservice-protos -lsystem_api-update_engine-protos -lsystem_api-vm_plugin_dispatcher-protos -lsystem_api-u2f-protos -lsystem_api-chunneld-protos -lsystem_api-system_proxy-protos -lsystem_api-vm_permission_service-protos -lsystem_api-anomaly_detector-protos -lsystem_api-minios-protos -lsystem_api-dlp-protos -lsystem_api-rmad-protos -lsystem_api-fusebox-protos -lsystem_api-privacy_screen-protos -lsystem_api-cdm_oemcrypto-protos -lsystem_api-ml-protos -lsystem_api-lvmd-protos -lsystem_api-shadercached-protos -lsystem_api-spaced-protos -lsystem_api-imageloader-protos -lsystem_api -lsystem_api-arc-protos -lsystem_api-private_computing-protos -lsystem_api-arcvm_data_migrator-protos -lsystem_api-featured-protos -lsystem_api-vm_wl-protos -lsystem_api-printscanmgr-protos -lsystem_api-vm_memory_management-protos -ltpm_manager -ltrunks -lhwsec-foundation
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
