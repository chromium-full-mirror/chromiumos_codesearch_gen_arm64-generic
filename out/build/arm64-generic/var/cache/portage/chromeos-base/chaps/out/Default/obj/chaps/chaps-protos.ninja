defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/chaps/proto_bindings -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -DVCSID=\"9999-3ebbb89bcc9f6b02863d0181a9ee6f5bac38a8d9\" -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libchaps-protos

build obj/gen/include/chaps/proto_bindings/libchaps-protos.attributes.pb.o: cxx gen/include/chaps/proto_bindings/attributes.pb.cc || obj/chaps/chaps-protos_gen.stamp
  source_file_part = attributes.pb.cc
  source_name_part = attributes.pb

build ./libchaps-protos.a: alink obj/gen/include/chaps/proto_bindings/libchaps-protos.attributes.pb.o || obj/chaps/chaps-protos_gen.stamp
  arflags = rcs
  output_extension = .a
  output_dir = 
