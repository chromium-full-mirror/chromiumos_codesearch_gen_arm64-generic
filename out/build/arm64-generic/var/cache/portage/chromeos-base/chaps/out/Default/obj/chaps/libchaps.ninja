defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_TPM_INSECURE_FALLBACK=false -DUSE_FUZZER=false
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/chaps-0.0.1-r4318/work/chaps-0.0.1 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = libchaps


build ./lib/libchaps.so: solink obj/chaps/libchaps_source_set.attributes.o obj/chaps/libchaps_source_set.chaps.o obj/chaps/libchaps_source_set.chaps_proxy.o obj/chaps/libchaps_source_set.chaps_utility.o obj/chaps/libchaps_source_set.isolate_chromeos.o obj/chaps/libchaps_source_set.proto_conversion.o obj/chaps/libchaps_source_set.token_manager_client.o || obj/chaps/libchaps_source_set.stamp obj/chaps/_libchaps-install_config.stamp
