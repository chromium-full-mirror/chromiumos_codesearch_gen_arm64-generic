ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libmems-0.0.1-r518/work/libmems-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libmems: phony ./lib/libmems.so
build _libmems-install_config: phony obj/libmems/_libmems-install_config.stamp
build _libmems_pkg_config-install_config: phony obj/libmems/_libmems_pkg_config-install_config.stamp
build _libmems_test_support-install_config: phony obj/libmems/_libmems_test_support-install_config.stamp
build _libmems_test_support_pkg_config-install_config: phony obj/libmems/_libmems_test_support_pkg_config-install_config.stamp
build install_headers: phony obj/libmems/install_headers.stamp
build libmems_pkg_config: phony obj/libmems/libmems_pkg_config.stamp
build libmems_test_support: phony ./lib/libmems_test_support.so
build libmems_test_support_pkg_config: phony obj/libmems/libmems_test_support_pkg_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libmems$:_libmems-install_config: phony obj/libmems/_libmems-install_config.stamp
build libmems$:_libmems_pkg_config-install_config: phony obj/libmems/_libmems_pkg_config-install_config.stamp
build libmems$:_libmems_test_support-install_config: phony obj/libmems/_libmems_test_support-install_config.stamp
build libmems$:_libmems_test_support_pkg_config-install_config: phony obj/libmems/_libmems_test_support_pkg_config-install_config.stamp
build libmems$:all: phony obj/libmems/all.stamp
build libmems$:install_headers: phony obj/libmems/install_headers.stamp
build libmems$:libmems: phony ./lib/libmems.so
build libmems$:libmems_pkg_config: phony obj/libmems/libmems_pkg_config.stamp
build libmems$:libmems_test_support: phony ./lib/libmems_test_support.so
build libmems$:libmems_test_support_pkg_config: phony obj/libmems/libmems_test_support_pkg_config.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libmems/_libmems-install_config.stamp $
    obj/libmems/_libmems_pkg_config-install_config.stamp $
    obj/libmems/_libmems_test_support-install_config.stamp $
    obj/libmems/_libmems_test_support_pkg_config-install_config.stamp $
    obj/libmems/all.stamp $
    obj/libmems/install_headers.stamp $
    ./lib/libmems.so $
    obj/libmems/libmems_pkg_config.stamp $
    ./lib/libmems_test_support.so $
    obj/libmems/libmems_test_support_pkg_config.stamp

default all
