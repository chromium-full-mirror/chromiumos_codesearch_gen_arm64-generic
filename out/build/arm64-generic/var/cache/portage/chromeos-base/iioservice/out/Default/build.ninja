ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/iioservice-0.0.1-r769/work/iioservice-0.0.1/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _iioservice-install_config: phony obj/iioservice/daemon/_iioservice-install_config.stamp
build install_dbus_conf: phony obj/iioservice/daemon/install_dbus_conf.stamp
build install_init_conf: phony obj/iioservice/daemon/install_init_conf.stamp
build install_minijail_conf: phony obj/iioservice/daemon/install_minijail_conf.stamp
build install_policy: phony obj/iioservice/daemon/install_policy.stamp
build install_seccomp_policy: phony obj/iioservice/daemon/install_seccomp_policy.stamp
build libiioservice: phony ./libiioservice.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build iioservice/daemon$:_iioservice-install_config: phony obj/iioservice/daemon/_iioservice-install_config.stamp
build iioservice/daemon$:all: phony obj/iioservice/daemon/all.stamp
build iioservice/daemon$:iioservice: phony ./iioservice
build iioservice/daemon$:install_dbus_conf: phony obj/iioservice/daemon/install_dbus_conf.stamp
build iioservice/daemon$:install_init_conf: phony obj/iioservice/daemon/install_init_conf.stamp
build iioservice/daemon$:install_minijail_conf: phony obj/iioservice/daemon/install_minijail_conf.stamp
build iioservice/daemon$:install_policy: phony obj/iioservice/daemon/install_policy.stamp
build iioservice/daemon$:install_seccomp_policy: phony obj/iioservice/daemon/install_seccomp_policy.stamp
build iioservice/daemon$:libiioservice: phony ./libiioservice.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/iioservice/daemon/_iioservice-install_config.stamp $
    obj/iioservice/daemon/all.stamp $
    ./iioservice $
    obj/iioservice/daemon/install_dbus_conf.stamp $
    obj/iioservice/daemon/install_init_conf.stamp $
    obj/iioservice/daemon/install_minijail_conf.stamp $
    obj/iioservice/daemon/install_policy.stamp $
    obj/iioservice/daemon/install_seccomp_policy.stamp $
    ./libiioservice.a

default all
