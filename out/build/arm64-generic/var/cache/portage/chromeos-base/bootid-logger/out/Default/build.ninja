ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/bootid-logger-0.0.1-r412/work/bootid-logger-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _bootid-logger-install_config: phony obj/bootid-logger/_bootid-logger-install_config.stamp
build _croslog-install_config: phony obj/croslog/_croslog-install_config.stamp
build _log-metrics-collector-install_config: phony obj/croslog/_log-metrics-collector-install_config.stamp
build _log_rotator-install_config: phony obj/croslog/log_rotator/_log_rotator-install_config.stamp
build bootid_logger_lib: phony ./libbootid_logger_lib.a
build install_init_config: phony obj/bootid-logger/install_init_config.stamp
build libcroslog_static: phony ./libcroslog_static.a
build log_constants: phony obj/croslog/log_constants.stamp
build log_rotator_static: phony ./liblog_rotator_static.a
build root: phony obj/common-mk/gn_root/root.stamp
build bootid-logger$:_bootid-logger-install_config: phony obj/bootid-logger/_bootid-logger-install_config.stamp
build bootid-logger$:all: phony obj/bootid-logger/all.stamp
build bootid-logger$:bootid-logger: phony ./bootid-logger
build bootid-logger$:bootid_logger_lib: phony ./libbootid_logger_lib.a
build bootid-logger$:install_init_config: phony obj/bootid-logger/install_init_config.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build croslog$:_croslog-install_config: phony obj/croslog/_croslog-install_config.stamp
build croslog$:_log-metrics-collector-install_config: phony obj/croslog/_log-metrics-collector-install_config.stamp
build croslog$:all: phony obj/croslog/all.stamp
build croslog$:croslog: phony ./croslog
build croslog$:libcroslog_static: phony ./libcroslog_static.a
build croslog$:log-metrics-collector: phony ./log-metrics-collector
build croslog$:log_constants: phony obj/croslog/log_constants.stamp
build croslog/log_rotator$:_log_rotator-install_config: phony obj/croslog/log_rotator/_log_rotator-install_config.stamp
build croslog/log_rotator$:all: phony obj/croslog/log_rotator/all.stamp
build croslog/log_rotator$:log_rotator: phony ./log_rotator
build croslog/log_rotator: phony ./log_rotator
build croslog/log_rotator$:log_rotator_static: phony ./liblog_rotator_static.a

build all: phony $
    obj/bootid-logger/_bootid-logger-install_config.stamp $
    obj/bootid-logger/all.stamp $
    ./bootid-logger $
    ./libbootid_logger_lib.a $
    obj/bootid-logger/install_init_config.stamp $
    obj/common-mk/gn_root/root.stamp $
    obj/croslog/_croslog-install_config.stamp $
    obj/croslog/_log-metrics-collector-install_config.stamp $
    obj/croslog/all.stamp $
    ./croslog $
    ./libcroslog_static.a $
    ./log-metrics-collector $
    obj/croslog/log_constants.stamp $
    obj/croslog/log_rotator/_log_rotator-install_config.stamp $
    obj/croslog/log_rotator/all.stamp $
    ./log_rotator $
    ./liblog_rotator_static.a

default all
