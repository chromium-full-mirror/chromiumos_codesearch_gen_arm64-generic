ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/lorgnette-client-0.0.1-r135/work/lorgnette-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _liblorgnette-client-test.pc-install_config: phony obj/lorgnette/client/_liblorgnette-client-test.pc-install_config.stamp
build _liblorgnette-client.pc-install_config: phony obj/lorgnette/client/_liblorgnette-client.pc-install_config.stamp
build liblorgnette-client-headers: phony obj/lorgnette/client/liblorgnette-client-headers.stamp
build liblorgnette-client-test.pc: phony obj/lorgnette/client/liblorgnette-client-test.pc.stamp
build liblorgnette-client.pc: phony obj/lorgnette/client/liblorgnette-client.pc.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build lorgnette/client$:_liblorgnette-client-test.pc-install_config: phony obj/lorgnette/client/_liblorgnette-client-test.pc-install_config.stamp
build lorgnette/client$:_liblorgnette-client.pc-install_config: phony obj/lorgnette/client/_liblorgnette-client.pc-install_config.stamp
build lorgnette/client$:all: phony obj/lorgnette/client/all.stamp
build lorgnette/client$:liblorgnette-client-headers: phony obj/lorgnette/client/liblorgnette-client-headers.stamp
build lorgnette/client$:liblorgnette-client-test.pc: phony obj/lorgnette/client/liblorgnette-client-test.pc.stamp
build lorgnette/client$:liblorgnette-client.pc: phony obj/lorgnette/client/liblorgnette-client.pc.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/lorgnette/client/_liblorgnette-client-test.pc-install_config.stamp $
    obj/lorgnette/client/_liblorgnette-client.pc-install_config.stamp $
    obj/lorgnette/client/all.stamp $
    obj/lorgnette/client/liblorgnette-client-headers.stamp $
    obj/lorgnette/client/liblorgnette-client-test.pc.stamp $
    obj/lorgnette/client/liblorgnette-client.pc.stamp

default all
