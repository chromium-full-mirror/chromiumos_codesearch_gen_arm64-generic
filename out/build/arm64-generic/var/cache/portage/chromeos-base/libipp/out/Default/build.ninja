ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libipp: phony ./lib/libipp.so
build _libipp-install_config: phony obj/libipp/_libipp-install_config.stamp
build install_headers: phony obj/libipp/install_headers.stamp
build install_pkgconfig: phony obj/libipp/install_pkgconfig.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build libipp$:_libipp-install_config: phony obj/libipp/_libipp-install_config.stamp
build libipp$:all: phony obj/libipp/all.stamp
build libipp$:install_headers: phony obj/libipp/install_headers.stamp
build libipp$:install_pkgconfig: phony obj/libipp/install_pkgconfig.stamp
build libipp$:libipp: phony ./lib/libipp.so
build libipp$:libipp_test: phony ./libipp_test

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/libipp/_libipp-install_config.stamp $
    obj/libipp/all.stamp $
    obj/libipp/install_headers.stamp $
    obj/libipp/install_pkgconfig.stamp $
    ./lib/libipp.so $
    ./libipp_test

default all
