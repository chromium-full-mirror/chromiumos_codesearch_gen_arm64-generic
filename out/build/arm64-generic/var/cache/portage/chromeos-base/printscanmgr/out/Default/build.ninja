ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/printscanmgr-0.0.1-r203/work/printscanmgr-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _printscanmgr-install_config: phony obj/printscanmgr/_printscanmgr-install_config.stamp
build _seccomp_policy-check_seccomp: phony obj/printscanmgr/seccomp/_seccomp_policy-check_seccomp.stamp
build cups_uri_helper_utils: phony obj/printscanmgr/cups_uri_helper/cups_uri_helper_utils.stamp
build dbus_config: phony obj/printscanmgr/dbus/dbus_config.stamp
build dbus_service: phony obj/printscanmgr/dbus_service/dbus_service.stamp
build init_config: phony obj/printscanmgr/init/init_config.stamp
build libdaemon: phony obj/printscanmgr/daemon/libdaemon.stamp
build libexecutor: phony obj/printscanmgr/executor/libexecutor.stamp
build libminijail: phony obj/printscanmgr/minijail/libminijail.stamp
build mojo_bindings: phony ./libmojo_bindings.a
build mojo_bindings_gen: phony obj/printscanmgr/mojom/mojo_bindings_gen.stamp
build mojo_bindings_gen_mojo_templates: phony obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates.stamp
build mojo_bindings_gen_mojo_templates_dir: phony obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates_dir.stamp
build mojo_bindings_gen_parse: phony obj/printscanmgr/mojom/mojo_bindings_gen_parse.stamp
build printscanmgr-adaptors: phony obj/printscanmgr/dbus_bindings/printscanmgr-adaptors.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build seccomp_policy: phony obj/printscanmgr/seccomp/seccomp_policy.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build printscanmgr$:_printscanmgr-install_config: phony obj/printscanmgr/_printscanmgr-install_config.stamp
build printscanmgr$:all: phony obj/printscanmgr/all.stamp
build printscanmgr$:printscanmgr: phony ./printscanmgr
build printscanmgr/cups_uri_helper$:cups_uri_helper_utils: phony obj/printscanmgr/cups_uri_helper/cups_uri_helper_utils.stamp
build printscanmgr/daemon$:libdaemon: phony obj/printscanmgr/daemon/libdaemon.stamp
build printscanmgr/dbus$:dbus_config: phony obj/printscanmgr/dbus/dbus_config.stamp
build printscanmgr/dbus_bindings$:printscanmgr-adaptors: phony obj/printscanmgr/dbus_bindings/printscanmgr-adaptors.stamp
build printscanmgr/dbus_service$:dbus_service: phony obj/printscanmgr/dbus_service/dbus_service.stamp
build printscanmgr/dbus_service: phony obj/printscanmgr/dbus_service/dbus_service.stamp
build printscanmgr/executor$:libexecutor: phony obj/printscanmgr/executor/libexecutor.stamp
build printscanmgr/init$:init_config: phony obj/printscanmgr/init/init_config.stamp
build printscanmgr/minijail$:libminijail: phony obj/printscanmgr/minijail/libminijail.stamp
build printscanmgr/mojom$:mojo_bindings: phony ./libmojo_bindings.a
build printscanmgr/mojom$:mojo_bindings_gen: phony obj/printscanmgr/mojom/mojo_bindings_gen.stamp
build printscanmgr/mojom$:mojo_bindings_gen_mojo_templates: phony obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates.stamp
build printscanmgr/mojom$:mojo_bindings_gen_mojo_templates_dir: phony obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates_dir.stamp
build printscanmgr/mojom$:mojo_bindings_gen_parse: phony obj/printscanmgr/mojom/mojo_bindings_gen_parse.stamp
build printscanmgr/seccomp$:_seccomp_policy-check_seccomp: phony obj/printscanmgr/seccomp/_seccomp_policy-check_seccomp.stamp
build printscanmgr/seccomp$:seccomp_policy: phony obj/printscanmgr/seccomp/seccomp_policy.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/printscanmgr/_printscanmgr-install_config.stamp $
    obj/printscanmgr/all.stamp $
    ./printscanmgr $
    obj/printscanmgr/cups_uri_helper/cups_uri_helper_utils.stamp $
    obj/printscanmgr/daemon/libdaemon.stamp $
    obj/printscanmgr/dbus/dbus_config.stamp $
    obj/printscanmgr/dbus_bindings/printscanmgr-adaptors.stamp $
    obj/printscanmgr/dbus_service/dbus_service.stamp $
    obj/printscanmgr/executor/libexecutor.stamp $
    obj/printscanmgr/init/init_config.stamp $
    obj/printscanmgr/minijail/libminijail.stamp $
    ./libmojo_bindings.a $
    obj/printscanmgr/mojom/mojo_bindings_gen.stamp $
    obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates.stamp $
    obj/printscanmgr/mojom/mojo_bindings_gen_mojo_templates_dir.stamp $
    obj/printscanmgr/mojom/mojo_bindings_gen_parse.stamp $
    obj/printscanmgr/seccomp/_seccomp_policy-check_seccomp.stamp $
    obj/printscanmgr/seccomp/seccomp_policy.stamp

default all
