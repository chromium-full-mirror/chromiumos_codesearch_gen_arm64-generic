ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/policy_utils-0.0.1-r519/work/policy_utils-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _policy-install_config: phony obj/policy_utils/_policy-install_config.stamp
build libmgmt: phony ./libmgmt.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build policy_utils$:_policy-install_config: phony obj/policy_utils/_policy-install_config.stamp
build policy_utils$:all: phony obj/policy_utils/all.stamp
build policy_utils$:libmgmt: phony ./libmgmt.a
build policy_utils$:policy: phony ./policy

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/policy_utils/_policy-install_config.stamp $
    obj/policy_utils/all.stamp $
    ./libmgmt.a $
    ./policy

default all
