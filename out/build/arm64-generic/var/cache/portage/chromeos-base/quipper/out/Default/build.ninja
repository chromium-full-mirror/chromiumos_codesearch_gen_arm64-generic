ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/quipper-0.0.1-r2965/work/quipper-0.0.1/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build common: phony ./libcommon.a
build common_test: phony ./libcommon_test.a
build conversion_utils: phony ./libconversion_utils.a
build perf_data_proto: phony ./libperf_data_proto.a
build perf_data_proto_gen: phony obj/chromiumos-wide-profiling/perf_data_proto_gen.stamp
build perf_parser_options_proto: phony ./libperf_parser_options_proto.a
build perf_parser_options_proto_gen: phony obj/chromiumos-wide-profiling/perf_parser_options_proto_gen.stamp
build perf_stat_proto: phony ./libperf_stat_proto.a
build perf_stat_proto_gen: phony obj/chromiumos-wide-profiling/perf_stat_proto_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build chromiumos-wide-profiling$:all: phony obj/chromiumos-wide-profiling/all.stamp
build chromiumos-wide-profiling$:common: phony ./libcommon.a
build chromiumos-wide-profiling$:common_test: phony ./libcommon_test.a
build chromiumos-wide-profiling$:conversion_utils: phony ./libconversion_utils.a
build chromiumos-wide-profiling$:perf_converter: phony ./perf_converter
build chromiumos-wide-profiling$:perf_data_proto: phony ./libperf_data_proto.a
build chromiumos-wide-profiling$:perf_data_proto_gen: phony obj/chromiumos-wide-profiling/perf_data_proto_gen.stamp
build chromiumos-wide-profiling$:perf_parser_options_proto: phony ./libperf_parser_options_proto.a
build chromiumos-wide-profiling$:perf_parser_options_proto_gen: phony obj/chromiumos-wide-profiling/perf_parser_options_proto_gen.stamp
build chromiumos-wide-profiling$:perf_stat_proto: phony ./libperf_stat_proto.a
build chromiumos-wide-profiling$:perf_stat_proto_gen: phony obj/chromiumos-wide-profiling/perf_stat_proto_gen.stamp
build chromiumos-wide-profiling$:quipper: phony ./quipper
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/chromiumos-wide-profiling/all.stamp $
    ./libcommon.a $
    ./libcommon_test.a $
    ./libconversion_utils.a $
    ./perf_converter $
    ./libperf_data_proto.a $
    obj/chromiumos-wide-profiling/perf_data_proto_gen.stamp $
    ./libperf_parser_options_proto.a $
    obj/chromiumos-wide-profiling/perf_parser_options_proto_gen.stamp $
    ./libperf_stat_proto.a $
    obj/chromiumos-wide-profiling/perf_stat_proto_gen.stamp $
    ./quipper $
    obj/common-mk/gn_root/root.stamp

default all
