rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/bootlockbox/client/all.stamp: stamp obj/bootlockbox/client/bootlockbox-proxies.stamp ./lib/libbootlockbox-client.so
subninja obj/bootlockbox/client/bootlockbox-proto.ninja
rule __bootlockbox_client_bootlockbox-proto_gen___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/bootlockbox-client-0.0.1-r2250/work/bootlockbox-client-0.0.1/common-mk/file_generator_wrapper.py protoc key_value_map.proto --proto_path /build/arm64-generic/tmp/portage/chromeos-base/bootlockbox-client-0.0.1-r2250/work/bootlockbox-client-0.0.1/bootlockbox --proto_path /build/arm64-generic/usr/share/proto --proto_path /build/arm64-generic/var/cache/portage/chromeos-base/bootlockbox-client/out/Default/gen/bootlockbox/client --cpp_out=/build/arm64-generic/var/cache/portage/chromeos-base/bootlockbox-client/out/Default/gen/include/bootlockbox
  description = ACTION //bootlockbox/client:bootlockbox-proto_gen(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/bootlockbox/key_value_map.pb.cc gen/include/bootlockbox/key_value_map.pb.h: __bootlockbox_client_bootlockbox-proto_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/bootlockbox-client-0.0.1-r2250/work/bootlockbox-client-0.0.1/common-mk/file_generator_wrapper.py ../../../../../../../tmp/portage/chromeos-base/bootlockbox-client-0.0.1-r2250/work/bootlockbox-client-0.0.1/bootlockbox/key_value_map.proto

build obj/bootlockbox/client/bootlockbox-proto_gen.stamp: stamp gen/include/bootlockbox/key_value_map.pb.cc gen/include/bootlockbox/key_value_map.pb.h
