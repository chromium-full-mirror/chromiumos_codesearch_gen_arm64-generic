ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/bootlockbox-client-0.0.1-r2255/work/bootlockbox-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build bootlockbox-proto: phony ./libbootlockbox-proto.a
build bootlockbox-proto_gen: phony obj/bootlockbox/client/bootlockbox-proto_gen.stamp
build bootlockbox-proxies: phony obj/bootlockbox/client/bootlockbox-proxies.stamp
build libbootlockbox-client: phony ./lib/libbootlockbox-client.so
build root: phony obj/common-mk/gn_root/root.stamp
build bootlockbox/client$:all: phony obj/bootlockbox/client/all.stamp
build bootlockbox/client$:bootlockbox-proto: phony ./libbootlockbox-proto.a
build bootlockbox/client$:bootlockbox-proto_gen: phony obj/bootlockbox/client/bootlockbox-proto_gen.stamp
build bootlockbox/client$:bootlockbox-proxies: phony obj/bootlockbox/client/bootlockbox-proxies.stamp
build bootlockbox/client$:libbootlockbox-client: phony ./lib/libbootlockbox-client.so
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/bootlockbox/client/all.stamp $
    ./libbootlockbox-proto.a $
    obj/bootlockbox/client/bootlockbox-proto_gen.stamp $
    obj/bootlockbox/client/bootlockbox-proxies.stamp $
    ./lib/libbootlockbox-client.so $
    obj/common-mk/gn_root/root.stamp

default all
