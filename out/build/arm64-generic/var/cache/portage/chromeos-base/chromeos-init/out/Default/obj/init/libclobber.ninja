defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DIRENCRYPTION=true -DUSE_ENCRYPTED_REBOOT_VAULT=true -DUSE_ENCRYPTED_STATEFUL=true -DUSE_FSVERITY=false -DUSE_LVM_MIGRATION=false -DUSE_LVM_STATEFUL_PARTITION=false -DUSE_PRJQUOTA=false -DUSE_TPM2=true
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -DUSE_RTTI_FOR_TYPE_TAGS=1 -Wno-unused-local-typedefs -DBASE_VER=1211970 -Wno-unused-local-typedefs -DBASE_VER=1211970 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -pthread
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libclobber

build obj/init/libclobber.clobber_state.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/init/clobber_state.cc
  source_file_part = clobber_state.cc
  source_name_part = clobber_state
build obj/init/libclobber.clobber_state_log.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/init/clobber_state_log.cc
  source_file_part = clobber_state_log.cc
  source_name_part = clobber_state_log
build obj/init/libclobber.clobber_ui.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/init/clobber_ui.cc
  source_file_part = clobber_ui.cc
  source_name_part = clobber_ui

build ./libclobber.a: alink obj/init/libclobber.clobber_state.o obj/init/libclobber.clobber_state_log.o obj/init/libclobber.clobber_ui.o || ./libutils.a
  arflags = rcsT
  output_extension = .a
  output_dir = 
