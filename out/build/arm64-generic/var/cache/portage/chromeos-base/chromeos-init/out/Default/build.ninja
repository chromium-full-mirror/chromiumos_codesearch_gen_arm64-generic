ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/chromeos-init-0.0.26-r5169/work/chromeos-init-0.0.26 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build file_attrs_cleaner_lib: phony ./libfile_attrs_cleaner_lib.a
build install_setuid_restriction: phony obj/init/install_setuid_restriction.stamp
build libclobber: phony ./libclobber.a
build libcrosstartup: phony ./libcrosstartup.a
build process_killer_lib: phony ./libprocess_killer_lib.a
build root: phony obj/common-mk/gn_root/root.stamp
build usermode-helper_lib: phony ./libusermode-helper_lib.a
build usr_share_cros_init_scripts: phony obj/init/usr_share_cros_init_scripts.stamp
build utils: phony ./libutils.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build init$:all: phony obj/init/all.stamp
build init$:chromeos_startup: phony ./chromeos_startup
build init$:clobber-state: phony ./clobber-state
build init$:cros_sysrq_init: phony ./cros_sysrq_init
build init$:file_attrs_cleaner_lib: phony ./libfile_attrs_cleaner_lib.a
build init$:file_attrs_cleaner_tool: phony ./file_attrs_cleaner_tool
build init$:install_setuid_restriction: phony obj/init/install_setuid_restriction.stamp
build init$:libclobber: phony ./libclobber.a
build init$:libcrosstartup: phony ./libcrosstartup.a
build init$:net_poll_tool: phony ./net_poll_tool
build init$:periodic_scheduler: phony ./periodic_scheduler
build init$:process_killer: phony ./process_killer
build init$:process_killer_lib: phony ./libprocess_killer_lib.a
build init$:static_node_tool: phony ./static_node_tool
build init$:usermode-helper: phony ./usermode-helper
build init$:usermode-helper_lib: phony ./libusermode-helper_lib.a
build init$:usr_share_cros_init_scripts: phony obj/init/usr_share_cros_init_scripts.stamp
build init$:utils: phony ./libutils.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/init/all.stamp $
    ./chromeos_startup $
    ./clobber-state $
    ./cros_sysrq_init $
    ./libfile_attrs_cleaner_lib.a $
    ./file_attrs_cleaner_tool $
    obj/init/install_setuid_restriction.stamp $
    ./libclobber.a $
    ./libcrosstartup.a $
    ./net_poll_tool $
    ./periodic_scheduler $
    ./process_killer $
    ./libprocess_killer_lib.a $
    ./static_node_tool $
    ./usermode-helper $
    ./libusermode-helper_lib.a $
    obj/init/usr_share_cros_init_scripts.stamp $
    ./libutils.a

default all
