rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/init/all.stamp
build obj/init/all.stamp: stamp ./chromeos_startup ./clobber-state ./cros_sysrq_init ./file_attrs_cleaner_tool ./net_poll_tool ./periodic_scheduler ./process_killer ./static_node_tool ./usermode-helper obj/init/usr_share_cros_init_scripts.stamp
subninja obj/init/chromeos_startup.ninja
subninja obj/init/clobber-state.ninja
subninja obj/init/cros_sysrq_init.ninja
subninja obj/init/file_attrs_cleaner_lib.ninja
subninja obj/init/file_attrs_cleaner_tool.ninja
subninja obj/init/libclobber.ninja
subninja obj/init/libcrosstartup.ninja
subninja obj/init/net_poll_tool.ninja
subninja obj/init/periodic_scheduler.ninja
subninja obj/init/process_killer.ninja
subninja obj/init/process_killer_lib.ninja
subninja obj/init/static_node_tool.ninja
subninja obj/init/usermode-helper.ninja
subninja obj/init/usermode-helper_lib.ninja
build obj/init/usr_share_cros_init_scripts.stamp: stamp
subninja obj/init/utils.ninja
