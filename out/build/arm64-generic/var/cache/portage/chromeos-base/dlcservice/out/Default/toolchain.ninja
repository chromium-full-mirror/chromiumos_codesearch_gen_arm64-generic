rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/dlcservice/all.stamp
build obj/dlcservice/_dlc_metadata_util-install_config.stamp: stamp
build obj/dlcservice/_dlcservice-install_config.stamp: stamp
build obj/dlcservice/_dlcservice_util-install_config.stamp: stamp
build obj/dlcservice/_dlcverify-install_config.stamp: stamp
build obj/dlcservice/_libdlcservice-utils-install_config.stamp: stamp
build obj/dlcservice/all.stamp: stamp ./dlc_metadata_util ./dlcservice obj/dlcservice/dlcservice_adaptors.stamp ./dlcservice_util ./dlcverify obj/dlcservice/install_dbus_config.stamp obj/dlcservice/install_dlctool.stamp obj/dlcservice/install_minijail_conf.stamp obj/dlcservice/install_seccomp_policy.stamp obj/dlcservice/install_upstart_conf.stamp obj/dlcservice/install_utils_header.stamp obj/dlcservice/install_utils_pkgconfig.stamp ./libdlcservice.a ./libdlcservice_utils.a
subninja obj/dlcservice/dlc_metadata_util.ninja
subninja obj/dlcservice/dlcservice.ninja
rule __dlcservice_dlcservice_adaptors___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/dlcservice-0.0.1-r1186/work/dlcservice-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/dlcservice/out/Default/gen/include/dlcservice/dbus_adaptors/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/dlcservice-0.0.1-r1186/work/dlcservice-0.0.1/dlcservice/dbus_adaptors/dbus-service-config.json ${in}
  description = ACTION //dlcservice:dlcservice_adaptors(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/dlcservice/dbus_adaptors/org.chromium.DlcServiceInterface.h: __dlcservice_dlcservice_adaptors___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/dlcservice-0.0.1-r1186/work/dlcservice-0.0.1/dlcservice/dbus_adaptors/org.chromium.DlcServiceInterface.xml | ../../../../../../../tmp/portage/chromeos-base/dlcservice-0.0.1-r1186/work/dlcservice-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.DlcServiceInterface

build obj/dlcservice/dlcservice_adaptors.stamp: stamp gen/include/dlcservice/dbus_adaptors/org.chromium.DlcServiceInterface.h
subninja obj/dlcservice/dlcservice_util.ninja
subninja obj/dlcservice/dlcverify.ninja
build obj/dlcservice/install_dbus_config.stamp: stamp
build obj/dlcservice/install_dlctool.stamp: stamp
build obj/dlcservice/install_minijail_conf.stamp: stamp
build obj/dlcservice/install_seccomp_policy.stamp: stamp
build obj/dlcservice/install_upstart_conf.stamp: stamp
build obj/dlcservice/install_utils_header.stamp: stamp
build obj/dlcservice/install_utils_pkgconfig.stamp: stamp
subninja obj/dlcservice/libdlcservice.ninja
subninja obj/dlcservice/libdlcservice-utils.ninja
subninja obj/dlcservice/libdlcservice_utils.ninja
subninja obj/dlcservice/libdlcverify.ninja
