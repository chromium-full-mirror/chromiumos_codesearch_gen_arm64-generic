ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/hardware_verifier-0.0.1-r1012/work/hardware_verifier-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _hardware_verifier-install_config: phony obj/hardware_verifier/_hardware_verifier-install_config.stamp
build dbus-adaptors: phony obj/hardware_verifier/dbus-adaptors.stamp
build hardware_verifier-goprotos: phony obj/hardware_verifier/proto/hardware_verifier-goprotos.stamp
build hardware_verifier-protos: phony ./libhardware_verifier-protos.a
build hardware_verifier-protos_gen: phony obj/hardware_verifier/proto/hardware_verifier-protos_gen.stamp
build install_dbus_config: phony obj/hardware_verifier/install_dbus_config.stamp
build install_dbus_service: phony obj/hardware_verifier/install_dbus_service.stamp
build install_init_config: phony obj/hardware_verifier/install_init_config.stamp
build install_minijail_config: phony obj/hardware_verifier/install_minijail_config.stamp
build install_minijail_dbus_config: phony obj/hardware_verifier/install_minijail_dbus_config.stamp
build libhardware_verifier: phony ./libhardware_verifier.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build hardware_verifier$:_hardware_verifier-install_config: phony obj/hardware_verifier/_hardware_verifier-install_config.stamp
build hardware_verifier$:all: phony obj/hardware_verifier/all.stamp
build hardware_verifier$:dbus-adaptors: phony obj/hardware_verifier/dbus-adaptors.stamp
build hardware_verifier$:hardware_verifier: phony ./hardware_verifier
build hardware_verifier$:install_dbus_config: phony obj/hardware_verifier/install_dbus_config.stamp
build hardware_verifier$:install_dbus_service: phony obj/hardware_verifier/install_dbus_service.stamp
build hardware_verifier$:install_init_config: phony obj/hardware_verifier/install_init_config.stamp
build hardware_verifier$:install_minijail_config: phony obj/hardware_verifier/install_minijail_config.stamp
build hardware_verifier$:install_minijail_dbus_config: phony obj/hardware_verifier/install_minijail_dbus_config.stamp
build hardware_verifier$:libhardware_verifier: phony ./libhardware_verifier.a
build hardware_verifier/proto$:all: phony obj/hardware_verifier/proto/all.stamp
build hardware_verifier/proto$:hardware_verifier-goprotos: phony obj/hardware_verifier/proto/hardware_verifier-goprotos.stamp
build hardware_verifier/proto$:hardware_verifier-protos: phony ./libhardware_verifier-protos.a
build hardware_verifier/proto$:hardware_verifier-protos_gen: phony obj/hardware_verifier/proto/hardware_verifier-protos_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/hardware_verifier/_hardware_verifier-install_config.stamp $
    obj/hardware_verifier/all.stamp $
    obj/hardware_verifier/dbus-adaptors.stamp $
    ./hardware_verifier $
    obj/hardware_verifier/install_dbus_config.stamp $
    obj/hardware_verifier/install_dbus_service.stamp $
    obj/hardware_verifier/install_init_config.stamp $
    obj/hardware_verifier/install_minijail_config.stamp $
    obj/hardware_verifier/install_minijail_dbus_config.stamp $
    ./libhardware_verifier.a $
    obj/hardware_verifier/proto/all.stamp $
    obj/hardware_verifier/proto/hardware_verifier-goprotos.stamp $
    ./libhardware_verifier-protos.a $
    obj/hardware_verifier/proto/hardware_verifier-protos_gen.stamp

default all
