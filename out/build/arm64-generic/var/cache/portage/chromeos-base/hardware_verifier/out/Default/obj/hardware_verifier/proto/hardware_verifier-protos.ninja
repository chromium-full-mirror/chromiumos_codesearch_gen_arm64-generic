defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/hardware_verifier -Igen/include -I../../../../../../../tmp/portage/chromeos-base/hardware_verifier-0.0.1-r1029/work/hardware_verifier-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/runtime_probe/proto_bindings
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libhardware_verifier-protos

build obj/gen/include/hardware_verifier/libhardware_verifier-protos.hardware_verifier.pb.o: cxx gen/include/hardware_verifier/hardware_verifier.pb.cc || obj/hardware_verifier/proto/hardware_verifier-protos_gen.stamp
  source_file_part = hardware_verifier.pb.cc
  source_name_part = hardware_verifier.pb

build ./libhardware_verifier-protos.a: alink obj/gen/include/hardware_verifier/libhardware_verifier-protos.hardware_verifier.pb.o || obj/hardware_verifier/proto/hardware_verifier-protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
