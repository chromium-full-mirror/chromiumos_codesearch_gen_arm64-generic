ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/tpm_manager-0.0.1-r3216/work/tpm_manager-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _check_tpm_preinit_condition-install_config: phony obj/tpm_manager/_check_tpm_preinit_condition-install_config.stamp
build install_minijail_conf: phony obj/tpm_manager/install_minijail_conf.stamp
build install_tmpfiles_config: phony obj/tpm_manager/install_tmpfiles_config.stamp
build legacy_local_data_proto: phony ./liblegacy_local_data_proto.a
build legacy_local_data_proto_gen: phony obj/tpm_manager/legacy_local_data_proto_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build server_library: phony ./libserver_library.a
build tpm_manager_test: phony ./libtpm_manager_test.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build tpm_manager$:_check_tpm_preinit_condition-install_config: phony obj/tpm_manager/_check_tpm_preinit_condition-install_config.stamp
build tpm_manager$:all: phony obj/tpm_manager/all.stamp
build tpm_manager$:check_tpm_preinit_condition: phony ./check_tpm_preinit_condition
build tpm_manager$:install_minijail_conf: phony obj/tpm_manager/install_minijail_conf.stamp
build tpm_manager$:install_tmpfiles_config: phony obj/tpm_manager/install_tmpfiles_config.stamp
build tpm_manager$:legacy_local_data_proto: phony ./liblegacy_local_data_proto.a
build tpm_manager$:legacy_local_data_proto_gen: phony obj/tpm_manager/legacy_local_data_proto_gen.stamp
build tpm_manager$:local_data_migration: phony ./local_data_migration
build tpm_manager$:server_library: phony ./libserver_library.a
build tpm_manager$:tpm_manager_test: phony ./libtpm_manager_test.a
build tpm_manager$:tpm_managerd: phony ./tpm_managerd

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/tpm_manager/_check_tpm_preinit_condition-install_config.stamp $
    obj/tpm_manager/all.stamp $
    ./check_tpm_preinit_condition $
    obj/tpm_manager/install_minijail_conf.stamp $
    obj/tpm_manager/install_tmpfiles_config.stamp $
    ./liblegacy_local_data_proto.a $
    obj/tpm_manager/legacy_local_data_proto_gen.stamp $
    ./local_data_migration $
    ./libserver_library.a $
    ./libtpm_manager_test.a $
    ./tpm_managerd

default all
