rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/tpm_manager/all.stamp
build obj/tpm_manager/_check_tpm_preinit_condition-install_config.stamp: stamp
build obj/tpm_manager/all.stamp: stamp ./check_tpm_preinit_condition obj/tpm_manager/install_minijail_conf.stamp obj/tpm_manager/install_tmpfiles_config.stamp ./local_data_migration ./tpm_managerd
subninja obj/tpm_manager/check_tpm_preinit_condition.ninja
build obj/tpm_manager/install_minijail_conf.stamp: stamp
build obj/tpm_manager/install_tmpfiles_config.stamp: stamp
subninja obj/tpm_manager/legacy_local_data_proto.ninja
rule __tpm_manager_legacy_local_data_proto_gen___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py protoc legacy_local_data.proto --proto_path /mnt/host/source/src/platform2/tpm_manager/server --proto_path /build/arm64-generic/usr/share/proto --cpp_out=/build/arm64-generic/var/cache/portage/chromeos-base/tpm_manager/out/Default/gen/include/tpm_manager/server
  description = ACTION //tpm_manager:legacy_local_data_proto_gen(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/tpm_manager/server/legacy_local_data.pb.cc gen/include/tpm_manager/server/legacy_local_data.pb.h: __tpm_manager_legacy_local_data_proto_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../mnt/host/source/src/platform2/tpm_manager/server/legacy_local_data.proto

build obj/tpm_manager/legacy_local_data_proto_gen.stamp: stamp gen/include/tpm_manager/server/legacy_local_data.pb.cc gen/include/tpm_manager/server/legacy_local_data.pb.h
subninja obj/tpm_manager/local_data_migration.ninja
subninja obj/tpm_manager/server_library.ninja
subninja obj/tpm_manager/tpm_manager_test.ninja
subninja obj/tpm_manager/tpm_managerd.ninja
