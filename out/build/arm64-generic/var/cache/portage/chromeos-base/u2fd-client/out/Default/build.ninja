ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/u2fd-client-0.0.1-r628/work/u2fd-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libu2fd-client-install_config: phony obj/u2fd/client/_libu2fd-client-install_config.stamp
build _u2fd-client-install_config: phony obj/u2fd/client/_u2fd-client-install_config.stamp
build libu2fd-client: phony ./lib/libu2fd-client.so
build root: phony obj/common-mk/gn_root/root.stamp
build u2fd-client: phony obj/u2fd/client/u2fd-client.stamp
build user_state_proto: phony ./libuser_state_proto.a
build user_state_proto_gen: phony obj/u2fd/client/user_state_proto_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build u2fd/client$:_libu2fd-client-install_config: phony obj/u2fd/client/_libu2fd-client-install_config.stamp
build u2fd/client$:_u2fd-client-install_config: phony obj/u2fd/client/_u2fd-client-install_config.stamp
build u2fd/client$:all: phony obj/u2fd/client/all.stamp
build u2fd/client$:libu2fd-client: phony ./lib/libu2fd-client.so
build u2fd/client$:u2fd-client: phony obj/u2fd/client/u2fd-client.stamp
build u2fd/client$:user_state_proto: phony ./libuser_state_proto.a
build u2fd/client$:user_state_proto_gen: phony obj/u2fd/client/user_state_proto_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/u2fd/client/_libu2fd-client-install_config.stamp $
    obj/u2fd/client/_u2fd-client-install_config.stamp $
    obj/u2fd/client/all.stamp $
    ./lib/libu2fd-client.so $
    obj/u2fd/client/u2fd-client.stamp $
    ./libuser_state_proto.a $
    obj/u2fd/client/user_state_proto_gen.stamp

default all
