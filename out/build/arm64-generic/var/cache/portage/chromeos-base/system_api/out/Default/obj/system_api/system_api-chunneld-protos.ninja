defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/chunneld/proto_bindings -Igen/include -I../../../../../../../tmp/portage/chromeos-base/system_api-0.0.1-r5643/work/system_api-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libsystem_api-chunneld-protos

build obj/gen/include/chunneld/proto_bindings/libsystem_api-chunneld-protos.chunneld_service.pb.o: cxx gen/include/chunneld/proto_bindings/chunneld_service.pb.cc || obj/system_api/system_api-chunneld-protos_gen.stamp
  source_file_part = chunneld_service.pb.cc
  source_name_part = chunneld_service.pb

build ./libsystem_api-chunneld-protos.a: alink obj/gen/include/chunneld/proto_bindings/libsystem_api-chunneld-protos.chunneld_service.pb.o || obj/system_api/system_api-chunneld-protos_gen.stamp
  arflags = rcs
  output_extension = .a
  output_dir = 
