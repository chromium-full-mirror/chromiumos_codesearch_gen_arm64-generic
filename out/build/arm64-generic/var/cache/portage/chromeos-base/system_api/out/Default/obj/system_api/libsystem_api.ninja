defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/system_api-0.0.1-r5625/work/system_api-0.0.1 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = libsystem_api

build obj/system_api/libsystem_api.inputdeps.stamp: stamp obj/system_api/system_api-attestation-protos_gen.stamp obj/system_api/system_api-biod-protos_gen.stamp obj/system_api/system_api-bootlockbox-protos_gen.stamp obj/system_api/system_api-chaps-protos_gen.stamp obj/system_api/system_api-cryptohome-protos_gen.stamp obj/system_api/system_api-libarc_attestation-protos_gen.stamp obj/system_api/system_api-patchpanel-protos_gen.stamp obj/system_api/system_api-tpm_manager-protos_gen.stamp

build ./lib/libsystem_api.so: solink ./libsystem_api-attestation-protos.a ./libsystem_api-biod-protos.a ./libsystem_api-bootlockbox-protos.a ./libsystem_api-chaps-protos.a ./libsystem_api-cryptohome-protos.a ./libsystem_api-libarc_attestation-protos.a ./libsystem_api-patchpanel-protos.a ./libsystem_api-tpm_manager-protos.a || obj/system_api/_libsystem_api-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lprotobuf-lite -labsl_log_internal_check_op -labsl_log_internal_nullguard -labsl_log_severity -labsl_strings -labsl_string_view -labsl_base -lrt -labsl_raw_logging_internal -labsl_spinlock_wait -labsl_throw_delegate -labsl_strings_internal -labsl_int128 -labsl_log_internal_message -labsl_examine_stack -labsl_stacktrace -labsl_debugging_internal -labsl_symbolize -labsl_demangle_internal -labsl_malloc_internal -labsl_log_internal_format -labsl_log_internal_globals -labsl_time -labsl_civil_time -labsl_time_zone -labsl_str_format_internal -labsl_log_internal_proto -labsl_log_internal_log_sink_set -labsl_log_globals -labsl_hash -labsl_city -labsl_bad_optional_access -labsl_bad_variant_access -labsl_low_level_hash -labsl_log_entry -labsl_log_sink -labsl_synchronization -labsl_graphcycles_internal -labsl_kernel_timeout_internal -labsl_strerror -labsl_log_internal_conditions -labsl_cord -labsl_cord_internal -labsl_crc_cord_state -labsl_crc32c -labsl_crc_cpu_detect -labsl_crc_internal -labsl_cordz_functions -labsl_exponential_biased -labsl_cordz_info -labsl_cordz_handle -labsl_leak_check -labsl_die_if_null -labsl_flags -labsl_flags_commandlineflag -labsl_flags_commandlineflag_internal -labsl_flags_config -labsl_flags_program_name -labsl_flags_internal -labsl_flags_marshalling -labsl_flags_reflection -labsl_flags_private_handle_accessor -labsl_raw_hash_set -labsl_hashtablez_sampler -labsl_log_initialize -labsl_status -labsl_statusor -lutf8_validity -lutf8_range
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
