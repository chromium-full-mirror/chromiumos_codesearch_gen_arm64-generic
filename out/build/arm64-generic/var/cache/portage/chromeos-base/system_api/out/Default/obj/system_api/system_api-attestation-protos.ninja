defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/attestation/proto_bindings -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libsystem_api-attestation-protos

build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.attestation_ca.pb.o: cxx gen/include/attestation/proto_bindings/attestation_ca.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = attestation_ca.pb.cc
  source_name_part = attestation_ca.pb
build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.database.pb.o: cxx gen/include/attestation/proto_bindings/database.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = database.pb.cc
  source_name_part = database.pb
build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.google_key.pb.o: cxx gen/include/attestation/proto_bindings/google_key.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = google_key.pb.cc
  source_name_part = google_key.pb
build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.interface.pb.o: cxx gen/include/attestation/proto_bindings/interface.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = interface.pb.cc
  source_name_part = interface.pb
build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.keystore.pb.o: cxx gen/include/attestation/proto_bindings/keystore.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = keystore.pb.cc
  source_name_part = keystore.pb
build obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.pca_agent.pb.o: cxx gen/include/attestation/proto_bindings/pca_agent.pb.cc || obj/system_api/system_api-attestation-protos_gen.stamp
  source_file_part = pca_agent.pb.cc
  source_name_part = pca_agent.pb

build ./libsystem_api-attestation-protos.a: alink obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.attestation_ca.pb.o obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.database.pb.o obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.google_key.pb.o obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.interface.pb.o obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.keystore.pb.o obj/gen/include/attestation/proto_bindings/libsystem_api-attestation-protos.pca_agent.pb.o || obj/system_api/system_api-attestation-protos_gen.stamp
  arflags = rcs
  output_extension = .a
  output_dir = 
