ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/usb_bouncer-0.0.1-r880/work/usb_bouncer-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build root: phony obj/common-mk/gn_root/root.stamp
build usb_bouncer_common: phony ./libusb_bouncer_common.a
build usb_bouncer_protos: phony ./libusb_bouncer_protos.a
build usb_bouncer_protos_gen: phony obj/usb_bouncer/usb_bouncer_protos_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build usb_bouncer$:all: phony obj/usb_bouncer/all.stamp
build usb_bouncer$:usb_bouncer: phony ./usb_bouncer
build usb_bouncer$:usb_bouncer_common: phony ./libusb_bouncer_common.a
build usb_bouncer$:usb_bouncer_protos: phony ./libusb_bouncer_protos.a
build usb_bouncer$:usb_bouncer_protos_gen: phony obj/usb_bouncer/usb_bouncer_protos_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/usb_bouncer/all.stamp $
    ./usb_bouncer $
    ./libusb_bouncer_common.a $
    ./libusb_bouncer_protos.a $
    obj/usb_bouncer/usb_bouncer_protos_gen.stamp

default all
