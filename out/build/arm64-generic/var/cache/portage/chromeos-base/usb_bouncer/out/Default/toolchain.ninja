rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/usb_bouncer/all.stamp
build obj/usb_bouncer/all.stamp: stamp ./usb_bouncer
subninja obj/usb_bouncer/usb_bouncer.ninja
subninja obj/usb_bouncer/usb_bouncer_common.ninja
subninja obj/usb_bouncer/usb_bouncer_protos.ninja
rule __usb_bouncer_usb_bouncer_protos_gen___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/usb_bouncer-0.0.1-r883/work/usb_bouncer-0.0.1/common-mk/file_generator_wrapper.py protoc usb_bouncer.proto --proto_path /build/arm64-generic/tmp/portage/chromeos-base/usb_bouncer-0.0.1-r883/work/usb_bouncer-0.0.1/usb_bouncer --proto_path /build/arm64-generic/usr/share/proto --cpp_out=/build/arm64-generic/var/cache/portage/chromeos-base/usb_bouncer/out/Default/gen/include/usb_bouncer
  description = ACTION //usb_bouncer:usb_bouncer_protos_gen(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/usb_bouncer/usb_bouncer.pb.cc gen/include/usb_bouncer/usb_bouncer.pb.h: __usb_bouncer_usb_bouncer_protos_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/usb_bouncer-0.0.1-r883/work/usb_bouncer-0.0.1/common-mk/file_generator_wrapper.py ../../../../../../../tmp/portage/chromeos-base/usb_bouncer-0.0.1-r883/work/usb_bouncer-0.0.1/usb_bouncer/usb_bouncer.proto

build obj/usb_bouncer/usb_bouncer_protos_gen.stamp: stamp gen/include/usb_bouncer/usb_bouncer.pb.cc gen/include/usb_bouncer/usb_bouncer.pb.h
