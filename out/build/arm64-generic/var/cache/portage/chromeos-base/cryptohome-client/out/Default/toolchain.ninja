rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/cryptohome/client/all.stamp
build obj/cryptohome/client/all.stamp: stamp obj/cryptohome/client/userdataauth-client-headers.stamp
rule __cryptohome_client_userdataauth-client-headers___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/cryptohome-client-0.0.1-r3073/work/cryptohome-client-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -service-config=/build/arm64-generic/tmp/portage/chromeos-base/cryptohome-client-0.0.1-r3073/work/cryptohome-client-0.0.1/cryptohome/dbus_bindings/dbus-service-config-UserDataAuth.json -proxy=/build/arm64-generic/var/cache/portage/chromeos-base/cryptohome-client/out/Default/gen/include/user_data_auth/dbus-proxies.h -mock=/build/arm64-generic/var/cache/portage/chromeos-base/cryptohome-client/out/Default/gen/include/user_data_auth/dbus-proxy-mocks.h -proxy-path-for-mocks=user_data_auth/dbus-proxies.h ../../../../../../../tmp/portage/chromeos-base/cryptohome-client-0.0.1-r3073/work/cryptohome-client-0.0.1/cryptohome/dbus_bindings/org.chromium.UserDataAuth.xml
  description = ACTION //cryptohome/client:userdataauth-client-headers(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/user_data_auth/dbus-proxies.h gen/include/user_data_auth/dbus-proxy-mocks.h: __cryptohome_client_userdataauth-client-headers___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/cryptohome-client-0.0.1-r3073/work/cryptohome-client-0.0.1/common-mk/file_generator_wrapper.py ../../../../../../../tmp/portage/chromeos-base/cryptohome-client-0.0.1-r3073/work/cryptohome-client-0.0.1/cryptohome/dbus_bindings/org.chromium.UserDataAuth.xml

build obj/cryptohome/client/userdataauth-client-headers.stamp: stamp gen/include/user_data_auth/dbus-proxies.h gen/include/user_data_auth/dbus-proxy-mocks.h
