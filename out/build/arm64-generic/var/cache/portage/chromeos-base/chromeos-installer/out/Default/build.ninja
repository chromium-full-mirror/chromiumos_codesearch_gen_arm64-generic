ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/chromeos-installer-0.0.3-r4153/work/chromeos-installer-0.0.3 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cros_installer-install_config: phony obj/installer/_cros_installer-install_config.stamp
build _evwaitkey-install_config: phony obj/installer/_evwaitkey-install_config.stamp
build _postinst_script_symlink-0-install_config: phony obj/installer/_postinst_script_symlink-0-install_config.stamp
build chromeos_install_script: phony obj/installer/chromeos_install_script.stamp
build crx_import_script: phony obj/installer/crx_import_script.stamp
build init_confs: phony obj/installer/init_confs.stamp
build libcros_installer: phony ./libcros_installer.a
build postinst_script_symlink: phony obj/installer/postinst_script_symlink.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build sbin_scripts: phony obj/installer/sbin_scripts.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build installer$:_cros_installer-install_config: phony obj/installer/_cros_installer-install_config.stamp
build installer$:_evwaitkey-install_config: phony obj/installer/_evwaitkey-install_config.stamp
build installer$:_postinst_script_symlink-0-install_config: phony obj/installer/_postinst_script_symlink-0-install_config.stamp
build installer$:all: phony obj/installer/all.stamp
build installer$:chromeos_install_script: phony obj/installer/chromeos_install_script.stamp
build installer$:cros_installer: phony ./cros_installer
build installer$:crx_import_script: phony obj/installer/crx_import_script.stamp
build installer$:evwaitkey: phony ./evwaitkey
build installer$:init_confs: phony obj/installer/init_confs.stamp
build installer$:libcros_installer: phony ./libcros_installer.a
build installer$:postinst_script_symlink: phony obj/installer/postinst_script_symlink.stamp
build installer$:sbin_scripts: phony obj/installer/sbin_scripts.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/installer/_cros_installer-install_config.stamp $
    obj/installer/_evwaitkey-install_config.stamp $
    obj/installer/_postinst_script_symlink-0-install_config.stamp $
    obj/installer/all.stamp $
    obj/installer/chromeos_install_script.stamp $
    ./cros_installer $
    obj/installer/crx_import_script.stamp $
    ./evwaitkey $
    obj/installer/init_confs.stamp $
    ./libcros_installer.a $
    obj/installer/postinst_script_symlink.stamp $
    obj/installer/sbin_scripts.stamp

default all
