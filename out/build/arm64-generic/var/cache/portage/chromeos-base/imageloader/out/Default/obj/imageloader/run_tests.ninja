defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = run_tests

build obj/imageloader/run_tests.inputdeps.stamp: stamp obj/imageloader/imageloader-adaptors.stamp obj/imageloader/protos_gen.stamp
build obj/imageloader/run_tests.component_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/component_test.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = component_test.cc
  source_name_part = component_test
build obj/imageloader/run_tests.dlc_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/dlc_test.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = dlc_test.cc
  source_name_part = dlc_test
build obj/imageloader/run_tests.global_context.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/global_context.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = global_context.cc
  source_name_part = global_context
build obj/imageloader/run_tests.imageloader.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/imageloader.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = imageloader.cc
  source_name_part = imageloader
build obj/imageloader/run_tests.imageloader_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/imageloader_test.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = imageloader_test.cc
  source_name_part = imageloader_test
build obj/imageloader/run_tests.manifest_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/manifest_test.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = manifest_test.cc
  source_name_part = manifest_test
build obj/imageloader/run_tests.test_utilities.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/test_utilities.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = test_utilities.cc
  source_name_part = test_utilities
build obj/imageloader/run_tests.verity_mounter_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/imageloader/verity_mounter_test.cc || obj/imageloader/run_tests.inputdeps.stamp
  source_file_part = verity_mounter_test.cc
  source_name_part = verity_mounter_test

build ./run_tests: link obj/imageloader/run_tests.component_test.o obj/imageloader/run_tests.dlc_test.o obj/imageloader/run_tests.global_context.o obj/imageloader/run_tests.imageloader.o obj/imageloader/run_tests.imageloader_test.o obj/imageloader/run_tests.manifest_test.o obj/imageloader/run_tests.test_utilities.o obj/imageloader/run_tests.verity_mounter_test.o ./libimageloader_static.a ./libtestrunner.a ./lib/libimageloader-manifest.so ./libprotos.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/usr/lib64 -L/build/arm64-generic/lib64
  libs = -lgmock -lgtest -lpthread -lbrillo -lcrypto -ldevmapper -lbase -ldlcservice-metadata -lminijail -lsystem_api-device_management-protos -lsystem_api-hps-protos -lsystem_api-power_manager-protos -lsystem_api-authpolicy-protos -lsystem_api-protos -lsystem_api-kerberos-protos -lsystem_api-login_manager-protos -lsystem_api-lorgnette-protos -lsystem_api-smbprovider-protos -lsystem_api-vm_concierge-protos -lsystem_api-vm_applications-protos -lsystem_api-vm_launch-protos -lsystem_api-vm_sk_forwarding-protos -lsystem_api-vm_cicerone-protos -lsystem_api-seneschal-protos -lsystem_api-oobe_config-protos -lsystem_api-runtime_probe-protos -lsystem_api-dlcservice-protos -lsystem_api-update_engine-protos -lsystem_api-vm_plugin_dispatcher-protos -lsystem_api-u2f-protos -lsystem_api-chunneld-protos -lsystem_api-system_proxy-protos -lsystem_api-vm_permission_service-protos -lsystem_api-anomaly_detector-protos -lsystem_api-minios-protos -lsystem_api-dlp-protos -lsystem_api-rmad-protos -lsystem_api-fusebox-protos -lsystem_api-privacy_screen-protos -lsystem_api-cdm_oemcrypto-protos -lsystem_api-ml-protos -lsystem_api-lvmd-protos -lsystem_api-shadercached-protos -lsystem_api-spaced-protos -lsystem_api-imageloader-protos -lsystem_api -lsystem_api-arc-protos -lsystem_api-private_computing-protos -lsystem_api-arcvm_data_migrator-protos -lsystem_api-featured-protos -lsystem_api-vm_wl-protos -lsystem_api-printscanmgr-protos -lsystem_api-vm_memory_management-protos -lvboot_host -lprotobuf-lite -lbase-test
  frameworks =
