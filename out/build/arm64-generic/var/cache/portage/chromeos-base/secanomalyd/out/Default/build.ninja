ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/secanomalyd-0.0.1-r608/work/secanomalyd-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _secanomalyd-install_config: phony obj/secanomalyd/_secanomalyd-install_config.stamp
build install_minijail_conf: phony obj/secanomalyd/install_minijail_conf.stamp
build install_upstart_config: phony obj/secanomalyd/install_upstart_config.stamp
build landlock: phony obj/secanomalyd/landlock.stamp
build libsecanomaly: phony ./libsecanomaly.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build secanomalyd$:_secanomalyd-install_config: phony obj/secanomalyd/_secanomalyd-install_config.stamp
build secanomalyd$:all: phony obj/secanomalyd/all.stamp
build secanomalyd$:install_minijail_conf: phony obj/secanomalyd/install_minijail_conf.stamp
build secanomalyd$:install_upstart_config: phony obj/secanomalyd/install_upstart_config.stamp
build secanomalyd$:landlock: phony obj/secanomalyd/landlock.stamp
build secanomalyd$:libsecanomaly: phony ./libsecanomaly.a
build secanomalyd$:secanomalyd: phony ./secanomalyd

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/secanomalyd/_secanomalyd-install_config.stamp $
    obj/secanomalyd/all.stamp $
    obj/secanomalyd/install_minijail_conf.stamp $
    obj/secanomalyd/install_upstart_config.stamp $
    obj/secanomalyd/landlock.stamp $
    ./libsecanomaly.a $
    ./secanomalyd

default all
