build obj/secanomalyd/libsecanomaly.mounts.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/secanomalyd/mounts.cc
  source_file_part = mounts.cc
  source_name_part = mounts
build obj/secanomalyd/libsecanomaly.processes.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/secanomalyd/processes.cc
  source_file_part = processes.cc
  source_name_part = processes
build obj/secanomalyd/libsecanomaly.reporter.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/secanomalyd/reporter.cc
