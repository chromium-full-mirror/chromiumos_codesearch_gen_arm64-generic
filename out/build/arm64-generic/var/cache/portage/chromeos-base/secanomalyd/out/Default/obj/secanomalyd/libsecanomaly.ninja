build ./libsecanomaly.a: alink obj/secanomalyd/libsecanomaly.audit_log_reader.o obj/secanomalyd/libsecanomaly.daemon.o obj/secanomalyd/libsecanomaly.metrics.o obj/secanomalyd/libsecanomaly.mount_entry.o obj/secanomalyd/libsecanomaly.mounts.o obj/secanomalyd/libsecanomaly.processes.o obj/secanomalyd/libsecanomaly.reporter.o obj/secanomalyd/libsecanomaly.system_context.o obj/secanomalyd/libsecanomaly.text_file_reader.o || obj/secanomalyd/landlock.stamp
  arflags = rcsT
