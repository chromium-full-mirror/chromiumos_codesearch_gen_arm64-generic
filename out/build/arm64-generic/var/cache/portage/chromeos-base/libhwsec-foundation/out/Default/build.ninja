ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libhwsec-foundation-0.0.1-r703/work/libhwsec-foundation-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libhwsec-foundation: phony ./lib/libhwsec-foundation.so
build _hwsec_status-install_config: phony obj/libhwsec-foundation/_hwsec_status-install_config.stamp
build _libhwsec-foundation-install_config: phony obj/libhwsec-foundation/_libhwsec-foundation-install_config.stamp
build _libhwsec-profiling-install_config: phony obj/libhwsec-foundation/_libhwsec-profiling-install_config.stamp
build _tpm_clear_request-install_config: phony obj/libhwsec-foundation/_tpm_clear_request-install_config.stamp
build _tpm_version_client-install_config: phony obj/libhwsec-foundation/_tpm_version_client-install_config.stamp
build install_headers: phony obj/libhwsec-foundation/install_headers.stamp
build install_hwsec_shutdown_signal: phony obj/libhwsec-foundation/install_hwsec_shutdown_signal.stamp
build install_no_tpm_checker: phony obj/libhwsec-foundation/install_no_tpm_checker.stamp
build install_status_headers: phony obj/libhwsec-foundation/install_status_headers.stamp
build install_status_impl_headers: phony obj/libhwsec-foundation/install_status_impl_headers.stamp
build install_syscaller_headers: phony obj/libhwsec-foundation/install_syscaller_headers.stamp
build install_test_syscaller_headers: phony obj/libhwsec-foundation/install_test_syscaller_headers.stamp
build install_tlcl_wrapper_headers: phony obj/libhwsec-foundation/install_tlcl_wrapper_headers.stamp
build install_tpm_error_headers: phony obj/libhwsec-foundation/install_tpm_error_headers.stamp
build install_tpm_version: phony obj/libhwsec-foundation/install_tpm_version.stamp
build install_utility_headers: phony obj/libhwsec-foundation/install_utility_headers.stamp
build install_vpd_reader_headers: phony obj/libhwsec-foundation/install_vpd_reader_headers.stamp
build libhwsec-profiling: phony ./libhwsec-profiling.a
build print_tool_proto_library: phony obj/libhwsec-foundation/print_tool_proto_library.stamp
build proto_library: phony ./libproto_library.a
build root: phony obj/common-mk/gn_root/root.stamp
build tool_proto: phony ./libtool_proto.a
build tool_proto_gen: phony obj/libhwsec-foundation/tool_proto_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libhwsec-foundation$:_hwsec_status-install_config: phony obj/libhwsec-foundation/_hwsec_status-install_config.stamp
build libhwsec-foundation$:_libhwsec-foundation-install_config: phony obj/libhwsec-foundation/_libhwsec-foundation-install_config.stamp
build libhwsec-foundation$:_libhwsec-profiling-install_config: phony obj/libhwsec-foundation/_libhwsec-profiling-install_config.stamp
build libhwsec-foundation$:_tpm_clear_request-install_config: phony obj/libhwsec-foundation/_tpm_clear_request-install_config.stamp
build libhwsec-foundation$:_tpm_version_client-install_config: phony obj/libhwsec-foundation/_tpm_version_client-install_config.stamp
build libhwsec-foundation$:all: phony obj/libhwsec-foundation/all.stamp
build libhwsec-foundation$:hwsec_status: phony ./hwsec_status
build libhwsec-foundation$:install_headers: phony obj/libhwsec-foundation/install_headers.stamp
build libhwsec-foundation$:install_hwsec_shutdown_signal: phony obj/libhwsec-foundation/install_hwsec_shutdown_signal.stamp
build libhwsec-foundation$:install_no_tpm_checker: phony obj/libhwsec-foundation/install_no_tpm_checker.stamp
build libhwsec-foundation$:install_status_headers: phony obj/libhwsec-foundation/install_status_headers.stamp
build libhwsec-foundation$:install_status_impl_headers: phony obj/libhwsec-foundation/install_status_impl_headers.stamp
build libhwsec-foundation$:install_syscaller_headers: phony obj/libhwsec-foundation/install_syscaller_headers.stamp
build libhwsec-foundation$:install_test_syscaller_headers: phony obj/libhwsec-foundation/install_test_syscaller_headers.stamp
build libhwsec-foundation$:install_tlcl_wrapper_headers: phony obj/libhwsec-foundation/install_tlcl_wrapper_headers.stamp
build libhwsec-foundation$:install_tpm_error_headers: phony obj/libhwsec-foundation/install_tpm_error_headers.stamp
build libhwsec-foundation$:install_tpm_version: phony obj/libhwsec-foundation/install_tpm_version.stamp
build libhwsec-foundation$:install_utility_headers: phony obj/libhwsec-foundation/install_utility_headers.stamp
build libhwsec-foundation$:install_vpd_reader_headers: phony obj/libhwsec-foundation/install_vpd_reader_headers.stamp
build libhwsec-foundation$:libhwsec-foundation: phony ./lib/libhwsec-foundation.so
build libhwsec-foundation$:libhwsec-profiling: phony ./libhwsec-profiling.a
build libhwsec-foundation$:print_tool_proto_library: phony obj/libhwsec-foundation/print_tool_proto_library.stamp
build libhwsec-foundation$:proto_library: phony ./libproto_library.a
build libhwsec-foundation$:tool_proto: phony ./libtool_proto.a
build libhwsec-foundation$:tool_proto_gen: phony obj/libhwsec-foundation/tool_proto_gen.stamp
build libhwsec-foundation$:tpm_clear_request: phony ./tpm_clear_request
build libhwsec-foundation$:tpm_version_client: phony ./tpm_version_client

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libhwsec-foundation/_hwsec_status-install_config.stamp $
    obj/libhwsec-foundation/_libhwsec-foundation-install_config.stamp $
    obj/libhwsec-foundation/_libhwsec-profiling-install_config.stamp $
    obj/libhwsec-foundation/_tpm_clear_request-install_config.stamp $
    obj/libhwsec-foundation/_tpm_version_client-install_config.stamp $
    obj/libhwsec-foundation/all.stamp $
    ./hwsec_status $
    obj/libhwsec-foundation/install_headers.stamp $
    obj/libhwsec-foundation/install_hwsec_shutdown_signal.stamp $
    obj/libhwsec-foundation/install_no_tpm_checker.stamp $
    obj/libhwsec-foundation/install_status_headers.stamp $
    obj/libhwsec-foundation/install_status_impl_headers.stamp $
    obj/libhwsec-foundation/install_syscaller_headers.stamp $
    obj/libhwsec-foundation/install_test_syscaller_headers.stamp $
    obj/libhwsec-foundation/install_tlcl_wrapper_headers.stamp $
    obj/libhwsec-foundation/install_tpm_error_headers.stamp $
    obj/libhwsec-foundation/install_tpm_version.stamp $
    obj/libhwsec-foundation/install_utility_headers.stamp $
    obj/libhwsec-foundation/install_vpd_reader_headers.stamp $
    ./lib/libhwsec-foundation.so $
    ./libhwsec-profiling.a $
    obj/libhwsec-foundation/print_tool_proto_library.stamp $
    ./libproto_library.a $
    ./libtool_proto.a $
    obj/libhwsec-foundation/tool_proto_gen.stamp $
    ./tpm_clear_request $
    ./tpm_version_client

default all
