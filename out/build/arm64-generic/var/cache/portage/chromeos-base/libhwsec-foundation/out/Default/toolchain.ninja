rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/libhwsec-foundation/all.stamp
subninja obj/common-mk/testrunner/testrunner.ninja
build obj/libhwsec-foundation/_libhwsec-foundation-install_config.stamp: stamp
build obj/libhwsec-foundation/_libhwsec-profiling-install_config.stamp: stamp
build obj/libhwsec-foundation/_tpm_version_client-install_config.stamp: stamp
build obj/libhwsec-foundation/all.stamp: stamp obj/libhwsec-foundation/install_headers.stamp obj/libhwsec-foundation/install_hwsec_shutdown_signal.stamp ./lib/libhwsec-foundation.so ./libhwsec-profiling.a ./tpm_version_client ./hwsec-foundation_testrunner obj/libhwsec-foundation/install_test_syscaller_headers.stamp
subninja obj/libhwsec-foundation/hwsec-foundation_testrunner.ninja
build obj/libhwsec-foundation/install_headers.stamp: stamp obj/libhwsec-foundation/install_status_headers.stamp obj/libhwsec-foundation/install_syscaller_headers.stamp obj/libhwsec-foundation/install_tlcl_wrapper_headers.stamp obj/libhwsec-foundation/install_tpm_error_headers.stamp obj/libhwsec-foundation/install_utility_headers.stamp obj/libhwsec-foundation/install_vpd_reader_headers.stamp
build obj/libhwsec-foundation/install_hwsec_shutdown_signal.stamp: stamp
build obj/libhwsec-foundation/install_no_tpm_checker.stamp: stamp
build obj/libhwsec-foundation/install_status_headers.stamp: stamp obj/libhwsec-foundation/install_status_impl_headers.stamp
build obj/libhwsec-foundation/install_status_impl_headers.stamp: stamp
build obj/libhwsec-foundation/install_syscaller_headers.stamp: stamp
build obj/libhwsec-foundation/install_test_syscaller_headers.stamp: stamp
build obj/libhwsec-foundation/install_tlcl_wrapper_headers.stamp: stamp
build obj/libhwsec-foundation/install_tpm_error_headers.stamp: stamp
build obj/libhwsec-foundation/install_tpm_version.stamp: stamp
build obj/libhwsec-foundation/install_utility_headers.stamp: stamp
build obj/libhwsec-foundation/install_vpd_reader_headers.stamp: stamp
subninja obj/libhwsec-foundation/libhwsec-foundation.ninja
subninja obj/libhwsec-foundation/libhwsec-profiling.ninja
subninja obj/libhwsec-foundation/tpm_version_client.ninja
