ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/lorgnette-0.0.1-r3682/work/lorgnette-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _lorgnette-install_config: phony obj/lorgnette/_lorgnette-install_config.stamp
build install_dbus_config: phony obj/lorgnette/install_dbus_config.stamp
build install_init: phony obj/lorgnette/install_init.stamp
build install_minijail_config: phony obj/lorgnette/install_minijail_config.stamp
build install_system_service: phony obj/lorgnette/install_system_service.stamp
build install_tmpfiles_config: phony obj/lorgnette/tmpfiles.d/install_tmpfiles_config.stamp
build liblorgnette: phony ./liblorgnette.a
build liblorgnette_cli: phony ./liblorgnette_cli.a
build lorgnette-adaptors: phony obj/lorgnette/lorgnette-adaptors.stamp
build lorgnette-proxies: phony obj/lorgnette/lorgnette-proxies.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build tmpfiles.d: phony obj/lorgnette/tmpfiles.d/tmpfiles.d.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build lorgnette$:_lorgnette-install_config: phony obj/lorgnette/_lorgnette-install_config.stamp
build lorgnette$:all: phony obj/lorgnette/all.stamp
build lorgnette$:install_dbus_config: phony obj/lorgnette/install_dbus_config.stamp
build lorgnette$:install_init: phony obj/lorgnette/install_init.stamp
build lorgnette$:install_minijail_config: phony obj/lorgnette/install_minijail_config.stamp
build lorgnette$:install_system_service: phony obj/lorgnette/install_system_service.stamp
build lorgnette$:liblorgnette: phony ./liblorgnette.a
build lorgnette$:liblorgnette_cli: phony ./liblorgnette_cli.a
build lorgnette$:lorgnette: phony ./lorgnette
build lorgnette$:lorgnette-adaptors: phony obj/lorgnette/lorgnette-adaptors.stamp
build lorgnette$:lorgnette-proxies: phony obj/lorgnette/lorgnette-proxies.stamp
build lorgnette$:lorgnette_cli: phony ./lorgnette_cli
build lorgnette/tmpfiles.d$:install_tmpfiles_config: phony obj/lorgnette/tmpfiles.d/install_tmpfiles_config.stamp
build lorgnette/tmpfiles.d$:tmpfiles.d: phony obj/lorgnette/tmpfiles.d/tmpfiles.d.stamp
build lorgnette/tmpfiles.d: phony obj/lorgnette/tmpfiles.d/tmpfiles.d.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/lorgnette/_lorgnette-install_config.stamp $
    obj/lorgnette/all.stamp $
    obj/lorgnette/install_dbus_config.stamp $
    obj/lorgnette/install_init.stamp $
    obj/lorgnette/install_minijail_config.stamp $
    obj/lorgnette/install_system_service.stamp $
    ./liblorgnette.a $
    ./liblorgnette_cli.a $
    ./lorgnette $
    obj/lorgnette/lorgnette-adaptors.stamp $
    obj/lorgnette/lorgnette-proxies.stamp $
    ./lorgnette_cli $
    obj/lorgnette/tmpfiles.d/install_tmpfiles_config.stamp $
    obj/lorgnette/tmpfiles.d/tmpfiles.d.stamp

default all
