ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/pp_cli-0.0.1-r158/work/pp_cli-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _pp_cli-install_config: phony obj/patchpanel/pp_cli/_pp_cli-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build patchpanel/pp_cli$:_pp_cli-install_config: phony obj/patchpanel/pp_cli/_pp_cli-install_config.stamp
build patchpanel/pp_cli$:all: phony obj/patchpanel/pp_cli/all.stamp
build patchpanel/pp_cli$:pp_cli: phony ./pp_cli
build patchpanel/pp_cli: phony ./pp_cli

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/patchpanel/pp_cli/_pp_cli-install_config.stamp $
    obj/patchpanel/pp_cli/all.stamp $
    ./pp_cli

default all
