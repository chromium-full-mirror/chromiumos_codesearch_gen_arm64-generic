  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/generate-pc.py --output /build/arm64-generic/var/cache/portage/chromeos-base/shill-net/out/Default/obj/net-base/libnet-base.pc --name=libnet-base --description=Network\$ primitive\$ library --version=9999 --requires=libchrome --libs=-lnet-base
  description = ACTION //net-base:libnet-base_pc(//common-mk/toolchain:toolchain)
  restat = 1

build obj/net-base/libnet-base.pc: __net-base_libnet-base_pc___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/generate-pc.py obj/net-base/_libnet-base_pc-install_config.stamp

build obj/net-base/libnet-base_pc.stamp: stamp obj/net-base/libnet-base.pc
subninja obj/net-base/net_base_test_support.ninja
build obj/shill/net/_libshill-net-install_config.stamp: stamp
build obj/shill/net/all.stamp: stamp obj/shill/net/install_headers.stamp ./lib/libshill-net.so ./shill_net_test
build obj/shill/net/install_headers.stamp: stamp
