ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/secure-erase-file-0.0.1-r1234/work/secure-erase-file-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libsecure_erase_file-install_config: phony obj/secure_erase_file/_libsecure_erase_file-install_config.stamp
build _secure_erase_file-install_config: phony obj/secure_erase_file/_secure_erase_file-install_config.stamp
build install_headers: phony obj/secure_erase_file/install_headers.stamp
build libsecure_erase_file: phony ./lib/libsecure_erase_file.so
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build secure_erase_file$:_libsecure_erase_file-install_config: phony obj/secure_erase_file/_libsecure_erase_file-install_config.stamp
build secure_erase_file$:_secure_erase_file-install_config: phony obj/secure_erase_file/_secure_erase_file-install_config.stamp
build secure_erase_file$:all: phony obj/secure_erase_file/all.stamp
build secure_erase_file$:install_headers: phony obj/secure_erase_file/install_headers.stamp
build secure_erase_file$:libsecure_erase_file: phony ./lib/libsecure_erase_file.so
build secure_erase_file$:secure_erase_file: phony ./secure_erase_file

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/secure_erase_file/_libsecure_erase_file-install_config.stamp $
    obj/secure_erase_file/_secure_erase_file-install_config.stamp $
    obj/secure_erase_file/all.stamp $
    obj/secure_erase_file/install_headers.stamp $
    ./lib/libsecure_erase_file.so $
    ./secure_erase_file

default all
