ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/tpm_softclear_utils-0.0.1-r935/work/tpm_softclear_utils-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _tpm_softclear-install_config: phony obj/tpm_softclear_utils/_tpm_softclear-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build utility_library: phony ./libutility_library.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build tpm_softclear_utils$:_tpm_softclear-install_config: phony obj/tpm_softclear_utils/_tpm_softclear-install_config.stamp
build tpm_softclear_utils$:all: phony obj/tpm_softclear_utils/all.stamp
build tpm_softclear_utils$:tpm_softclear: phony ./tpm_softclear
build tpm_softclear_utils$:utility_library: phony ./libutility_library.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/tpm_softclear_utils/_tpm_softclear-install_config.stamp $
    obj/tpm_softclear_utils/all.stamp $
    ./tpm_softclear $
    ./libutility_library.a

default all
