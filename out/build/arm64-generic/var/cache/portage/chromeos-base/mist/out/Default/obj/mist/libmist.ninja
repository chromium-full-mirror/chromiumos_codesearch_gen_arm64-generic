defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -pthread -DPROTOBUF_USE_DLLS -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1241304 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -DPROTOBUF_USE_DLLS
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libmist

build obj/mist/libmist.config_loader.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/config_loader.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = config_loader.cc
  source_name_part = config_loader
build obj/mist/libmist.context.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/context.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = context.cc
  source_name_part = context
build obj/mist/libmist.event_dispatcher.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/event_dispatcher.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = event_dispatcher.cc
  source_name_part = event_dispatcher
build obj/mist/libmist.metrics.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/metrics.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = metrics.cc
  source_name_part = metrics
build obj/mist/libmist.mist.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/mist.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = mist.cc
  source_name_part = mist
build obj/mist/libmist.usb_modem_one_shot_switcher.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/usb_modem_one_shot_switcher.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = usb_modem_one_shot_switcher.cc
  source_name_part = usb_modem_one_shot_switcher
build obj/mist/libmist.usb_modem_switch_context.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/usb_modem_switch_context.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = usb_modem_switch_context.cc
  source_name_part = usb_modem_switch_context
build obj/mist/libmist.usb_modem_switch_operation.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/usb_modem_switch_operation.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = usb_modem_switch_operation.cc
  source_name_part = usb_modem_switch_operation
build obj/mist/libmist.usb_modem_switcher.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mist/usb_modem_switcher.cc || obj/mist/mist-protos_gen.stamp
  source_file_part = usb_modem_switcher.cc
  source_name_part = usb_modem_switcher

build ./libmist.a: alink obj/mist/libmist.config_loader.o obj/mist/libmist.context.o obj/mist/libmist.event_dispatcher.o obj/mist/libmist.metrics.o obj/mist/libmist.mist.o obj/mist/libmist.usb_modem_one_shot_switcher.o obj/mist/libmist.usb_modem_switch_context.o obj/mist/libmist.usb_modem_switch_operation.o obj/mist/libmist.usb_modem_switcher.o || ./libmist-protos.a
  arflags = rcsT
  output_extension = .a
  output_dir = 
