build debugd$:scheduler_configuration_helper: phony ./scheduler_configuration_helper
build debugd$:scheduler_configuration_utils: phony ./libscheduler_configuration_utils.a
build debugd$:typec_connector_class_helper: phony ./typec_connector_class_helper
build debugd$:usb4_devinfo_helper: phony ./usb4_devinfo_helper

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/debugd/_audit_log_filter-install_config.stamp $
    obj/debugd/_bt_usb_disconnect_helper-install_config.stamp $
    obj/debugd/_capture_packets-install_config.stamp $
    obj/debugd/_cups_uri_helper-install_config.stamp $
    obj/debugd/_debugd-install_config.stamp $
    obj/debugd/_dev_features_chrome_remote_debugging-install_config.stamp $
    obj/debugd/_dev_features_password-install_config.stamp $
    obj/debugd/_dev_features_rootfs_verification-install_config.stamp $
    obj/debugd/_dev_features_ssh-install_config.stamp $
