ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _audit_log_filter-install_config: phony obj/debugd/_audit_log_filter-install_config.stamp
build _bt_usb_disconnect_helper-install_config: phony obj/debugd/_bt_usb_disconnect_helper-install_config.stamp
build _capture_packets-install_config: phony obj/debugd/_capture_packets-install_config.stamp
build _cups_uri_helper-install_config: phony obj/debugd/_cups_uri_helper-install_config.stamp
build _debugd-install_config: phony obj/debugd/_debugd-install_config.stamp
build _dev_features_chrome_remote_debugging-install_config: phony obj/debugd/_dev_features_chrome_remote_debugging-install_config.stamp
build _dev_features_password-install_config: phony obj/debugd/_dev_features_password-install_config.stamp
build _dev_features_rootfs_verification-install_config: phony obj/debugd/_dev_features_rootfs_verification-install_config.stamp
build _dev_features_ssh-install_config: phony obj/debugd/_dev_features_ssh-install_config.stamp
build _dev_features_usb_boot-install_config: phony obj/debugd/_dev_features_usb_boot-install_config.stamp
build _folder_size_dump-install_config: phony obj/debugd/_folder_size_dump-install_config.stamp
build _generate_logs-install_config: phony obj/debugd/_generate_logs-install_config.stamp
build _icmp-install_config: phony obj/debugd/_icmp-install_config.stamp
build _modetest_helper-install_config: phony obj/debugd/_modetest_helper-install_config.stamp
build _netif-install_config: phony obj/debugd/_netif-install_config.stamp
build _network_status-install_config: phony obj/debugd/_network_status-install_config.stamp
build _scheduler_configuration_helper-install_config: phony obj/debugd/_scheduler_configuration_helper-install_config.stamp
build _typec_connector_class_helper-install_config: phony obj/debugd/_typec_connector_class_helper-install_config.stamp
build _usb4_devinfo_helper-install_config: phony obj/debugd/_usb4_devinfo_helper-install_config.stamp
build cryptohome-proto: phony ./libcryptohome-proto.a
build cryptohome-proto_gen: phony obj/debugd/cryptohome-proto_gen.stamp
build debugd-adaptors: phony obj/debugd/debugd-adaptors.stamp
build debugd_dbus_utils: phony ./libdebugd_dbus_utils.a
build debugd_share_config: phony obj/debugd/debugd_share_config.stamp
build install_helper_scripts: phony obj/debugd/install_helper_scripts.stamp
build install_tmpfilesd: phony obj/debugd/install_tmpfilesd.stamp
build install_tmpfilesd_dev: phony obj/debugd/install_tmpfilesd_dev.stamp
build libdebugd: phony ./libdebugd.a
build power_manager-proto: phony ./libpower_manager-proto.a
build power_manager-proto_gen: phony obj/debugd/power_manager-proto_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build scheduler_configuration_utils: phony ./libscheduler_configuration_utils.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build debugd$:_audit_log_filter-install_config: phony obj/debugd/_audit_log_filter-install_config.stamp
build debugd$:_bt_usb_disconnect_helper-install_config: phony obj/debugd/_bt_usb_disconnect_helper-install_config.stamp
build debugd$:_capture_packets-install_config: phony obj/debugd/_capture_packets-install_config.stamp
