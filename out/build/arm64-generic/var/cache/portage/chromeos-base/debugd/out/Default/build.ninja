    obj/debugd/_folder_size_dump-install_config.stamp $
    obj/debugd/_generate_logs-install_config.stamp $
    obj/debugd/_icmp-install_config.stamp $
    obj/debugd/_modetest_helper-install_config.stamp $
    obj/debugd/_netif-install_config.stamp $
    obj/debugd/_network_status-install_config.stamp $
    obj/debugd/_scheduler_configuration_helper-install_config.stamp $
    obj/debugd/_typec_connector_class_helper-install_config.stamp $
    obj/debugd/_usb4_devinfo_helper-install_config.stamp $
    obj/debugd/all.stamp $
    ./audit_log_filter $
