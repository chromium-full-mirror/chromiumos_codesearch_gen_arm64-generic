defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/debugd-0.0.1-r3790/work/debugd-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DPROTOBUF_USE_DLLS
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fvisibility=default -flto=thin -fsanitize=cfi-derived-cast -fsanitize=cfi-icall -fsanitize=cfi-vcall -fsanitize=cfi-unrelated-cast -fsanitize-ignorelist=/build/arm64-generic/tmp/portage/chromeos-base/debugd-0.0.1-r3790/files/cfi-ignore.txt -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libpower_manager-proto

build obj/gen/include/libpower_manager-proto.battery_saver.pb.o: cxx gen/include/battery_saver.pb.cc || obj/debugd/power_manager-proto_gen.stamp
  source_file_part = battery_saver.pb.cc
  source_name_part = battery_saver.pb

build ./libpower_manager-proto.a: alink obj/gen/include/libpower_manager-proto.battery_saver.pb.o || obj/debugd/power_manager-proto_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
