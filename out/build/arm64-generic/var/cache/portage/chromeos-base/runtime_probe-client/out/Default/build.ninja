ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _runtime_probe-client-pc-install_config: phony obj/runtime_probe/client/_runtime_probe-client-pc-install_config.stamp
build _runtime_probe-client-test-pc-install_config: phony obj/runtime_probe/client/_runtime_probe-client-test-pc-install_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build runtime_probe-client-headers: phony obj/runtime_probe/client/runtime_probe-client-headers.stamp
build runtime_probe-client-pc: phony obj/runtime_probe/client/runtime_probe-client-pc.stamp
build runtime_probe-client-test-pc: phony obj/runtime_probe/client/runtime_probe-client-test-pc.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build runtime_probe/client$:_runtime_probe-client-pc-install_config: phony obj/runtime_probe/client/_runtime_probe-client-pc-install_config.stamp
build runtime_probe/client$:_runtime_probe-client-test-pc-install_config: phony obj/runtime_probe/client/_runtime_probe-client-test-pc-install_config.stamp
build runtime_probe/client$:all: phony obj/runtime_probe/client/all.stamp
build runtime_probe/client$:runtime_probe-client-headers: phony obj/runtime_probe/client/runtime_probe-client-headers.stamp
build runtime_probe/client$:runtime_probe-client-pc: phony obj/runtime_probe/client/runtime_probe-client-pc.stamp
build runtime_probe/client$:runtime_probe-client-test-pc: phony obj/runtime_probe/client/runtime_probe-client-test-pc.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/runtime_probe/client/_runtime_probe-client-pc-install_config.stamp $
    obj/runtime_probe/client/_runtime_probe-client-test-pc-install_config.stamp $
    obj/runtime_probe/client/all.stamp $
    obj/runtime_probe/client/runtime_probe-client-headers.stamp $
    obj/runtime_probe/client/runtime_probe-client-pc.stamp $
    obj/runtime_probe/client/runtime_probe-client-test-pc.stamp

default all
