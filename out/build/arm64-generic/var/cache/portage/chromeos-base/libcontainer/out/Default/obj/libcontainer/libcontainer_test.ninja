defines = -DUNIT_TEST -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_device_mapper=true
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libcontainer_test

build obj/libcontainer/libcontainer_test.cgroup.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/cgroup.cc
  source_file_part = cgroup.cc
  source_name_part = cgroup
build obj/libcontainer/libcontainer_test.cgroup_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/cgroup_test.cc
  source_file_part = cgroup_test.cc
  source_name_part = cgroup_test
build obj/libcontainer/libcontainer_test.config.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/config.cc
  source_file_part = config.cc
  source_name_part = config
build obj/libcontainer/libcontainer_test.container.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/container.cc
  source_file_part = container.cc
  source_name_part = container
build obj/libcontainer/libcontainer_test.libcontainer.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/libcontainer.cc
  source_file_part = libcontainer.cc
  source_name_part = libcontainer
build obj/libcontainer/libcontainer_test.libcontainer_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/libcontainer_test.cc
  source_file_part = libcontainer_test.cc
  source_name_part = libcontainer_test
build obj/libcontainer/libcontainer_test.libcontainer_util.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libcontainer/libcontainer_util.cc
  source_file_part = libcontainer_util.cc
  source_name_part = libcontainer_util

build ./libcontainer_test: link obj/libcontainer/libcontainer_test.cgroup.o obj/libcontainer/libcontainer_test.cgroup_test.o obj/libcontainer/libcontainer_test.config.o obj/libcontainer/libcontainer_test.container.o obj/libcontainer/libcontainer_test.libcontainer.o obj/libcontainer/libcontainer_test.libcontainer_test.o obj/libcontainer/libcontainer_test.libcontainer_util.o ./libtestrunner.a
  ldflags = -Wl,-wrap=chmod -Wl,-wrap=chown -Wl,-wrap=getuid -Wl,-wrap=kill -Wl,-wrap=mkdir -Wl,-wrap=mkdtemp -Wl,-wrap=mount -Wl,-wrap=rmdir -Wl,-wrap=setns -Wl,-wrap=umount -Wl,-wrap=umount2 -Wl,-wrap=unlink -Wl,-wrap=mknod -Wl,-wrap=stat -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/lib64
  libs = -lgmock -lgtest -lpthread -lbase -lminijail -ldevmapper -lbase-test -lbrillo
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
