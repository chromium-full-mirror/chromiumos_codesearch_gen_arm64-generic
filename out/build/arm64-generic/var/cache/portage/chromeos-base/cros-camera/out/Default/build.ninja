ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cros_camera_service-install_config: phony obj/camera/hal_adapter/_cros_camera_service-install_config.stamp
build _install_cros_camera_policy-check_seccomp: phony obj/camera/hal_adapter/_install_cros_camera_policy-check_seccomp.stamp
build dlc_client: phony ./libdlc_client.a
build install_cros_camera_conf: phony obj/camera/hal_adapter/install_cros_camera_conf.stamp
build install_cros_camera_policy: phony obj/camera/hal_adapter/install_cros_camera_policy.stamp
build install_cros_camera_service_mojo: phony obj/camera/hal_adapter/install_cros_camera_service_mojo.stamp
build install_dbus_cros_camera_conf: phony obj/camera/hal_adapter/install_dbus_cros_camera_conf.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build camera/hal_adapter$:_cros_camera_service-install_config: phony obj/camera/hal_adapter/_cros_camera_service-install_config.stamp
build camera/hal_adapter$:_install_cros_camera_policy-check_seccomp: phony obj/camera/hal_adapter/_install_cros_camera_policy-check_seccomp.stamp
build camera/hal_adapter$:all: phony obj/camera/hal_adapter/all.stamp
build camera/hal_adapter$:cros_camera_service: phony ./cros_camera_service
build camera/hal_adapter$:install_cros_camera_conf: phony obj/camera/hal_adapter/install_cros_camera_conf.stamp
build camera/hal_adapter$:install_cros_camera_policy: phony obj/camera/hal_adapter/install_cros_camera_policy.stamp
build camera/hal_adapter$:install_cros_camera_service_mojo: phony obj/camera/hal_adapter/install_cros_camera_service_mojo.stamp
build camera/hal_adapter$:install_dbus_cros_camera_conf: phony obj/camera/hal_adapter/install_dbus_cros_camera_conf.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build ml_core/dlc$:all: phony obj/ml_core/dlc/all.stamp
build ml_core/dlc$:dlc_client: phony ./libdlc_client.a

build all: phony $
    obj/camera/hal_adapter/_cros_camera_service-install_config.stamp $
    obj/camera/hal_adapter/_install_cros_camera_policy-check_seccomp.stamp $
    obj/camera/hal_adapter/all.stamp $
    ./cros_camera_service $
    obj/camera/hal_adapter/install_cros_camera_conf.stamp $
    obj/camera/hal_adapter/install_cros_camera_policy.stamp $
    obj/camera/hal_adapter/install_cros_camera_service_mojo.stamp $
    obj/camera/hal_adapter/install_dbus_cros_camera_conf.stamp $
    obj/common-mk/gn_root/root.stamp $
    obj/ml_core/dlc/all.stamp $
    ./libdlc_client.a

default all
