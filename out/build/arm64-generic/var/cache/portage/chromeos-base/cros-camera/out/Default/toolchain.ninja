rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/camera/hal_adapter/_cros_camera_service-install_config.stamp: stamp
rule __camera_hal_adapter__install_cros_camera_policy-check_seccomp___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env /usr/bin/compile_seccomp_policy --arch-json /build/arm64-generic/build/share/constants.json ${in} /build/arm64-generic/var/cache/portage/chromeos-base/cros-camera/out/Default/gen/camera/hal_adapter/seccomp/${source_name_part}.bpf
  description = ACTION //camera/hal_adapter:_install_cros_camera_policy-check_seccomp(//common-mk/toolchain:toolchain)
  restat = 1

build gen/camera/hal_adapter/seccomp/cros-camera-arm64.bpf: __camera_hal_adapter__install_cros_camera_policy-check_seccomp___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/cros-camera-0.0.1-r1970/work/cros-camera-0.0.1/camera/hal_adapter/seccomp_filter/cros-camera-arm64.policy | ../../../../../../../../../usr/bin/compile_seccomp_policy ../../../../../../../build/share/constants.json
  source_name_part = cros-camera-arm64

build obj/camera/hal_adapter/_install_cros_camera_policy-check_seccomp.stamp: stamp gen/camera/hal_adapter/seccomp/cros-camera-arm64.bpf
build obj/camera/hal_adapter/all.stamp: stamp ./cros_camera_service obj/camera/hal_adapter/install_cros_camera_conf.stamp obj/camera/hal_adapter/install_cros_camera_policy.stamp obj/camera/hal_adapter/install_cros_camera_service_mojo.stamp obj/camera/hal_adapter/install_dbus_cros_camera_conf.stamp
subninja obj/camera/hal_adapter/cros_camera_service.ninja
build obj/camera/hal_adapter/install_cros_camera_conf.stamp: stamp
build obj/camera/hal_adapter/install_cros_camera_policy.stamp: stamp obj/camera/hal_adapter/_install_cros_camera_policy-check_seccomp.stamp
build obj/camera/hal_adapter/install_cros_camera_service_mojo.stamp: stamp
build obj/camera/hal_adapter/install_dbus_cros_camera_conf.stamp: stamp
build obj/common-mk/gn_root/root.stamp: stamp obj/camera/hal_adapter/all.stamp
build obj/ml_core/dlc/all.stamp: stamp ./libdlc_client.a
subninja obj/ml_core/dlc/dlc_client.ninja
