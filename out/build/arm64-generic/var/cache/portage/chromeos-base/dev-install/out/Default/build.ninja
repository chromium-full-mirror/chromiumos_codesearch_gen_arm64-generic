ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/dev-install-0.0.1-r1539/work/dev-install-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _dev_install-install_config: phony obj/dev-install/_dev_install-install_config.stamp
build install_bashrc: phony obj/dev-install/install_bashrc.stamp
build install_envd: phony obj/dev-install/install_envd.stamp
build install_make_defaults: phony obj/dev-install/install_make_defaults.stamp
build libdev_install: phony ./libdev_install.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build dev-install$:_dev_install-install_config: phony obj/dev-install/_dev_install-install_config.stamp
build dev-install$:all: phony obj/dev-install/all.stamp
build dev-install$:dev_install: phony ./dev_install
build dev-install$:install_bashrc: phony obj/dev-install/install_bashrc.stamp
build dev-install$:install_envd: phony obj/dev-install/install_envd.stamp
build dev-install$:install_make_defaults: phony obj/dev-install/install_make_defaults.stamp
build dev-install$:libdev_install: phony ./libdev_install.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/dev-install/_dev_install-install_config.stamp $
    obj/dev-install/all.stamp $
    ./dev_install $
    obj/dev-install/install_bashrc.stamp $
    obj/dev-install/install_envd.stamp $
    obj/dev-install/install_make_defaults.stamp $
    ./libdev_install.a

default all
