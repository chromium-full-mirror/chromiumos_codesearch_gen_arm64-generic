ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/dns-proxy-0.0.1-r875/work/dns-proxy-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _dnsproxyd-install_config: phony obj/dns-proxy/_dnsproxyd-install_config.stamp
build dnsproxy_ipc_protos: phony ./libdnsproxy_ipc_protos.a
build dnsproxy_ipc_protos_gen: phony obj/dns-proxy/dnsproxy_ipc_protos_gen.stamp
build install_config: phony obj/dns-proxy/tmpfiles.d/install_config.stamp
build install_init_config: phony obj/dns-proxy/install_init_config.stamp
build install_seccomp_policy: phony obj/dns-proxy/install_seccomp_policy.stamp
build libdnsproxy: phony ./libdnsproxy.a
build root: phony obj/common-mk/gn_root/root.stamp
build tmpfiles.d: phony obj/dns-proxy/tmpfiles.d/tmpfiles.d.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build dns-proxy$:_dnsproxyd-install_config: phony obj/dns-proxy/_dnsproxyd-install_config.stamp
build dns-proxy$:all: phony obj/dns-proxy/all.stamp
build dns-proxy$:dnsproxy_ipc_protos: phony ./libdnsproxy_ipc_protos.a
build dns-proxy$:dnsproxy_ipc_protos_gen: phony obj/dns-proxy/dnsproxy_ipc_protos_gen.stamp
build dns-proxy$:dnsproxyd: phony ./dnsproxyd
build dns-proxy$:install_init_config: phony obj/dns-proxy/install_init_config.stamp
build dns-proxy$:install_seccomp_policy: phony obj/dns-proxy/install_seccomp_policy.stamp
build dns-proxy$:libdnsproxy: phony ./libdnsproxy.a
build dns-proxy/tmpfiles.d$:install_config: phony obj/dns-proxy/tmpfiles.d/install_config.stamp
build dns-proxy/tmpfiles.d$:tmpfiles.d: phony obj/dns-proxy/tmpfiles.d/tmpfiles.d.stamp
build dns-proxy/tmpfiles.d: phony obj/dns-proxy/tmpfiles.d/tmpfiles.d.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/dns-proxy/_dnsproxyd-install_config.stamp $
    obj/dns-proxy/all.stamp $
    ./libdnsproxy_ipc_protos.a $
    obj/dns-proxy/dnsproxy_ipc_protos_gen.stamp $
    ./dnsproxyd $
    obj/dns-proxy/install_init_config.stamp $
    obj/dns-proxy/install_seccomp_policy.stamp $
    ./libdnsproxy.a $
    obj/dns-proxy/tmpfiles.d/install_config.stamp $
    obj/dns-proxy/tmpfiles.d/tmpfiles.d.stamp

default all
