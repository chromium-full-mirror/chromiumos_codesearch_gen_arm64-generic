ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/g2f_tools-0.0.1-r1438/work/g2f_tools-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _g2ftool-install_config: phony obj/u2fd/g2f_tools/_g2ftool-install_config.stamp
build _webauthntool-install_config: phony obj/u2fd/g2f_tools/_webauthntool-install_config.stamp
build libg2fclient: phony ./libg2fclient.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build u2fd/g2f_tools$:_g2ftool-install_config: phony obj/u2fd/g2f_tools/_g2ftool-install_config.stamp
build u2fd/g2f_tools$:_webauthntool-install_config: phony obj/u2fd/g2f_tools/_webauthntool-install_config.stamp
build u2fd/g2f_tools$:all: phony obj/u2fd/g2f_tools/all.stamp
build u2fd/g2f_tools$:g2ftool: phony ./g2ftool
build u2fd/g2f_tools$:libg2fclient: phony ./libg2fclient.a
build u2fd/g2f_tools$:webauthntool: phony ./webauthntool

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/u2fd/g2f_tools/_g2ftool-install_config.stamp $
    obj/u2fd/g2f_tools/_webauthntool-install_config.stamp $
    obj/u2fd/g2f_tools/all.stamp $
    ./g2ftool $
    ./libg2fclient.a $
    ./webauthntool

default all
