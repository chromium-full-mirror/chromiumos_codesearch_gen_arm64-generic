ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/device_management-client-0.0.1-r108/work/device_management-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libdevice_management-client-headers: phony obj/device_management/client/libdevice_management-client-headers.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build device_management/client$:all: phony obj/device_management/client/all.stamp
build device_management/client$:libdevice_management-client-headers: phony obj/device_management/client/libdevice_management-client-headers.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/device_management/client/all.stamp $
    obj/device_management/client/libdevice_management-client-headers.stamp

default all
