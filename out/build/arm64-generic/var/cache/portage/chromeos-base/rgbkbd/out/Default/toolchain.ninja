rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/rgbkbd/all.stamp
build obj/rgbkbd/_rgbkbd-install_config.stamp: stamp
build obj/rgbkbd/all.stamp: stamp obj/rgbkbd/install_dbus_activation.stamp obj/rgbkbd/install_dbus_config.stamp obj/rgbkbd/install_minijail_config.stamp obj/rgbkbd/install_seccomp_policy.stamp obj/rgbkbd/install_upstart_config.stamp ./rgbkbd
build obj/rgbkbd/install_dbus_activation.stamp: stamp
build obj/rgbkbd/install_dbus_config.stamp: stamp
build obj/rgbkbd/install_minijail_config.stamp: stamp
build obj/rgbkbd/install_seccomp_policy.stamp: stamp
build obj/rgbkbd/install_upstart_config.stamp: stamp
subninja obj/rgbkbd/librgbkbd.ninja
subninja obj/rgbkbd/rgbkbd.ninja
rule __rgbkbd_rgbkbd-adaptor___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/rgbkbd-0.0.1-r510/work/rgbkbd-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/rgbkbd/out/Default/gen/include/rgbkbd/dbus_adaptors/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/rgbkbd-0.0.1-r510/work/rgbkbd-0.0.1/rgbkbd/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //rgbkbd:rgbkbd-adaptor(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/rgbkbd/dbus_adaptors/org.chromium.Rgbkbd.h: __rgbkbd_rgbkbd-adaptor___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/rgbkbd-0.0.1-r510/work/rgbkbd-0.0.1/rgbkbd/dbus_bindings/org.chromium.Rgbkbd.xml | ../../../../../../../tmp/portage/chromeos-base/rgbkbd-0.0.1-r510/work/rgbkbd-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.Rgbkbd

build obj/rgbkbd/rgbkbd-adaptor.stamp: stamp gen/include/rgbkbd/dbus_adaptors/org.chromium.Rgbkbd.h
