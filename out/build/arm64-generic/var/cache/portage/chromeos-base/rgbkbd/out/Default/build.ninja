ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/rgbkbd-0.0.1-r511/work/rgbkbd-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _rgbkbd-install_config: phony obj/rgbkbd/_rgbkbd-install_config.stamp
build install_dbus_activation: phony obj/rgbkbd/install_dbus_activation.stamp
build install_dbus_config: phony obj/rgbkbd/install_dbus_config.stamp
build install_minijail_config: phony obj/rgbkbd/install_minijail_config.stamp
build install_seccomp_policy: phony obj/rgbkbd/install_seccomp_policy.stamp
build install_upstart_config: phony obj/rgbkbd/install_upstart_config.stamp
build librgbkbd: phony ./librgbkbd.a
build rgbkbd-adaptor: phony obj/rgbkbd/rgbkbd-adaptor.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build rgbkbd$:_rgbkbd-install_config: phony obj/rgbkbd/_rgbkbd-install_config.stamp
build rgbkbd$:all: phony obj/rgbkbd/all.stamp
build rgbkbd$:install_dbus_activation: phony obj/rgbkbd/install_dbus_activation.stamp
build rgbkbd$:install_dbus_config: phony obj/rgbkbd/install_dbus_config.stamp
build rgbkbd$:install_minijail_config: phony obj/rgbkbd/install_minijail_config.stamp
build rgbkbd$:install_seccomp_policy: phony obj/rgbkbd/install_seccomp_policy.stamp
build rgbkbd$:install_upstart_config: phony obj/rgbkbd/install_upstart_config.stamp
build rgbkbd$:librgbkbd: phony ./librgbkbd.a
build rgbkbd$:rgbkbd: phony ./rgbkbd
build rgbkbd$:rgbkbd-adaptor: phony obj/rgbkbd/rgbkbd-adaptor.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/rgbkbd/_rgbkbd-install_config.stamp $
    obj/rgbkbd/all.stamp $
    obj/rgbkbd/install_dbus_activation.stamp $
    obj/rgbkbd/install_dbus_config.stamp $
    obj/rgbkbd/install_minijail_config.stamp $
    obj/rgbkbd/install_seccomp_policy.stamp $
    obj/rgbkbd/install_upstart_config.stamp $
    ./librgbkbd.a $
    ./rgbkbd $
    obj/rgbkbd/rgbkbd-adaptor.stamp

default all
