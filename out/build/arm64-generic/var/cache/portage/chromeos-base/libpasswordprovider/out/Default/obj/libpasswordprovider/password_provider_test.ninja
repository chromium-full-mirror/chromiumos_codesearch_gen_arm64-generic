defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = password_provider_test

build obj/libpasswordprovider/password_provider_test.password.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libpasswordprovider/password.cc
  source_file_part = password.cc
  source_name_part = password
build obj/libpasswordprovider/password_provider_test.password_provider.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libpasswordprovider/password_provider.cc
  source_file_part = password_provider.cc
  source_name_part = password_provider
build obj/libpasswordprovider/password_provider_test.password_provider_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libpasswordprovider/password_provider_test.cc
  source_file_part = password_provider_test.cc
  source_name_part = password_provider_test
build obj/libpasswordprovider/password_provider_test.password_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libpasswordprovider/password_test.cc
  source_file_part = password_test.cc
  source_name_part = password_test

build ./password_provider_test: link obj/libpasswordprovider/password_provider_test.password.o obj/libpasswordprovider/password_provider_test.password_provider.o obj/libpasswordprovider/password_provider_test.password_provider_test.o obj/libpasswordprovider/password_provider_test.password_test.o ./lib/libpasswordprovider.so ./libtestrunner.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/
  libs = -lkeyutils -lgmock -lgtest -lpthread -lbase -lbrillo -lbase-test
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
