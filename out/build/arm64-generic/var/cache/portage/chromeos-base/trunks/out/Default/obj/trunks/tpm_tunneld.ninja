defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_GENERIC_TPM2=false -DUSE_PINWEAVER_CSME=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/chromeos
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = tpm_tunneld

build obj/trunks/tpm_tunneld.inputdeps.stamp: stamp obj/trunks/interface_proto_gen.stamp obj/trunks/pinweaver_proto_gen.stamp
build obj/trunks/csme/tpm_tunneld.tpm_tunnel_service.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/tpm_tunnel_service.cc || obj/trunks/tpm_tunneld.inputdeps.stamp
  source_file_part = tpm_tunnel_service.cc
  source_name_part = tpm_tunnel_service
build obj/trunks/csme/tpm_tunneld.tpm_tunneld.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/tpm_tunneld.cc || obj/trunks/tpm_tunneld.inputdeps.stamp
  source_file_part = tpm_tunneld.cc
  source_name_part = tpm_tunneld

build ./tpm_tunneld: link obj/trunks/csme/tpm_tunneld.tpm_tunnel_service.o obj/trunks/csme/tpm_tunneld.tpm_tunneld.o ./lib/libtrunks.so
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -L/build/arm64-generic/usr/lib64
  libs = -lhwsec-foundation -lbrillo -lbase -lpthread -lmetrics -lssl -lcrypto -lprotobuf-lite -lminijail
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
