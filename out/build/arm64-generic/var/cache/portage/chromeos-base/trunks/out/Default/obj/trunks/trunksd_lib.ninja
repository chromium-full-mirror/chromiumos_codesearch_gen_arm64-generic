defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_GENERIC_TPM2=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -pthread -DPROTOBUF_USE_DLLS -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1241304 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -DPROTOBUF_USE_DLLS -I/build/arm64-generic/usr/include/power_manager-client -I/build/arm64-generic/usr/include/power_manager-client
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libtrunksd_lib

build obj/trunks/trunksd_lib.inputdeps.stamp: stamp obj/trunks/interface_proto_gen.stamp obj/trunks/pinweaver_proto_gen.stamp
build obj/trunks/libtrunksd_lib.power_manager.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/power_manager.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = power_manager.cc
  source_name_part = power_manager
build obj/trunks/resilience/libtrunksd_lib.write_error_tracker_impl.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/resilience/write_error_tracker_impl.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = write_error_tracker_impl.cc
  source_name_part = write_error_tracker_impl
build obj/trunks/libtrunksd_lib.resource_manager.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/resource_manager.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = resource_manager.cc
  source_name_part = resource_manager
build obj/trunks/libtrunksd_lib.tpm_handle.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/tpm_handle.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = tpm_handle.cc
  source_name_part = tpm_handle
build obj/trunks/libtrunksd_lib.trunks_dbus_service.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/trunks_dbus_service.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = trunks_dbus_service.cc
  source_name_part = trunks_dbus_service
build obj/trunks/libtrunksd_lib.trunks_metrics.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/trunks_metrics.cc || obj/trunks/trunksd_lib.inputdeps.stamp
  source_file_part = trunks_metrics.cc
  source_name_part = trunks_metrics

build ./libtrunksd_lib.a: alink obj/trunks/libtrunksd_lib.power_manager.o obj/trunks/resilience/libtrunksd_lib.write_error_tracker_impl.o obj/trunks/libtrunksd_lib.resource_manager.o obj/trunks/libtrunksd_lib.tpm_handle.o obj/trunks/libtrunksd_lib.trunks_dbus_service.o obj/trunks/libtrunksd_lib.trunks_metrics.o || ./lib/libtrunks.so
  arflags = rcs
  output_extension = .a
  output_dir = 
