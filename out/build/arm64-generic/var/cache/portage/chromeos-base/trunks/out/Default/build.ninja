ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/trunks-0.0.1-r3748/work/trunks-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build trunks: phony ./lib/libtrunks.so
build install_freezer_tmpfilesd: phony obj/trunks/install_freezer_tmpfilesd.stamp
build install_pre_init_config: phony obj/trunks/install_pre_init_config.stamp
build install_tmpfiles_config: phony obj/trunks/install_tmpfiles_config.stamp
build install_trunksd_conf: phony obj/trunks/install_trunksd_conf.stamp
build interface_proto: phony ./libinterface_proto.a
build interface_proto_gen: phony obj/trunks/interface_proto_gen.stamp
build libtrunks: phony obj/trunks/libtrunks.stamp
build pinweaver_proto: phony ./libpinweaver_proto.a
build pinweaver_proto_gen: phony obj/trunks/pinweaver_proto_gen.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build trunks_adaptors: phony obj/trunks/trunks_adaptors.stamp
build trunks_proxies: phony obj/trunks/trunks_proxies.stamp
build trunks_test: phony ./libtrunks_test.a
build trunksd_lib: phony ./libtrunksd_lib.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build trunks$:all: phony obj/trunks/all.stamp
build trunks$:install_freezer_tmpfilesd: phony obj/trunks/install_freezer_tmpfilesd.stamp
build trunks$:install_pre_init_config: phony obj/trunks/install_pre_init_config.stamp
build trunks$:install_tmpfiles_config: phony obj/trunks/install_tmpfiles_config.stamp
build trunks$:install_trunksd_conf: phony obj/trunks/install_trunksd_conf.stamp
build trunks$:interface_proto: phony ./libinterface_proto.a
build trunks$:interface_proto_gen: phony obj/trunks/interface_proto_gen.stamp
build trunks$:libtrunks: phony obj/trunks/libtrunks.stamp
build trunks$:pinweaver_client: phony ./pinweaver_client
build trunks$:pinweaver_proto: phony ./libpinweaver_proto.a
build trunks$:pinweaver_proto_gen: phony obj/trunks/pinweaver_proto_gen.stamp
build trunks$:trunks: phony ./lib/libtrunks.so
build trunks$:trunks_adaptors: phony obj/trunks/trunks_adaptors.stamp
build trunks$:trunks_client: phony ./trunks_client
build trunks$:trunks_proxies: phony obj/trunks/trunks_proxies.stamp
build trunks$:trunks_send: phony ./trunks_send
build trunks$:trunks_test: phony ./libtrunks_test.a
build trunks$:trunksd: phony ./trunksd
build trunks$:trunksd_lib: phony ./libtrunksd_lib.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/trunks/all.stamp $
    obj/trunks/install_freezer_tmpfilesd.stamp $
    obj/trunks/install_pre_init_config.stamp $
    obj/trunks/install_tmpfiles_config.stamp $
    obj/trunks/install_trunksd_conf.stamp $
    ./libinterface_proto.a $
    obj/trunks/interface_proto_gen.stamp $
    obj/trunks/libtrunks.stamp $
    ./pinweaver_client $
    ./libpinweaver_proto.a $
    obj/trunks/pinweaver_proto_gen.stamp $
    ./lib/libtrunks.so $
    obj/trunks/trunks_adaptors.stamp $
    ./trunks_client $
    obj/trunks/trunks_proxies.stamp $
    ./trunks_send $
    ./libtrunks_test.a $
    ./trunksd $
    ./libtrunksd_lib.a

default all
