defines = -DUSE_CSME_EMULATOR=false -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_GENERIC_TPM2=false -DUSE_PINWEAVER_CSME=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -fPIC
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = pinweaver_csme_lib

build obj/trunks/csme/pinweaver_csme_lib.mei_client_char_device.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/mei_client_char_device.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = mei_client_char_device.cc
  source_name_part = mei_client_char_device
build obj/trunks/csme/pinweaver_csme_lib.mei_client_factory.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/mei_client_factory.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = mei_client_factory.cc
  source_name_part = mei_client_factory
build obj/trunks/csme/pinweaver_csme_lib.mei_client_socket.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/mei_client_socket.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = mei_client_socket.cc
  source_name_part = mei_client_socket
build obj/trunks/csme/pinweaver_csme_lib.pinweaver_core_client.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/pinweaver_core_client.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = pinweaver_core_client.cc
  source_name_part = pinweaver_core_client
build obj/trunks/csme/pinweaver_csme_lib.pinweaver_core_client_null.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/pinweaver_core_client_null.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = pinweaver_core_client_null.cc
  source_name_part = pinweaver_core_client_null
build obj/trunks/csme/pinweaver_csme_lib.pinweaver_provision_client.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/pinweaver_provision_client.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = pinweaver_provision_client.cc
  source_name_part = pinweaver_provision_client
build obj/trunks/csme/pinweaver_csme_lib.pinweaver_provision_impl.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/trunks/csme/pinweaver_provision_impl.cc || obj/trunks/pinweaver_proto_gen.stamp
  source_file_part = pinweaver_provision_impl.cc
  source_name_part = pinweaver_provision_impl

build obj/trunks/pinweaver_csme_lib.stamp: stamp obj/trunks/csme/pinweaver_csme_lib.mei_client_char_device.o obj/trunks/csme/pinweaver_csme_lib.mei_client_factory.o obj/trunks/csme/pinweaver_csme_lib.mei_client_socket.o obj/trunks/csme/pinweaver_csme_lib.pinweaver_core_client.o obj/trunks/csme/pinweaver_csme_lib.pinweaver_core_client_null.o obj/trunks/csme/pinweaver_csme_lib.pinweaver_provision_client.o obj/trunks/csme/pinweaver_csme_lib.pinweaver_provision_impl.o || ./libpinweaver_proto.a
