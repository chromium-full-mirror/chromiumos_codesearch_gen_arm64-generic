defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_TPM1=false -DUSE_TPM2=true -DUSE_TPM2_SIMULATOR=false -DUSE_TPM_DYNAMIC=false -DUSE_GENERIC_TPM2=false -DUSE_CR50_ONBOARD=false -DUSE_TI50_ONBOARD=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
root_out_dir = .
target_output_name = libattestation


build ./lib/libattestation.so: solink obj/gen/attestation/common/proto_library.print_attestation_ca_proto.o obj/gen/attestation/common/proto_library.print_interface_proto.o obj/gen/attestation/common/proto_library.print_keystore_proto.o || obj/attestation/proto_library.stamp obj/attestation/_libattestation-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lsystem_api -lbrillo -lbase -lpthread -lprotobuf-lite
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
