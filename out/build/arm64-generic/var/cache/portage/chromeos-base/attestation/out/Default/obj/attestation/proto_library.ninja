defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_TPM1=false -DUSE_TPM2=true -DUSE_TPM2_SIMULATOR=false -DUSE_TPM_DYNAMIC=false -DUSE_GENERIC_TPM2=false -DUSE_CR50_ONBOARD=false -DUSE_TI50_ONBOARD=false
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/attestation-0.0.1-r4281/work/attestation-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -Wconsumed -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -DPROTOBUF_USE_DLLS -pthread -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1252475 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = proto_library

build obj/gen/attestation/common/proto_library.print_attestation_ca_proto.o: cxx gen/attestation/common/print_attestation_ca_proto.cc || obj/attestation/print_proto_library.stamp
  source_file_part = print_attestation_ca_proto.cc
  source_name_part = print_attestation_ca_proto
build obj/gen/attestation/common/proto_library.print_interface_proto.o: cxx gen/attestation/common/print_interface_proto.cc || obj/attestation/print_proto_library.stamp
  source_file_part = print_interface_proto.cc
  source_name_part = print_interface_proto
build obj/gen/attestation/common/proto_library.print_keystore_proto.o: cxx gen/attestation/common/print_keystore_proto.cc || obj/attestation/print_proto_library.stamp
  source_file_part = print_keystore_proto.cc
  source_name_part = print_keystore_proto

build obj/attestation/proto_library.stamp: stamp obj/gen/attestation/common/proto_library.print_attestation_ca_proto.o obj/gen/attestation/common/proto_library.print_interface_proto.o obj/gen/attestation/common/proto_library.print_keystore_proto.o || obj/attestation/print_proto_library.stamp
