build ./lib/libnet-base.so: solink obj/net-base/libnet-base.ares_interface.o obj/net-base/libnet-base.byte_utils.o obj/net-base/libnet-base.dns_client.o obj/net-base/libnet-base.ip_address.o obj/net-base/libnet-base.ip_address_utils.o obj/net-base/libnet-base.ipv4_address.o obj/net-base/libnet-base.ipv6_address.o obj/net-base/libnet-base.mac_address.o obj/net-base/libnet-base.netlink_sock_diag.o obj/net-base/libnet-base.netlink_socket.o obj/net-base/libnet-base.rtnl_handler.o obj/net-base/libnet-base.rtnl_listener.o obj/net-base/libnet-base.rtnl_message.o obj/net-base/libnet-base.socket.o || obj/net-base/_libnet-base-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lcares -lbase -lpthread
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
