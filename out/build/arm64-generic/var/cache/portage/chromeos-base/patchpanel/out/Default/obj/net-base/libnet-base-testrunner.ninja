build ./libnet-base-testrunner: link obj/net-base/libnet-base-testrunner.byte_utils_test.o obj/net-base/libnet-base-testrunner.dns_client_test.o obj/net-base/libnet-base-testrunner.ip_address_test.o obj/net-base/libnet-base-testrunner.ipv4_address_test.o obj/net-base/libnet-base-testrunner.ipv6_address_test.o obj/net-base/libnet-base-testrunner.mac_address_test.o obj/net-base/libnet-base-testrunner.netlink_socket_test.o obj/net-base/libnet-base-testrunner.rtnl_handler_test.o obj/net-base/libnet-base-testrunner.rtnl_listener_test.o obj/net-base/libnet-base-testrunner.rtnl_message_test.o obj/net-base/libnet-base-testrunner.socket_test.o obj/net-base/net_base_test_support.mock_netlink_socket.o obj/net-base/net_base_test_support.mock_rtnl_handler.o obj/net-base/net_base_test_support.mock_socket.o ./lib/libnet-base.so ./libtestrunner.a || obj/net-base/net_base_test_support.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -lcares -lbase -lbase-test -lnet-base -lre2 -lbrillo
