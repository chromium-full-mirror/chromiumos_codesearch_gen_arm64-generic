ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/routing-simulator-0.0.1-r102/work/routing-simulator-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _routing-simulator-install_config: phony obj/routing-simulator/_routing-simulator-install_config.stamp
build librouting-simulator: phony ./librouting-simulator.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build routing-simulator$:_routing-simulator-install_config: phony obj/routing-simulator/_routing-simulator-install_config.stamp
build routing-simulator$:all: phony obj/routing-simulator/all.stamp
build routing-simulator$:librouting-simulator: phony ./librouting-simulator.a
build routing-simulator$:routing-simulator: phony ./routing-simulator

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/routing-simulator/_routing-simulator-install_config.stamp $
    obj/routing-simulator/all.stamp $
    ./librouting-simulator.a $
    ./routing-simulator

default all
