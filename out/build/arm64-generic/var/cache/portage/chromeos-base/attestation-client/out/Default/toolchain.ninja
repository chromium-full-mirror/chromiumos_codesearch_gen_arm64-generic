rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/attestation/client/all.stamp: stamp obj/attestation/client/libattestation-client-headers.stamp
rule __attestation_client_libattestation-client-headers___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -service-config=/mnt/host/source/src/platform2/attestation/common/dbus_bindings/dbus-service-config.json -proxy=/build/arm64-generic/var/cache/portage/chromeos-base/attestation-client/out/Default/gen/include/attestation/dbus-proxies.h -mock=/build/arm64-generic/var/cache/portage/chromeos-base/attestation-client/out/Default/gen/include/attestation/dbus-proxy-mocks.h -proxy-path-for-mocks=attestation/dbus-proxies.h ../../../../../../../../../mnt/host/source/src/platform2/attestation/common/dbus_bindings/org.chromium.Attestation.xml
  description = ACTION //attestation/client:libattestation-client-headers(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/attestation/dbus-proxies.h gen/include/attestation/dbus-proxy-mocks.h: __attestation_client_libattestation-client-headers___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../mnt/host/source/src/platform2/attestation/common/dbus_bindings/org.chromium.Attestation.xml

build obj/attestation/client/libattestation-client-headers.stamp: stamp gen/include/attestation/dbus-proxies.h gen/include/attestation/dbus-proxy-mocks.h
build obj/common-mk/gn_root/root.stamp: stamp obj/attestation/client/all.stamp
