defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/login_manager/login_screen_storage -Igen/include -I../../../../../../../tmp/portage/chromeos-base/chromeos-login-0.0.2-r5705/work/chromeos-login-0.0.2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = liblogin_manager-login_screen_storage-protos

build obj/gen/include/login_manager/login_screen_storage/liblogin_manager-login_screen_storage-protos.login_screen_storage_index.pb.o: cxx gen/include/login_manager/login_screen_storage/login_screen_storage_index.pb.cc || obj/login_manager/login_manager-login_screen_storage-protos_gen.stamp
  source_file_part = login_screen_storage_index.pb.cc
  source_name_part = login_screen_storage_index.pb

build ./liblogin_manager-login_screen_storage-protos.a: alink obj/gen/include/login_manager/login_screen_storage/liblogin_manager-login_screen_storage-protos.login_screen_storage_index.pb.o || obj/login_manager/login_manager-login_screen_storage-protos_gen.stamp
  arflags = rcs
  output_extension = .a
  output_dir = 
