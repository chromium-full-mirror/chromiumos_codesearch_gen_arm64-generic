defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DBUILD_LIBHWSEC -DENABLE_PROFILING=false -DUSE_TPM_DYNAMIC=false -DUSE_TPM1=false\|\|false -DUSE_TPM2=true\|\|false -DUSE_FUZZER=false
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/libhwsec-0.0.1-r1069/work/libhwsec-0.0.1 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = libhwsec

build obj/libhwsec/libhwsec.inputdeps.stamp: stamp obj/libhwsec/oobe_config_encrypted_data_proto_gen.stamp obj/libhwsec/pinweaver_manager_proto_gen.stamp obj/libhwsec/signature-sealed-data-flatbuffers-binding-generate.stamp

