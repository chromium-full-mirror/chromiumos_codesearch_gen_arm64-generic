abstraction_internal_library.frontend_impl.o obj/libhwsec/frontend/pinweaver_manager/hardware_abstraction_internal_library.frontend_impl.o obj/libhwsec/frontend/recovery_crypto/hardware_abstraction_internal_library.frontend_impl.o obj/libhwsec/frontend/u2fd/hardware_abstraction_internal_library.frontend_impl.o obj/libhwsec/frontend/u2fd/hardware_abstraction_internal_library.vendor_frontend_impl.o obj/libhwsec/middleware/hardware_abstraction_internal_library.function_name.o obj/libhwsec/middleware/hardware_abstraction_internal_library.metrics.o obj/libhwsec/platform/hardware_abstraction_internal_library.platform_impl.o obj/libhwsec/proxy/hardware_abstraction_internal_library.proxy.o obj/libhwsec/proxy/hardware_abstraction_internal_library.proxy_impl.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.attestation.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.backend.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.config.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.da_mitigation.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.deriving.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.encryption.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.event_management.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.key_management.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.pinweaver.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.random.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.recovery_crypto.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.ro_data.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.sealing.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.session_management.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.signature_sealing.o obj/libhwsec/backend/tpm2/hardware_abstraction_internal_library.signin