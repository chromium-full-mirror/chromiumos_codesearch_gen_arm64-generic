ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/shill-dbus-client-0.0.1-r2104/work/shill-dbus-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libshill-dbus-client: phony ./lib/libshill-dbus-client.so
build libshill-dbus-client_deps: phony obj/shill/dbus/client/libshill-dbus-client_deps.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build shill/dbus/client$:all: phony obj/shill/dbus/client/all.stamp
build shill/dbus/client$:libshill-dbus-client: phony ./lib/libshill-dbus-client.so
build shill/dbus/client$:libshill-dbus-client_deps: phony obj/shill/dbus/client/libshill-dbus-client_deps.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/shill/dbus/client/all.stamp $
    ./lib/libshill-dbus-client.so $
    obj/shill/dbus/client/libshill-dbus-client_deps.stamp

default all
