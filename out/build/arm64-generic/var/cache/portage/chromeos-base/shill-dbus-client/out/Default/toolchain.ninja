rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/shill/dbus/client/all.stamp
build obj/shill/dbus/client/all.stamp: stamp ./lib/libshill-dbus-client.so
subninja obj/shill/dbus/client/libshill-dbus-client.ninja
rule __shill_dbus_client_libshill-dbus-client_deps___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/shill-dbus-client-0.0.1-r2109/work/shill-dbus-client-0.0.1/common-mk/write_args.py --output /build/arm64-generic/var/cache/portage/chromeos-base/shill-dbus-client/out/Default/gen/libshill-dbus-client-deps.txt --
  description = ACTION //shill/dbus/client:libshill-dbus-client_deps(//common-mk/toolchain:toolchain)
  restat = 1

build gen/libshill-dbus-client-deps.txt: __shill_dbus_client_libshill-dbus-client_deps___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/shill-dbus-client-0.0.1-r2109/work/shill-dbus-client-0.0.1/common-mk/write_args.py

build obj/shill/dbus/client/libshill-dbus-client_deps.stamp: stamp gen/libshill-dbus-client-deps.txt
