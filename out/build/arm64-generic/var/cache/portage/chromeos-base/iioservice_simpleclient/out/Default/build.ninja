ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/iioservice_simpleclient-0.0.1-r513/work/iioservice_simpleclient-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _iioservice_event-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_event-install_config.stamp
build _iioservice_query-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_query-install_config.stamp
build _iioservice_simpleclient-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_simpleclient-install_config.stamp
build install_policy: phony obj/iioservice/iioservice_simpleclient/install_policy.stamp
build libiioservice_simpleclient: phony ./libiioservice_simpleclient.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build iioservice/iioservice_simpleclient$:_iioservice_event-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_event-install_config.stamp
build iioservice/iioservice_simpleclient$:_iioservice_query-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_query-install_config.stamp
build iioservice/iioservice_simpleclient$:_iioservice_simpleclient-install_config: phony obj/iioservice/iioservice_simpleclient/_iioservice_simpleclient-install_config.stamp
build iioservice/iioservice_simpleclient$:all: phony obj/iioservice/iioservice_simpleclient/all.stamp
build iioservice/iioservice_simpleclient$:iioservice_event: phony ./iioservice_event
build iioservice/iioservice_simpleclient$:iioservice_query: phony ./iioservice_query
build iioservice/iioservice_simpleclient$:iioservice_simpleclient: phony ./iioservice_simpleclient
build iioservice/iioservice_simpleclient: phony ./iioservice_simpleclient
build iioservice/iioservice_simpleclient$:install_policy: phony obj/iioservice/iioservice_simpleclient/install_policy.stamp
build iioservice/iioservice_simpleclient$:libiioservice_simpleclient: phony ./libiioservice_simpleclient.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/iioservice/iioservice_simpleclient/_iioservice_event-install_config.stamp $
    obj/iioservice/iioservice_simpleclient/_iioservice_query-install_config.stamp $
    obj/iioservice/iioservice_simpleclient/_iioservice_simpleclient-install_config.stamp $
    obj/iioservice/iioservice_simpleclient/all.stamp $
    ./iioservice_event $
    ./iioservice_query $
    ./iioservice_simpleclient $
    obj/iioservice/iioservice_simpleclient/install_policy.stamp $
    ./libiioservice_simpleclient.a

default all
