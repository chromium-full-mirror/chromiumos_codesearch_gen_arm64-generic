ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/cryptohome-dev-utils-0.0.1-r2946/work/cryptohome-dev-utils-0.0.1/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cryptohome-test-tool-install_config: phony obj/cryptohome/dev-utils/_cryptohome-test-tool-install_config.stamp
build _cryptohome-tpm-live-test-install_config: phony obj/cryptohome/dev-utils/_cryptohome-tpm-live-test-install_config.stamp
