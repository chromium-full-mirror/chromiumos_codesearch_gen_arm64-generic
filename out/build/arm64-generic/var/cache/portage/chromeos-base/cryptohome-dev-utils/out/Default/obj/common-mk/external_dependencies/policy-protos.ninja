build ./libpolicy-protos.a: alink obj/gen/include/bindings/libpolicy-protos.chrome_device_policy.pb.o obj/gen/include/bindings/libpolicy-protos.chrome_extension_policy.pb.o obj/gen/include/bindings/libpolicy-protos.device_management_backend.pb.o obj/gen/include/bindings/libpolicy-protos.private_membership.pb.o obj/gen/include/bindings/libpolicy-protos.private_membership_rlwe.pb.o obj/gen/include/bindings/libpolicy-protos.serialization.pb.o || ./libpolicy_common_definitions-protos.a obj/common-mk/external_dependencies/policy-protos_gen.stamp
