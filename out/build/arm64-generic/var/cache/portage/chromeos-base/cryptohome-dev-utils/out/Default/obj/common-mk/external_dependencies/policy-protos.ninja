  source_file_part = private_membership_rlwe.pb.cc
  source_name_part = private_membership_rlwe.pb
build obj/gen/include/bindings/libpolicy-protos.serialization.pb.o: cxx gen/include/bindings/serialization.pb.cc || obj/common-mk/external_dependencies/policy-protos.inputdeps.stamp
  source_file_part = serialization.pb.cc
