  source_file_part = signature_sealed_data.pb.cc
  source_name_part = signature_sealed_data.pb
build obj/gen/include/cryptohome/libcryptohome-proto.timestamp.pb.o: cxx gen/include/cryptohome/timestamp.pb.cc || obj/cryptohome/libs/cryptohome-proto_gen.stamp
