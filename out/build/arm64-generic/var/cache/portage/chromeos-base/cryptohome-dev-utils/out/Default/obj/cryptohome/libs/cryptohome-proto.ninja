build ./libcryptohome-proto.a: alink obj/gen/include/cryptohome/cryptorecovery/libcryptohome-proto.cryptorecovery.pb.o obj/gen/include/cryptohome/cryptorecovery/libcryptohome-proto.recovery_id_container.pb.o obj/gen/include/cryptohome/libcryptohome-proto.signature_sealed_data.pb.o obj/gen/include/cryptohome/libcryptohome-proto.timestamp.pb.o obj/gen/include/cryptohome/libcryptohome-proto.vault_keyset.pb.o || obj/cryptohome/libs/cryptohome-proto_gen.stamp
