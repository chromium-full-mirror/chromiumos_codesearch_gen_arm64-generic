ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/run_oci-0.0.1-r1436/work/run_oci-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _run_oci-install_config: phony obj/run_oci/_run_oci-install_config.stamp
build container_config_parser: phony ./lib/libcontainer_config_parser.so
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build run_oci$:_run_oci-install_config: phony obj/run_oci/_run_oci-install_config.stamp
build run_oci$:all: phony obj/run_oci/all.stamp
build run_oci$:container_config_parser: phony ./lib/libcontainer_config_parser.so
build run_oci$:run_oci: phony ./run_oci

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/run_oci/_run_oci-install_config.stamp $
    obj/run_oci/all.stamp $
    ./lib/libcontainer_config_parser.so $
    ./run_oci

default all
