build crash-reporter$:crash_serializer_main: phony ./crash_serializer
build crash-reporter$:crash_serializer_proto: phony ./libcrash_serializer_proto.a
build crash-reporter$:crash_serializer_proto_gen: phony obj/crash-reporter/crash_serializer_proto_gen.stamp
build crash-reporter$:hold_lock_file: phony ./hold_lock_file
build crash-reporter$:libbluetooth_devcd_parser: phony ./libbluetooth_devcd_parser.a
build crash-reporter$:libcrash: phony ./libcrash.a
