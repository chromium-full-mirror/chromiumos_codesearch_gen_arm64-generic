defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = libenterprise_rollback_metrics

build obj/oobe_config/metrics/libenterprise_rollback_metrics.inputdeps.stamp: stamp obj/oobe_config/metrics/enterprise_rollback_metrics_proto_gen.stamp obj/oobe_config/metrics/libenterprise_rollback_metrics_pc.stamp

build ./lib/libenterprise_rollback_metrics.so: solink obj/oobe_config/metrics/enterprise_rollback_metrics_library_common_sources.enterprise_rollback_metrics_handler.o obj/oobe_config/metrics/enterprise_rollback_metrics_library_common_sources.enterprise_rollback_metrics_recorder.o obj/oobe_config/metrics/enterprise_rollback_metrics_library_common_sources.enterprise_rollback_metrics_tracking.o obj/oobe_config/filesystem/filesystem.file_handler.o ./libenterprise_rollback_metrics_proto.a || obj/oobe_config/metrics/enterprise_rollback_metrics_library_common_sources.stamp obj/oobe_config/metrics/libenterprise_rollback_metrics_pc.stamp obj/oobe_config/filesystem/filesystem.stamp obj/oobe_config/metrics/_libenterprise_rollback_metrics-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lmetrics -lstructuredmetrics -lprotobuf-lite -labsl_log_internal_check_op -labsl_leak_check -labsl_die_if_null -labsl_log_internal_conditions -labsl_log_internal_message -labsl_examine_stack -labsl_log_internal_format -labsl_log_internal_proto -labsl_log_internal_nullguard -labsl_log_internal_log_sink_set -labsl_log_sink -labsl_log_entry -labsl_flags -labsl_flags_internal -labsl_flags_marshalling -labsl_flags_reflection -labsl_flags_private_handle_accessor -labsl_flags_commandlineflag -labsl_flags_commandlineflag_internal -labsl_flags_config -labsl_flags_program_name -labsl_log_initialize -labsl_log_globals -labsl_log_internal_globals -labsl_raw_hash_set -labsl_hash -labsl_city -labsl_low_level_hash -labsl_hashtablez_sampler -labsl_statusor -labsl_status -labsl_cord -labsl_cordz_info -labsl_cord_internal -labsl_cordz_functions -labsl_exponential_biased -labsl_cordz_handle -labsl_crc_cord_state -labsl_crc32c -labsl_crc_internal -labsl_crc_cpu_detect -labsl_bad_optional_access -labsl_str_format_internal -labsl_strerror -labsl_synchronization -labsl_graphcycles_internal -labsl_kernel_timeout_internal -labsl_stacktrace -labsl_symbolize -labsl_debugging_internal -labsl_demangle_internal -labsl_malloc_internal -labsl_time -labsl_civil_time -labsl_time_zone -labsl_bad_variant_access -lutf8_validity -lutf8_range -labsl_strings -labsl_string_view -labsl_strings_internal -labsl_base -lrt -labsl_spinlock_wait -labsl_int128 -labsl_throw_delegate -labsl_raw_logging_internal -labsl_log_severity -lbrillo
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
