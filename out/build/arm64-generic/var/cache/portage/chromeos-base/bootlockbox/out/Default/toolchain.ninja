rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/bootlockbox/_bootlockboxd-install_config.stamp: stamp
build obj/bootlockbox/_bootlockboxtool-install_config.stamp: stamp
build obj/bootlockbox/all.stamp: stamp ./bootlockboxd ./bootlockboxtool obj/bootlockbox/install_minijail_conf.stamp obj/bootlockbox/install_policy.stamp obj/bootlockbox/install_systemd.stamp obj/bootlockbox/install_tmpfiles_config.stamp obj/bootlockbox/install_init.stamp
rule __bootlockbox_bootlockbox-adaptors___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/bootlockbox-0.0.1-r441/work/bootlockbox-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/bootlockbox/out/Default/gen/include/dbus_adaptors/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/bootlockbox-0.0.1-r441/work/bootlockbox-0.0.1/bootlockbox/dbus_adaptors/dbus-service-config.json ${in}
  description = ACTION //bootlockbox:bootlockbox-adaptors(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/dbus_adaptors/org.chromium.BootLockboxInterface.h: __bootlockbox_bootlockbox-adaptors___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/bootlockbox-0.0.1-r441/work/bootlockbox-0.0.1/bootlockbox/dbus_adaptors/org.chromium.BootLockboxInterface.xml | ../../../../../../../tmp/portage/chromeos-base/bootlockbox-0.0.1-r441/work/bootlockbox-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.BootLockboxInterface

build obj/bootlockbox/bootlockbox-adaptors.stamp: stamp gen/include/dbus_adaptors/org.chromium.BootLockboxInterface.h
subninja obj/bootlockbox/bootlockboxd.ninja
subninja obj/bootlockbox/bootlockboxtool.ninja
build obj/bootlockbox/install_init.stamp: stamp
build obj/bootlockbox/install_minijail_conf.stamp: stamp
build obj/bootlockbox/install_policy.stamp: stamp
build obj/bootlockbox/install_systemd.stamp: stamp
build obj/bootlockbox/install_tmpfiles_config.stamp: stamp
subninja obj/bootlockbox/libnvram-boot-lockbox.ninja
build obj/common-mk/gn_root/root.stamp: stamp obj/bootlockbox/all.stamp
