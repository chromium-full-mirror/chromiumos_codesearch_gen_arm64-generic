defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = boot_lockbox_test

build obj/bootlockbox/boot_lockbox_test.boot_lockbox_dbus_adaptor.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/bootlockbox/boot_lockbox_dbus_adaptor.cc
  source_file_part = boot_lockbox_dbus_adaptor.cc
  source_name_part = boot_lockbox_dbus_adaptor
build obj/bootlockbox/boot_lockbox_test.boot_lockbox_service_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/bootlockbox/boot_lockbox_service_test.cc
  source_file_part = boot_lockbox_service_test.cc
  source_name_part = boot_lockbox_service_test
build obj/bootlockbox/boot_lockbox_test.fake_hwsec_space.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/bootlockbox/fake_hwsec_space.cc
  source_file_part = fake_hwsec_space.cc
  source_name_part = fake_hwsec_space
build obj/bootlockbox/boot_lockbox_test.hwsec_space_impl_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/bootlockbox/hwsec_space_impl_test.cc
  source_file_part = hwsec_space_impl_test.cc
  source_name_part = hwsec_space_impl_test
build obj/bootlockbox/boot_lockbox_test.nvram_boot_lockbox_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/bootlockbox/nvram_boot_lockbox_test.cc
  source_file_part = nvram_boot_lockbox_test.cc
  source_name_part = nvram_boot_lockbox_test

build ./boot_lockbox_test: link obj/bootlockbox/boot_lockbox_test.boot_lockbox_dbus_adaptor.o obj/bootlockbox/boot_lockbox_test.boot_lockbox_service_test.o obj/bootlockbox/boot_lockbox_test.fake_hwsec_space.o obj/bootlockbox/boot_lockbox_test.hwsec_space_impl_test.o obj/bootlockbox/boot_lockbox_test.nvram_boot_lockbox_test.o ./libnvram-boot-lockbox.a ./libtestrunner.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/usr/lib64
  libs = -lhwsec_test -lgmock -lgtest -lpthread -lbrillo-test -lbrillo -lbase -lcurl -lbase-test -lhwsec -lsystem_api-device_management-protos -lsystem_api-hps-protos -lsystem_api-power_manager-protos -lsystem_api-authpolicy-protos -lsystem_api-protos -lsystem_api-kerberos-protos -lsystem_api-login_manager-protos -lsystem_api-lorgnette-protos -lsystem_api-smbprovider-protos -lsystem_api-vm_concierge-protos -lsystem_api-vm_applications-protos -lsystem_api-vm_launch-protos -lsystem_api-vm_sk_forwarding-protos -lsystem_api-vm_cicerone-protos -lsystem_api-seneschal-protos -lsystem_api-oobe_config-protos -lsystem_api-runtime_probe-protos -lsystem_api-dlcservice-protos -lsystem_api-update_engine-protos -lsystem_api-vm_plugin_dispatcher-protos -lsystem_api-u2f-protos -lsystem_api-chunneld-protos -lsystem_api-system_proxy-protos -lsystem_api-vm_permission_service-protos -lsystem_api-anomaly_detector-protos -lsystem_api-minios-protos -lsystem_api-dlp-protos -lsystem_api-rmad-protos -lsystem_api-fusebox-protos -lsystem_api-privacy_screen-protos -lsystem_api-cdm_oemcrypto-protos -lsystem_api-ml-protos -lsystem_api-lvmd-protos -lsystem_api-shadercached-protos -lsystem_api-spaced-protos -lsystem_api-imageloader-protos -lsystem_api -lsystem_api-arc-protos -lsystem_api-private_computing-protos -lsystem_api-arcvm_data_migrator-protos -lsystem_api-featured-protos -lsystem_api-vm_wl-protos -lsystem_api-printscanmgr-protos -lsystem_api-vm_memory_management-protos -lprotobuf-lite -lhwsec-foundation -lbootlockbox-client
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
