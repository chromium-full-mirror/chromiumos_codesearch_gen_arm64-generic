build runtime_probe/utils: phony obj/runtime_probe/utils/utils.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/runtime_probe/_runtime_probe-install_config.stamp $
    obj/runtime_probe/all.stamp $
    obj/runtime_probe/daemon.stamp $
    obj/runtime_probe/dbus-adaptors.stamp $
    obj/runtime_probe/install_minijail_conf.stamp $
    obj/runtime_probe/lib.stamp $
    ./runtime_probe $
    obj/runtime_probe/dbus/dbus.stamp $
    obj/runtime_probe/dbus/install_dbus_config.stamp $
    obj/runtime_probe/dbus/install_dbus_service_activation_config.stamp $
    obj/runtime_probe/function_templates/function_templates.stamp $
    obj/runtime_probe/functions/functions.stamp $
    obj/runtime_probe/init/_install_seccomp-check_seccomp.stamp $
    obj/runtime_probe/init/init.stamp $
    obj/runtime_probe/init/install_init_config.stamp $
    obj/runtime_probe/init/install_seccomp.stamp $
    obj/runtime_probe/sandbox/_install_sandbox_seccomp-check_seccomp.stamp $
    obj/runtime_probe/sandbox/install_sandbox_args.stamp $
    obj/runtime_probe/sandbox/install_sandbox_seccomp.stamp $
    obj/runtime_probe/sandbox/sandbox.stamp $
    obj/runtime_probe/system/context_factory.stamp $
    obj/runtime_probe/system/context_production.stamp $
    obj/runtime_probe/system/helper_invoker_direct.stamp $
    obj/runtime_probe/system/system_base.stamp $
    obj/runtime_probe/utils/utils.stamp

default all
