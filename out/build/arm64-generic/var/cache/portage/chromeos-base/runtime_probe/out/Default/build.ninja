ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/runtime_probe-0.0.1-r1373/work/runtime_probe-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _install_sandbox_seccomp-check_seccomp: phony obj/runtime_probe/sandbox/_install_sandbox_seccomp-check_seccomp.stamp
build _install_seccomp-check_seccomp: phony obj/runtime_probe/init/_install_seccomp-check_seccomp.stamp
build _runtime_probe-install_config: phony obj/runtime_probe/_runtime_probe-install_config.stamp
build context_factory: phony obj/runtime_probe/system/context_factory.stamp
build context_production: phony obj/runtime_probe/system/context_production.stamp
build daemon: phony obj/runtime_probe/daemon.stamp
build dbus: phony obj/runtime_probe/dbus/dbus.stamp
build dbus-adaptors: phony obj/runtime_probe/dbus-adaptors.stamp
build function_templates: phony obj/runtime_probe/function_templates/function_templates.stamp
build functions: phony obj/runtime_probe/functions/functions.stamp
build helper_invoker_direct: phony obj/runtime_probe/system/helper_invoker_direct.stamp
build init: phony obj/runtime_probe/init/init.stamp
build install_dbus_config: phony obj/runtime_probe/dbus/install_dbus_config.stamp
build install_dbus_service_activation_config: phony obj/runtime_probe/dbus/install_dbus_service_activation_config.stamp
build install_init_config: phony obj/runtime_probe/init/install_init_config.stamp
build install_minijail_conf: phony obj/runtime_probe/install_minijail_conf.stamp
build install_sandbox_args: phony obj/runtime_probe/sandbox/install_sandbox_args.stamp
build install_sandbox_seccomp: phony obj/runtime_probe/sandbox/install_sandbox_seccomp.stamp
build install_seccomp: phony obj/runtime_probe/init/install_seccomp.stamp
build lib: phony obj/runtime_probe/lib.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build sandbox: phony obj/runtime_probe/sandbox/sandbox.stamp
build system_base: phony obj/runtime_probe/system/system_base.stamp
build utils: phony obj/runtime_probe/utils/utils.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build runtime_probe$:_runtime_probe-install_config: phony obj/runtime_probe/_runtime_probe-install_config.stamp
build runtime_probe$:all: phony obj/runtime_probe/all.stamp
build runtime_probe$:daemon: phony obj/runtime_probe/daemon.stamp
build runtime_probe$:dbus-adaptors: phony obj/runtime_probe/dbus-adaptors.stamp
build runtime_probe$:install_minijail_conf: phony obj/runtime_probe/install_minijail_conf.stamp
build runtime_probe$:lib: phony obj/runtime_probe/lib.stamp
build runtime_probe$:runtime_probe: phony ./runtime_probe
build runtime_probe/dbus$:dbus: phony obj/runtime_probe/dbus/dbus.stamp
build runtime_probe/dbus: phony obj/runtime_probe/dbus/dbus.stamp
build runtime_probe/dbus$:install_dbus_config: phony obj/runtime_probe/dbus/install_dbus_config.stamp
build runtime_probe/dbus$:install_dbus_service_activation_config: phony obj/runtime_probe/dbus/install_dbus_service_activation_config.stamp
build runtime_probe/function_templates$:function_templates: phony obj/runtime_probe/function_templates/function_templates.stamp
build runtime_probe/function_templates: phony obj/runtime_probe/function_templates/function_templates.stamp
build runtime_probe/functions$:functions: phony obj/runtime_probe/functions/functions.stamp
build runtime_probe/functions: phony obj/runtime_probe/functions/functions.stamp
build runtime_probe/init$:_install_seccomp-check_seccomp: phony obj/runtime_probe/init/_install_seccomp-check_seccomp.stamp
build runtime_probe/init$:init: phony obj/runtime_probe/init/init.stamp
build runtime_probe/init: phony obj/runtime_probe/init/init.stamp
build runtime_probe/init$:install_init_config: phony obj/runtime_probe/init/install_init_config.stamp
build runtime_probe/init$:install_seccomp: phony obj/runtime_probe/init/install_seccomp.stamp
build runtime_probe/sandbox$:_install_sandbox_seccomp-check_seccomp: phony obj/runtime_probe/sandbox/_install_sandbox_seccomp-check_seccomp.stamp
build runtime_probe/sandbox$:install_sandbox_args: phony obj/runtime_probe/sandbox/install_sandbox_args.stamp
build runtime_probe/sandbox$:install_sandbox_seccomp: phony obj/runtime_probe/sandbox/install_sandbox_seccomp.stamp
build runtime_probe/sandbox$:sandbox: phony obj/runtime_probe/sandbox/sandbox.stamp
build runtime_probe/sandbox: phony obj/runtime_probe/sandbox/sandbox.stamp
build runtime_probe/system$:context_factory: phony obj/runtime_probe/system/context_factory.stamp
build runtime_probe/system$:context_production: phony obj/runtime_probe/system/context_production.stamp
build runtime_probe/system$:helper_invoker_direct: phony obj/runtime_probe/system/helper_invoker_direct.stamp
