ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libp2p-client: phony ./libp2p-client.a
build libp2p-http-server: phony ./libp2p-http-server.a
build libp2p-server: phony ./libp2p-server.a
build libp2p-testutil: phony ./libp2p-testutil.a
build libp2p-util: phony ./libp2p-util.a
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build p2p$:all: phony obj/p2p/all.stamp
build p2p$:libp2p-client: phony ./libp2p-client.a
build p2p$:libp2p-http-server: phony ./libp2p-http-server.a
build p2p$:libp2p-server: phony ./libp2p-server.a
build p2p$:libp2p-testutil: phony ./libp2p-testutil.a
build p2p$:libp2p-util: phony ./libp2p-util.a
build p2p$:p2p-client: phony ./p2p-client
build p2p$:p2p-client-unittests: phony ./p2p-client-unittests
build p2p$:p2p-common-unittests: phony ./p2p-common-unittests
build p2p$:p2p-http-server: phony ./p2p-http-server
build p2p$:p2p-http-server-unittests: phony ./p2p-http-server-unittests
build p2p$:p2p-server: phony ./p2p-server
build p2p$:p2p-server-unittests: phony ./p2p-server-unittests

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/p2p/all.stamp $
    ./libp2p-client.a $
    ./libp2p-http-server.a $
    ./libp2p-server.a $
    ./libp2p-testutil.a $
    ./libp2p-util.a $
    ./p2p-client $
    ./p2p-client-unittests $
    ./p2p-common-unittests $
    ./p2p-http-server $
    ./p2p-http-server-unittests $
    ./p2p-server $
    ./p2p-server-unittests

default all
