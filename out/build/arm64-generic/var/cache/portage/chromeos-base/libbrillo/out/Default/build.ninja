ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libbrillo: phony obj/libbrillo/libbrillo.stamp
build cloud_policy_proto_generator: phony obj/common-mk/external_dependencies/cloud_policy_proto_generator.stamp
build dbus-proxies: phony obj/common-mk/external_dependencies/dbus-proxies.stamp
build enterprise_management_goprotos: phony obj/common-mk/external_dependencies/enterprise_management_goprotos.stamp
build grpc_test_rpcs_protolib: phony ./libgrpc_test_rpcs_protolib.a
build grpc_test_rpcs_protolib_gen: phony obj/libbrillo/grpc_test_rpcs_protolib_gen.stamp
build install_attributes-proto: phony ./libinstall_attributes-proto.a
build install_attributes-proto_gen: phony obj/common-mk/external_dependencies/install_attributes-proto_gen.stamp
build install_attributes_proto: phony ./libinstall_attributes_proto.a
build install_attributes_proto_gen: phony obj/libbrillo/install_attributes_proto_gen.stamp
build libbrillo-core: phony ./lib/libbrillo-core.so
build libbrillo-cryptohome: phony ./lib/libbrillo-cryptohome.so
build libbrillo-grpc: phony ./lib/libbrillo-grpc.so
build libbrillo-http: phony ./lib/libbrillo-http.so
build libbrillo-minijail: phony ./lib/libbrillo-minijail.so
build libbrillo-namespaces: phony ./lib/libbrillo-namespaces.so
build libbrillo-protobuf: phony ./lib/libbrillo-protobuf.so
build libbrillo-storage: phony ./lib/libbrillo-storage.so
build libbrillo-streams: phony ./lib/libbrillo-streams.so
build libbrillo-test: phony ./libbrillo-test.a
build libbrillo-test_pc: phony obj/libbrillo/libbrillo-test_pc.stamp
build libbrillo-udev: phony ./lib/libbrillo-udev.so
build libbrillo-usb: phony ./lib/libbrillo-usb.so
build libbrillo-vboot: phony ./lib/libbrillo-vboot.so
build libbrillo_pc: phony obj/libbrillo/libbrillo_pc.stamp
