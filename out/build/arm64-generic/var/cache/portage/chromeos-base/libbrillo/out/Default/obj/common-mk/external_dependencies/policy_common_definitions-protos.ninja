defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/bindings -Igen/include -I../../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2405/work/libbrillo-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -fPIC
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libpolicy_common_definitions-protos

build obj/gen/include/bindings/libpolicy_common_definitions-protos.policy_common_definitions.pb.o: cxx gen/include/bindings/policy_common_definitions.pb.cc || obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp
  source_file_part = policy_common_definitions.pb.cc
  source_name_part = policy_common_definitions.pb

build ./libpolicy_common_definitions-protos.a: alink obj/gen/include/bindings/libpolicy_common_definitions-protos.policy_common_definitions.pb.o || obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
