build obj/libbrillo/brillo/grpc/libbrillo-grpc_tests.grpc_completion_queue_dispatcher_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/grpc/grpc_completion_queue_dispatcher_test.cc || obj/libbrillo/grpc_test_rpcs_protolib_gen.stamp
  source_file_part = grpc_completion_queue_dispatcher_test.cc
