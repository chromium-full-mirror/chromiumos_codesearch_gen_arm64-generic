defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DBUS=true -DUSE_RTTI_FOR_TYPE_TAGS=1 -DUSE_ENTERPRISE_ROLLBACK_REVEN=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../../../mnt/host/source/src/platform2/libbrillo
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1255387 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DPROTOBUF_USE_DLLS
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libbrillo-udev

build obj/libbrillo/brillo/udev/libbrillo-udev.udev.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/udev.cc
  source_file_part = udev.cc
  source_name_part = udev
build obj/libbrillo/brillo/udev/libbrillo-udev.udev_device.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/udev_device.cc
  source_file_part = udev_device.cc
  source_name_part = udev_device
build obj/libbrillo/brillo/udev/libbrillo-udev.udev_enumerate.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/udev_enumerate.cc
  source_file_part = udev_enumerate.cc
  source_name_part = udev_enumerate
build obj/libbrillo/brillo/udev/libbrillo-udev.udev_list_entry.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/udev_list_entry.cc
  source_file_part = udev_list_entry.cc
  source_name_part = udev_list_entry
build obj/libbrillo/brillo/udev/libbrillo-udev.udev_monitor.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/udev_monitor.cc
  source_file_part = udev_monitor.cc
  source_name_part = udev_monitor
build obj/libbrillo/brillo/udev/libbrillo-udev.utils.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/udev/utils.cc
  source_file_part = utils.cc
  source_name_part = utils

build ./lib/libbrillo-udev.so: solink obj/libbrillo/brillo/udev/libbrillo-udev.udev.o obj/libbrillo/brillo/udev/libbrillo-udev.udev_device.o obj/libbrillo/brillo/udev/libbrillo-udev.udev_enumerate.o obj/libbrillo/brillo/udev/libbrillo-udev.udev_list_entry.o obj/libbrillo/brillo/udev/libbrillo-udev.udev_monitor.o obj/libbrillo/brillo/udev/libbrillo-udev.utils.o || obj/libbrillo/_libbrillo-udev-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lbase -lpthread -ludev
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
