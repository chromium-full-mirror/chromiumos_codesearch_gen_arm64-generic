defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DBUS=true -DUSE_RTTI_FOR_TYPE_TAGS=1 -DUSE_ENTERPRISE_ROLLBACK_REVEN=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../../../mnt/host/source/src/platform2/libbrillo -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libpolicy_tests

build obj/libbrillo/libpolicy_tests.inputdeps.stamp: stamp obj/common-mk/external_dependencies/policy-protos_gen.stamp obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp obj/libbrillo/install_attributes_proto_gen.stamp obj/libbrillo/libinstallattributes-includes.stamp obj/libbrillo/libpolicy-includes.stamp
build obj/libbrillo/install_attributes/libpolicy_tests.mock_install_attributes_reader.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/install_attributes/mock_install_attributes_reader.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = mock_install_attributes_reader.cc
  source_name_part = mock_install_attributes_reader
build obj/libbrillo/policy/tests/libpolicy_tests.device_local_account_policy_util_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/policy/tests/device_local_account_policy_util_test.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = device_local_account_policy_util_test.cc
  source_name_part = device_local_account_policy_util_test
build obj/libbrillo/policy/tests/libpolicy_tests.device_policy_impl_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/policy/tests/device_policy_impl_test.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = device_policy_impl_test.cc
  source_name_part = device_policy_impl_test
build obj/libbrillo/policy/tests/libpolicy_tests.libpolicy_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/policy/tests/libpolicy_test.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = libpolicy_test.cc
  source_name_part = libpolicy_test
build obj/libbrillo/policy/tests/libpolicy_tests.policy_util_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/policy/tests/policy_util_test.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = policy_util_test.cc
  source_name_part = policy_util_test
build obj/libbrillo/policy/tests/libpolicy_tests.resilient_policy_util_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/policy/tests/resilient_policy_util_test.cc || obj/libbrillo/libpolicy_tests.inputdeps.stamp
  source_file_part = resilient_policy_util_test.cc
  source_name_part = resilient_policy_util_test

build ./libpolicy_tests: link obj/libbrillo/install_attributes/libpolicy_tests.mock_install_attributes_reader.o obj/libbrillo/policy/tests/libpolicy_tests.device_local_account_policy_util_test.o obj/libbrillo/policy/tests/libpolicy_tests.device_policy_impl_test.o obj/libbrillo/policy/tests/libpolicy_tests.libpolicy_test.o obj/libbrillo/policy/tests/libpolicy_tests.policy_util_test.o obj/libbrillo/policy/tests/libpolicy_tests.resilient_policy_util_test.o ./lib/libinstallattributes.so ./lib/libpolicy.so ./libpolicy-protos.a ./libtestrunner.a ./libpolicy_common_definitions-protos.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -lbase -lprotobuf-lite -lssl -lcrypto -lbrillo -lbase-test
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
