defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DBUS=true -DUSE_RTTI_FOR_TYPE_TAGS=1 -DUSE_ENTERPRISE_ROLLBACK_REVEN=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../../../mnt/host/source/src/platform2/libbrillo
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -I/build/arm64-generic/usr/include/libchrome -Wno-unused-local-typedefs -DBASE_VER=1241304 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DPROTOBUF_USE_DLLS
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libbrillo-streams

build obj/libbrillo/brillo/streams/libbrillo-streams.file_stream.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/file_stream.cc
  source_file_part = file_stream.cc
  source_name_part = file_stream
build obj/libbrillo/brillo/streams/libbrillo-streams.input_stream_set.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/input_stream_set.cc
  source_file_part = input_stream_set.cc
  source_name_part = input_stream_set
build obj/libbrillo/brillo/streams/libbrillo-streams.memory_containers.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/memory_containers.cc
  source_file_part = memory_containers.cc
  source_name_part = memory_containers
build obj/libbrillo/brillo/streams/libbrillo-streams.memory_stream.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/memory_stream.cc
  source_file_part = memory_stream.cc
  source_name_part = memory_stream
build obj/libbrillo/brillo/streams/libbrillo-streams.stream.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/stream.cc
  source_file_part = stream.cc
  source_name_part = stream
build obj/libbrillo/brillo/streams/libbrillo-streams.stream_errors.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/stream_errors.cc
  source_file_part = stream_errors.cc
  source_name_part = stream_errors
build obj/libbrillo/brillo/streams/libbrillo-streams.stream_utils.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/libbrillo/brillo/streams/stream_utils.cc
  source_file_part = stream_utils.cc
  source_name_part = stream_utils

build ./lib/libbrillo-streams.so: solink obj/libbrillo/brillo/streams/libbrillo-streams.file_stream.o obj/libbrillo/brillo/streams/libbrillo-streams.input_stream_set.o obj/libbrillo/brillo/streams/libbrillo-streams.memory_containers.o obj/libbrillo/brillo/streams/libbrillo-streams.memory_stream.o obj/libbrillo/brillo/streams/libbrillo-streams.stream.o obj/libbrillo/brillo/streams/libbrillo-streams.stream_errors.o obj/libbrillo/brillo/streams/libbrillo-streams.stream_utils.o ./lib/libbrillo-core.so || obj/libbrillo/_libbrillo-streams-install_config.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -L/build/arm64-generic/usr/lib64
  libs = -lbase -lpthread -lssl -lcrypto
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
