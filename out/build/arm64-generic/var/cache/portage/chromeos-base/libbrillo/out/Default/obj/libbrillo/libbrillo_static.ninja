defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_DBUS=true -DUSE_RTTI_FOR_TYPE_TAGS=1 -DUSE_ENTERPRISE_ROLLBACK_REVEN=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -I../../../../../../../../../mnt/host/source/src/platform2/libbrillo -Igen
root_out_dir = .
target_output_name = libbrillo_static

build obj/libbrillo/libbrillo_static.inputdeps.stamp: stamp obj/common-mk/external_dependencies/policy-protos_gen.stamp obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp obj/libbrillo/install_attributes_proto_gen.stamp obj/libbrillo/libbrillo_pc.stamp obj/libbrillo/libinstallattributes-includes.stamp obj/libbrillo/libpolicy-includes.stamp

build ./libbrillo_static.a: alink || obj/libbrillo/libbrillo_pc.stamp ./lib/libinstallattributes.so ./lib/libpolicy.so ./lib/libbrillo-core.so ./lib/libbrillo-storage.so ./lib/libbrillo-http.so ./lib/libbrillo-streams.so ./lib/libbrillo-cryptohome.so ./lib/libbrillo-namespaces.so ./lib/libbrillo-minijail.so ./lib/libbrillo-protobuf.so ./lib/libbrillo-grpc.so ./lib/libbrillo-vboot.so ./lib/libbrillo-udev.so ./lib/libbrillo-usb.so
  arflags = rcsT
  output_extension = .a
  output_dir = 
