defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libgrpc_test_rpcs_protolib

build obj/gen/include/libgrpc_test_rpcs_protolib.test_rpcs.grpc.pb.o: cxx gen/include/test_rpcs.grpc.pb.cc || obj/libbrillo/grpc_test_rpcs_protolib_gen.stamp
  source_file_part = test_rpcs.grpc.pb.cc
  source_name_part = test_rpcs.grpc.pb
build obj/gen/include/libgrpc_test_rpcs_protolib.test_rpcs.pb.o: cxx gen/include/test_rpcs.pb.cc || obj/libbrillo/grpc_test_rpcs_protolib_gen.stamp
  source_file_part = test_rpcs.pb.cc
  source_name_part = test_rpcs.pb

build ./libgrpc_test_rpcs_protolib.a: alink obj/gen/include/libgrpc_test_rpcs_protolib.test_rpcs.grpc.pb.o obj/gen/include/libgrpc_test_rpcs_protolib.test_rpcs.pb.o || obj/libbrillo/grpc_test_rpcs_protolib_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
