defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/brillo/proto_bindings -Igen/include -I../../../../../../../tmp/portage/chromeos-base/libbrillo-0.0.1-r2408/work/libbrillo-0.0.1 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -fPIC -fvisibility=default
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libinstall_attributes_proto

build obj/gen/include/brillo/proto_bindings/libinstall_attributes_proto.install_attributes.pb.o: cxx gen/include/brillo/proto_bindings/install_attributes.pb.cc || obj/libbrillo/install_attributes_proto_gen.stamp
  source_file_part = install_attributes.pb.cc
  source_name_part = install_attributes.pb

build ./libinstall_attributes_proto.a: alink obj/gen/include/brillo/proto_bindings/libinstall_attributes_proto.install_attributes.pb.o || obj/libbrillo/install_attributes_proto_gen.stamp
  arflags = rcs
  output_extension = .a
  output_dir = 
