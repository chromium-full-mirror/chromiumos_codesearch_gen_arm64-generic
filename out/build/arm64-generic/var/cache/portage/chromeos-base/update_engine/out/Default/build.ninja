ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/update_engine-0.0.3-r4940/work/update_engine-0.0.3 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _delta_generator-install_config: phony obj/update_engine/_delta_generator-install_config.stamp
build _update_engine-install_config: phony obj/update_engine/_update_engine-install_config.stamp
build _update_engine_client-install_config: phony obj/update_engine/_update_engine_client-install_config.stamp
build install_subtool: phony obj/update_engine/install_subtool.stamp
build libpayload_consumer: phony ./libpayload_consumer.a
build libpayload_generator: phony ./libpayload_generator.a
build libupdate_engine: phony ./libupdate_engine.a
build libupdate_engine_client: phony ./libupdate_engine_client.a
build root: phony obj/common-mk/gn_root/root.stamp
build update_engine-dbus-adaptor: phony obj/update_engine/update_engine-dbus-adaptor.stamp
build update_engine-dbus-kiosk-app-client: phony obj/update_engine/update_engine-dbus-kiosk-app-client.stamp
build update_metadata-protos: phony ./libupdate_metadata-protos.a
build update_metadata-protos_gen: phony obj/update_engine/update_metadata-protos_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build update_engine$:_delta_generator-install_config: phony obj/update_engine/_delta_generator-install_config.stamp
build update_engine$:_update_engine-install_config: phony obj/update_engine/_update_engine-install_config.stamp
build update_engine$:_update_engine_client-install_config: phony obj/update_engine/_update_engine_client-install_config.stamp
build update_engine$:all: phony obj/update_engine/all.stamp
build update_engine$:delta_generator: phony ./delta_generator
build update_engine$:install_subtool: phony obj/update_engine/install_subtool.stamp
build update_engine$:libpayload_consumer: phony ./libpayload_consumer.a
build update_engine$:libpayload_generator: phony ./libpayload_generator.a
build update_engine$:libupdate_engine: phony ./libupdate_engine.a
build update_engine$:libupdate_engine_client: phony ./libupdate_engine_client.a
build update_engine$:update_engine: phony ./update_engine
build update_engine$:update_engine-dbus-adaptor: phony obj/update_engine/update_engine-dbus-adaptor.stamp
build update_engine$:update_engine-dbus-kiosk-app-client: phony obj/update_engine/update_engine-dbus-kiosk-app-client.stamp
build update_engine$:update_engine_client: phony ./update_engine_client
build update_engine$:update_metadata-protos: phony ./libupdate_metadata-protos.a
build update_engine$:update_metadata-protos_gen: phony obj/update_engine/update_metadata-protos_gen.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/update_engine/_delta_generator-install_config.stamp $
    obj/update_engine/_update_engine-install_config.stamp $
    obj/update_engine/_update_engine_client-install_config.stamp $
    obj/update_engine/all.stamp $
    ./delta_generator $
    obj/update_engine/install_subtool.stamp $
    ./libpayload_consumer.a $
    ./libpayload_generator.a $
    ./libupdate_engine.a $
    ./libupdate_engine_client.a $
    ./update_engine $
    obj/update_engine/update_engine-dbus-adaptor.stamp $
    obj/update_engine/update_engine-dbus-kiosk-app-client.stamp $
    ./update_engine_client $
    ./libupdate_metadata-protos.a $
    obj/update_engine/update_metadata-protos_gen.stamp

default all
