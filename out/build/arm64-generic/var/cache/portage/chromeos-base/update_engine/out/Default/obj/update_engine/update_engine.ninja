defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -D__CHROMEOS__ -D_POSIX_C_SOURCE=199309L -DUSE_CFM=false -DUSE_FEC=0 -DUSE_HWID_OVERRIDE=false -DUSE_HW_DETAILS=false -DUSE_REPORT_REQUISITION=false -DUSE_LVM_STATEFUL_PARTITION=false
