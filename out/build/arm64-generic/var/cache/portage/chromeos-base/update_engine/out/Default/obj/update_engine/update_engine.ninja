build obj/update_engine/update_engine.main.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/update_engine/main.cc || obj/update_engine/update_engine-dbus-adaptor.stamp obj/update_engine/update_engine-dbus-kiosk-app-client.stamp obj/update_engine/update_metadata-protos_gen.stamp
