ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/kerberos-0.0.1-r880/work/kerberos-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _kerberosd-install_config: phony obj/kerberos/_kerberosd-install_config.stamp
build container-protos: phony ./libcontainer-protos.a
build container-protos_gen: phony obj/kerberos/container-protos_gen.stamp
build dbus_code_generator: phony obj/kerberos/dbus_code_generator.stamp
build install_config_cros_startup: phony obj/kerberos/install_config_cros_startup.stamp
build install_config_dbus_system-services: phony obj/kerberos/install_config_dbus_system-services.stamp
build install_config_dbus_systemd: phony obj/kerberos/install_config_dbus_systemd.stamp
build install_config_init: phony obj/kerberos/install_config_init.stamp
build install_seccomp_policy: phony obj/kerberos/install_seccomp_policy.stamp
build libkerberos: phony ./libkerberos.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build kerberos$:_kerberosd-install_config: phony obj/kerberos/_kerberosd-install_config.stamp
build kerberos$:all: phony obj/kerberos/all.stamp
build kerberos$:container-protos: phony ./libcontainer-protos.a
build kerberos$:container-protos_gen: phony obj/kerberos/container-protos_gen.stamp
build kerberos$:dbus_code_generator: phony obj/kerberos/dbus_code_generator.stamp
build kerberos$:install_config_cros_startup: phony obj/kerberos/install_config_cros_startup.stamp
build kerberos$:install_config_dbus_system-services: phony obj/kerberos/install_config_dbus_system-services.stamp
build kerberos$:install_config_dbus_systemd: phony obj/kerberos/install_config_dbus_systemd.stamp
build kerberos$:install_config_init: phony obj/kerberos/install_config_init.stamp
build kerberos$:install_seccomp_policy: phony obj/kerberos/install_seccomp_policy.stamp
build kerberos$:kerberosd: phony ./kerberosd
build kerberos$:libkerberos: phony ./libkerberos.a

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/kerberos/_kerberosd-install_config.stamp $
    obj/kerberos/all.stamp $
    ./libcontainer-protos.a $
    obj/kerberos/container-protos_gen.stamp $
    obj/kerberos/dbus_code_generator.stamp $
    obj/kerberos/install_config_cros_startup.stamp $
    obj/kerberos/install_config_dbus_system-services.stamp $
    obj/kerberos/install_config_dbus_systemd.stamp $
    obj/kerberos/install_config_init.stamp $
    obj/kerberos/install_seccomp_policy.stamp $
    ./kerberosd $
    ./libkerberos.a

default all
