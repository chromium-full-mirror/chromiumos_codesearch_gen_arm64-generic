defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../tmp/portage/chromeos-base/metrics-0.0.2-r3776/work/metrics-0.0.2/platform2 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = metrics_daemon


build ./metrics_daemon: link ./libmetrics_daemon.a ./lib/libmetrics.so ./libupload_service.a ./libmetrics_proto.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -L/build/arm64-generic/usr/lib64
  libs = -ldbus-1 -lbrillo -lbase -lpthread -lre2 -labsl_base -lrt -labsl_log_severity -labsl_raw_logging_internal -labsl_spinlock_wait -labsl_throw_delegate -labsl_flags -labsl_flags_commandlineflag -labsl_flags_commandlineflag_internal -labsl_bad_optional_access -labsl_strings -labsl_string_view -labsl_strings_internal -labsl_int128 -labsl_flags_config -labsl_flags_program_name -labsl_synchronization -labsl_graphcycles_internal -labsl_malloc_internal -labsl_kernel_timeout_internal -labsl_time -labsl_civil_time -labsl_time_zone -labsl_stacktrace -labsl_debugging_internal -labsl_symbolize -labsl_demangle_internal -labsl_flags_internal -labsl_flags_marshalling -labsl_str_format_internal -labsl_flags_reflection -labsl_flags_private_handle_accessor -labsl_cord -labsl_cord_internal -labsl_crc_cord_state -labsl_crc32c -labsl_crc_cpu_detect -labsl_crc_internal -labsl_cordz_functions -labsl_exponential_biased -labsl_cordz_info -labsl_cordz_handle -labsl_hash -labsl_city -labsl_bad_variant_access -labsl_low_level_hash -labsl_raw_hash_set -labsl_hashtablez_sampler -lvboot_host -ldl -lprotobuf-lite -labsl_log_internal_check_op -labsl_log_internal_nullguard -labsl_log_internal_message -labsl_examine_stack -labsl_log_internal_format -labsl_log_internal_globals -labsl_log_internal_proto -labsl_log_internal_log_sink_set -labsl_log_globals -labsl_log_entry -labsl_log_sink -labsl_strerror -labsl_log_internal_conditions -labsl_leak_check -labsl_die_if_null -labsl_log_initialize -labsl_status -labsl_statusor -lutf8_validity -lutf8_range -lrootdev -lsystem_api-power_manager-protos
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
