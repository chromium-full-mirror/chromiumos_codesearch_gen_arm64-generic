rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/smbprovider/all.stamp
build obj/smbprovider/_smbproviderd-install_config.stamp: stamp
build obj/smbprovider/all.stamp: stamp obj/smbprovider/install_dbus_config.stamp obj/smbprovider/install_dbus_service.stamp obj/smbprovider/install_init.stamp obj/smbprovider/install_policy.stamp ./smbproviderd
build obj/smbprovider/install_dbus_config.stamp: stamp
build obj/smbprovider/install_dbus_service.stamp: stamp
build obj/smbprovider/install_init.stamp: stamp
build obj/smbprovider/install_policy.stamp: stamp
subninja obj/smbprovider/libsmbprovider.ninja
subninja obj/smbprovider/smbproviderd.ninja
rule __smbprovider_smbproviderd_adaptors___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/smbprovider-0.0.1-r1056/work/smbprovider-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/smbprovider/out/Default/gen/include/dbus_adaptors/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/smbprovider-0.0.1-r1056/work/smbprovider-0.0.1/smbprovider/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //smbprovider:smbproviderd_adaptors(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/dbus_adaptors/org.chromium.SmbProvider.h: __smbprovider_smbproviderd_adaptors___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/smbprovider-0.0.1-r1056/work/smbprovider-0.0.1/smbprovider/dbus_bindings/org.chromium.SmbProvider.xml | ../../../../../../../tmp/portage/chromeos-base/smbprovider-0.0.1-r1056/work/smbprovider-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.SmbProvider

build obj/smbprovider/smbproviderd_adaptors.stamp: stamp gen/include/dbus_adaptors/org.chromium.SmbProvider.h
