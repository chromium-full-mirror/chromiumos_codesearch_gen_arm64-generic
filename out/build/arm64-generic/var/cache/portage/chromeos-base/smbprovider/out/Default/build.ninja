ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/smbprovider-0.0.1-r1057/work/smbprovider-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _smbproviderd-install_config: phony obj/smbprovider/_smbproviderd-install_config.stamp
build install_dbus_config: phony obj/smbprovider/install_dbus_config.stamp
build install_dbus_service: phony obj/smbprovider/install_dbus_service.stamp
build install_init: phony obj/smbprovider/install_init.stamp
build install_policy: phony obj/smbprovider/install_policy.stamp
build libsmbprovider: phony ./libsmbprovider.a
build root: phony obj/common-mk/gn_root/root.stamp
build smbproviderd_adaptors: phony obj/smbprovider/smbproviderd_adaptors.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build smbprovider$:_smbproviderd-install_config: phony obj/smbprovider/_smbproviderd-install_config.stamp
build smbprovider$:all: phony obj/smbprovider/all.stamp
build smbprovider$:install_dbus_config: phony obj/smbprovider/install_dbus_config.stamp
build smbprovider$:install_dbus_service: phony obj/smbprovider/install_dbus_service.stamp
build smbprovider$:install_init: phony obj/smbprovider/install_init.stamp
build smbprovider$:install_policy: phony obj/smbprovider/install_policy.stamp
build smbprovider$:libsmbprovider: phony ./libsmbprovider.a
build smbprovider$:smbproviderd: phony ./smbproviderd
build smbprovider$:smbproviderd_adaptors: phony obj/smbprovider/smbproviderd_adaptors.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/smbprovider/_smbproviderd-install_config.stamp $
    obj/smbprovider/all.stamp $
    obj/smbprovider/install_dbus_config.stamp $
    obj/smbprovider/install_dbus_service.stamp $
    obj/smbprovider/install_init.stamp $
    obj/smbprovider/install_policy.stamp $
    ./libsmbprovider.a $
    ./smbproviderd $
    obj/smbprovider/smbproviderd_adaptors.stamp

default all
