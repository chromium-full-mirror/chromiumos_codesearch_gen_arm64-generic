ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/cros-camera-android-deps-0.0.1-r356/work/cros-camera-android-deps-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libcros_camera_android_deps-install_config: phony obj/camera/android/_libcros_camera_android_deps-install_config.stamp
build _libcros_camera_android_deps_pkg_config-install_config: phony obj/camera/android/_libcros_camera_android_deps_pkg_config-install_config.stamp
build install_header_files_include: phony obj/camera/android/install_header_files_include.stamp
build install_libcamera_client_include_camera: phony obj/camera/android/install_libcamera_client_include_camera.stamp
build install_libcamera_metadata_include_system: phony obj/camera/android/install_libcamera_metadata_include_system.stamp
build libcros_camera_android_deps: phony ./lib/libcros_camera_android_deps.so
build libcros_camera_android_deps_pkg_config: phony obj/camera/android/libcros_camera_android_deps_pkg_config.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build camera/android$:_libcros_camera_android_deps-install_config: phony obj/camera/android/_libcros_camera_android_deps-install_config.stamp
build camera/android$:_libcros_camera_android_deps_pkg_config-install_config: phony obj/camera/android/_libcros_camera_android_deps_pkg_config-install_config.stamp
build camera/android$:all: phony obj/camera/android/all.stamp
build camera/android$:install_header_files_include: phony obj/camera/android/install_header_files_include.stamp
build camera/android$:install_libcamera_client_include_camera: phony obj/camera/android/install_libcamera_client_include_camera.stamp
build camera/android$:install_libcamera_metadata_include_system: phony obj/camera/android/install_libcamera_metadata_include_system.stamp
build camera/android$:libcros_camera_android_deps: phony ./lib/libcros_camera_android_deps.so
build camera/android$:libcros_camera_android_deps_pkg_config: phony obj/camera/android/libcros_camera_android_deps_pkg_config.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/camera/android/_libcros_camera_android_deps-install_config.stamp $
    obj/camera/android/_libcros_camera_android_deps_pkg_config-install_config.stamp $
    obj/camera/android/all.stamp $
    obj/camera/android/install_header_files_include.stamp $
    obj/camera/android/install_libcamera_client_include_camera.stamp $
    obj/camera/android/install_libcamera_metadata_include_system.stamp $
    ./lib/libcros_camera_android_deps.so $
    obj/camera/android/libcros_camera_android_deps_pkg_config.stamp $
    obj/common-mk/gn_root/root.stamp

default all
