defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/mock_printer/proto -Igen/include -I../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r636/work/virtual-usb-printer-0.0.1/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libmocking_protos

build obj/gen/include/mock_printer/proto/libmocking_protos.control_flow.pb.o: cxx gen/include/mock_printer/proto/control_flow.pb.cc || obj/virtual-usb-printer/mock_printer/mocking_protos_gen.stamp
  source_file_part = control_flow.pb.cc
  source_name_part = control_flow.pb
build obj/gen/include/mock_printer/proto/libmocking_protos.http.pb.o: cxx gen/include/mock_printer/proto/http.pb.cc || obj/virtual-usb-printer/mock_printer/mocking_protos_gen.stamp
  source_file_part = http.pb.cc
  source_name_part = http.pb
build obj/gen/include/mock_printer/proto/libmocking_protos.ipp.pb.o: cxx gen/include/mock_printer/proto/ipp.pb.cc || obj/virtual-usb-printer/mock_printer/mocking_protos_gen.stamp
  source_file_part = ipp.pb.cc
  source_name_part = ipp.pb

build ./libmocking_protos.a: alink obj/gen/include/mock_printer/proto/libmocking_protos.control_flow.pb.o obj/gen/include/mock_printer/proto/libmocking_protos.http.pb.o obj/gen/include/mock_printer/proto/libmocking_protos.ipp.pb.o || obj/virtual-usb-printer/mock_printer/mocking_protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
