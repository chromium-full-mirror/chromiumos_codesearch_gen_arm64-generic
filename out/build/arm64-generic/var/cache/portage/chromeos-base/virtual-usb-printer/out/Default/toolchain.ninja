  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/common-mk/file_generator_wrapper.py protoc control_flow.proto http.proto ipp.proto --proto_path /build/arm64-generic/tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/virtual-usb-printer/mock_printer/proto --proto_path /build/arm64-generic/usr/share/proto --cpp_out=/build/arm64-generic/var/cache/portage/chromeos-base/virtual-usb-printer/out/Default/gen/include/mock_printer/proto
  description = ACTION //virtual-usb-printer/mock_printer:mocking_protos_gen(//common-mk/toolchain:toolchain)
