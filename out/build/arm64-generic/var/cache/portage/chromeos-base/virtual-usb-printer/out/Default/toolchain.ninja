subninja obj/virtual-usb-printer/mock_printer/ipp_matching.ninja
subninja obj/virtual-usb-printer/mock_printer/ipp_matching_validation.ninja
subninja obj/virtual-usb-printer/mock_printer/libipp_helper.ninja
subninja obj/virtual-usb-printer/mock_printer/mocking_protos.ninja
