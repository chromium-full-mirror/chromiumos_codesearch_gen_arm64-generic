build gen/include/mock_printer/proto/control_flow.pb.cc gen/include/mock_printer/proto/control_flow.pb.h gen/include/mock_printer/proto/http.pb.cc gen/include/mock_printer/proto/http.pb.h gen/include/mock_printer/proto/ipp.pb.cc gen/include/mock_printer/proto/ipp.pb.h: __virtual-usb-printer_mock_printer_mocking_protos_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/common-mk/file_generator_wrapper.py ../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/virtual-usb-printer/mock_printer/proto/control_flow.proto ../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/virtual-usb-printer/mock_printer/proto/http.proto ../../../../../../../tmp/portage/chromeos-base/virtual-usb-printer-0.0.1-r630/work/virtual-usb-printer-0.0.1/platform2/virtual-usb-printer/mock_printer/proto/ipp.proto

build obj/virtual-usb-printer/mock_printer/mocking_protos_gen.stamp: stamp gen/include/mock_printer/proto/control_flow.pb.cc gen/include/mock_printer/proto/control_flow.pb.h gen/include/mock_printer/proto/http.pb.cc gen/include/mock_printer/proto/http.pb.h gen/include/mock_printer/proto/ipp.pb.cc gen/include/mock_printer/proto/ipp.pb.h
