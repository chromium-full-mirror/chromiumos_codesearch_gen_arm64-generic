ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/cros-disks-0.0.1-r3883/work/cros-disks-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _cros-disks-install_config: phony obj/cros-disks/_cros-disks-install_config.stamp
build install_cros_disks_config: phony obj/cros-disks/install_cros_disks_config.stamp
build install_dbus_config: phony obj/cros-disks/install_dbus_config.stamp
build install_minijail_config: phony obj/cros-disks/install_minijail_config.stamp
build install_powerd_prefs: phony obj/cros-disks/install_powerd_prefs.stamp
build install_seccomp_policies: phony obj/cros-disks/install_seccomp_policies.stamp
build install_setuid_restriction: phony obj/cros-disks/install_setuid_restriction.stamp
build install_tmpfilesd: phony obj/cros-disks/install_tmpfilesd.stamp
build install_usb_device_info: phony obj/cros-disks/install_usb_device_info.stamp
build libdisks: phony ./libdisks.a
build libdisks-adaptors: phony obj/cros-disks/libdisks-adaptors.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build cros-disks$:_cros-disks-install_config: phony obj/cros-disks/_cros-disks-install_config.stamp
build cros-disks$:all: phony obj/cros-disks/all.stamp
build cros-disks$:cros-disks: phony ./cros-disks
build cros-disks$:install_cros_disks_config: phony obj/cros-disks/install_cros_disks_config.stamp
build cros-disks$:install_dbus_config: phony obj/cros-disks/install_dbus_config.stamp
build cros-disks$:install_minijail_config: phony obj/cros-disks/install_minijail_config.stamp
build cros-disks$:install_powerd_prefs: phony obj/cros-disks/install_powerd_prefs.stamp
build cros-disks$:install_seccomp_policies: phony obj/cros-disks/install_seccomp_policies.stamp
build cros-disks$:install_setuid_restriction: phony obj/cros-disks/install_setuid_restriction.stamp
build cros-disks$:install_tmpfilesd: phony obj/cros-disks/install_tmpfilesd.stamp
build cros-disks$:install_usb_device_info: phony obj/cros-disks/install_usb_device_info.stamp
build cros-disks$:libdisks: phony ./libdisks.a
build cros-disks$:libdisks-adaptors: phony obj/cros-disks/libdisks-adaptors.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/cros-disks/_cros-disks-install_config.stamp $
    obj/cros-disks/all.stamp $
    ./cros-disks $
    obj/cros-disks/install_cros_disks_config.stamp $
    obj/cros-disks/install_dbus_config.stamp $
    obj/cros-disks/install_minijail_config.stamp $
    obj/cros-disks/install_powerd_prefs.stamp $
    obj/cros-disks/install_seccomp_policies.stamp $
    obj/cros-disks/install_setuid_restriction.stamp $
    obj/cros-disks/install_tmpfilesd.stamp $
    obj/cros-disks/install_usb_device_info.stamp $
    ./libdisks.a $
    obj/cros-disks/libdisks-adaptors.stamp

default all
