rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/cros-disks/all.stamp
subninja obj/common-mk/testrunner/testrunner.ninja
build obj/cros-disks/_cros-disks-install_config.stamp: stamp
build obj/cros-disks/all.stamp: stamp ./cros-disks obj/cros-disks/install_cros_disks_config.stamp obj/cros-disks/install_dbus_config.stamp obj/cros-disks/install_minijail_config.stamp obj/cros-disks/install_powerd_prefs.stamp obj/cros-disks/install_setuid_restriction.stamp obj/cros-disks/install_tmpfilesd.stamp obj/cros-disks/install_usb_device_info.stamp ./libdisks.a obj/cros-disks/libdisks-adaptors.stamp obj/cros-disks/install_seccomp_policies.stamp ./disks_testrunner ./disks_testrunner_root
subninja obj/cros-disks/common_test_sources.ninja
subninja obj/cros-disks/cros-disks.ninja
subninja obj/cros-disks/disks_testrunner.ninja
subninja obj/cros-disks/disks_testrunner_root.ninja
build obj/cros-disks/install_cros_disks_config.stamp: stamp
build obj/cros-disks/install_dbus_config.stamp: stamp
build obj/cros-disks/install_minijail_config.stamp: stamp
build obj/cros-disks/install_powerd_prefs.stamp: stamp
build obj/cros-disks/install_seccomp_policies.stamp: stamp
build obj/cros-disks/install_setuid_restriction.stamp: stamp
build obj/cros-disks/install_tmpfilesd.stamp: stamp
build obj/cros-disks/install_usb_device_info.stamp: stamp
subninja obj/cros-disks/libdisks.ninja
rule __cros-disks_libdisks-adaptors___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/cros-disks/out/Default/gen/include/cros-disks/dbus_adaptors/${source_name_part}.h -service-config=/mnt/host/source/src/platform2/cros-disks/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //cros-disks:libdisks-adaptors(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/cros-disks/dbus_adaptors/org.chromium.CrosDisks.h: __cros-disks_libdisks-adaptors___common-mk_toolchain_toolchain__rule ../../../../../../../../../mnt/host/source/src/platform2/cros-disks/dbus_bindings/org.chromium.CrosDisks.xml | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.CrosDisks

build obj/cros-disks/libdisks-adaptors.stamp: stamp gen/include/cros-disks/dbus_adaptors/org.chromium.CrosDisks.h
