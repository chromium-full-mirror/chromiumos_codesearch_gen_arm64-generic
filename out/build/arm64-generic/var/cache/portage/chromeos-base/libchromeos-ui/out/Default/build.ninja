ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libchromeos-ui-0.0.1-r2130/work/libchromeos-ui-0.0.1/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libchromeos-ui: phony ./lib/libchromeos-ui.so
build libchromeos-ui_source_set: phony obj/libchromeos-ui/libchromeos-ui_source_set.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libchromeos-ui$:all: phony obj/libchromeos-ui/all.stamp
build libchromeos-ui$:libchromeos-ui: phony ./lib/libchromeos-ui.so
build libchromeos-ui$:libchromeos-ui_source_set: phony obj/libchromeos-ui/libchromeos-ui_source_set.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libchromeos-ui/all.stamp $
    ./lib/libchromeos-ui.so $
    obj/libchromeos-ui/libchromeos-ui_source_set.stamp

default all
