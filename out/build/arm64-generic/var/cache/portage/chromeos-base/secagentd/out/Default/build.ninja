build libfake_platform_features: phony ./lib/libfake_platform_features.so
build libfeatured: phony ./libfeatured.a
build libfeatures: phony ./lib/libfeatures.so
build libfeatures_c: phony ./lib/libfeatures_c.so
build libsecagent: phony ./libsecagent.a
