ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/secagentd-0.0.1-r407/work/secagentd-0.0.1/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build bpf_network: phony obj/secagentd/bpf_network.stamp
build bpf_process: phony obj/secagentd/bpf_process.stamp
build dbus-proxies: phony obj/common-mk/external_dependencies/dbus-proxies.stamp
build enterprise_management_goprotos: phony obj/common-mk/external_dependencies/enterprise_management_goprotos.stamp
build install_attributes-proto: phony ./libinstall_attributes-proto.a
build install_attributes-proto_gen: phony obj/common-mk/external_dependencies/install_attributes-proto_gen.stamp
build install_freezer_tmpfilesd: phony obj/secagentd/install_freezer_tmpfilesd.stamp
build install_minijail_conf: phony obj/secagentd/install_minijail_conf.stamp
build install_rsyslog_conf: phony obj/secagentd/install_rsyslog_conf.stamp
build install_tmpfiles_conf: phony obj/secagentd/install_tmpfiles_conf.stamp
build install_upstart_conf: phony obj/secagentd/install_upstart_conf.stamp
build libsecagent: phony ./libsecagent.a
build libsecagentd-goprotos: phony obj/secagentd/proto/libsecagentd-goprotos.stamp
build modemmanager-dbus-adaptors: phony obj/common-mk/external_dependencies/modemmanager-dbus-adaptors.stamp
build policy-goprotos: phony obj/common-mk/external_dependencies/policy-goprotos.stamp
build policy-protos: phony ./libpolicy-protos.a
build policy-protos_gen: phony obj/common-mk/external_dependencies/policy-protos_gen.stamp
build policy_common_definitions-protos: phony ./libpolicy_common_definitions-protos.a
build policy_common_definitions-protos_gen: phony obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp
build private_membership_goprotos: phony obj/common-mk/external_dependencies/private_membership_goprotos.stamp
build private_membership_rlwe_goprotos: phony obj/common-mk/external_dependencies/private_membership_rlwe_goprotos.stamp
build rlwe_goprotos: phony obj/common-mk/external_dependencies/rlwe_goprotos.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build security_xdr_events_proto: phony ./libsecurity_xdr_events_proto.a
build security_xdr_events_proto_gen: phony obj/secagentd/proto/security_xdr_events_proto_gen.stamp
build user_policy-protos: phony ./libuser_policy-protos.a
build user_policy-protos_gen: phony obj/common-mk/external_dependencies/user_policy-protos_gen.stamp
build vmlinux_h: phony obj/secagentd/vmlinux_h.stamp
build common-mk/external_dependencies$:dbus-proxies: phony obj/common-mk/external_dependencies/dbus-proxies.stamp
build common-mk/external_dependencies$:enterprise_management_goprotos: phony obj/common-mk/external_dependencies/enterprise_management_goprotos.stamp
build common-mk/external_dependencies$:install_attributes-proto: phony ./libinstall_attributes-proto.a
build common-mk/external_dependencies$:install_attributes-proto_gen: phony obj/common-mk/external_dependencies/install_attributes-proto_gen.stamp
build common-mk/external_dependencies$:modemmanager-dbus-adaptors: phony obj/common-mk/external_dependencies/modemmanager-dbus-adaptors.stamp
build common-mk/external_dependencies$:policy-goprotos: phony obj/common-mk/external_dependencies/policy-goprotos.stamp
build common-mk/external_dependencies$:policy-protos: phony ./libpolicy-protos.a
build common-mk/external_dependencies$:policy-protos_gen: phony obj/common-mk/external_dependencies/policy-protos_gen.stamp
build common-mk/external_dependencies$:policy_common_definitions-protos: phony ./libpolicy_common_definitions-protos.a
build common-mk/external_dependencies$:policy_common_definitions-protos_gen: phony obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp
build common-mk/external_dependencies$:private_membership_goprotos: phony obj/common-mk/external_dependencies/private_membership_goprotos.stamp
build common-mk/external_dependencies$:private_membership_rlwe_goprotos: phony obj/common-mk/external_dependencies/private_membership_rlwe_goprotos.stamp
build common-mk/external_dependencies$:rlwe_goprotos: phony obj/common-mk/external_dependencies/rlwe_goprotos.stamp
build common-mk/external_dependencies$:user_policy-protos: phony ./libuser_policy-protos.a
build common-mk/external_dependencies$:user_policy-protos_gen: phony obj/common-mk/external_dependencies/user_policy-protos_gen.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build secagentd$:all: phony obj/secagentd/all.stamp
build secagentd$:bpf_network: phony obj/secagentd/bpf_network.stamp
build secagentd$:bpf_process: phony obj/secagentd/bpf_process.stamp
build secagentd$:install_freezer_tmpfilesd: phony obj/secagentd/install_freezer_tmpfilesd.stamp
build secagentd$:install_minijail_conf: phony obj/secagentd/install_minijail_conf.stamp
build secagentd$:install_rsyslog_conf: phony obj/secagentd/install_rsyslog_conf.stamp
build secagentd$:install_tmpfiles_conf: phony obj/secagentd/install_tmpfiles_conf.stamp
build secagentd$:install_upstart_conf: phony obj/secagentd/install_upstart_conf.stamp
build secagentd$:libsecagent: phony ./libsecagent.a
build secagentd$:secagentd: phony ./secagentd
build secagentd$:vmlinux_h: phony obj/secagentd/vmlinux_h.stamp
build secagentd/proto$:all: phony obj/secagentd/proto/all.stamp
build secagentd/proto$:libsecagentd-goprotos: phony obj/secagentd/proto/libsecagentd-goprotos.stamp
build secagentd/proto$:security_xdr_events_proto: phony ./libsecurity_xdr_events_proto.a
build secagentd/proto$:security_xdr_events_proto_gen: phony obj/secagentd/proto/security_xdr_events_proto_gen.stamp

build all: phony $
    obj/common-mk/external_dependencies/dbus-proxies.stamp $
    obj/common-mk/external_dependencies/enterprise_management_goprotos.stamp $
    ./libinstall_attributes-proto.a $
    obj/common-mk/external_dependencies/install_attributes-proto_gen.stamp $
    obj/common-mk/external_dependencies/modemmanager-dbus-adaptors.stamp $
    obj/common-mk/external_dependencies/policy-goprotos.stamp $
    ./libpolicy-protos.a $
    obj/common-mk/external_dependencies/policy-protos_gen.stamp $
    ./libpolicy_common_definitions-protos.a $
    obj/common-mk/external_dependencies/policy_common_definitions-protos_gen.stamp $
    obj/common-mk/external_dependencies/private_membership_goprotos.stamp $
    obj/common-mk/external_dependencies/private_membership_rlwe_goprotos.stamp $
    obj/common-mk/external_dependencies/rlwe_goprotos.stamp $
    ./libuser_policy-protos.a $
    obj/common-mk/external_dependencies/user_policy-protos_gen.stamp $
    obj/common-mk/gn_root/root.stamp $
    obj/secagentd/all.stamp $
    obj/secagentd/bpf_network.stamp $
    obj/secagentd/bpf_process.stamp $
    obj/secagentd/install_freezer_tmpfilesd.stamp $
    obj/secagentd/install_minijail_conf.stamp $
    obj/secagentd/install_rsyslog_conf.stamp $
    obj/secagentd/install_tmpfiles_conf.stamp $
    obj/secagentd/install_upstart_conf.stamp $
    ./libsecagent.a $
    ./secagentd $
    obj/secagentd/vmlinux_h.stamp $
    obj/secagentd/proto/all.stamp $
    obj/secagentd/proto/libsecagentd-goprotos.stamp $
    ./libsecurity_xdr_events_proto.a $
    obj/secagentd/proto/security_xdr_events_proto_gen.stamp

default all
