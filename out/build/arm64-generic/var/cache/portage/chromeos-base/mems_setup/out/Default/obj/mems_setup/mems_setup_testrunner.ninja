defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DUSE_IIOSERVICE_PROXIMITY=false
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -pthread
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = mems_setup_testrunner

build obj/mems_setup/mems_setup_testrunner.accel_3d_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/accel_3d_test.cc
  source_file_part = accel_3d_test.cc
  source_name_part = accel_3d_test
build obj/mems_setup/mems_setup_testrunner.accelerometer_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/accelerometer_test.cc
  source_file_part = accelerometer_test.cc
  source_name_part = accelerometer_test
build obj/mems_setup/mems_setup_testrunner.als_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/als_test.cc
  source_file_part = als_test.cc
  source_name_part = als_test
build obj/mems_setup/mems_setup_testrunner.gyroscope_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/gyroscope_test.cc
  source_file_part = gyroscope_test.cc
  source_name_part = gyroscope_test
build obj/mems_setup/mems_setup_testrunner.light_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/light_test.cc
  source_file_part = light_test.cc
  source_name_part = light_test
build obj/mems_setup/mems_setup_testrunner.proximity_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/proximity_test.cc
  source_file_part = proximity_test.cc
  source_name_part = proximity_test
build obj/mems_setup/mems_setup_testrunner.test_fakes.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/test_fakes.cc
  source_file_part = test_fakes.cc
  source_name_part = test_fakes
build obj/mems_setup/mems_setup_testrunner.test_helper.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/test_helper.cc
  source_file_part = test_helper.cc
  source_name_part = test_helper
build obj/mems_setup/mems_setup_testrunner.vpd_loader_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/mems_setup/vpd_loader_test.cc
  source_file_part = vpd_loader_test.cc
  source_name_part = vpd_loader_test

build ./mems_setup_testrunner: link obj/mems_setup/mems_setup_testrunner.accel_3d_test.o obj/mems_setup/mems_setup_testrunner.accelerometer_test.o obj/mems_setup/mems_setup_testrunner.als_test.o obj/mems_setup/mems_setup_testrunner.gyroscope_test.o obj/mems_setup/mems_setup_testrunner.light_test.o obj/mems_setup/mems_setup_testrunner.proximity_test.o obj/mems_setup/mems_setup_testrunner.test_fakes.o obj/mems_setup/mems_setup_testrunner.test_helper.o obj/mems_setup/mems_setup_testrunner.vpd_loader_test.o ./libmems_setup.a ./libtestrunner.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -pthread -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -lbrillo-test -lbrillo -lbase -lcurl -lbase-test -lcros_config -lsar -lre2 -lmems_test_support -lsar_test_support -lmems
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
