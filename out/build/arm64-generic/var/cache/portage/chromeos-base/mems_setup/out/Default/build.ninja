ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/mems_setup-0.0.1-r918/work/mems_setup-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _mems_remove-install_config: phony obj/mems_setup/_mems_remove-install_config.stamp
build _mems_setup-install_config: phony obj/mems_setup/_mems_setup-install_config.stamp
build libmems_setup: phony ./libmems_setup.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build mems_setup$:_mems_remove-install_config: phony obj/mems_setup/_mems_remove-install_config.stamp
build mems_setup$:_mems_setup-install_config: phony obj/mems_setup/_mems_setup-install_config.stamp
build mems_setup$:all: phony obj/mems_setup/all.stamp
build mems_setup$:libmems_setup: phony ./libmems_setup.a
build mems_setup$:mems_remove: phony ./mems_remove
build mems_setup$:mems_setup: phony ./mems_setup

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/mems_setup/_mems_remove-install_config.stamp $
    obj/mems_setup/_mems_setup-install_config.stamp $
    obj/mems_setup/all.stamp $
    ./libmems_setup.a $
    ./mems_remove $
    ./mems_setup

default all
