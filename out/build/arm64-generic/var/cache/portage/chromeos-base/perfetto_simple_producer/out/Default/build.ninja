ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/perfetto_simple_producer-0.0.1-r327/work/perfetto_simple_producer-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _perfetto_simple_producer-install_config: phony obj/perfetto_simple_producer/_perfetto_simple_producer-install_config.stamp
build libperfetto_simple_producer: phony ./libperfetto_simple_producer.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build perfetto_simple_producer$:_perfetto_simple_producer-install_config: phony obj/perfetto_simple_producer/_perfetto_simple_producer-install_config.stamp
build perfetto_simple_producer$:all: phony obj/perfetto_simple_producer/all.stamp
build perfetto_simple_producer$:libperfetto_simple_producer: phony ./libperfetto_simple_producer.a
build perfetto_simple_producer$:perfetto_simple_producer: phony ./perfetto_simple_producer

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/perfetto_simple_producer/_perfetto_simple_producer-install_config.stamp $
    obj/perfetto_simple_producer/all.stamp $
    ./libperfetto_simple_producer.a $
    ./perfetto_simple_producer

default all
