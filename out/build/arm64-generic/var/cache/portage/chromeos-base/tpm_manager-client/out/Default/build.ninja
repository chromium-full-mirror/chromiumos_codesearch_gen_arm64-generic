ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/tpm_manager-client-0.0.1-r772/work/tpm_manager-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libtpm_manager: phony ./lib/libtpm_manager.so
build libtpm_manager-client: phony obj/tpm_manager/client/libtpm_manager-client.stamp
build libtpm_manager-client-headers: phony obj/tpm_manager/client/libtpm_manager-client-headers.stamp
build libtpm_manager-client-test: phony obj/tpm_manager/client/libtpm_manager-client-test.stamp
build print_proto_library: phony obj/tpm_manager/client/print_proto_library.stamp
build proto_library: phony ./libproto_library.a
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build tpm_manager/client$:all: phony obj/tpm_manager/client/all.stamp
build tpm_manager/client$:libtpm_manager: phony ./lib/libtpm_manager.so
build tpm_manager/client$:libtpm_manager-client: phony obj/tpm_manager/client/libtpm_manager-client.stamp
build tpm_manager/client$:libtpm_manager-client-headers: phony obj/tpm_manager/client/libtpm_manager-client-headers.stamp
build tpm_manager/client$:libtpm_manager-client-test: phony obj/tpm_manager/client/libtpm_manager-client-test.stamp
build tpm_manager/client$:print_proto_library: phony obj/tpm_manager/client/print_proto_library.stamp
build tpm_manager/client$:proto_library: phony ./libproto_library.a
build tpm_manager/client$:tpm_manager_client: phony ./tpm_manager_client

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/tpm_manager/client/all.stamp $
    ./lib/libtpm_manager.so $
    obj/tpm_manager/client/libtpm_manager-client.stamp $
    obj/tpm_manager/client/libtpm_manager-client-headers.stamp $
    obj/tpm_manager/client/libtpm_manager-client-test.stamp $
    obj/tpm_manager/client/print_proto_library.stamp $
    ./libproto_library.a $
    ./tpm_manager_client

default all
