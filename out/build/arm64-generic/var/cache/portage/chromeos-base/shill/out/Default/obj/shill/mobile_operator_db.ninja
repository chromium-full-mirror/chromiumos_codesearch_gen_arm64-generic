defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DPKCS11_LIB=\"/usr/lib64/libchaps.so\" -DRUNDIR=\"/run/shill\" -DSHIMDIR=\"/usr/lib64/shill/shims\" -DTEST_BUILD
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
root_out_dir = .
target_output_name = libmobile_operator_db

build obj/shill/mobile_operator_db.inputdeps.stamp: stamp obj/shill/mobile_operator_db-db_gen.stamp obj/shill/mobile_operator_db-protos_gen.stamp

build ./libmobile_operator_db.a: alink || obj/shill/mobile_operator_db-db.stamp ./libmobile_operator_db-protos.a
  arflags = rcsT
  output_extension = .a
  output_dir = 
