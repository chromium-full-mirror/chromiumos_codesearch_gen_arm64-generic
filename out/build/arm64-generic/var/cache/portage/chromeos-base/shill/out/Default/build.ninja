build metrics/structured$:gen_structured_events: phony obj/metrics/structured/gen_structured_events.stamp
build metrics/structured$:libstructuredmetrics: phony ./lib/libstructuredmetrics.so
build metrics/structured$:libstructuredmetrics_pkg_config: phony obj/metrics/structured/libstructuredmetrics_pkg_config.stamp
build metrics/structured$:storage: phony ./libstorage.a
build metrics/structured$:storage_gen: phony obj/metrics/structured/storage_gen.stamp
build metrics/structured$:update_reset_counter: phony ./update_reset_counter
build net-base$:_libnet-base-install_config: phony obj/net-base/_libnet-base-install_config.stamp
build net-base$:_libnet-base_pc-install_config: phony obj/net-base/_libnet-base_pc-install_config.stamp
build net-base$:all: phony obj/net-base/all.stamp
build net-base$:libnet-base: phony ./lib/libnet-base.so
build net-base$:libnet-base-testrunner: phony ./libnet-base-testrunner
build net-base$:libnet-base_pc: phony obj/net-base/libnet-base_pc.stamp
build net-base$:net_base_test_support: phony obj/net-base/net_base_test_support.stamp
build shill$:all: phony obj/shill/all.stamp
build shill$:cellular_mobile_operator_info_tester: phony ./cellular_mobile_operator_info_tester
build shill$:generate_bluetooth_proxies: phony obj/shill/generate_bluetooth_proxies.stamp
build shill$:generate_cellular_proxies: phony obj/shill/generate_cellular_proxies.stamp
build shill$:generate_dhcpcd_proxies: phony obj/shill/generate_dhcpcd_proxies.stamp
build shill$:generate_supplicant_proxies: phony obj/shill/generate_supplicant_proxies.stamp
