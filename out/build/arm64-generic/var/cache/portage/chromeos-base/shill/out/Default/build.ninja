ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/shill-0.0.6-r4761/work/shill-0.0.6 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build generate_bluetooth_proxies: phony obj/shill/generate_bluetooth_proxies.stamp
build generate_cellular_proxies: phony obj/shill/generate_cellular_proxies.stamp
build generate_dhcpcd_proxies: phony obj/shill/generate_dhcpcd_proxies.stamp
build generate_supplicant_proxies: phony obj/shill/generate_supplicant_proxies.stamp
build generate_upstart_proxies: phony obj/shill/generate_upstart_proxies.stamp
build libshill: phony ./libshill.a
build mobile_operator_db: phony ./libmobile_operator_db.a
build mobile_operator_db-db: phony obj/shill/mobile_operator_db-db.stamp
build mobile_operator_db-db_gen: phony obj/shill/mobile_operator_db-db_gen.stamp
build mobile_operator_db-protos: phony ./libmobile_operator_db-protos.a
build mobile_operator_db-protos_gen: phony obj/shill/mobile_operator_db-protos_gen.stamp
build mobile_operator_db-test-db: phony obj/shill/mobile_operator_db-test-db.stamp
build mobile_operator_db-test-db_gen: phony obj/shill/mobile_operator_db-test-db_gen.stamp
build mojo_bindings: phony ./libmojo_bindings.a
build mojo_bindings_gen: phony obj/shill/mojo_bindings_gen.stamp
build mojo_bindings_gen_mojo_templates: phony obj/shill/mojo_bindings_gen_mojo_templates.stamp
build mojo_bindings_gen_mojo_templates_dir: phony obj/shill/mojo_bindings_gen_mojo_templates_dir.stamp
build mojo_bindings_gen_parse: phony obj/shill/mojo_bindings_gen_parse.stamp
build mojo_policy: phony obj/shill/mojo_policy.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build shill-chromeos-dbus-adaptors: phony obj/shill/shill-chromeos-dbus-adaptors.stamp
build shill-pppd-plugin: phony ./lib/libshill-pppd-plugin.so
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build shill$:all: phony obj/shill/all.stamp
build shill$:cellular_mobile_operator_info_tester: phony ./cellular_mobile_operator_info_tester
build shill$:generate_bluetooth_proxies: phony obj/shill/generate_bluetooth_proxies.stamp
build shill$:generate_cellular_proxies: phony obj/shill/generate_cellular_proxies.stamp
build shill$:generate_dhcpcd_proxies: phony obj/shill/generate_dhcpcd_proxies.stamp
build shill$:generate_supplicant_proxies: phony obj/shill/generate_supplicant_proxies.stamp
build shill$:generate_upstart_proxies: phony obj/shill/generate_upstart_proxies.stamp
build shill$:libshill: phony ./libshill.a
build shill$:mobile_operator_db: phony ./libmobile_operator_db.a
build shill$:mobile_operator_db-db: phony obj/shill/mobile_operator_db-db.stamp
build shill$:mobile_operator_db-db_gen: phony obj/shill/mobile_operator_db-db_gen.stamp
build shill$:mobile_operator_db-protos: phony ./libmobile_operator_db-protos.a
build shill$:mobile_operator_db-protos_gen: phony obj/shill/mobile_operator_db-protos_gen.stamp
build shill$:mobile_operator_db-test-db: phony obj/shill/mobile_operator_db-test-db.stamp
build shill$:mobile_operator_db-test-db_gen: phony obj/shill/mobile_operator_db-test-db_gen.stamp
build shill$:mojo_bindings: phony ./libmojo_bindings.a
build shill$:mojo_bindings_gen: phony obj/shill/mojo_bindings_gen.stamp
build shill$:mojo_bindings_gen_mojo_templates: phony obj/shill/mojo_bindings_gen_mojo_templates.stamp
build shill$:mojo_bindings_gen_mojo_templates_dir: phony obj/shill/mojo_bindings_gen_mojo_templates_dir.stamp
build shill$:mojo_bindings_gen_parse: phony obj/shill/mojo_bindings_gen_parse.stamp
build shill$:mojo_policy: phony obj/shill/mojo_policy.stamp
build shill$:openvpn-script: phony ./openvpn-script
build shill$:set-apn-helper: phony ./set-apn-helper
build shill$:shill: phony ./shill
build shill$:shill-chromeos-dbus-adaptors: phony obj/shill/shill-chromeos-dbus-adaptors.stamp
build shill$:shill-pppd-plugin: phony ./lib/libshill-pppd-plugin.so

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/shill/all.stamp $
    ./cellular_mobile_operator_info_tester $
    obj/shill/generate_bluetooth_proxies.stamp $
    obj/shill/generate_cellular_proxies.stamp $
    obj/shill/generate_dhcpcd_proxies.stamp $
    obj/shill/generate_supplicant_proxies.stamp $
    obj/shill/generate_upstart_proxies.stamp $
    ./libshill.a $
    ./libmobile_operator_db.a $
    obj/shill/mobile_operator_db-db.stamp $
    obj/shill/mobile_operator_db-db_gen.stamp $
    ./libmobile_operator_db-protos.a $
    obj/shill/mobile_operator_db-protos_gen.stamp $
    obj/shill/mobile_operator_db-test-db.stamp $
    obj/shill/mobile_operator_db-test-db_gen.stamp $
    ./libmojo_bindings.a $
    obj/shill/mojo_bindings_gen.stamp $
    obj/shill/mojo_bindings_gen_mojo_templates.stamp $
    obj/shill/mojo_bindings_gen_mojo_templates_dir.stamp $
    obj/shill/mojo_bindings_gen_parse.stamp $
    obj/shill/mojo_policy.stamp $
    ./openvpn-script $
    ./set-apn-helper $
    ./shill $
    obj/shill/shill-chromeos-dbus-adaptors.stamp $
    ./lib/libshill-pppd-plugin.so

default all
