ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libnet-base-install_config: phony obj/net-base/_libnet-base-install_config.stamp
build _libnet-base_pc-install_config: phony obj/net-base/_libnet-base_pc-install_config.stamp
build _libshill-net-install_config: phony obj/shill/net/_libshill-net-install_config.stamp
build _update_reset_counter-install_config: phony obj/metrics/structured/_update_reset_counter-install_config.stamp
build gen_structured_events: phony obj/metrics/structured/gen_structured_events.stamp
build generate_bluetooth_proxies: phony obj/shill/generate_bluetooth_proxies.stamp
build generate_cellular_proxies: phony obj/shill/generate_cellular_proxies.stamp
build generate_dhcpcd_proxies: phony obj/shill/generate_dhcpcd_proxies.stamp
build generate_supplicant_proxies: phony obj/shill/generate_supplicant_proxies.stamp
build generate_upstart_proxies: phony obj/shill/generate_upstart_proxies.stamp
build install_headers: phony obj/shill/net/install_headers.stamp
build install_minijail_conf: phony obj/metrics/install_minijail_conf.stamp
build libmetrics: phony ./lib/libmetrics.so
build libmetrics_daemon: phony ./libmetrics_daemon.a
build libnet-base: phony ./lib/libnet-base.so
build libnet-base_pc: phony obj/net-base/libnet-base_pc.stamp
build libshill: phony ./libshill.a
build libshill-net: phony ./lib/libshill-net.so
build libshill-net_deps: phony obj/shill/net/libshill-net_deps.stamp
build libstructuredmetrics: phony ./lib/libstructuredmetrics.so
build libstructuredmetrics_pkg_config: phony obj/metrics/structured/libstructuredmetrics_pkg_config.stamp
build libupload_service: phony ./libupload_service.a
build metrics_proto: phony ./libmetrics_proto.a
build metrics_proto_gen: phony obj/metrics/metrics_proto_gen.stamp
build metrics_test_support: phony obj/metrics/metrics_test_support.stamp
build mobile_operator_db: phony ./libmobile_operator_db.a
build mobile_operator_db-db: phony obj/shill/mobile_operator_db-db.stamp
build mobile_operator_db-db_gen: phony obj/shill/mobile_operator_db-db_gen.stamp
build mobile_operator_db-protos: phony ./libmobile_operator_db-protos.a
build mobile_operator_db-protos_gen: phony obj/shill/mobile_operator_db-protos_gen.stamp
build mobile_operator_db-test-db: phony obj/shill/mobile_operator_db-test-db.stamp
build mobile_operator_db-test-db_gen: phony obj/shill/mobile_operator_db-test-db_gen.stamp
build mojo_bindings: phony ./libmojo_bindings.a
build mojo_bindings_gen: phony obj/shill/mojo_bindings_gen.stamp
build mojo_bindings_gen_mojo_templates: phony obj/shill/mojo_bindings_gen_mojo_templates.stamp
build mojo_bindings_gen_mojo_templates_dir: phony obj/shill/mojo_bindings_gen_mojo_templates_dir.stamp
build mojo_bindings_gen_parse: phony obj/shill/mojo_bindings_gen_parse.stamp
build mojo_policy: phony obj/shill/mojo_policy.stamp
build net_base_test_support: phony obj/net-base/net_base_test_support.stamp
build net_test_support: phony obj/shill/net/net_test_support.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build shill-chromeos-dbus-adaptors: phony obj/shill/shill-chromeos-dbus-adaptors.stamp
build shill-pppd-plugin: phony ./lib/libshill-pppd-plugin.so
build storage: phony ./libstorage.a
build storage_gen: phony obj/metrics/structured/storage_gen.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build metrics$:all: phony obj/metrics/all.stamp
build metrics$:chromeos-pgmem: phony ./chromeos-pgmem
build metrics$:cumulative_metrics_test: phony ./cumulative_metrics_test
build metrics$:hold_lock_file: phony ./hold_lock_file
build metrics$:install_minijail_conf: phony obj/metrics/install_minijail_conf.stamp
build metrics$:libmetrics: phony ./lib/libmetrics.so
