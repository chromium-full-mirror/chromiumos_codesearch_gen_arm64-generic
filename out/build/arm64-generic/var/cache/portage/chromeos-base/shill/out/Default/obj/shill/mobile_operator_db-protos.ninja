defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include/shill/mobile_operator_db -Igen/include -I../../../../../../../tmp/portage/chromeos-base/shill-0.0.6-r4678/work/shill-0.0.6 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE
cflags_cc = -Wno-unreachable-code -Wno-deprecated-declarations -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -O2 -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libmobile_operator_db-protos

build obj/gen/include/shill/mobile_operator_db/libmobile_operator_db-protos.mobile_operator_db.pb.o: cxx gen/include/shill/mobile_operator_db/mobile_operator_db.pb.cc || obj/shill/mobile_operator_db-protos_gen.stamp
  source_file_part = mobile_operator_db.pb.cc
  source_name_part = mobile_operator_db.pb

build ./libmobile_operator_db-protos.a: alink obj/gen/include/shill/mobile_operator_db/libmobile_operator_db-protos.mobile_operator_db.pb.o || obj/shill/mobile_operator_db-protos_gen.stamp
  arflags = rcsT
  output_extension = .a
  output_dir = 
