defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64 -DPKCS11_LIB=\"/usr/lib64/libchaps.so\" -DRUNDIR=\"/run/shill\" -DSHIMDIR=\"/usr/lib64/shill/shims\" -DTEST_BUILD
