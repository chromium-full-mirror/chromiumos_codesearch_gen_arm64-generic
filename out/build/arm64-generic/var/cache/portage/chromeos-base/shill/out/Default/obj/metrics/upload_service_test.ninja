defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -I../../../../../../../../../mnt/host/source/src/platform2/metrics -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include -Igen
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -pthread
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -O2 -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-exceptions
root_out_dir = .
target_output_name = upload_service_test

build obj/metrics/upload_service_test.persistent_integer.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/persistent_integer.cc || obj/metrics/metrics_proto_gen.stamp
  source_file_part = persistent_integer.cc
  source_name_part = persistent_integer
build obj/metrics/uploader/upload_service_test.metrics_hashes_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/uploader/metrics_hashes_test.cc || obj/metrics/metrics_proto_gen.stamp
  source_file_part = metrics_hashes_test.cc
  source_name_part = metrics_hashes_test
build obj/metrics/uploader/upload_service_test.metrics_log_base_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/uploader/metrics_log_base_test.cc || obj/metrics/metrics_proto_gen.stamp
  source_file_part = metrics_log_base_test.cc
  source_name_part = metrics_log_base_test
build obj/metrics/uploader/mock/upload_service_test.sender_mock.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/uploader/mock/sender_mock.cc || obj/metrics/metrics_proto_gen.stamp
  source_file_part = sender_mock.cc
  source_name_part = sender_mock
build obj/metrics/uploader/upload_service_test.upload_service_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/uploader/upload_service_test.cc || obj/metrics/metrics_proto_gen.stamp
  source_file_part = upload_service_test.cc
  source_name_part = upload_service_test

build ./upload_service_test: link obj/metrics/upload_service_test.persistent_integer.o obj/metrics/uploader/upload_service_test.metrics_hashes_test.o obj/metrics/uploader/upload_service_test.metrics_log_base_test.o obj/metrics/uploader/mock/upload_service_test.sender_mock.o obj/metrics/uploader/upload_service_test.upload_service_test.o ./libupload_service.a ./libtestrunner.a ./lib/libmetrics.so ./libmetrics_proto.a
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -pthread -L/build/arm64-generic/usr/lib64
  libs = -lgmock -lgtest -lpthread -ldbus-1 -lbrillo -lbase -lre2 -lvboot_host -lprotobuf-lite -lbase-test
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
