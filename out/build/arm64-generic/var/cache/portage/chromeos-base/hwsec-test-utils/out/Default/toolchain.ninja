rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/hwsec-test-utils/all.stamp
build obj/hwsec-test-utils/_attestation-injected-keys-install_config.stamp: stamp
build obj/hwsec-test-utils/_fake_pca_agentd-install_config.stamp: stamp
build obj/hwsec-test-utils/_hwsec-ownership-id-install_config.stamp: stamp
build obj/hwsec-test-utils/_hwsec-test-va-install_config.stamp: stamp
build obj/hwsec-test-utils/all.stamp: stamp ./attestation-injected-keys ./fake_pca_agentd ./hwsec-ownership-id ./hwsec-test-va
subninja obj/hwsec-test-utils/attestation-injected-keys.ninja
subninja obj/hwsec-test-utils/common_library.ninja
subninja obj/hwsec-test-utils/fake_pca_agent_library.ninja
subninja obj/hwsec-test-utils/fake_pca_agentd.ninja
subninja obj/hwsec-test-utils/hwsec-ownership-id.ninja
subninja obj/hwsec-test-utils/hwsec-test-va.ninja
subninja obj/hwsec-test-utils/verified_access_library.ninja
