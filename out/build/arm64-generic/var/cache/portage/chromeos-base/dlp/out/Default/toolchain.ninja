rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/dlp/all.stamp
build obj/dlp/_dlp-install_config.stamp: stamp
build obj/dlp/_dlp_init-install_config.stamp: stamp
build obj/dlp/all.stamp: stamp obj/dlp/dbus_adaptors_generator.stamp obj/dlp/dbus_proxies_generator.stamp ./dlp ./dlp_init obj/dlp/install_init.stamp obj/dlp/install_seccomp_policy.stamp obj/dlp/install_system-services.stamp obj/dlp/install_systemd.stamp
rule __dlp_dbus_adaptors_generator___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/dlp/out/Default/gen/include/dlp/${source_name_part}.h -service-config=/mnt/host/source/src/platform2/dlp/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //dlp:dbus_adaptors_generator(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/dlp/org.chromium.Dlp.h: __dlp_dbus_adaptors_generator___common-mk_toolchain_toolchain__rule ../../../../../../../../../mnt/host/source/src/platform2/dlp/dbus_bindings/org.chromium.Dlp.xml | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.Dlp

build obj/dlp/dbus_adaptors_generator.stamp: stamp gen/include/dlp/org.chromium.Dlp.h
rule __dlp_dbus_proxies_generator___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -service-config= -proxy=/build/arm64-generic/var/cache/portage/chromeos-base/dlp/out/Default/gen/include/dlp/dbus-proxies.h -mock=/build/arm64-generic/var/cache/portage/chromeos-base/dlp/out/Default/gen/include/dlp/dbus-proxy-mocks.h ../../../../../../../../../mnt/host/source/src/platform2/dlp/dbus_bindings/org.chromium.DlpFilesPolicyService.xml
  description = ACTION //dlp:dbus_proxies_generator(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/dlp/dbus-proxies.h gen/include/dlp/dbus-proxy-mocks.h: __dlp_dbus_proxies_generator___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../mnt/host/source/src/platform2/dlp/dbus_bindings/org.chromium.DlpFilesPolicyService.xml

build obj/dlp/dbus_proxies_generator.stamp: stamp gen/include/dlp/dbus-proxies.h gen/include/dlp/dbus-proxy-mocks.h
subninja obj/dlp/dlp.ninja
subninja obj/dlp/dlp_init.ninja
build obj/dlp/install_init.stamp: stamp
build obj/dlp/install_seccomp_policy.stamp: stamp
build obj/dlp/install_system-services.stamp: stamp
build obj/dlp/install_systemd.stamp: stamp
subninja obj/dlp/libdlp_static.ninja
