defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -pthread
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables -fno-exceptions
root_out_dir = .
target_output_name = metrics_library_test

build obj/metrics/metrics_library_test.fake_metrics_library_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/fake_metrics_library_test.cc
  source_file_part = fake_metrics_library_test.cc
  source_name_part = fake_metrics_library_test
build obj/metrics/metrics_library_test.metrics_library_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/metrics_library_test.cc
  source_file_part = metrics_library_test.cc
  source_name_part = metrics_library_test
build obj/metrics/metrics_library_test.metrics_writer_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/metrics_writer_test.cc
  source_file_part = metrics_writer_test.cc
  source_name_part = metrics_writer_test
build obj/metrics/serialization/metrics_library_test.serialization_utils_test.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/serialization/serialization_utils_test.cc
  source_file_part = serialization_utils_test.cc
  source_name_part = serialization_utils_test

build ./metrics_library_test: link obj/metrics/metrics_library_test.fake_metrics_library_test.o obj/metrics/metrics_library_test.metrics_library_test.o obj/metrics/metrics_library_test.metrics_writer_test.o obj/metrics/serialization/metrics_library_test.serialization_utils_test.o obj/metrics/metrics_test_support.fake_metrics_library.o ./lib/libmetrics.so ./libtestrunner.a || ./hold_lock_file obj/metrics/metrics_test_support.stamp
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic -pie -pthread -Wl,-rpath=\$$ORIGIN/lib/ -Wl,-rpath-link=lib/ -pthread -L/build/arm64-generic/usr/lib64
  libs = -lpolicy -lgmock -lgtest -lpthread -ldbus-1 -lbrillo -lbase -lre2 -lbase-test
  frameworks =
  swiftmodules =
  output_extension = 
  output_dir = .
