defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -I../../../../../../../../../mnt/host/source/src/platform2/metrics -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIC -fvisibility=default -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -I/build/arm64-generic/usr/include/chromeos -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1211970 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/session_manager-client
cflags_cc = -fno-exceptions -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libmetrics

build obj/metrics/libmetrics.c_metrics_library.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/c_metrics_library.cc
  source_file_part = c_metrics_library.cc
  source_name_part = c_metrics_library
build obj/metrics/libmetrics.cumulative_metrics.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/cumulative_metrics.cc
  source_file_part = cumulative_metrics.cc
  source_name_part = cumulative_metrics
build obj/metrics/libmetrics.metrics_library.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/metrics_library.cc
  source_file_part = metrics_library.cc
  source_name_part = metrics_library
build obj/metrics/libmetrics.metrics_writer.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/metrics_writer.cc
  source_file_part = metrics_writer.cc
  source_name_part = metrics_writer
build obj/metrics/libmetrics.persistent_integer.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/persistent_integer.cc
  source_file_part = persistent_integer.cc
  source_name_part = persistent_integer
build obj/metrics/serialization/libmetrics.metric_sample.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/serialization/metric_sample.cc
  source_file_part = metric_sample.cc
  source_name_part = metric_sample
build obj/metrics/serialization/libmetrics.serialization_utils.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/serialization/serialization_utils.cc
  source_file_part = serialization_utils.cc
  source_name_part = serialization_utils
build obj/metrics/libmetrics.timer.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/metrics/timer.cc
  source_file_part = timer.cc
  source_name_part = timer

build ./lib/libmetrics.so: solink obj/metrics/libmetrics.c_metrics_library.o obj/metrics/libmetrics.cumulative_metrics.o obj/metrics/libmetrics.metrics_library.o obj/metrics/libmetrics.metrics_writer.o obj/metrics/libmetrics.persistent_integer.o obj/metrics/serialization/libmetrics.metric_sample.o obj/metrics/serialization/libmetrics.serialization_utils.o obj/metrics/libmetrics.timer.o
  ldflags = -Wl,-O2 -Wl,--as-needed -Wl,--fix-cortex-a53-843419 -Wl,--gc-sections -Wl,--icf=all -Wl,-z,relro -Wl,-z,noexecstack -Wl,-z,now -Wl,--as-needed --sysroot=/build/arm64-generic
  libs = -lpolicy -lbrillo -lbase -lpthread
  frameworks =
  swiftmodules =
  output_extension = .so
  output_dir = .
