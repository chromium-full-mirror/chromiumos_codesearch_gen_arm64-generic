defines = -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
include_dirs = -Igen/include -I../../../../../../../../../mnt/host/source/src/platform2 -I/build/arm64-generic/usr/include
cflags = -Wall -Wunused -Wbool-operation -Wfree-nonheap-object -Wint-in-bool-context -Wstring-compare -Wstring-plus-int -Wxor-used-as-pow -Wdeprecated-declarations -Wno-c99-designator -Wno-unused-parameter -Wunreachable-code -Wunreachable-code-return -ggdb3 -fstack-protector-strong -Wformat=2 -fvisibility=internal -Wa,--noexecstack -Wimplicit-fallthrough -Werror -Wno-error=deprecated-enum-enum-conversion -Wno-error=deprecated-this-capture -ftrivial-auto-var-init=pattern --sysroot=/build/arm64-generic -fPIE -I/build/arm64-generic/usr/include/dbus-1.0 -I/build/arm64-generic/usr/lib64/dbus-1.0/include -DUSE_RTTI_FOR_TYPE_TAGS=1 -I/build/arm64-generic/usr/include/libchrome -I/build/arm64-generic/usr/include/glib-2.0 -I/build/arm64-generic/usr/lib64/glib-2.0/include -I/build/arm64-generic/usr/include/perfetto -I/build/arm64-generic/usr/include/nss -I/build/arm64-generic/usr/include/nspr -I/build/arm64-generic/usr/include/chromeos -pthread -DPROTOBUF_USE_DLLS -I/build/arm64-generic/usr/include/libusb-1.0 -Wno-unused-local-typedefs -DBASE_VER=1241304 -DBASE_USE_PERFETTO_CLIENT_LIBRARY -DPERFETTO_ENABLE_LEGACY_TRACE_EVENTS=1 -I/build/arm64-generic/usr/include/session_manager-client -DPROTOBUF_USE_DLLS
cflags_cc = -std=gnu++20 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Os -pipe -march=armv8-a -g -ffunction-sections -fdata-sections -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables
root_out_dir = .
target_output_name = libdlp_static

build obj/dlp/libdlp_static.dlp_adaptor.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/dlp_adaptor.cc
  source_file_part = dlp_adaptor.cc
  source_name_part = dlp_adaptor
build obj/dlp/libdlp_static.dlp_daemon.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/dlp_daemon.cc
  source_file_part = dlp_daemon.cc
  source_name_part = dlp_daemon
build obj/dlp/libdlp_static.dlp_database.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/dlp_database.cc
  source_file_part = dlp_database.cc
  source_name_part = dlp_database
build obj/dlp/libdlp_static.dlp_metrics.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/dlp_metrics.cc
  source_file_part = dlp_metrics.cc
  source_name_part = dlp_metrics
build obj/dlp/libdlp_static.dlp_requests_cache.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/dlp_requests_cache.cc
  source_file_part = dlp_requests_cache.cc
  source_name_part = dlp_requests_cache
build obj/dlp/libdlp_static.fanotify_reader_thread.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/fanotify_reader_thread.cc
  source_file_part = fanotify_reader_thread.cc
  source_name_part = fanotify_reader_thread
build obj/dlp/libdlp_static.fanotify_watcher.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/fanotify_watcher.cc
  source_file_part = fanotify_watcher.cc
  source_name_part = fanotify_watcher
build obj/dlp/libdlp_static.file_id.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/file_id.cc
  source_file_part = file_id.cc
  source_name_part = file_id
build obj/dlp/libdlp_static.kernel_version_tools.o: cxx ../../../../../../../../../mnt/host/source/src/platform2/dlp/kernel_version_tools.cc
  source_file_part = kernel_version_tools.cc
  source_name_part = kernel_version_tools

build ./libdlp_static.a: alink obj/dlp/libdlp_static.dlp_adaptor.o obj/dlp/libdlp_static.dlp_daemon.o obj/dlp/libdlp_static.dlp_database.o obj/dlp/libdlp_static.dlp_metrics.o obj/dlp/libdlp_static.dlp_requests_cache.o obj/dlp/libdlp_static.fanotify_reader_thread.o obj/dlp/libdlp_static.fanotify_watcher.o obj/dlp/libdlp_static.file_id.o obj/dlp/libdlp_static.kernel_version_tools.o || ./lib/libfeatures.so
  arflags = rcsT
  output_extension = .a
  output_dir = 
