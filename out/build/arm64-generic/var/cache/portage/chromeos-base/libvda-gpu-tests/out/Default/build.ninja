ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libvda-gpu-tests-0.0.1-r561/work/libvda-gpu-tests-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libvda: phony ./lib/libvda.so
build libvda_pc: phony obj/arc/vm/libvda/libvda_pc.stamp
build libvda_source_set: phony obj/arc/vm/libvda/libvda_source_set.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build video_mojo_bindings: phony ./libvideo_mojo_bindings.a
build video_mojo_bindings_gen: phony obj/arc/vm/libvda/video_mojo_bindings_gen.stamp
build video_mojo_bindings_gen_mojo_templates: phony obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates.stamp
build video_mojo_bindings_gen_mojo_templates_dir: phony obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates_dir.stamp
build video_mojo_bindings_gen_parse: phony obj/arc/vm/libvda/video_mojo_bindings_gen_parse.stamp
build arc/vm/libvda$:all: phony obj/arc/vm/libvda/all.stamp
build arc/vm/libvda$:libvda: phony ./lib/libvda.so
build arc/vm/libvda: phony ./lib/libvda.so
build arc/vm/libvda$:libvda_gpu_unittest: phony ./libvda_gpu_unittest
build arc/vm/libvda$:libvda_pc: phony obj/arc/vm/libvda/libvda_pc.stamp
build arc/vm/libvda$:libvda_source_set: phony obj/arc/vm/libvda/libvda_source_set.stamp
build arc/vm/libvda$:video_mojo_bindings: phony ./libvideo_mojo_bindings.a
build arc/vm/libvda$:video_mojo_bindings_gen: phony obj/arc/vm/libvda/video_mojo_bindings_gen.stamp
build arc/vm/libvda$:video_mojo_bindings_gen_mojo_templates: phony obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates.stamp
build arc/vm/libvda$:video_mojo_bindings_gen_mojo_templates_dir: phony obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates_dir.stamp
build arc/vm/libvda$:video_mojo_bindings_gen_parse: phony obj/arc/vm/libvda/video_mojo_bindings_gen_parse.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp

build all: phony $
    obj/arc/vm/libvda/all.stamp $
    ./lib/libvda.so $
    ./libvda_gpu_unittest $
    obj/arc/vm/libvda/libvda_pc.stamp $
    obj/arc/vm/libvda/libvda_source_set.stamp $
    ./libvideo_mojo_bindings.a $
    obj/arc/vm/libvda/video_mojo_bindings_gen.stamp $
    obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates.stamp $
    obj/arc/vm/libvda/video_mojo_bindings_gen_mojo_templates_dir.stamp $
    obj/arc/vm/libvda/video_mojo_bindings_gen_parse.stamp $
    obj/common-mk/gn_root/root.stamp

default all
