rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/swap_management/all.stamp
build obj/swap_management/_swap_management-install_config.stamp: stamp
build obj/swap_management/all.stamp: stamp obj/swap_management/install_dbus_config.stamp obj/swap_management/install_init.stamp obj/swap_management/install_minijail_conf.stamp obj/swap_management/install_tmpfiles_config.stamp obj/swap_management/install_udev_rule.stamp ./swap_management
build obj/swap_management/install_dbus_config.stamp: stamp
build obj/swap_management/install_init.stamp: stamp
build obj/swap_management/install_minijail_conf.stamp: stamp
build obj/swap_management/install_tmpfiles_config.stamp: stamp
build obj/swap_management/install_udev_rule.stamp: stamp
subninja obj/swap_management/libswapmanagement.ninja
rule __swap_management_swap-management-adaptors___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/chromeos-base/swap_management-0.0.1-r272/work/swap_management-0.0.1/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -adaptor=/build/arm64-generic/var/cache/portage/chromeos-base/swap_management/out/Default/gen/include/swap_management/dbus_adaptors/${source_name_part}.h -service-config=/build/arm64-generic/tmp/portage/chromeos-base/swap_management-0.0.1-r272/work/swap_management-0.0.1/swap_management/dbus_bindings/dbus-service-config.json ${in}
  description = ACTION //swap_management:swap-management-adaptors(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/swap_management/dbus_adaptors/org.chromium.SwapManagement.h: __swap_management_swap-management-adaptors___common-mk_toolchain_toolchain__rule ../../../../../../../tmp/portage/chromeos-base/swap_management-0.0.1-r272/work/swap_management-0.0.1/swap_management/dbus_bindings/org.chromium.SwapManagement.xml | ../../../../../../../tmp/portage/chromeos-base/swap_management-0.0.1-r272/work/swap_management-0.0.1/common-mk/file_generator_wrapper.py
  source_name_part = org.chromium.SwapManagement

build obj/swap_management/swap-management-adaptors.stamp: stamp gen/include/swap_management/dbus_adaptors/org.chromium.SwapManagement.h
subninja obj/swap_management/swap_management.ninja
