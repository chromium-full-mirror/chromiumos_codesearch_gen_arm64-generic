build obj/device_management/all.stamp: stamp ./device_management_client ./device_managementd obj/device_management/install_init.stamp obj/device_management/install_minijail_conf.stamp obj/device_management/install_policy.stamp obj/device_management/install_systemd.stamp obj/device_management/install_tmpfiles_config.stamp
