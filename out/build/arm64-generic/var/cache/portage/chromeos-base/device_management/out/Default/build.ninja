ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/device_management-0.0.1-r216/work/device_management-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _device_management_client-install_config: phony obj/device_management/_device_management_client-install_config.stamp
build _device_managementd-install_config: phony obj/device_management/_device_managementd-install_config.stamp
build device_management_adaptors: phony obj/device_management/device_management_adaptors.stamp
build device_management_server_library: phony obj/device_management/device_management_server_library.stamp
build install_init: phony obj/device_management/install_init.stamp
build install_minijail_conf: phony obj/device_management/install_minijail_conf.stamp
build install_policy: phony obj/device_management/install_policy.stamp
build install_systemd: phony obj/device_management/install_systemd.stamp
build install_tmpfiles_config: phony obj/device_management/install_tmpfiles_config.stamp
build print_proto_library: phony obj/device_management/print_proto_library.stamp
build proto_library: phony obj/device_management/proto_library.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build device_management$:_device_management_client-install_config: phony obj/device_management/_device_management_client-install_config.stamp
build device_management$:_device_managementd-install_config: phony obj/device_management/_device_managementd-install_config.stamp
build device_management$:all: phony obj/device_management/all.stamp
build device_management$:device_management_adaptors: phony obj/device_management/device_management_adaptors.stamp
build device_management$:device_management_client: phony ./device_management_client
build device_management$:device_management_server_library: phony obj/device_management/device_management_server_library.stamp
build device_management$:device_managementd: phony ./device_managementd
build device_management$:install_init: phony obj/device_management/install_init.stamp
build device_management$:install_minijail_conf: phony obj/device_management/install_minijail_conf.stamp
build device_management$:install_policy: phony obj/device_management/install_policy.stamp
build device_management$:install_systemd: phony obj/device_management/install_systemd.stamp
build device_management$:install_tmpfiles_config: phony obj/device_management/install_tmpfiles_config.stamp
build device_management$:print_proto_library: phony obj/device_management/print_proto_library.stamp
build device_management$:proto_library: phony obj/device_management/proto_library.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/device_management/_device_management_client-install_config.stamp $
    obj/device_management/_device_managementd-install_config.stamp $
    obj/device_management/all.stamp $
    obj/device_management/device_management_adaptors.stamp $
    ./device_management_client $
    obj/device_management/device_management_server_library.stamp $
    ./device_managementd $
    obj/device_management/install_init.stamp $
    obj/device_management/install_minijail_conf.stamp $
    obj/device_management/install_policy.stamp $
    obj/device_management/install_systemd.stamp $
    obj/device_management/install_tmpfiles_config.stamp $
    obj/device_management/print_proto_library.stamp $
    obj/device_management/proto_library.stamp

default all
