rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/patchpanel/dbus/all.stamp
subninja obj/common-mk/testrunner/testrunner.ninja
build obj/patchpanel/dbus/all.stamp: stamp ./lib/libpatchpanel-client.so ./patchpanel-client_testrunner
subninja obj/patchpanel/dbus/libpatchpanel-client.ninja
subninja obj/patchpanel/dbus/patchpanel-client_testrunner.ninja
subninja obj/patchpanel/dbus/patchpanel_client_test_support.ninja
rule __patchpanel_dbus_patchpanel_dbus_proxies___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py go-generate-chromeos-dbus-bindings -service-config=/mnt/host/source/src/platform2/patchpanel/dbus_bindings/dbus-service-config.json -proxy=/build/arm64-generic/var/cache/portage/chromeos-base/patchpanel-client/out/Default/gen/include/patchpanel/dbus-proxies.h ../../../../../../../../../mnt/host/source/src/platform2/patchpanel/dbus_bindings/org.chromium.patchpanel.xml
  description = ACTION //patchpanel/dbus:patchpanel_dbus_proxies(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/patchpanel/dbus-proxies.h: __patchpanel_dbus_patchpanel_dbus_proxies___common-mk_toolchain_toolchain__rule | ../../../../../../../../../mnt/host/source/src/platform2/common-mk/file_generator_wrapper.py ../../../../../../../../../mnt/host/source/src/platform2/patchpanel/dbus_bindings/org.chromium.patchpanel.xml

build obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp: stamp gen/include/patchpanel/dbus-proxies.h
