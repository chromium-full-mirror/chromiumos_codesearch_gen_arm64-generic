ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libpatchpanel-client: phony ./lib/libpatchpanel-client.so
build patchpanel_client_test_support: phony obj/patchpanel/dbus/patchpanel_client_test_support.stamp
build patchpanel_dbus_proxies: phony obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build testrunner: phony ./libtestrunner.a
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build common-mk/testrunner$:testrunner: phony ./libtestrunner.a
build common-mk/testrunner: phony ./libtestrunner.a
build patchpanel/dbus$:all: phony obj/patchpanel/dbus/all.stamp
build patchpanel/dbus$:libpatchpanel-client: phony ./lib/libpatchpanel-client.so
build patchpanel/dbus$:patchpanel-client_testrunner: phony ./patchpanel-client_testrunner
build patchpanel/dbus$:patchpanel_client_test_support: phony obj/patchpanel/dbus/patchpanel_client_test_support.stamp
build patchpanel/dbus$:patchpanel_dbus_proxies: phony obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    ./libtestrunner.a $
    obj/patchpanel/dbus/all.stamp $
    ./lib/libpatchpanel-client.so $
    ./patchpanel-client_testrunner $
    obj/patchpanel/dbus/patchpanel_client_test_support.stamp $
    obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp

default all
