ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/patchpanel-client-0.0.1-r949/work/patchpanel-client-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build libpatchpanel-client: phony ./lib/libpatchpanel-client.so
build patchpanel_dbus_proxies: phony obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build patchpanel/dbus$:all: phony obj/patchpanel/dbus/all.stamp
build patchpanel/dbus$:libpatchpanel-client: phony ./lib/libpatchpanel-client.so
build patchpanel/dbus$:patchpanel_dbus_proxies: phony obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/patchpanel/dbus/all.stamp $
    ./lib/libpatchpanel-client.so $
    obj/patchpanel/dbus/patchpanel_dbus_proxies.stamp

default all
