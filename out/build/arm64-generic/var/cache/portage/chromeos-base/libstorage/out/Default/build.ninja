ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../tmp/portage/chromeos-base/libstorage-0.0.1-r2/work/libstorage-0.0.1 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libstorage_fake_platform-install_config: phony obj/libstorage/platform/_libstorage_fake_platform-install_config.stamp
build _libstorage_fake_platform_pc-install_config: phony obj/libstorage/platform/_libstorage_fake_platform_pc-install_config.stamp
build _libstorage_fuzzer-install_config: phony obj/libstorage/platform/_libstorage_fuzzer-install_config.stamp
build _libstorage_fuzzer_pc-install_config: phony obj/libstorage/platform/_libstorage_fuzzer_pc-install_config.stamp
build _libstorage_platform-install_config: phony obj/libstorage/platform/_libstorage_platform-install_config.stamp
build _libstorage_platform_pc-install_config: phony obj/libstorage/platform/_libstorage_platform_pc-install_config.stamp
build install_fuzzer_headers: phony obj/libstorage/platform/install_fuzzer_headers.stamp
build install_platform_fake_headers: phony obj/libstorage/platform/install_platform_fake_headers.stamp
build install_platform_headers: phony obj/libstorage/platform/install_platform_headers.stamp
build libstorage_fake_platform: phony ./lib/libstorage_fake_platform.so
build libstorage_fake_platform_pc: phony obj/libstorage/platform/libstorage_fake_platform_pc.stamp
build libstorage_fuzzer: phony ./lib/libstorage_fuzzer.so
build libstorage_fuzzer_pc: phony obj/libstorage/platform/libstorage_fuzzer_pc.stamp
build libstorage_platform: phony ./lib/libstorage_platform.so
build libstorage_platform_pc: phony obj/libstorage/platform/libstorage_platform_pc.stamp
build libstorage_platform_static: phony ./libstorage_platform_static.a
build libstorage_sources: phony obj/libstorage/platform/libstorage_sources.stamp
build platform: phony obj/libstorage/platform/platform.stamp
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build libstorage$:all: phony obj/libstorage/all.stamp
build libstorage/platform$:_libstorage_fake_platform-install_config: phony obj/libstorage/platform/_libstorage_fake_platform-install_config.stamp
build libstorage/platform$:_libstorage_fake_platform_pc-install_config: phony obj/libstorage/platform/_libstorage_fake_platform_pc-install_config.stamp
build libstorage/platform$:_libstorage_fuzzer-install_config: phony obj/libstorage/platform/_libstorage_fuzzer-install_config.stamp
build libstorage/platform$:_libstorage_fuzzer_pc-install_config: phony obj/libstorage/platform/_libstorage_fuzzer_pc-install_config.stamp
build libstorage/platform$:_libstorage_platform-install_config: phony obj/libstorage/platform/_libstorage_platform-install_config.stamp
build libstorage/platform$:_libstorage_platform_pc-install_config: phony obj/libstorage/platform/_libstorage_platform_pc-install_config.stamp
build libstorage/platform$:install_fuzzer_headers: phony obj/libstorage/platform/install_fuzzer_headers.stamp
build libstorage/platform$:install_platform_fake_headers: phony obj/libstorage/platform/install_platform_fake_headers.stamp
build libstorage/platform$:install_platform_headers: phony obj/libstorage/platform/install_platform_headers.stamp
build libstorage/platform$:libstorage_fake_platform: phony ./lib/libstorage_fake_platform.so
build libstorage/platform$:libstorage_fake_platform_pc: phony obj/libstorage/platform/libstorage_fake_platform_pc.stamp
build libstorage/platform$:libstorage_fuzzer: phony ./lib/libstorage_fuzzer.so
build libstorage/platform$:libstorage_fuzzer_pc: phony obj/libstorage/platform/libstorage_fuzzer_pc.stamp
build libstorage/platform$:libstorage_platform: phony ./lib/libstorage_platform.so
build libstorage/platform$:libstorage_platform_pc: phony obj/libstorage/platform/libstorage_platform_pc.stamp
build libstorage/platform$:libstorage_platform_static: phony ./libstorage_platform_static.a
build libstorage/platform$:libstorage_sources: phony obj/libstorage/platform/libstorage_sources.stamp
build libstorage/platform$:platform: phony obj/libstorage/platform/platform.stamp
build libstorage/platform: phony obj/libstorage/platform/platform.stamp

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/libstorage/all.stamp $
    obj/libstorage/platform/_libstorage_fake_platform-install_config.stamp $
    obj/libstorage/platform/_libstorage_fake_platform_pc-install_config.stamp $
    obj/libstorage/platform/_libstorage_fuzzer-install_config.stamp $
    obj/libstorage/platform/_libstorage_fuzzer_pc-install_config.stamp $
    obj/libstorage/platform/_libstorage_platform-install_config.stamp $
    obj/libstorage/platform/_libstorage_platform_pc-install_config.stamp $
    obj/libstorage/platform/install_fuzzer_headers.stamp $
    obj/libstorage/platform/install_platform_fake_headers.stamp $
    obj/libstorage/platform/install_platform_headers.stamp $
    ./lib/libstorage_fake_platform.so $
    obj/libstorage/platform/libstorage_fake_platform_pc.stamp $
    ./lib/libstorage_fuzzer.so $
    obj/libstorage/platform/libstorage_fuzzer_pc.stamp $
    ./lib/libstorage_platform.so $
    obj/libstorage/platform/libstorage_platform_pc.stamp $
    ./libstorage_platform_static.a $
    obj/libstorage/platform/libstorage_sources.stamp $
    obj/libstorage/platform/platform.stamp

default all
