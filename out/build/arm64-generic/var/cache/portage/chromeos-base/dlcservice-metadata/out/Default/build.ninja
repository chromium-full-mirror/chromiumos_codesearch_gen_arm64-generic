ninja_required_version = 1.7.2

rule gn
  command = ../../../../../../../../../usr/bin/gn --root=../../../../../../../../../mnt/host/source/src/platform2 -q --regeneration gen .
  pool = console
  description = Regenerating ninja files

# The 'gn' rule also writes build.ninja, unbeknownst to ninja. The
# build.ninja edge is separate to prevent ninja from deleting it
# (due to depfile usage) if interrupted. gn uses atomic writes to
# ensure that build.ninja is always valid even if interrupted.
build build.ninja.stamp: gn
  generator = 1
  depfile = build.ninja.d

build build.ninja: phony build.ninja.stamp
  generator = 1

subninja toolchain.ninja

build _libdlcservice-metadata-install_config: phony obj/dlcservice/metadata/_libdlcservice-metadata-install_config.stamp
build install_header: phony obj/dlcservice/metadata/install_header.stamp
build install_pkgconfig: phony obj/dlcservice/metadata/install_pkgconfig.stamp
build libdlcservice-metadata: phony ./lib/libdlcservice-metadata.so
build root: phony obj/common-mk/gn_root/root.stamp
build common-mk/gn_root$:root: phony obj/common-mk/gn_root/root.stamp
build dlcservice/metadata$:_libdlcservice-metadata-install_config: phony obj/dlcservice/metadata/_libdlcservice-metadata-install_config.stamp
build dlcservice/metadata$:all: phony obj/dlcservice/metadata/all.stamp
build dlcservice/metadata$:install_header: phony obj/dlcservice/metadata/install_header.stamp
build dlcservice/metadata$:install_pkgconfig: phony obj/dlcservice/metadata/install_pkgconfig.stamp
build dlcservice/metadata$:libdlcservice-metadata: phony ./lib/libdlcservice-metadata.so

build all: phony $
    obj/common-mk/gn_root/root.stamp $
    obj/dlcservice/metadata/_libdlcservice-metadata-install_config.stamp $
    obj/dlcservice/metadata/all.stamp $
    obj/dlcservice/metadata/install_header.stamp $
    obj/dlcservice/metadata/install_pkgconfig.stamp $
    ./lib/libdlcservice-metadata.so

default all
