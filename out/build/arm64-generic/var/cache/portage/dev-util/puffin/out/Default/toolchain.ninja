rule link
  command = aarch64-cros-linux-gnu-clang++ ${ldflags} -o ${output_dir}/${target_output_name}${output_extension} -Wl,--start-group ${in} -Wl,--end-group ${solibs} ${libs}
  description = LINK ${output_dir}/${target_output_name}${output_extension}
rule cxx
  command = aarch64-cros-linux-gnu-clang++ -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = CXX ${out}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = aarch64-cros-linux-gnu-clang++ -shared ${ldflags} -o ${output_dir}/lib/${target_output_name}${output_extension} -Wl,-soname=${target_output_name}${output_extension} @lib/${target_output_name}${output_extension}.rsp
  description = SOLINK ${target_output_name}${output_extension}
  rspfile = lib/${target_output_name}${output_extension}.rsp
  rspfile_content = -Wl,--whole-archive ${in} ${solibs} -Wl,--no-whole-archive ${libs}
rule stamp
  command = touch ${out}
  description = STAMP ${out}
rule alink
  command = rm -f ${out} && llvm-ar ${arflags} ${out} @${out}.rsp
  description = AR ${target_output_name}${output_extension}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule asm
  command = aarch64-cros-linux-gnu-clang -MMD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = CC ${out}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = cp -af ${in} ${out}
  description = COPY ${in} ${out}

build obj/common-mk/gn_root/root.stamp: stamp obj/puffin/all.stamp
build obj/puffin/all.stamp: stamp ./libpuffin-proto.a ./libpuffdiff.a ./libpuffpatch.a ./puffin
subninja obj/puffin/libpuffdiff.ninja
subninja obj/puffin/libpuffin-proto.ninja
rule __puffin_libpuffin-proto_gen___common-mk_toolchain_toolchain__rule
  command = /usr/bin/env ../../../../../../../tmp/portage/dev-util/puffin-1.0.0-r448/work/puffin-1.0.0/platform2/common-mk/file_generator_wrapper.py protoc puffin.proto --proto_path /build/arm64-generic/tmp/portage/dev-util/puffin-1.0.0-r448/work/puffin-1.0.0/platform2/puffin/src --proto_path /build/arm64-generic/usr/share/proto --cpp_out=/build/arm64-generic/var/cache/portage/dev-util/puffin/out/Default/gen/include/puffin/src
  description = ACTION //puffin:libpuffin-proto_gen(//common-mk/toolchain:toolchain)
  restat = 1

build gen/include/puffin/src/puffin.pb.cc gen/include/puffin/src/puffin.pb.h: __puffin_libpuffin-proto_gen___common-mk_toolchain_toolchain__rule | ../../../../../../../tmp/portage/dev-util/puffin-1.0.0-r448/work/puffin-1.0.0/platform2/common-mk/file_generator_wrapper.py ../../../../../../../tmp/portage/dev-util/puffin-1.0.0-r448/work/puffin-1.0.0/platform2/puffin/src/puffin.proto

build obj/puffin/libpuffin-proto_gen.stamp: stamp gen/include/puffin/src/puffin.pb.cc gen/include/puffin/src/puffin.pb.h
subninja obj/puffin/libpuffpatch.ninja
subninja obj/puffin/puffin.ninja
